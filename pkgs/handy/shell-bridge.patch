diff --git a/src-tauri/src/shell_bridge.rs b/src-tauri/src/shell_bridge.rs
new file mode 100644
index 0000000..1bedbfd
--- /dev/null
+++ b/src-tauri/src/shell_bridge.rs
@@ -0,0 +1,126 @@
+//! Mirrors the recording overlay's events onto a Unix socket, so a desktop shell can draw
+//! its own overlay instead of Handy's window. Each event is one JSON object per line; a
+//! client that connects mid-session is sent the current state first. Works whatever
+//! `overlay_style` is set to.
+//!
+//! Socket: `$XDG_RUNTIME_DIR/handy/overlay.sock`.
+
+use serde_json::{json, Value};
+use std::io::Write;
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Mutex;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+static CLIENTS: Mutex<Vec<UnixStream>> = Mutex::new(Vec::new());
+// The last state and readiness, replayed to a client that connects mid-session.
+static SNAPSHOT: Mutex<Vec<String>> = Mutex::new(Vec::new());
+static LAST_LEVELS: AtomicU64 = AtomicU64::new(0);
+
+const LEVEL_INTERVAL_MS: u64 = 33;
+
+fn socket_path() -> Option<PathBuf> {
+    std::env::var_os("XDG_RUNTIME_DIR").map(|dir| PathBuf::from(dir).join("handy").join("overlay.sock"))
+}
+
+pub fn init() {
+    let Some(path) = socket_path() else {
+        log::warn!("shell bridge: XDG_RUNTIME_DIR unset, not serving overlay events");
+        return;
+    };
+    if let Some(dir) = path.parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    // Another running instance owns a socket that answers; only a dead one is replaced.
+    if UnixStream::connect(&path).is_ok() {
+        log::warn!("shell bridge: {} is already served", path.display());
+        return;
+    }
+    let _ = std::fs::remove_file(&path);
+    let listener = match UnixListener::bind(&path) {
+        Ok(listener) => listener,
+        Err(e) => {
+            log::warn!("shell bridge: cannot bind {}: {e}", path.display());
+            return;
+        }
+    };
+    log::info!("shell bridge: serving overlay events on {}", path.display());
+    std::thread::spawn(move || {
+        for stream in listener.incoming().flatten() {
+            // A shell that stops reading is dropped rather than stalling the audio path.
+            let _ = stream.set_write_timeout(Some(Duration::from_millis(50)));
+            let mut stream = stream;
+            let replay = SNAPSHOT.lock().map(|s| s.clone()).unwrap_or_default();
+            if replay.iter().all(|line| stream.write_all(line.as_bytes()).is_ok()) {
+                if let Ok(mut clients) = CLIENTS.lock() {
+                    clients.push(stream);
+                }
+            }
+        }
+    });
+}
+
+fn publish(value: Value) -> String {
+    let mut line = value.to_string();
+    line.push('\n');
+    if let Ok(mut clients) = CLIENTS.lock() {
+        clients.retain_mut(|c| c.write_all(line.as_bytes()).is_ok());
+    }
+    line
+}
+
+/// "recording", "streaming", "transcribing" or "processing".
+pub fn state(state: &str) {
+    let line = publish(json!({ "event": "state", "state": state }));
+    if let Ok(mut snapshot) = SNAPSHOT.lock() {
+        // Recording begins a session: its readiness is not known yet.
+        if state == "recording" || state == "streaming" {
+            snapshot.clear();
+        } else {
+            snapshot.retain(|l| !l.contains("\"event\":\"state\""));
+        }
+        snapshot.insert(0, line);
+    }
+}
+
+pub fn hide() {
+    publish(json!({ "event": "hide" }));
+    if let Ok(mut snapshot) = SNAPSHOT.lock() {
+        snapshot.clear();
+    }
+}
+
+/// The microphone has delivered its first samples.
+pub fn ready() {
+    let line = publish(json!({ "event": "ready" }));
+    if let Ok(mut snapshot) = SNAPSHOT.lock() {
+        snapshot.push(line);
+    }
+}
+
+/// 16 spectrum buckets, 0..1, throttled to about 30 a second.
+pub fn levels(levels: &[f32]) {
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis() as u64;
+    if now.saturating_sub(LAST_LEVELS.load(Ordering::Relaxed)) < LEVEL_INTERVAL_MS {
+        return;
+    }
+    LAST_LEVELS.store(now, Ordering::Relaxed);
+    let has_clients = CLIENTS.lock().map(|c| !c.is_empty()).unwrap_or(false);
+    if has_clients {
+        publish(json!({ "event": "levels", "levels": levels }));
+    }
+}
+
+/// Live text: `committed` no longer changes, `tentative` may still be rewritten.
+pub fn text(committed: &str, tentative: &str) {
+    publish(json!({ "event": "text", "committed": committed, "tentative": tentative }));
+}
+
+/// The stream is finalizing ("transcribing") or post-processing ("polishing").
+pub fn working(kind: &str) {
+    publish(json!({ "event": "working", "kind": kind }));
+}
