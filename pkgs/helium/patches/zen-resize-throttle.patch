+void MultiContentsView::SetThrottledContentsResize(
+    bool throttled,
+    std::optional<int> lead_width) {
+  // The panes' current widths only split `lead_width` between them, so it
+  // doesn't matter that they are about to be laid out again.
+  const bool side_by_side =
+      IsInSplitView() &&
+      GetSplitLayout() == split_tabs::SplitTabLayout::kSideBySide;
+  int total_width = 0;
+  if (side_by_side) {
+    for (auto& contents_container_view : contents_container_views_) {
+      total_width += contents_container_view->width();
+    }
+  }
+  for (auto& contents_container_view : contents_container_views_) {
+    std::optional<int> pane_lead_width = lead_width;
+    if (pane_lead_width && side_by_side) {
+      pane_lead_width =
+          total_width > 0
+              ? base::ClampRound(static_cast<float>(*pane_lead_width) *
+                                 contents_container_view->width() /
+                                 total_width)
+              : 0;
+    }
+    contents_container_view->contents_view()->SetThrottledResize(
+        throttled, pane_lead_width);
+  }
+}
