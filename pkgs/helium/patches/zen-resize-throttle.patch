+void ContentsWebView::SetResizeDeadlineOverride(
+    content::WebContents* web_contents,
+    bool no_deadline) {
+  // On Linux and Windows the frame host already embeds a resized surface with
+  // a zero deadline, so the browser's frame shows the page's last frame rather
+  // than waiting for one of the new size. Any surface it embeds without a size
+  // change still gets the caller's deadline, though, usually the default of a
+  // few frames: e.g. a surface id the renderer allocated reported back with
+  // its frame, or a resize with kUseDefaultDeadlineWhenAnimatingBounds. During
+  // the slide that would stall the browser's frame, and the sidebar with it,
+  // until the page has drawn. Clearing the override restores the usual
+  // deadlines once the sidebar is at rest.
+  content::RenderWidgetHostView* const rwhv =
+      web_contents ? web_contents->GetRenderWidgetHostView() : nullptr;
+  if (!rwhv) {
+    return;
+  }
+  if (no_deadline) {
+    rwhv->SetForceSpecifiedDeadline(0u);
+  } else {
+    rwhv->SetForceSpecifiedDeadline(std::nullopt);
+  }
+}
