+
+void ContentsWebView::MaybeResizeThrottledRenderer() {
+#if defined(USE_AURA)
+  aura::Window* const native_view = holder()->native_view();
+  if (!native_view || holder()->size().IsEmpty()) {
+    return;
+  }
+  gfx::Size target_size = holder()->size();
+  target_size.Enlarge(throttled_resize_lead_width_.value_or(0), 0);
+  const gfx::Size current_size = native_view->bounds().size();
+  // Leave rounding differences, and the spring settling, to the exact resize
+  // at the end of the slide, which then has nothing left to do.
+  if (current_size.height() == target_size.height() &&
+      std::abs(current_size.width() - target_size.width()) <=
+          kThrottledResizeTolerance) {
+    return;
+  }
+  // Laying the page out ahead at its final width can't wait: the sidebar is
+  // already uncovering it.
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!throttled_resize_lead_width_ &&
+      now - last_throttled_resize_ < kThrottledResizeInterval) {
+    return;
+  }
+  last_throttled_resize_ = now;
+  // The holder has just positioned the native view, and with fast resize it
+  // keeps this size and clips it to the view. The page's renderer follows the
+  // native view's size; the frame host shows its last frame unstretched, with
+  // the page's background colour beside it, until it draws at the new size.
+  native_view->SetBounds(
+      gfx::Rect(native_view->bounds().origin(), target_size));
+#endif
+}
