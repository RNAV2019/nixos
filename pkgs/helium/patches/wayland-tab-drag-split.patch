+// Observes one window's DragDropClient during a system DnD tab drag and
+// forwards its position updates to TabDragController. The client notifies
+// observers on every motion, whichever aura window (tab strip widget, web
+// contents, ...) is under the cursor.
+class TabDragController::SystemDnDClientObserver
+    : public aura::client::DragDropClientObserver {
+ public:
+  explicit SystemDnDClientObserver(aura::client::DragDropClient* client) {
+    observation_.Observe(client);
+  }
+  SystemDnDClientObserver(const SystemDnDClientObserver&) = delete;
+  SystemDnDClientObserver& operator=(const SystemDnDClientObserver&) = delete;
+  ~SystemDnDClientObserver() override = default;
+
+  bool IsObserving(aura::client::DragDropClient* client) const {
+    return observation_.IsObservingSource(client);
+  }
+
+  // aura::client::DragDropClientObserver:
+  void OnDragUpdated(const ui::DropTargetEvent& event) override {
+    if (!TabDragController::IsSystemDnDTabDragData(event.data())) {
+      return;
+    }
+    // The tab strip's DropTarget may already have forwarded this location.
+    if (g_tab_drag_controller->last_system_dnd_root_location_ ==
+        event.root_location()) {
+      return;
+    }
+    VLOG(2) << "SystemDnDClientObserver::OnDragUpdated root="
+            << event.root_location().ToString();
+    // May destroy `this` (via the TabDragController); don't touch members
+    // afterwards.
+    TabDragController::OnSystemDnDUpdated(event);
+  }
+  void OnDragDropClientDestroying() override { observation_.Reset(); }
+
+ private:
+  base::ScopedObservation<aura::client::DragDropClient,
+                          aura::client::DragDropClientObserver>
+      observation_{this};
+};
+#endif  // defined(USE_AURA)
