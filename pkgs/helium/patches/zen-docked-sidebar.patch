+
+// A group of browser controls that frameless (zen) mode shows in the vertical
+// tab strip instead of the hidden toolbar. The controls are the toolbar's own
+// views, re-parented here by ZenSidebarToolbarController, so their state and
+// bubbles keep working.
+class ZenSidebarToolbarRow : public views::FlexLayoutView {
+  METADATA_HEADER(ZenSidebarToolbarRow, views::FlexLayoutView)
+
+ public:
+  enum class Kind {
+    // Above the tabs: navigation, extensions and downloads, with the site
+    // pill below them.
+    kTop,
+    // Next to the new tab button: bookmark star, profile and app menu.
+    kBottom,
+  };
+
+  // Which end of the row a control is added to.
+  enum class Edge {
+    kLeading,
+    kTrailing,
+  };
+
+  ZenSidebarToolbarRow(Kind kind,
+                       BrowserView* browser_view,
+                       tabs::VerticalTabStripStateController* state_controller);
+  ZenSidebarToolbarRow(const ZenSidebarToolbarRow&) = delete;
+  ZenSidebarToolbarRow& operator=(const ZenSidebarToolbarRow&) = delete;
+  ~ZenSidebarToolbarRow() override;
+
+  // Takes a toolbar control. It is wrapped in a slot that ignores the flex and
+  // margin properties the toolbar sets on it. If `can_shrink` is true the
+  // control is laid out between its minimum and preferred widths, which lets
+  // the extensions container overflow pinned actions into its menu.
+  void AddControl(std::unique_ptr<views::View> control,
+                  Edge edge,
+                  bool can_shrink);
+
+  // Returns a control previously passed to AddControl().
+  std::unique_ptr<views::View> RemoveControl(views::View* control);
+
+  // Updates the site pill and bookmark star for the active tab.
+  void UpdateForActiveContents(content::WebContents* contents);
+
+  ZenSidebarSitePill* site_pill() { return site_pill_; }
+  ZenSidebarBookmarkStar* bookmark_star() { return bookmark_star_; }
+
+ private:
+  void OnCollapseStateChanged(tabs::VerticalTabStripCollapseState state);
+
+  raw_ptr<views::FlexLayoutView> controls_ = nullptr;
+  raw_ptr<views::View> spacer_ = nullptr;
+  raw_ptr<ZenSidebarSitePill> site_pill_ = nullptr;
+  raw_ptr<ZenSidebarBookmarkStar> bookmark_star_ = nullptr;
+  base::CallbackListSubscription collapse_state_subscription_;
+};
+
+// Moves the toolbar's navigation, extensions, pinned actions, profile and app
+// menu controls into the vertical tab strip's rows while frameless (zen) mode
+// hides the toolbar, and puts them back afterwards.
+class ZenSidebarToolbarController {
+ public:
+  ZenSidebarToolbarController(ToolbarView* toolbar,
+                              ZenSidebarToolbarRow* top_row,
+                              ZenSidebarToolbarRow* bottom_row);
+  ZenSidebarToolbarController(const ZenSidebarToolbarController&) = delete;
+  ZenSidebarToolbarController& operator=(const ZenSidebarToolbarController&) =
+      delete;
+  // Puts the controls back into the toolbar. Must run while both the toolbar
+  // and the rows are alive.
+  ~ZenSidebarToolbarController();
+
+  void SetRelocated(bool relocated);
+  bool relocated() const { return relocated_; }
+
+  ZenSidebarToolbarRow* top_row() { return top_row_; }
+  ZenSidebarToolbarRow* bottom_row() { return bottom_row_; }
+
+ private:
+  struct MovedControl {
+    raw_ptr<views::View> control;
+    raw_ptr<ZenSidebarToolbarRow> row;
+    size_t toolbar_index;
+  };
+
+  void Move(views::View* control,
+            ZenSidebarToolbarRow* row,
+            ZenSidebarToolbarRow::Edge edge,
+            bool can_shrink);
+
+  const raw_ptr<ToolbarView> toolbar_;
+  const raw_ptr<ZenSidebarToolbarRow> top_row_;
+  const raw_ptr<ZenSidebarToolbarRow> bottom_row_;
+  // In the order they were moved, so they can be put back in reverse.
+  std::vector<MovedControl> moved_controls_;
+  bool relocated_ = false;
+};
