+////////////////////////////////////////////////////////////////////////////////
+// ZenSidebarSitePill:
+
+ZenSidebarSitePill::ZenSidebarSitePill(BrowserView* browser_view)
+    : views::LabelButton(base::BindRepeating(&ZenSidebarSitePill::OnPressed,
+                                             base::Unretained(this))),
+      browser_view_(browser_view) {
+  // As tall and as round as the vertical tabs below it.
+  SetMinSize(
+      gfx::Size(0, GetLayoutConstant(LayoutConstant::kVerticalTabHeight)));
+  SetImageLabelSpacing(kSitePillImageLabelSpacing);
+  SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  // Keep the end of the host, which carries the registrable domain.
+  SetElideBehavior(gfx::ELIDE_HEAD);
+  SetEnabledTextColors(kColorTabForegroundInactiveFrameActive);
+  ConfigureInkDrop(this,
+                   std::make_unique<views::RoundRectHighlightPathGenerator>(
+                       gfx::Insets(), GetCornerRadius()));
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_TOOLTIP_LOCATION_ICON));
+}
+
+ZenSidebarSitePill::~ZenSidebarSitePill() = default;
+
+// static
+int ZenSidebarSitePill::GetCornerRadius() {
+  return GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+}
+
+void ZenSidebarSitePill::OnThemeChanged() {
+  views::LabelButton::OnThemeChanged();
+  // A faint wash and hairline of the sidebar's text color: reads as a field,
+  // not as a tab, and works on light and dark frames alike.
+  const SkColor foreground =
+      GetColorProvider()->GetColor(kColorTabForegroundInactiveFrameActive);
+  const float radius = GetCornerRadius();
+  SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetA(foreground, kSitePillFillAlpha), radius,
+      kSitePillOutlineThickness));
+  SetBorder(views::CreatePaddedBorder(
+      views::CreateRoundedRectBorder(
+          kSitePillOutlineThickness, radius,
+          SkColorSetA(foreground, kSitePillOutlineAlpha)),
+      gfx::Insets::VH(0, kSitePillHorizontalPadding -
+                             kSitePillOutlineThickness)));
+}
+
+void ZenSidebarSitePill::Update() {
+  const LocationBarModel* const model =
+      LocationBarModel::From(browser_view_->browser());
+  if (!model) {
+    return;
+  }
+
+  const bool show_url = model->ShouldDisplayURL();
+  SetText(show_url ? model->GetURLForDisplay(/*trim_after_host_name=*/true)
+                   : std::u16string());
+  SetTooltipText(show_url
+                     ? model->GetURLForDisplay()
+                     : l10n_util::GetStringUTF16(IDS_TOOLTIP_LOCATION_ICON));
+
+  const bool dangerous =
+      model->GetSecurityLevel() == security_state::DANGEROUS;
+  SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          model->GetVectorIcon(),
+          dangerous ? kColorOmniboxSecurityChipDangerous
+                    : kColorTabForegroundInactiveFrameActive,
+          GetLayoutConstant(LayoutConstant::kLocationBarIconSize)));
+}
+
+void ZenSidebarSitePill::OnPressed() {
+  // Page info anchors itself to this pill through
+  // bubble_anchor_util::GetPageInfoAnchorConfiguration().
+  ShowPageInfoDialog(browser_view_->GetActiveWebContents(), base::DoNothing(),
+                     bubble_anchor_util::Anchor::kLocationBar);
+}
