+// Shows the security state and host of the active tab in the sidebar while
+// frameless (zen) mode hides the location bar. Pressing it opens page info,
+// like the location bar's icon does.
+class ZenSidebarSitePill : public views::LabelButton {
+  METADATA_HEADER(ZenSidebarSitePill, views::LabelButton)
+
+ public:
+  explicit ZenSidebarSitePill(BrowserView* browser_view);
+  ZenSidebarSitePill(const ZenSidebarSitePill&) = delete;
+  ZenSidebarSitePill& operator=(const ZenSidebarSitePill&) = delete;
+  ~ZenSidebarSitePill() override;
+
+  // Refreshes the icon and host from the window's location bar model.
+  void Update();
+
+ private:
+  void OnPressed();
+
