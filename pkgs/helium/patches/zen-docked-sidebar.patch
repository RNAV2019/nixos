+constexpr base::TimeDelta kZenSidebarShowDuration = base::Milliseconds(330);
+constexpr base::TimeDelta kZenSidebarHideDuration = base::Milliseconds(230);
+
+// The show spring's damping ratio and decay rate per slide duration. It
+// overshoots once by exp(-pi * zeta / sqrt(1 - zeta^2)), about 3.8%, and has
+// settled to within 0.2% by the end of the slide.
+constexpr double kZenSidebarShowDampingRatio = 0.72;
+constexpr double kZenSidebarShowDecay = 6.2;
+// The hide spring is critically damped.
+constexpr double kZenSidebarHideRate = 7.5;
+
+// Position of an under-damped spring released at rest from 0 towards 1, after
+// `t` of the slide's duration. Goes above 1 while it overshoots.
+double ZenSidebarShowCurve(double t) {
+  constexpr double kZeta = kZenSidebarShowDampingRatio;
+  const double omega_d =
+      kZenSidebarShowDecay / kZeta * std::sqrt(1.0 - kZeta * kZeta);
+  const auto spring = [omega_d](double x) {
+    return 1.0 - std::exp(-kZenSidebarShowDecay * x) *
+                     (std::cos(omega_d * x) + kZenSidebarShowDecay / omega_d *
+                                                  std::sin(omega_d * x));
+  };
+  t = std::clamp(t, 0.0, 1.0);
+  // Fold in what is left of the motion so the slide ends exactly at 1.
+  return spring(t) + (1.0 - spring(1.0)) * t;
+}
+
+// Position of a critically damped spring released at rest from 0 towards 1,
