+ToolbarView::ZenSidebarControls ToolbarView::GetZenSidebarControls() {
+  ZenSidebarControls controls;
+  if (display_mode_ != DisplayMode::kNormal || !initialized_) {
+    return controls;
+  }
+  controls.back = back_.get();
+  controls.forward = forward_.get();
+  controls.reload = reload_.get();
+  controls.extensions = extensions_container_.get();
+  controls.pinned_actions = pinned_toolbar_actions_container_.get();
+  controls.avatar = avatar_.get();
+  controls.app_menu = app_menu_button_.get();
+  return controls;
+}
