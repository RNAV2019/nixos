+// Space between controls in a row.
+constexpr int kControlSpacing = 2;
+// Space between the controls and the site pill below them, and between the
+// pill and the tabs below it. The tab strip region adds a little more below.
+constexpr int kSitePillTopMargin = 6;
+constexpr int kSitePillBottomMargin = 8;
+constexpr int kSitePillOutlineThickness = 1;
+constexpr SkAlpha kSitePillFillAlpha = 0x12;
+constexpr SkAlpha kSitePillOutlineAlpha = 0x24;
+constexpr int kSitePillHorizontalPadding = 10;
+constexpr int kSitePillImageLabelSpacing = 6;
+// The spacer between the leading and trailing controls only takes width once
+// every control has its preferred width.
+constexpr int kSpacerFlexOrder = 2;
+
+// Holds one re-parented toolbar control. The toolbar sets its own flex and
+// margin properties on its children, which this row must not pick up, so the
+// row lays out slots instead and each slot fills itself with its control.
+class ZenSidebarToolbarSlot : public views::View {
+  METADATA_HEADER(ZenSidebarToolbarSlot, views::View)
+
+ public:
+  explicit ZenSidebarToolbarSlot(bool can_shrink) {
+    SetLayoutManager(std::make_unique<views::FillLayout>())
+        ->SetMinimumSizeEnabled(can_shrink);
+    SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(
+            can_shrink ? views::MinimumFlexSizeRule::kScaleToMinimum
+                       : views::MinimumFlexSizeRule::kPreferred,
+            views::MaximumFlexSizeRule::kPreferred));
+  }
+  ZenSidebarToolbarSlot(const ZenSidebarToolbarSlot&) = delete;
+  ZenSidebarToolbarSlot& operator=(const ZenSidebarToolbarSlot&) = delete;
+  ~ZenSidebarToolbarSlot() override = default;
+
+  void SetControl(std::unique_ptr<views::View> control) {
+    CHECK(children().empty());
+    SetVisible(AddChildView(std::move(control))->GetVisible());
+  }
+
+  // views::View:
+  void ChildVisibilityChanged(views::View* child) override {
+    // Controls such as the profile button are hidden by their own prefs.
+    SetVisible(child->GetVisible());
+  }
+  void ChildPreferredSizeChanged(views::View* child) override {
+    PreferredSizeChanged();
+  }
+};
+
+BEGIN_METADATA(ZenSidebarToolbarSlot)
+END_METADATA
+
