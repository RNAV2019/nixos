+
+void ContentsContainerView::SetRoundedClip(bool enabled) {
+  if (rounded_clip_ == enabled) {
+    return;
+  }
+  rounded_clip_ = enabled;
+  UpdateRoundedClip();
+}
+
+void ContentsContainerView::UpdateRoundedClip() {
+  if (!rounded_clip_) {
+    // Nothing else puts this view on a layer.
+    if (layer()) {
+      DestroyLayer();
+    }
+    return;
+  }
+
+  if (!layer()) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetName("ContentsContainerView:RoundedClip");
+  }
+  // Layers aren't mirrored, so mirror the radii like NativeViewHostAura does.
+  gfx::RoundedCornersF radii = rounded_clip_radii_;
+  if (base::i18n::IsRTL()) {
+    radii = gfx::RoundedCornersF(radii.upper_right(), radii.upper_left(),
+                                 radii.lower_left(), radii.lower_right());
+  }
+  layer()->SetMasksToBounds(true);
+  layer()->SetRoundedCornerRadius(radii);
+  layer()->SetIsFastRoundedCorner(true);
 }
 
