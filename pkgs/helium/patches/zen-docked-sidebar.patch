+////////////////////////////////////////////////////////////////////////////////
+// ZenSidebarBookmarkStar:
+
+ZenSidebarBookmarkStar::ZenSidebarBookmarkStar(BrowserView* browser_view)
+    : ToolbarButton(base::BindRepeating(&ZenSidebarBookmarkStar::OnPressed,
+                                        base::Unretained(this))),
+      browser_view_(browser_view) {
+  UpdateStarred(false);
+}
+
+ZenSidebarBookmarkStar::~ZenSidebarBookmarkStar() = default;
+
+void ZenSidebarBookmarkStar::SetWebContents(content::WebContents* contents) {
+  bookmark_tab_helper_observation_.Reset();
+  Observe(contents);
+  BookmarkTabHelper* const helper =
+      contents ? BookmarkTabHelper::FromWebContents(contents) : nullptr;
+  if (helper) {
+    bookmark_tab_helper_observation_.Observe(helper);
+  }
+  UpdateStarred(helper && helper->is_starred());
+}
+
+void ZenSidebarBookmarkStar::URLStarredChanged(
+    content::WebContents* web_contents,
+    bool starred) {
+  UpdateStarred(starred);
+}
+
+void ZenSidebarBookmarkStar::WebContentsDestroyed() {
+  // The tab helper is user data of the contents being destroyed.
+  bookmark_tab_helper_observation_.Reset();
+  Observe(nullptr);
+  UpdateStarred(false);
+}
+
+void ZenSidebarBookmarkStar::OnPressed() {
+  // A toggle, unlike Ctrl+D: add a bookmark without showing the bubble, or
+  // remove the page's bookmarks if it has any.
+  content::WebContents* const contents = browser_view_->GetActiveWebContents();
+  if (!contents) {
+    return;
+  }
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(
+          browser_view_->browser()->GetProfile());
+  if (!model || !model->loaded()) {
+    return;
+  }
+  GURL url;
+  std::u16string title;
+  if (!chrome::GetURLAndTitleToBookmark(contents, &url, &title)) {
+    return;
+  }
+  if (bookmarks::IsBookmarkedByUser(model, url)) {
+    bookmarks::RemoveAllBookmarks(model, url, FROM_HERE);
+    return;
+  }
+  if (!model->IsBookmarked(url) &&
+      contents->GetBrowserContext()->IsOffTheRecord()) {
+    // Incognito may not have saved the favicon, which the bookmark needs.
+    favicon::SaveFaviconEvenIfInIncognito(contents);
+  }
+  bookmarks::AddIfNotBookmarked(model, url, title);
+}
+
+void ZenSidebarBookmarkStar::UpdateStarred(bool starred) {
+  const bool rounded_icons = features::IsRoundedIconsEnabled();
+  const gfx::VectorIcon& starred_icon =
+      rounded_icons ? omnibox::kStarFilledIcon
+                    : omnibox::kStarActiveChromeRefreshOldIcon;
+  const gfx::VectorIcon& unstarred_icon =
+      rounded_icons ? omnibox::kStarIcon : omnibox::kStarChromeRefreshOldIcon;
+  SetVectorIcon(starred ? starred_icon : unstarred_icon);
+
+  const std::u16string name = l10n_util::GetStringUTF16(
+      starred ? IDS_TOOLTIP_STARRED : IDS_TOOLTIP_STAR);
+  SetTooltipText(name);
+  GetViewAccessibility().SetName(name);
+}
+
+BEGIN_METADATA(ZenSidebarBookmarkStar)
+END_METADATA
+
+////////////////////////////////////////////////////////////////////////////////
+// ZenSidebarToolbarRow:
+
+ZenSidebarToolbarRow::ZenSidebarToolbarRow(
+    Kind kind,
+    BrowserView* browser_view,
+    tabs::VerticalTabStripStateController* state_controller) {
+  SetOrientation(views::LayoutOrientation::kVertical);
+  SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+  // Shown by ZenSidebarToolbarController while it hosts toolbar controls.
+  SetVisible(false);
+  // The controls come from the toolbar; don't expose them as part of the
+  // tab list that contains this row.
+  GetViewAccessibility().SetRole(ax::mojom::Role::kToolbar);
+
+  auto controls = std::make_unique<views::FlexLayoutView>();
+  controls->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  controls->SetCollapseMargins(true);
+  controls_ = AddChildView(std::move(controls));
+
+  spacer_ = controls_->AddChildView(std::make_unique<views::View>());
+  spacer_->SetProperty(views::kMarginsKey, gfx::Insets());
+  spacer_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                               views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded)
+          .WithOrder(kSpacerFlexOrder));
+
+  if (kind == Kind::kTop) {
+    site_pill_ =
+        AddChildView(std::make_unique<ZenSidebarSitePill>(browser_view));
+    site_pill_->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(kSitePillTopMargin, 0, kSitePillBottomMargin, 0));
+  } else {
+    bookmark_star_ = controls_->AddChildViewAt(
+        std::make_unique<ZenSidebarBookmarkStar>(browser_view), 0);
+  }
+
+  if (state_controller) {
+    OnCollapseStateChanged(state_controller->GetCollapseState());
+    collapse_state_subscription_ =
+        state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+            &ZenSidebarToolbarRow::OnCollapseStateChanged,
+            base::Unretained(this)));
+  }
+}
+
+ZenSidebarToolbarRow::~ZenSidebarToolbarRow() = default;
+
+void ZenSidebarToolbarRow::AddControl(std::unique_ptr<views::View> control,
+                                      Edge edge,
+                                      bool can_shrink) {
+  auto slot = std::make_unique<ZenSidebarToolbarSlot>(can_shrink);
+  slot->SetControl(std::move(control));
+  const size_t index = edge == Edge::kLeading
+                           ? controls_->GetIndexOf(spacer_).value()
+                           : controls_->children().size();
+  controls_->AddChildViewAt(std::move(slot), index);
+}
+
+std::unique_ptr<views::View> ZenSidebarToolbarRow::RemoveControl(
+    views::View* control) {
+  auto* const slot =
+      views::AsViewClass<ZenSidebarToolbarSlot>(control->parent());
+  CHECK(slot);
+  CHECK(slot->parent() == controls_.get());
+  std::unique_ptr<views::View> owned_control = slot->RemoveChildViewT(control);
+  controls_->RemoveChildViewT(slot).reset();
+  return owned_control;
+}
+
+void ZenSidebarToolbarRow::UpdateForActiveContents(
+    content::WebContents* contents) {
+  if (site_pill_) {
+    site_pill_->Update();
+  }
+  if (bookmark_star_) {
+    bookmark_star_->SetWebContents(contents);
+  }
+}
+
+void ZenSidebarToolbarRow::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  // Like the new tab button, stack the controls while the tab strip is (or is
+  // becoming) collapsed to its icon-only width.
+  const bool collapsed =
+      state != tabs::VerticalTabStripCollapseState::kExpanded;
+  controls_->SetOrientation(collapsed ? views::LayoutOrientation::kVertical
+                                      : views::LayoutOrientation::kHorizontal);
+  controls_->SetDefault(views::kMarginsKey,
+                        collapsed ? gfx::Insets::VH(kControlSpacing / 2, 0)
+                                  : gfx::Insets::VH(0, kControlSpacing / 2));
+  spacer_->SetVisible(!collapsed);
+  if (site_pill_) {
+    site_pill_->SetVisible(!collapsed);
+  }
+}
+
+BEGIN_METADATA(ZenSidebarToolbarRow)
+END_METADATA
+
+////////////////////////////////////////////////////////////////////////////////
+// ZenSidebarToolbarController:
+
+ZenSidebarToolbarController::ZenSidebarToolbarController(
+    ToolbarView* toolbar,
+    ZenSidebarToolbarRow* top_row,
+    ZenSidebarToolbarRow* bottom_row)
+    : toolbar_(toolbar), top_row_(top_row), bottom_row_(bottom_row) {
+  CHECK(toolbar_);
+  CHECK(top_row_);
+  CHECK(bottom_row_);
+}
+
+ZenSidebarToolbarController::~ZenSidebarToolbarController() {
+  SetRelocated(false);
+}
+
+void ZenSidebarToolbarController::SetRelocated(bool relocated) {
+  if (relocated_ == relocated) {
+    return;
+  }
+  relocated_ = relocated;
+
+  if (relocated_) {
+    // Let pending icon animations finish before the containers change parent.
+    toolbar_->AbortToolbarContainerAnimationsForZenReveal();
+
+    using Edge = ZenSidebarToolbarRow::Edge;
+    const ToolbarView::ZenSidebarControls controls =
+        toolbar_->GetZenSidebarControls();
+    Move(controls.back, top_row_, Edge::kLeading, /*can_shrink=*/false);
+    Move(controls.forward, top_row_, Edge::kLeading, /*can_shrink=*/false);
+    Move(controls.reload, top_row_, Edge::kLeading, /*can_shrink=*/false);
+    Move(controls.extensions, top_row_, Edge::kTrailing, /*can_shrink=*/true);
+    Move(controls.pinned_actions, top_row_, Edge::kTrailing,
+         /*can_shrink=*/false);
+    Move(controls.avatar, bottom_row_, Edge::kTrailing, /*can_shrink=*/false);
+    Move(controls.app_menu, bottom_row_, Edge::kTrailing,
+         /*can_shrink=*/false);
+  } else {
+    for (auto it = moved_controls_.rbegin(); it != moved_controls_.rend();
+         ++it) {
+      std::unique_ptr<views::View> control =
+          it->row->RemoveControl(it->control);
+      // ToolbarView may have reordered its other children meanwhile.
+      toolbar_->AddChildViewAt(
+          std::move(control),
+          std::min(it->toolbar_index, toolbar_->children().size()));
+    }
+    moved_controls_.clear();
+  }
+
+  top_row_->SetVisible(relocated_);
+  bottom_row_->SetVisible(relocated_);
+  toolbar_->InvalidateLayout();
+}
+
+void ZenSidebarToolbarController::Move(views::View* control,
+                                       ZenSidebarToolbarRow* row,
+                                       ZenSidebarToolbarRow::Edge edge,
+                                       bool can_shrink) {
+  if (!control || control->parent() != toolbar_.get()) {
+    return;
+  }
+
+  // The toolbar's flex layout hides controls that overflow a narrow toolbar.
+  // Carry over whether the toolbar wants the control shown, not whether it
+  // happens to fit right now.
+  const auto* const toolbar_layout =
+      static_cast<const views::LayoutManagerBase*>(
+          toolbar_->GetLayoutManager());
+  const bool visible = toolbar_layout ? toolbar_layout->CanBeVisible(control)
+                                      : control->GetVisible();
+
+  const size_t toolbar_index = toolbar_->GetIndexOf(control).value();
+  std::unique_ptr<views::View> owned_control =
+      toolbar_->RemoveChildViewT(control);
+  owned_control->SetVisible(visible);
+  row->AddControl(std::move(owned_control), edge, can_shrink);
+  moved_controls_.push_back({control, row, toolbar_index});
+}
