+int VerticalTabStripRegionView::GetZenWindowEdgeGap() const {
+  // The docked zen sidebar is flush with the window edge, while the page next
+  // to it keeps the rounded frame's gap on its own side. Leave the same gap
+  // along the window edge, so every row (controls, site pill, pinned grid,
+  // tabs, new tab button) sits as far from the window edge as from the page.
+  // A detached (floating) sidebar is inset on both sides already, and the
+  // collapsed strip has no width to spare.
+  const BrowserView* const browser = browser_view();
+  if (!browser || !browser->IsZenModeEnabledForLayout() ||
+      !browser->IsZenModeSideChromePinned() ||
+      floating_style_ == FloatingStyle::kDetached ||
+      state_controller_->GetCollapseState() !=
+          tabs::VerticalTabStripCollapseState::kExpanded) {
+    return 0;
+  }
+  return MultiContentsView::kSplitViewContentInset;
+}
