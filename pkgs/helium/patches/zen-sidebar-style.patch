+void VerticalTabStyleViews::PaintSidebarTabBackground(
+    gfx::Canvas* canvas) const {
+  // Helium: Zen-style sidebar rows. The active tab is a raised surface in the
+  // theme's active tab color with a soft shadow; other tabs only show a wash of
+  // that color while hovered, and pinned tiles keep a faint wash at rest like
+  // Zen's essentials. Every fill comes from the active tab color, so it
+  // follows light, dark and custom themes.
+  const views::View* const view = delegate_->GetView();
+  const ui::ColorProvider* const color_provider = view->GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  const bool frame_active =
+      view->GetWidget() ? view->GetWidget()->ShouldPaintAsActive() : true;
+  const TabStyle::TabSelectionState selection_state = GetSelectionState();
+  const float hover =
+      std::clamp(static_cast<float>(delegate_->GetHoverAnimationValue()), 0.0f,
+                 1.0f);
+
+  SkColor fill = SK_ColorTRANSPARENT;
+  bool raised = false;
+  switch (selection_state) {
+    case TabStyle::TabSelectionState::kActive:
+      fill = tab_style()->GetTabBackgroundColor(
+          selection_state, /*hovered=*/false, frame_active, color_provider);
+      raised = true;
+      break;
+    case TabStyle::TabSelectionState::kSelected:
+      fill = tab_style()->GetTabBackgroundColor(
+          selection_state, /*hovered=*/hover > 0.0f, frame_active,
+          color_provider);
+      break;
+    case TabStyle::TabSelectionState::kInactive: {
+      const SkColor surface = tab_style()->GetTabBackgroundColor(
+          TabStyle::TabSelectionState::kActive, /*hovered=*/false,
+          frame_active, color_provider);
+      const bool pinned = delegate_->IsPinned();
+      const float alpha =
+          std::lerp(pinned ? kPinnedRestAlpha : 0.0f,
+                    pinned ? kPinnedHoverAlpha : kHoverAlpha, hover);
+      fill = SkColorSetA(surface, base::ClampRound<SkAlpha>(
+                                      SkColorGetA(surface) * alpha));
+      break;
+    }
+  }
+  if (SkColorGetA(fill) == SK_AlphaTRANSPARENT) {
+    return;
+  }
+
+  // Keep room below every row for the active tab's shadow, so all rows are the
+  // same height whether or not they are raised.
+  gfx::RectF bounds(view->GetLocalBounds());
+  bounds.Inset(gfx::InsetsF::TLBR(0, 0, kShadowSpace, 0));
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(fill);
+  if (raised) {
+    // A dark fill needs a denser shadow to read against a dark frame.
+    const SkAlpha shadow_alpha = color_utils::IsDark(fill) ? 0x59 : 0x26;
+    flags.setLooper(gfx::CreateShadowDrawLooper(
+        {gfx::ShadowValue(gfx::Vector2d(0, 1), /*blur=*/2,
+                          SkColorSetA(SK_ColorBLACK, shadow_alpha))}));
   }
+  canvas->DrawRoundRect(bounds, GetCornerRadius(), flags);
 }
 
