+void TabStripView::Layout(PassKey) {
+  LayoutSuperclass<views::View>(this);
+  // The pinned/unpinned separator is painted in the gap between the two
+  // scroll views, which may have moved.
+  const std::optional<gfx::Rect> separator_bounds = GetPinnedSeparatorBounds();
+  if (separator_bounds != pinned_separator_bounds_) {
+    pinned_separator_bounds_ = separator_bounds;
+    SchedulePaint();
+  }
+}
+
+void TabStripView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  // Helium: like Zen, a hairline separates the pinned tabs from the others in
+  // the vertical tab strip. TabStripViewLayout leaves a gap for it.
+  const std::optional<gfx::Rect> separator_bounds = GetPinnedSeparatorBounds();
+  if (!separator_bounds) {
+    return;
+  }
+  const bool frame_active =
+      GetWidget() ? GetWidget()->ShouldPaintAsActive() : true;
+  canvas->FillRect(*separator_bounds,
+                   GetColorProvider()->GetColor(
+                       frame_active ? kColorTabDividerFrameActive
+                                    : kColorTabDividerFrameInactive));
+}
+
+std::optional<gfx::Rect> TabStripView::GetPinnedSeparatorBounds() const {
+  if (!IsVerticalOrientation(collection_node_) ||
+      !pinned_tabs_scroll_view_->GetVisible() ||
+      !unpinned_tabs_scroll_view_->GetVisible() ||
+      pinned_tabs_scroll_view_->height() <= 0 ||
+      unpinned_tabs_scroll_view_->height() <= 0) {
+    return std::nullopt;
+  }
+  constexpr int kThickness = TabStripViewLayout::kPinnedSeparatorThickness;
+  const int gap_top = pinned_tabs_scroll_view_->bounds().bottom();
+  const int gap_bottom = unpinned_tabs_scroll_view_->y();
+  if (gap_bottom - gap_top < kThickness) {
+    return std::nullopt;
+  }
+  const int inset =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  return gfx::Rect(inset, gap_top + (gap_bottom - gap_top - kThickness) / 2,
+                   std::max(0, width() - 2 * inset), kThickness);
+}
