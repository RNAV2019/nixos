+
+void MultiContentsView::MaybeStartSplitAnimation(
+    const views::ProposedLayout& layout) {
+  if (!std::exchange(split_animation_pending_, false)) {
+    return;
+  }
+  // Not during browser animations (`target_content_bounds_`, which clip the
+  // contents themselves), and not with reduced motion.
+  const base::TimeDelta duration =
+      gfx::Animation::RichAnimationDuration(kSplitAnimationDuration);
+  if (!IsInSplitView() || !GetWidget() || target_content_bounds_ ||
+      !duration.is_positive()) {
+    return;
+  }
+
+  // Each pane is laid out (and its page resized) at its new bounds straight
+  // away, then its layer is translated back to where it was drawn and clipped
+  // to its old size, and both glide to the new place. Interpolating the bounds
+  // instead would resize the renderers on every frame; scaling the layers
+  // would stretch the pages when the orientation changes.
+  struct Move {
+    raw_ptr<views::View> view;
+    // In layer space, i.e. mirrored in RTL.
+    gfx::Rect from;
+    gfx::Rect to;
+    // Whether to also animate the clip from the old size to the new one.
+    bool clip = false;
+  };
+  std::vector<Move> moves;
+  const auto add_move = [&](views::View* view, bool clip) {
+    const views::ChildLayout* const child = layout.GetLayoutFor(view);
+    if (!child || !child->visible || !view->GetVisible()) {
+      return;
+    }
+    const gfx::Rect to = GetMirroredRect(child->bounds);
+    gfx::Rect from = view->GetMirroredBounds();
+    if (ui::Layer* const layer = view->layer()) {
+      // Mid-animation: start from where the view is drawn now. The transform
+      // animates on the compositor thread, so its value here is only current
+      // once the animation is aborted.
+      ui::LayerAnimator* const animator = layer->GetAnimator();
+      if (std::ranges::any_of(
+              split_animation_layer_owners_,
+              [view](const views::View* owner) { return owner == view; })) {
+        // Only the split animation runs on these temporary layers.
+        animator->AbortAllAnimations();
+      } else if (animator->IsAnimatingProperty(
+                     ui::LayerAnimationElement::TRANSFORM)) {
+        // Leaves the handle's fade alone.
+        animator->StopAnimatingProperty(ui::LayerAnimationElement::TRANSFORM);
+      }
+      from.Offset(
+          gfx::ToRoundedVector2d(layer->transform().To2dTranslation()));
+      if (clip && !layer->clip_rect().IsEmpty()) {
+        from.set_size(layer->clip_rect().size());
+      }
+    }
+    if (from != to) {
+      moves.push_back({view, from, to, clip});
+    }
+  };
+  for (ContentsContainerView* const container : contents_container_views_) {
+    add_move(container, /*clip=*/true);
+  }
+  for (MultiContentsSplitHandle* const handle : split_handles_) {
+    // The handles have their own (fading) layer.
+    if (handle->layer()) {
+      add_move(handle, /*clip=*/false);
+    }
+  }
+  if (moves.empty()) {
+    return;
+  }
+
+  const int animation_id = ++split_animation_id_;
+  views::AnimationBuilder builder;
+  builder
+      .SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET)
+      .OnEnded(base::BindOnce(&MultiContentsView::OnSplitAnimationDone,
+                              weak_ptr_factory_.GetWeakPtr(), animation_id))
+      .OnAborted(base::BindOnce(&MultiContentsView::OnSplitAnimationDone,
+                                weak_ptr_factory_.GetWeakPtr(),
+                                animation_id));
+  // Jump back to the old places...
+  views::AnimationSequenceBlock& jump = builder.Once();
+  for (const Move& move : moves) {
+    if (!move.view->layer()) {
+      // The pane containers paint nothing themselves; the layer only lives
+      // for the animation, so that the page (whose layer views manage) and
+      // the pane's overlays move and clip together.
+      move.view->SetPaintToLayer();
+      move.view->layer()->SetFillsBoundsOpaquely(false);
+      split_animation_layer_owners_.push_back(move.view);
+    }
+    const gfx::Vector2d offset = move.from.origin() - move.to.origin();
+    jump.SetTransform(move.view->layer(),
+                      gfx::Transform::MakeTranslation(offset.x(), offset.y()));
+    if (move.clip) {
+      jump.SetClipRect(move.view->layer(), gfx::Rect(move.from.size()));
+    }
+  }
+  // ...then glide to the new ones.
+  views::AnimationSequenceBlock& glide = jump.Then().SetDuration(duration);
+  for (const Move& move : moves) {
+    glide.SetTransform(move.view->layer(), gfx::Transform(),
+                       kSplitAnimationTween);
+    if (move.clip) {
+      glide.SetClipRect(move.view->layer(), gfx::Rect(move.to.size()),
+                        kSplitAnimationTween);
+    }
+  }
+}
+
+void MultiContentsView::OnSplitAnimationDone(int animation_id) {
+  // Don't drop layers from within the animator's callbacks.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&MultiContentsView::DestroySplitAnimationLayers,
+                     weak_ptr_factory_.GetWeakPtr(), animation_id));
+}
+
+void MultiContentsView::DestroySplitAnimationLayers(int animation_id) {
+  // A newer animation took over the layers.
+  if (animation_id != split_animation_id_) {
+    return;
+  }
+  for (views::View* const view : split_animation_layer_owners_) {
+    if (view->layer()) {
+      // Drops the transform and clip with it.
+      view->DestroyLayer();
+    }
+  }
+  split_animation_layer_owners_.clear();
+}
