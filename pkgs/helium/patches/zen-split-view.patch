+
+  dim_ = AddChildView(std::make_unique<views::View>());
+  dim_->SetPaintToLayer(ui::LAYER_SOLID_COLOR);
+  dim_->layer()->SetOpacity(kPreviewDimOpacity);
+  dim_->SetBackground(views::CreateLayerBasedRoundedBackground(
+      ui::kColorSysStateScrim, dim_radii_));
+
+  panel_ = AddChildView(std::make_unique<views::View>());
+  panel_->SetPaintToLayer(ui::LAYER_SOLID_COLOR);
+  panel_->layer()->SetOpacity(kPreviewPanelOpacity);
+  panel_->SetBackground(views::CreateLayerBasedRoundedBackground(
+      ui::kColorSysPrimary, panel_radii));
+  panel_->SetVisible(false);
+
+  panel_outline_ =
+      AddChildView(std::make_unique<ContentsContainerOutline>(nullptr));
+  panel_outline_->UpdateState(/*is_highlighted=*/false, ui::kColorSysPrimary);
+  panel_outline_->SetCornerRadii(panel_radii);
+  panel_outline_->SetVisible(false);
+
+  panel_chip_ = AddChildView(std::make_unique<Chip>(/*emphasized=*/true));
+  panel_chip_->SetVisible(false);
+  other_chip_ = AddChildView(std::make_unique<Chip>(/*emphasized=*/false));
+  other_chip_->SetVisible(false);
+}
