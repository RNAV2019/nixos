+
+// static
+void SplitTabPickerView::Show(
+    BrowserView* browser_view,
+    content::WebContents* dragged_contents,
+    content::WebContents* temp_contents,
+    bool dragged_first,
+    const split_tabs::SplitTabVisualData& visual_data) {
+  MultiContentsView* const host = browser_view->multi_contents_view();
+  SplitTabPickerView* const picker =
+      host->AddChildView(std::make_unique<SplitTabPickerView>(
+          browser_view, dragged_contents, temp_contents, dragged_first,
+          visual_data));
+  // The panes' bounds follow the split's layout and animation.
+  picker->pane_observations_.AddObservation(host);
+  for (auto& container : host->contents_container_views()) {
+    picker->pane_observations_.AddObservation(container.get());
+  }
+  picker->SyncBounds();
+}
+
+SplitTabPickerView::SplitTabPickerView(
+    BrowserView* browser_view,
+    content::WebContents* dragged_contents,
+    content::WebContents* temp_contents,
+    bool dragged_first,
+    const split_tabs::SplitTabVisualData& visual_data)
+    : browser_view_(browser_view),
+      model_(browser_view->browser()->tab_strip_model()),
+      dragged_contents_(dragged_contents->GetWeakPtr()),
+      temp_contents_(temp_contents->GetWeakPtr()),
+      dragged_first_(dragged_first),
+      visual_data_(visual_data) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetBackground(views::CreateRoundedRectBackground(ui::kColorSysSurface,
+                                                   GetGenericFrameRadius()));
+  SetFocusBehavior(FocusBehavior::ALWAYS);
+  // Placed by SyncBounds(), not by the MultiContentsView's layout.
+  SetProperty(views::kViewIgnoredByLayoutKey, true);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kListBox);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_SPLIT_VIEW_PICKER_ACCESSIBLE_NAME));
+
+  tabs::TabInterface* const dragged = GetTabIn(model_, dragged_contents);
+
+  column_ = AddChildView(std::make_unique<views::View>());
+  heading_ = column_->AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringFUTF16(
+          IDS_SPLIT_VIEW_PICKER_HEADING,
+          dragged ? TabUIHelper::From(dragged)->GetTitle()
+                  : std::u16string())));
+  heading_->SetFontList(heading_->font_list()
+                            .DeriveWithSizeDelta(2)
+                            .DeriveWithWeight(gfx::Font::Weight::SEMIBOLD));
+  heading_->SetElideBehavior(gfx::ELIDE_TAIL);
+  heading_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  heading_->SetEnabledColor(ui::kColorSysOnSurface);
+
+  // Painted into the picker's own layer: a scrolled layer of its own was not
+  // drawn over the pane.
+  scroll_view_ = column_->AddChildView(std::make_unique<views::ScrollView>(
+      views::ScrollView::ScrollWithLayers::kDisabled));
+  scroll_view_->SetBackgroundColor(std::nullopt);
+  scroll_view_->SetDrawOverflowIndicator(false);
+  rows_view_ = scroll_view_->SetContents(std::make_unique<views::View>());
+  rows_view_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kRowSpacing));
+
+  const auto add_row = [this](ui::ImageModel icon, const std::u16string& title,
+                              content::WebContents* contents) {
+    const int index = static_cast<int>(rows_.size());
+    base::WeakPtr<content::WebContents> weak_contents =
+        contents ? contents->GetWeakPtr()
+                 : base::WeakPtr<content::WebContents>();
+    rows_.push_back(rows_view_->AddChildView(std::make_unique<Row>(
+        std::move(icon), title, std::move(weak_contents),
+        base::BindRepeating(&SplitTabPickerView::SetSelectedIndex,
+                            base::Unretained(this), index),
+        base::BindRepeating(&SplitTabPickerView::ActivateRow,
+                            base::Unretained(this), index))));
+  };
+  // The window's other tabs, in tab strip order. Tabs in a split already can't
+  // join another one.
+  for (int i = 0; i < model_->count(); ++i) {
+    tabs::TabInterface* const tab = model_->GetTabAtIndex(i);
+    content::WebContents* const contents = tab->GetContents();
+    if (contents == dragged_contents || contents == temp_contents ||
+        tab->IsSplit()) {
+      continue;
+    }
+    TabUIHelper* const helper = TabUIHelper::From(tab);
+    add_row(GetSplitTabFavicon(tab, browser_view_->GetColorProvider()),
+            helper ? helper->GetTitle() : tab->GetTitle(), contents);
+  }
+  add_row(ui::ImageModel::FromVectorIcon(kAddIcon,
+                                         ui::kColorSysOnSurface, kRowIconSize),
+          l10n_util::GetStringUTF16(IDS_SPLIT_VIEW_NEW_TAB_LABEL), nullptr);
+  SetSelectedIndex(0);
+
+  model_->AddObserver(this);
+  arm_timer_.Start(FROM_HERE, kArmDelay,
+                   base::BindOnce(
+                       [](base::WeakPtr<SplitTabPickerView> picker) {
+                         if (picker && !picker->finished_) {
+                           picker->armed_ = true;
+                           if (!picker->HasFocus()) {
+                             picker->RequestFocus();
+                           }
+                         }
+                       },
+                       weak_ptr_factory_.GetWeakPtr()));
+}
+
+SplitTabPickerView::~SplitTabPickerView() {
+  TabStripModelObserver::StopObservingAll(this);
+}
+
+void SplitTabPickerView::Layout(PassKey) {
+  const gfx::Rect bounds = GetLocalBounds();
+  const int width =
+      std::clamp(bounds.width() - 2 * kColumnMargin, 0, kColumnMaxWidth);
+  const int heading_height = heading_->GetHeightForWidth(width);
+  const int rows_height = rows_view_->GetHeightForWidth(width);
+  const int max_list_height = std::max(
+      0, bounds.height() - 2 * kColumnMargin - heading_height - kHeadingGap);
+  const int list_height = std::min(rows_height, max_list_height);
+  const int column_height = heading_height + kHeadingGap + list_height;
+  column_->SetBounds((bounds.width() - width) / 2,
+                     std::max(0, (bounds.height() - column_height) / 2), width,
+                     column_height);
+  heading_->SetBounds(0, 0, width, heading_height);
+  scroll_view_->SetBounds(0, heading_height + kHeadingGap, width, list_height);
+  // The scroll view doesn't size its contents itself; it scrolls whatever
+  // size they have.
+  rows_view_->SetSize(gfx::Size(width, rows_height));
+}
+
+bool SplitTabPickerView::OnKeyPressed(const ui::KeyEvent& event) {
+  const int count = static_cast<int>(rows_.size());
+  switch (event.key_code()) {
+    case ui::VKEY_UP:
+      SetSelectedIndex((selected_index_ + count - 1) % count);
+      return true;
+    case ui::VKEY_DOWN:
+      SetSelectedIndex((selected_index_ + 1) % count);
+      return true;
+    case ui::VKEY_HOME:
+      SetSelectedIndex(0);
+      return true;
+    case ui::VKEY_END:
+      SetSelectedIndex(count - 1);
+      return true;
+    case ui::VKEY_RETURN:
+      ActivateRow(selected_index_);
+      return true;
+    case ui::VKEY_ESCAPE:
+      Cancel();
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool SplitTabPickerView::SkipDefaultKeyEventProcessing(
+    const ui::KeyEvent& event) {
+  // Keep browser accelerators (Escape stops loading, ...) off the keys the
+  // list uses.
+  switch (event.key_code()) {
+    case ui::VKEY_UP:
+    case ui::VKEY_DOWN:
+    case ui::VKEY_HOME:
+    case ui::VKEY_END:
+    case ui::VKEY_RETURN:
+    case ui::VKEY_ESCAPE:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool SplitTabPickerView::OnMousePressed(const ui::MouseEvent& event) {
+  // Takes focus and keeps clicks beside the list off the page behind.
+  return true;
+}
+
+void SplitTabPickerView::AddedToWidget() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<SplitTabPickerView> picker) {
+                       if (picker && !picker->finished_) {
+                         picker->RequestFocus();
+                       }
+                     },
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void SplitTabPickerView::OnViewBoundsChanged(views::View* observed_view) {
+  SyncBounds();
+}
+
+void SplitTabPickerView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (finished_) {
+    return;
+  }
+  // The model can't be changed from its own notification: react afterwards.
+  const auto post = [this](void (SplitTabPickerView::*method)()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<SplitTabPickerView> picker,
+                          void (SplitTabPickerView::*method)()) {
+                         if (picker && !picker->finished_) {
+                           (picker.get()->*method)();
+                         }
+                       },
+                       weak_ptr_factory_.GetWeakPtr(), method));
+  };
+
+  tabs::TabInterface* const temp = GetTabIn(model_, temp_contents_.get());
+  if (!temp || !GetTabIn(model_, dragged_contents_.get())) {
+    // One of the two tabs was closed from elsewhere.
+    post(&SplitTabPickerView::Cancel);
+    return;
+  }
+  if (selection.active_tab_changed() && model_->GetActiveTab() != temp) {
+    // Another tab was activated: the user went elsewhere (sidebar, clicking
+    // the dropped tab's half, ...).
+    if (armed_) {
+      post(&SplitTabPickerView::Cancel);
+    } else {
+      // Still setting the split up: focus restoration may have activated the
+      // dropped tab.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](base::WeakPtr<SplitTabPickerView> picker) {
+                if (!picker || picker->finished_) {
+                  return;
+                }
+                if (tabs::TabInterface* const temp = GetTabIn(
+                        picker->model_, picker->temp_contents_.get());
+                    temp && !picker->armed_) {
+                  picker->model_->ActivateTabAt(
+                      picker->model_->GetIndexOfTab(temp));
+                }
+              },
+              weak_ptr_factory_.GetWeakPtr()));
+    }
+  }
+  SyncBounds();
+}
+
+void SplitTabPickerView::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  model_ = nullptr;
+  finished_ = true;
+}
+
+void SplitTabPickerView::SyncBounds() {
+  MultiContentsView* const host = browser_view_->multi_contents_view();
+  ContentsContainerView* const container =
+      host->GetContentsContainerViewFor(temp_contents_.get());
+  SetVisible(container != nullptr);
+  if (container) {
+    SetBoundsRect(container->bounds());
+  }
+}
+
+void SplitTabPickerView::SetSelectedIndex(int index) {
+  if (rows_.empty()) {
+    return;
+  }
+  index = std::clamp(index, 0, static_cast<int>(rows_.size()) - 1);
+  rows_[selected_index_]->SetSelected(false);
+  selected_index_ = index;
+  rows_[selected_index_]->SetSelected(true);
+  rows_[selected_index_]->ScrollViewToVisible();
+}
+
+void SplitTabPickerView::ActivateRow(int index) {
+  if (finished_ || index < 0 || index >= static_cast<int>(rows_.size())) {
+    return;
+  }
+  if (content::WebContents* const contents = rows_[index]->contents()) {
+    ChooseTab(contents);
+  } else if (index == static_cast<int>(rows_.size()) - 1) {
+    ChooseNewTab();
+  } else {
+    // The tab closed meanwhile.
+    Cancel();
+  }
+}
+
+bool SplitTabPickerView::Finish() {
+  if (finished_) {
+    return false;
+  }
+  finished_ = true;
+  arm_timer_.Stop();
+  pane_observations_.RemoveAllObservations();
+  TabStripModelObserver::StopObservingAll(this);
+  // Hand the view to the task runner: this may run in its own event handler.
+  if (views::View* const host = parent()) {
+    std::unique_ptr<views::View> self = host->RemoveChildViewT(this);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(self));
+  }
+  return true;
+}
+
+void SplitTabPickerView::Cancel() {
+  TabStripModel* const model = model_;
+  tabs::TabInterface* const dragged = GetTabIn(model, dragged_contents_.get());
+  tabs::TabInterface* const temp = GetTabIn(model, temp_contents_.get());
+  if (!Finish() || !model) {
+    return;
+  }
+  // Show the dropped tab alone, as before the drop.
+  if (dragged) {
+    model->ActivateTabAt(model->GetIndexOfTab(dragged));
+  }
+  if (temp) {
+    if (temp->IsSplit()) {
+      model->RemoveSplit(temp->GetSplit().value());
+    }
+    temp->Close();
+  }
+}
+
+void SplitTabPickerView::ChooseTab(content::WebContents* chosen_contents) {
+  TabStripModel* const model = model_;
+  tabs::TabInterface* const chosen = GetTabIn(model, chosen_contents);
+  if (!chosen || chosen->IsSplit() ||
+      !GetTabIn(model, dragged_contents_.get())) {
+    Cancel();
+    return;
+  }
+  tabs::TabInterface* const temp = GetTabIn(model, temp_contents_.get());
+  if (!Finish()) {
+    return;
+  }
+
+  // Replace the temporary tab by the chosen one: the pivot of a new split is
+  // the active tab, which must be the chosen one.
+  model->ActivateTabAt(model->GetIndexOfTab(chosen));
+  if (temp) {
+    if (temp->IsSplit()) {
+      model->RemoveSplit(temp->GetSplit().value());
+    }
+    temp->Close();
+  }
+  tabs::TabInterface* const dragged = GetTabIn(model, dragged_contents_.get());
+  if (!dragged) {
+    return;
+  }
+  model->AddToNewSplit({model->GetIndexOfTab(dragged)}, visual_data_,
+                       split_tabs::SplitTabCreatedSource::kDragAndDropTab);
+  const bool dragged_is_first =
+      model->GetIndexOfTab(dragged) < model->GetIndexOfTab(chosen);
+  if (dragged_is_first != dragged_first_ && dragged->GetSplit()) {
+    model->ReverseTabsInSplit(dragged->GetSplit().value());
+  }
+  model->ActivateTabAt(model->GetIndexOfTab(dragged));
+}
+
+void SplitTabPickerView::ChooseNewTab() {
+  TabStripModel* const model = model_;
+  tabs::TabInterface* const temp = GetTabIn(model, temp_contents_.get());
+  if (!temp) {
+    Cancel();
+    return;
+  }
+  BrowserView* const browser_view = browser_view_;
+  if (!Finish()) {
+    return;
+  }
+  // The temporary tab becomes the new tab and stays in the split.
+  content::NavigationController::LoadURLParams params{
+      GURL(chrome::kChromeUINewTabURL)};
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  temp->GetContents()->GetController().LoadURLWithParams(params);
+  model->ActivateTabAt(model->GetIndexOfTab(temp));
+  CommandBarView::OpenForNewTabButton(browser_view);
+}
+
+BEGIN_METADATA(SplitTabPickerView)
+END_METADATA
