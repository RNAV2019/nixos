+void MultiContentsDropPreviewView::SetPanelBounds(
+    const gfx::Rect& panel_bounds) {
+  if (panel_bounds_ == panel_bounds) {
+    return;
+  }
+  panel_bounds_ = panel_bounds;
+  const bool show_panel = !panel_bounds_.IsEmpty();
+  panel_->SetVisible(show_panel);
+  panel_outline_->SetVisible(show_panel);
+  panel_->SetBoundsRect(panel_bounds_);
+  panel_outline_->SetBoundsRect(panel_bounds_);
+  LayoutChips();
+}
+
+void MultiContentsDropPreviewView::SetDimCornerRadii(
+    const gfx::RoundedCornersF& radii) {
+  if (dim_radii_ == radii) {
+    return;
+  }
+  dim_radii_ = radii;
+  dim_->SetBackground(views::CreateLayerBasedRoundedBackground(
+      ui::kColorSysStateScrim, dim_radii_));
+}
