+// One tab (or the "New tab" entry) in the list.
+class SplitTabPickerView::Row : public views::View {
+  METADATA_HEADER(Row, views::View)
+
+ public:
+  Row(ui::ImageModel icon,
+      const std::u16string& title,
+      base::WeakPtr<content::WebContents> contents,
+      base::RepeatingClosure on_hovered,
+      base::RepeatingClosure on_pressed)
+      : contents_(std::move(contents)),
+        on_hovered_(std::move(on_hovered)),
+        on_pressed_(std::move(on_pressed)) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::VH(kRowPaddingVertical, kRowPaddingHorizontal),
+        kRowIconSpacing));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* icon_view = AddChildView(std::make_unique<views::ImageView>());
+    icon_view->SetImageSize(gfx::Size(kRowIconSize, kRowIconSize));
+    icon_view->SetImage(std::move(icon));
+    label_ = AddChildView(std::make_unique<views::Label>(title));
+    label_->SetElideBehavior(gfx::ELIDE_TAIL);
+    label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label_->SetEnabledColor(ui::kColorSysOnSurface);
+    layout->SetFlexForView(label_, 1);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kListBoxOption);
+    GetViewAccessibility().SetName(title);
+  }
+  Row(const Row&) = delete;
+  Row& operator=(const Row&) = delete;
+  ~Row() override = default;
+
+  // The tab this row picks; null for the "New tab" row (or a closed tab).
+  content::WebContents* contents() const { return contents_.get(); }
+
+  void SetSelected(bool selected) {
+    SetBackground(selected ? views::CreateRoundedRectBackground(
+                                 ui::kColorSysTonalContainer, kRowCornerRadius)
+                           : nullptr);
+    label_->SetEnabledColor(selected ? ui::kColorSysOnTonalContainer
+                                     : ui::kColorSysOnSurface);
+    SchedulePaint();
+  }
+
+  // views::View:
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    on_hovered_.Run();
+  }
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    return event.IsOnlyLeftMouseButton();
+  }
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (event.IsOnlyLeftMouseButton() && HitTestPoint(event.location())) {
+      on_pressed_.Run();
+    }
+  }
+
+ private:
+  base::WeakPtr<content::WebContents> contents_;
+  base::RepeatingClosure on_hovered_;
+  base::RepeatingClosure on_pressed_;
+  raw_ptr<views::Label> label_ = nullptr;
+};
