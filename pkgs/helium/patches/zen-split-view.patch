+// Zen-style grab handle shown at the top centre of each pane of a split
+// (`pane_index` 0 is the start pane, 1 the end pane). It fades in while the
+// pointer is over its pane. Dragging it moves the pane: dropping it on the
+// other pane swaps the two, dropping it outside the contents area separates
+// the split. Clicking it (or Enter/Space, or a right click) opens the split
+// menu for that pane: separate views, close this pane, reverse views.
+class MultiContentsSplitHandle : public views::View,
+                                 public views::ContextMenuController,
+                                 public ui::EventObserver,
+                                 public TabStripModelObserver {
+  METADATA_HEADER(MultiContentsSplitHandle, views::View)
+
+ public:
+  static constexpr int kWidth = 40;
+  static constexpr int kHeight = 14;
+  // Gap between the top of the pane and the handle.
+  static constexpr int kTopMargin = 5;
+
+  MultiContentsSplitHandle(MultiContentsView* multi_contents_view,
+                           TabStripModel* tab_strip_model,
+                           int pane_index);
+  MultiContentsSplitHandle(const MultiContentsSplitHandle&) = delete;
+  MultiContentsSplitHandle& operator=(const MultiContentsSplitHandle&) = delete;
+  ~MultiContentsSplitHandle() override;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
