+MultiContentsDropPreviewView::MultiContentsDropPreviewView()
+    : dim_radii_(GetGenericFrameRadius()) {
+  // A not-drawn layer so the whole preview can be faded at once; every child
+  // is on its own layer, so the preview stacks above the web contents.
