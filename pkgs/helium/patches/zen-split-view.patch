+gfx::Rect MultiContentsDropTargetView::GetOverlayPanelBounds() const {
+  gfx::Rect bounds = GetLocalBounds();
+  bounds.Inset(kOverlayPanelInset);
+  if (!side_.has_value() || bounds.IsEmpty()) {
+    return bounds;
+  }
+  // Bounds are in unmirrored coordinates, which views flips for RTL, so the
+  // START half is on the left here, like the squeezing layout's.
+  switch (side_.value()) {
+    case DropSide::START:
+      bounds.set_width(std::max(0, (bounds.width() - kOverlayPanelGap) / 2));
+      break;
+    case DropSide::END: {
+      const int width = std::max(0, (bounds.width() - kOverlayPanelGap) / 2);
+      bounds.Inset(gfx::Insets().set_left(bounds.width() - width));
+      break;
+    }
+    case DropSide::BOTTOM: {
+      const int height =
+          std::max(0, (bounds.height() - kOverlayPanelGap) / 2);
+      bounds.Inset(gfx::Insets().set_top(bounds.height() - height));
+      break;
+    }
+  }
+  return bounds;
 }
 
