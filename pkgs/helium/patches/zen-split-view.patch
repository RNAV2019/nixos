+
+tabs::TabInterface* GetTabIn(const TabStripModel* model,
+                             content::WebContents* contents) {
+  if (!model || !contents) {
+    return nullptr;
+  }
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(contents);
+  return tab && model->GetIndexOfTab(tab) != TabStripModel::kNoTab ? tab
+                                                                    : nullptr;
+}
+
+}  // namespace
+
+SplitDropPlan ResolveSplitDropPlan(const DragSessionData& drag_data,
+                                   const TabStripModel& model) {
+  SplitDropPlan plan;
+  if (!drag_data.source_tab_was_active || drag_data.source_model != &model) {
+    return plan;
+  }
+
+  // The tabs the dragged one could be shown beside. The dragged tab itself is
+  // normally detached from the window by now.
+  content::WebContents* const dragged = drag_data.source_dragged_contents();
+  int candidates = 0;
+  for (int i = 0; i < model.count(); ++i) {
+    tabs::TabInterface* const tab = model.GetTabAtIndex(i);
+    if (tab->GetContents() != dragged && !tab->IsSplit()) {
+      ++candidates;
+    }
+  }
+
+  const int behavior =
+      model.profile()->GetPrefs()->GetInteger(prefs::kHeliumSplitSelfDropBehavior);
+  plan.other = SplitDropPlan::Other::kNewTab;
+  if (candidates == 0) {
+    return plan;
+  }
+  if (behavior == static_cast<int>(SplitSelfDropBehavior::kPick)) {
+    plan.other = SplitDropPlan::Other::kPickedTab;
+  } else if (behavior == static_cast<int>(SplitSelfDropBehavior::kPrevious)) {
+    tabs::TabInterface* const previous =
+        GetTabIn(&model, drag_data.previous_active_contents.get());
+    if (previous && !previous->IsSplit()) {
+      plan.other = SplitDropPlan::Other::kPreviousTab;
+      plan.previous_contents = drag_data.previous_active_contents;
+    }
+  }
+  return plan;
+}
+
+ui::ImageModel GetSplitTabFavicon(tabs::TabInterface* tab,
+                                  const ui::ColorProvider* color_provider) {
+  TabUIHelper* const helper = tab ? TabUIHelper::From(tab) : nullptr;
+  ui::ImageModel favicon = helper ? helper->GetFavicon() : ui::ImageModel();
+  bool themify = helper && helper->ShouldThemifyFavicon();
+  if (favicon.IsEmpty()) {
+    favicon = favicon::GetDefaultFaviconModel(kColorBookmarkBarBackground);
+    themify = true;
+  }
+  if (color_provider && themify) {
+    const SkColor color = color_provider->GetColor(kColorBookmarkFavicon);
+    if (color != SK_ColorTRANSPARENT) {
+      favicon = ui::ImageModel::FromImageSkia(
+          gfx::ImageSkiaOperations::CreateColorMask(
+              favicon.Rasterize(color_provider), color));
+    }
+  }
+  return favicon;
+}
