+void MultiContentsDropPreviewView::SetPreviewOpacity(float opacity) {
+  layer()->SetOpacity(opacity);
+}
+
+void MultiContentsDropPreviewView::Layout(PassKey) {
+  dim_->SetBoundsRect(GetLocalBounds());
+  panel_->SetBoundsRect(panel_bounds_);
+  panel_outline_->SetBoundsRect(panel_bounds_);
+  LayoutChips();
+}
+
+void MultiContentsDropPreviewView::SetChips(
+    std::optional<MultiContentsDropChipData> panel_chip,
+    std::optional<MultiContentsDropChipData> other_chip) {
+  panel_chip_->SetVisible(panel_chip.has_value());
+  if (panel_chip) {
+    panel_chip_->SetData(*panel_chip);
+  }
+  other_chip_->SetVisible(other_chip.has_value());
+  if (other_chip) {
+    other_chip_->SetData(*other_chip);
+  }
+  LayoutChips();
+}
+
+void MultiContentsDropPreviewView::SetOtherBounds(
+    const gfx::Rect& other_bounds) {
+  if (other_bounds_ == other_bounds) {
+    return;
+  }
+  other_bounds_ = other_bounds;
+  LayoutChips();
+}
+
+void MultiContentsDropPreviewView::LayoutChips() {
+  // Centres `chip` horizontally near the top of `region` (clear of the
+  // pane handles), where the drag image under the pointer rarely covers it,
+  // shrinking it to leave a margin.
+  constexpr int kChipTopMargin = 44;
+  const auto place = [](Chip* chip, const gfx::Rect& region) {
+    if (!chip->GetVisible() || region.IsEmpty()) {
+      return;
+    }
+    gfx::Size size = chip->GetPreferredSize();
+    size.set_width(
+        std::min(size.width(), std::max(0, region.width() - 2 * kChipEdgeMargin)));
+    chip->SetBoundsRect(gfx::Rect(
+        gfx::Point(region.CenterPoint().x() - size.width() / 2,
+                   region.y() + kChipTopMargin),
+        size));
+  };
+  place(panel_chip_, panel_bounds_);
+  place(other_chip_, other_bounds_);
+}
