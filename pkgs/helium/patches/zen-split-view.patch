+content::WebContents* MultiContentsView::GetWebContentsForPane(
+    int pane_index) const {
+  CHECK(pane_index == 0 || pane_index == 1);
+  return contents_container_views_[pane_index]->contents_view()->web_contents();
+}
+
+MultiContentsView::PaneDropTarget MultiContentsView::GetPaneDropTarget(
+    int pane_index,
+    const gfx::Point& point) const {
+  // Dragging the handle this far beyond the contents (onto the tab strip or
+  // sidebar, or out of the window) separates the split.
+  constexpr int kSeparateDistance = 24;
+  gfx::Rect keep_area = GetLocalBounds();
+  keep_area.Outset(kSeparateDistance);
+  if (!keep_area.Contains(point)) {
+    return PaneDropTarget::kSeparate;
+  }
+  const views::View* other_pane = contents_container_views_[1 - pane_index];
+  if (other_pane->GetVisible() &&
+      other_pane->HitTestPoint(
+          views::View::ConvertPointToTarget(this, other_pane, point))) {
+    return PaneDropTarget::kOtherPane;
+  }
+  return PaneDropTarget::kNone;
+}
+
+gfx::Rect MultiContentsView::GetPaneDragPreviewBounds() const {
+  return gfx::UnionRects(contents_container_views_[0]->bounds(),
+                         contents_container_views_[1]->bounds());
+}
+
+void MultiContentsView::UpdatePaneDrag(int pane_index,
+                                       const gfx::Point& point) {
+  CHECK(pane_index == 0 || pane_index == 1);
+  if (!IsInSplitView()) {
+    return;
+  }
+  dragging_pane_ = pane_index;
+
+  const gfx::Rect preview_bounds = GetPaneDragPreviewBounds();
+  pane_drag_preview_->SetBoundsRect(preview_bounds);
+  gfx::Rect panel_bounds;
+  if (GetPaneDropTarget(pane_index, point) == PaneDropTarget::kOtherPane) {
+    // Highlight where the dragged pane would go: the other pane's place.
+    panel_bounds = contents_container_views_[1 - pane_index]->bounds();
+    panel_bounds.Offset(-preview_bounds.OffsetFromOrigin());
+  }
+  pane_drag_preview_->SetPanelBounds(panel_bounds);
+  if (!pane_drag_preview_->GetVisible()) {
+    pane_drag_preview_->SetVisible(true);
+  }
+}
+
+void MultiContentsView::EndPaneDrag(int pane_index,
+                                    const gfx::Point& point,
+                                    bool cancelled) {
+  CHECK(pane_index == 0 || pane_index == 1);
+  const PaneDropTarget target = cancelled || !IsInSplitView()
+                                    ? PaneDropTarget::kNone
+                                    : GetPaneDropTarget(pane_index, point);
+  dragging_pane_.reset();
+  pane_drag_preview_->SetVisible(false);
+  pane_drag_preview_->SetPanelBounds(gfx::Rect());
+
+  switch (target) {
+    case PaneDropTarget::kNone:
+      break;
+    case PaneDropTarget::kOtherPane: {
+      const auto animate = AnimateSplitChanges();
+      OnSwap();
+      break;
+    }
+    case PaneDropTarget::kSeparate: {
+      TabStripModel* const model = browser_view_->browser()->tab_strip_model();
+      content::WebContents* const contents = GetWebContentsForPane(pane_index);
+      tabs::TabInterface* const tab =
+          contents ? tabs::TabInterface::MaybeGetFromContents(contents)
+                   : nullptr;
+      if (!tab || !tab->IsSplit()) {
+        break;
+      }
+      model->RemoveSplit(tab->GetSplit().value());
+      const int index = model->GetIndexOfTab(tab);
+      if (index != TabStripModel::kNoTab) {
+        model->ActivateTabAt(index);
+      }
+      break;
+    }
+  }
+}
+
+base::AutoReset<bool> MultiContentsView::AnimateSplitChanges() {
+  return base::AutoReset<bool>(&animate_split_changes_, true);
+}
+
+void MultiContentsView::MaybeStartSplitAnimation(
+    const views::ProposedLayout& layout) {
+  if (!std::exchange(split_animation_pending_, false)) {
+    return;
+  }
+  // Not during browser animations (`target_content_bounds_`, which clip the
+  // contents themselves), and not with reduced motion.
+  const base::TimeDelta duration =
+      gfx::Animation::RichAnimationDuration(kSplitAnimationDuration);
+  if (!IsInSplitView() || !GetWidget() || target_content_bounds_ ||
+      !duration.is_positive()) {
+    return;
+  }
+
+  // Each pane is laid out (and its page resized) at its new bounds straight
+  // away, then its layer is translated back to where it was drawn and clipped
+  // to its old size, and both glide to the new place. Interpolating the bounds
+  // instead would resize the renderers on every frame; scaling the layers
+  // would stretch the pages when the orientation changes.
+  std::vector<SplitMove>& moves = pending_split_moves_;
+  moves.clear();
+  pending_split_duration_ = duration;
+  const auto add_move = [&](views::View* view, bool clip) {
+    const views::ChildLayout* const child = layout.GetLayoutFor(view);
+    if (!child || !child->visible || !view->GetVisible()) {
+      return;
+    }
+    const gfx::Rect to = GetMirroredRect(child->bounds);
+    gfx::Rect from = view->GetMirroredBounds();
+    if (ui::Layer* const layer = view->layer()) {
+      // Mid-animation: start from where the view is drawn now. The transform
+      // animates on the compositor thread, so its value here is only current
+      // once the animation is aborted.
+      ui::LayerAnimator* const animator = layer->GetAnimator();
+      if (std::ranges::any_of(
+              split_animation_layer_owners_,
+              [view](const views::View* owner) { return owner == view; })) {
+        // Only the split animation runs on these temporary layers.
+        animator->AbortAllAnimations();
+      } else if (animator->IsAnimatingProperty(
+                     ui::LayerAnimationElement::TRANSFORM)) {
+        // Leaves the handle's fade alone.
+        animator->StopAnimatingProperty(ui::LayerAnimationElement::TRANSFORM);
+      }
+      from.Offset(
+          gfx::ToRoundedVector2d(layer->transform().To2dTranslation()));
+      if (clip && !layer->clip_rect().IsEmpty()) {
+        from.set_size(layer->clip_rect().size());
+      }
+      // The pages are laid out with this layout, and a native view host
+      // places its page using its ancestors' transforms, so the panes must be
+      // at rest until then.
+      layer->SetTransform(gfx::Transform());
+      if (clip) {
+        layer->SetClipRect(gfx::Rect());
+      }
+    }
+    if (from != to) {
+      moves.push_back({view, from, to, clip});
+    }
+  };
+  for (ContentsContainerView* const container : contents_container_views_) {
+    add_move(container, /*clip=*/true);
+  }
+  for (MultiContentsSplitHandle* const handle : split_handles_) {
+    // The handles have their own (fading) layer.
+    if (handle->layer()) {
+      add_move(handle, /*clip=*/false);
+    }
+  }
+}
+
+void MultiContentsView::Layout(PassKey) {
+  LayoutSuperclass<views::View>(this);
+  StartPendingSplitAnimation();
+}
+
+void MultiContentsView::StartPendingSplitAnimation() {
+  if (pending_split_moves_.empty()) {
+    return;
+  }
+  const std::vector<SplitMove> moves =
+      std::exchange(pending_split_moves_, {});
+  // Place the pages while the panes are still at rest, as moving a pane's
+  // layer with a transform would otherwise move its page twice.
+  for (ContentsContainerView* const container : contents_container_views_) {
+    container->contents_view()->holder()->DeprecatedLayoutImmediately();
+  }
+
+  const int animation_id = ++split_animation_id_;
+  views::AnimationBuilder builder;
+  builder
+      .SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET)
+      .OnEnded(base::BindOnce(&MultiContentsView::OnSplitAnimationDone,
+                              weak_ptr_factory_.GetWeakPtr(), animation_id))
+      .OnAborted(base::BindOnce(&MultiContentsView::OnSplitAnimationDone,
+                                weak_ptr_factory_.GetWeakPtr(),
+                                animation_id));
+  // Jump back to the old places...
+  views::AnimationSequenceBlock& jump = builder.Once();
+  for (const SplitMove& move : moves) {
+    if (!move.view->layer()) {
+      // The pane containers paint nothing themselves; the layer only lives
+      // for the animation, so that the page (whose layer views manage) and
+      // the pane's overlays move and clip together.
+      move.view->SetPaintToLayer();
+      move.view->layer()->SetFillsBoundsOpaquely(false);
+      split_animation_layer_owners_.push_back(move.view);
+    }
+    const gfx::Vector2d offset = move.from.origin() - move.to.origin();
+    jump.SetTransform(move.view->layer(),
+                      gfx::Transform::MakeTranslation(offset.x(), offset.y()));
+    if (move.clip) {
+      jump.SetClipRect(move.view->layer(), gfx::Rect(move.from.size()));
+    }
+  }
+  // ...then glide to the new ones.
+  views::AnimationSequenceBlock& glide =
+      jump.Then().SetDuration(pending_split_duration_);
+  for (const SplitMove& move : moves) {
+    glide.SetTransform(move.view->layer(), gfx::Transform(),
+                       kSplitAnimationTween);
+    if (move.clip) {
+      glide.SetClipRect(move.view->layer(), gfx::Rect(move.to.size()),
