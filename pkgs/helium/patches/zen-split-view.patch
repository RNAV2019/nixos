+void MultiContentsSplitHandle::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  const gfx::RectF bounds(GetLocalBounds());
+  const float radius = bounds.height() / 2.0f;
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(color_provider->GetColor(kColorToolbar));
+  canvas->DrawRoundRect(bounds, radius, flags);
+
+  gfx::RectF border_bounds = bounds;
+  border_bounds.Inset(0.5f);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1);
+  flags.setColor(
+      color_provider->GetColor(kColorToolbarContentAreaSeparator));
+  canvas->DrawRoundRect(border_bounds, radius - 0.5f, flags);
+
+  // Three dots, like Zen's rearrange grip.
+  SkColor dot_color = color_provider->GetColor(kColorToolbarText);
+  if (!IsMouseHovered() && !dragging_) {
+    dot_color = SkColorSetA(dot_color, kSplitHandleIdleDotAlpha);
+  }
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(dot_color);
+  const gfx::PointF center = bounds.CenterPoint();
+  for (int i = -1; i <= 1; ++i) {
+    canvas->DrawCircle(
+        gfx::PointF(center.x() + i * kSplitHandleDotSpacing, center.y()),
+        kSplitHandleDotRadius + 0.25f, flags);
+  }
+}
+
+bool MultiContentsSplitHandle::OnMousePressed(const ui::MouseEvent& event) {
+  if (!event.IsOnlyLeftMouseButton()) {
+    return false;
+  }
+  press_location_ = event.location();
+  return true;
+}
+
+bool MultiContentsSplitHandle::OnMouseDragged(const ui::MouseEvent& event) {
+  if (!press_location_.has_value()) {
+    return false;
+  }
+  if (!dragging_) {
+    if (!views::View::ExceededDragThreshold(event.location() -
+                                            *press_location_)) {
+      return true;
+    }
+    if (!multi_contents_view_->IsInSplitView()) {
+      return true;
+    }
+    CancelMenu();
+    dragging_ = true;
+    UpdateOpacity();
+    SchedulePaint();
+  }
+  // The widget holds mouse capture while the button is down, so drags keep
+  // arriving here over the web contents and outside the window.
+  multi_contents_view_->UpdatePaneDrag(pane_index_,
+                                       ToMultiContentsPoint(event.location()));
+  return true;
+}
+
+void MultiContentsSplitHandle::OnMouseReleased(const ui::MouseEvent& event) {
+  const bool was_pressed = press_location_.has_value();
+  press_location_.reset();
+  if (dragging_) {
+    dragging_ = false;
+    UpdateOpacity();
+    SchedulePaint();
+    // May end the split (and hide `this`).
+    multi_contents_view_->EndPaneDrag(
+        pane_index_, ToMultiContentsPoint(event.location()),
+        /*cancelled=*/false);
+    return;
+  }
+  if (was_pressed && event.IsLeftMouseButton() &&
+      HitTestPoint(event.location())) {
+    ShowMenu(GetBoundsInScreen(), ui::mojom::MenuSourceType::kMouse);
+  }
+}
+
+void MultiContentsSplitHandle::OnMouseCaptureLost() {
+  press_location_.reset();
+  CancelDrag();
+}
+
+void MultiContentsSplitHandle::OnMouseEntered(const ui::MouseEvent& event) {
+  UpdateOpacity();
+  SchedulePaint();
+}
+
+void MultiContentsSplitHandle::OnMouseExited(const ui::MouseEvent& event) {
+  UpdateOpacity();
+  SchedulePaint();
+}
+
+bool MultiContentsSplitHandle::OnKeyPressed(const ui::KeyEvent& event) {
+  switch (event.key_code()) {
+    case ui::VKEY_RETURN:
+    case ui::VKEY_SPACE:
+    case ui::VKEY_APPS:
+      ShowMenu(GetBoundsInScreen(), ui::mojom::MenuSourceType::kKeyboard);
+      return true;
+    case ui::VKEY_ESCAPE:
+      if (dragging_) {
+        CancelDrag();
+        return true;
+      }
+      return false;
+    default:
+      return false;
+  }
+}
+
+ui::Cursor MultiContentsSplitHandle::GetCursor(const ui::MouseEvent& event) {
+  return ui::Cursor(dragging_ ? ui::mojom::CursorType::kGrabbing
+                              : ui::mojom::CursorType::kGrab);
+}
+
+void MultiContentsSplitHandle::OnFocus() {
+  views::View::OnFocus();
+  UpdateOpacity();
+}
+
+void MultiContentsSplitHandle::OnBlur() {
+  views::View::OnBlur();
+  UpdateOpacity();
+}
+
+void MultiContentsSplitHandle::AddedToWidget() {
+  // The pane's web contents receive the mouse events over it, so watch the
+  // browser window's events to tell when the pointer is over this pane. Key
+  // presses are watched to cancel a drag with Escape.
+  hover_monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, GetWidget()->GetNativeWindow(),
+      {ui::EventType::kMouseMoved, ui::EventType::kMouseExited,
+       ui::EventType::kKeyPressed});
+}
+
+void MultiContentsSplitHandle::RemovedFromWidget() {
+  hover_monitor_.reset();
+  CancelMenu();
+}
+
+void MultiContentsSplitHandle::VisibilityChanged(views::View* starting_from,
+                                                 bool is_visible) {
+  if (!is_visible) {
+    CancelMenu();
+    CancelDrag();
+    pointer_in_pane_ = false;
+  }
+  UpdateOpacity();
+}
+
+void MultiContentsSplitHandle::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  ShowMenu(gfx::Rect(point, gfx::Size()), source_type);
+}
+
+void MultiContentsSplitHandle::OnEvent(const ui::Event& event) {
+  if (event.type() == ui::EventType::kKeyPressed) {
+    if (dragging_ && event.AsKeyEvent()->key_code() == ui::VKEY_ESCAPE) {
+      CancelDrag();
+    }
+    return;
+  }
+  if (!event.IsLocatedEvent() || !GetVisible()) {
+    return;
+  }
+  // The observer's root location is in screen coordinates (see
+  // aura::Env::AddEventObserver()).
+  views::View* const pane =
+      multi_contents_view_->contents_container_views()[pane_index_];
+  gfx::Point point =
+      gfx::ToFlooredPoint(event.AsLocatedEvent()->root_location_f());
+  views::View::ConvertPointFromScreen(pane, &point);
+  const bool in_pane = event.type() != ui::EventType::kMouseExited &&
+                       pane->GetVisible() && pane->HitTestPoint(point);
+  if (in_pane != pointer_in_pane_) {
+    pointer_in_pane_ = in_pane;
+    UpdateOpacity();
+  }
+}
+
+void MultiContentsSplitHandle::OnTabStripModelChanged(
+    TabStripModel*,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // The menu acts on a tab strip index; don't let it outlive a change.
+  if (change.type() != TabStripModelChange::kSelectionOnly ||
+      selection.active_tab_changed()) {
+    CancelMenu();
+  }
+}
+
+void MultiContentsSplitHandle::OnSplitTabChanged(const SplitTabChange&) {
+  CancelMenu();
+}
+
+void MultiContentsSplitHandle::ShowMenu(const gfx::Rect& anchor_in_screen,
+                                        ui::mojom::MenuSourceType source_type) {
+  if (IsMenuRunning() || dragging_ || !GetWidget()) {
+    return;
+  }
+  content::WebContents* const contents =
+      multi_contents_view_->GetWebContentsForPane(pane_index_);
+  const int index = contents
+                        ? tab_strip_model_->GetIndexOfWebContents(contents)
+                        : TabStripModel::kNoTab;
+  if (index == TabStripModel::kNoTab ||
+      !tab_strip_model_->GetTabAtIndex(index)->IsSplit()) {
+    return;
+  }
+
+  menu_runner_.reset();
+  menu_model_adapter_.reset();
+  // kMiniToolbar: "Separate views", "Close" (this pane's tab), the
+  // orientation toggle and "Reverse views", acting on the tab at `index`.
+  menu_model_ = std::make_unique<SplitHandleMenuModel>(multi_contents_view_,
+                                                       tab_strip_model_, index);
+  menu_model_adapter_ = std::make_unique<views::MenuModelAdapter>(
+      menu_model_.get(),
+      base::BindRepeating(&MultiContentsSplitHandle::OnMenuClosed,
+                          base::Unretained(this)));
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_adapter_->CreateMenu(), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, anchor_in_screen,
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+  UpdateOpacity();
+}
+
+void MultiContentsSplitHandle::CancelMenu() {
+  if (IsMenuRunning()) {
+    menu_runner_->Cancel();
+  }
+}
+
+bool MultiContentsSplitHandle::IsMenuRunning() const {
+  return menu_runner_ && menu_runner_->IsRunning();
+}
+
+void MultiContentsSplitHandle::OnMenuClosed() {
+  UpdateOpacity();
+}
+
+void MultiContentsSplitHandle::CancelDrag() {
+  if (!dragging_) {
+    return;
+  }
+  dragging_ = false;
+  UpdateOpacity();
+  SchedulePaint();
+  multi_contents_view_->EndPaneDrag(pane_index_, gfx::Point(),
+                                    /*cancelled=*/true);
+}
+
+gfx::Point MultiContentsSplitHandle::ToMultiContentsPoint(
+    const gfx::Point& point_in_this) const {
+  return views::View::ConvertPointToTarget(this, multi_contents_view_,
+                                           point_in_this);
+}
+
+void MultiContentsSplitHandle::UpdateOpacity() {
+  const bool shown = GetVisible() &&
+                     (pointer_in_pane_ || IsMouseHovered() || HasFocus() ||
+                      dragging_ || IsMenuRunning());
+  const float opacity = shown ? 1.0f : 0.0f;
+  if (target_opacity_ == opacity) {
+    return;
+  }
+  target_opacity_ = opacity;
+  ui::ScopedLayerAnimationSettings settings(layer()->GetAnimator());
+  settings.SetTransitionDuration(kSplitHandleFadeDuration);
+  settings.SetTweenType(gfx::Tween::EASE_OUT);
+  settings.SetPreemptionStrategy(
+      ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+  layer()->SetOpacity(opacity);
+}
+
+BEGIN_METADATA(MultiContentsSplitHandle)
+END_METADATA
