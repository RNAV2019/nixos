+void MultiContentsViewDropTargetController::HandleTabDragUpdate(
+    const gfx::Point& point_in_view,
+    bool is_rtl) {
+  // Zen: every point of the page maps to its left or right half, and the
+  // dragged tab takes that half of a 50/50 split. Points are in physical
+  // (LTR) coordinates, sides are logical.
+  const bool in_left_half =
+      point_in_view.x() < drop_target_parent_view_->width() / 2;
+  const MultiContentsDropTargetView::DropSide drop_side =
+      in_left_half != is_rtl ? MultiContentsDropTargetView::DropSide::START
+                             : MultiContentsDropTargetView::DropSide::END;
+
+  if (drop_target_view_->GetVisible() &&
+      drop_target_view_->drag_type() !=
+          MultiContentsDropTargetView::DragType::kTab) {
+    // A link drop target still fading out; drop it at once.
+    drop_target_view_->Hide(/*suppress_animation=*/true);
+  }
+
+  if (drop_target_view_->GetVisible()) {
+    // Already showing (or fading out) for this tab drag: follow the cursor
+    // to the other half immediately, and bring a fading overlay back.
+    show_drop_target_timer_.reset();
+    if (drop_target_view_->side() != drop_side ||
+        drop_target_view_->IsClosing()) {
+      drop_target_view_->Show(
+          drop_side, MultiContentsDropTargetView::DropTargetState::kFull,
+          MultiContentsDropTargetView::DragType::kTab);
+    }
+    return;
+  }
+
+  if (show_drop_target_timer_.has_value()) {
+    show_drop_target_timer_->drop_side = drop_side;
+    show_drop_target_timer_->drag_type =
+        MultiContentsDropTargetView::DragType::kTab;
+    return;
+  }
+
+  // A short delay so that a tab merely crossing the page (e.g. on its way to
+  // another window) doesn't flash the overlay.
+  show_drop_target_timer_.emplace(drop_side,
+                                  MultiContentsDropTargetView::DragType::kTab);
+  drag_point_at_timer_start_ = point_in_view;
+  show_drop_target_timer_->timer.Start(
+      FROM_HERE, kShowDropTargetForTabOverlayDelay, this,
+      &MultiContentsViewDropTargetController::ShowTimerDelayedDropTarget);
+}
+
+void MultiContentsViewDropTargetController::UpdateTabChips(
+    TabDragTarget::DragController& controller) {
+  if (!tab_strip_model_) {
+    return;
+  }
+  const DragSessionData& drag_data = controller.GetSessionData();
+  content::WebContents* const dragged = drag_data.source_dragged_contents();
+  const SplitDropPlan plan =
+      ResolveSplitDropPlan(drag_data, *tab_strip_model_);
+  content::WebContents* other = nullptr;
+  switch (plan.other) {
+    case SplitDropPlan::Other::kActiveTab:
+      if (tabs::TabInterface* const active = tab_strip_model_->GetActiveTab()) {
+        other = active->GetContents();
+      }
+      break;
+    case SplitDropPlan::Other::kPreviousTab:
+      other = plan.previous_contents.get();
+      break;
+    case SplitDropPlan::Other::kPickedTab:
+    case SplitDropPlan::Other::kNewTab:
+      break;
+  }
+  if (chips_valid_ && chips_dragged_ == dragged && chips_other_ == other &&
+      chips_plan_ == plan.other) {
+    return;
+  }
+  chips_valid_ = true;
+  chips_dragged_ = dragged;
+  chips_other_ = other;
+  chips_plan_ = plan.other;
+
+  const ui::ColorProvider* const color_provider =
+      drop_target_view_->GetColorProvider();
+  const auto tab_chip = [&](content::WebContents* contents)
+      -> std::optional<MultiContentsDropChipData> {
+    tabs::TabInterface* const tab =
+        contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+    if (!tab) {
+      return std::nullopt;
+    }
+    TabUIHelper* const helper = TabUIHelper::From(tab);
+    return MultiContentsDropChipData{
+        GetSplitTabFavicon(tab, color_provider),
+        helper ? helper->GetTitle() : tab->GetTitle()};
+  };
+
+  std::optional<MultiContentsDropChipData> other_chip;
+  switch (plan.other) {
+    case SplitDropPlan::Other::kActiveTab:
+    case SplitDropPlan::Other::kPreviousTab:
+      other_chip = tab_chip(other);
+      break;
+    case SplitDropPlan::Other::kPickedTab:
+      other_chip = MultiContentsDropChipData{
+          ui::ImageModel(),
+          l10n_util::GetStringUTF16(IDS_SPLIT_VIEW_PICK_TAB_LABEL)};
+      break;
+    case SplitDropPlan::Other::kNewTab:
+      other_chip = MultiContentsDropChipData{
+          ui::ImageModel(),
+          l10n_util::GetStringUTF16(IDS_SPLIT_VIEW_NEW_TAB_LABEL)};
+      break;
+  }
+  drop_target_view_->SetOverlayChips(tab_chip(dragged), std::move(other_chip));
+}
