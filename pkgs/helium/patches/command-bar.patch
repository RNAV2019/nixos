+// Paints the large soft shadow (and the keyword mode glow) of the command bar
+// card. It is a sibling below the card rather than part of it: its bounds
+// extend far beyond the card, and it must never take events, so that clicks
+// on the page around the card still reach the page.
+//
+// The shadow is evaluated per pixel by a runtime shader that dithers its alpha
+// before it is quantized; see the comment above kShadowSkSL in the .cc file
+// for why a blur mask filter shadow bands.
+class CommandBarShadowView : public views::View {
+  METADATA_HEADER(CommandBarShadowView, views::View)
+
+ public:
+  CommandBarShadowView();
+  CommandBarShadowView(const CommandBarShadowView&) = delete;
+  CommandBarShadowView& operator=(const CommandBarShadowView&) = delete;
+  ~CommandBarShadowView() override;
