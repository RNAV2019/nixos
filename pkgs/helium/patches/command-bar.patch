+////////////////////////////////////////////////////////////////////////////////
+// CommandBarView
+
+// static
+bool CommandBarView::IsAvailable(BrowserView* browser_view, bool ignore_prefs) {
+  BrowserWindowInterface* const browser = browser_view->browser();
+  if (!browser_view->GetWidget() ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+
+  ToolbarView* const toolbar = browser_view->toolbar();
+  LocationBarView* const location_bar =
+      toolbar ? toolbar->location_bar_view() : nullptr;
+  if (!location_bar || !location_bar->IsInitialized()) {
+    return false;
+  }
+
+  if (!ignore_prefs) {
+    const PrefService* const prefs = browser->GetProfile()->GetPrefs();
+    const HeliumLayoutStateController* const layout_state =
+        HeliumLayoutStateController::From(browser);
+    // Uses the frameless pref rather than BrowserView's zen state so that the
+    // bar also works in browser fullscreen.
+    const bool frameless = layout_state && layout_state->IsZenModeEnabled();
+    if (!(frameless && prefs->GetBoolean(prefs::kHeliumCommandBar)) &&
+        !prefs->GetBoolean(prefs::kHeliumCommandBarAlways)) {
+      return false;
+    }
+  }
+
+  // Leave tab (content) fullscreen alone, e.g. a fullscreen video.
+  if (auto* const exclusive_access_manager =
+          ExclusiveAccessManager::From(browser);
+      exclusive_access_manager &&
+      exclusive_access_manager->fullscreen_controller()->IsTabFullscreen()) {
+    return false;
+  }
+
+#if BUILDFLAG(IS_MAC)
+  // In immersive fullscreen the toolbar lives in a separate overlay widget, so
+  // the location bar cannot be reparented within one widget.
+  if (browser_view->IsFullscreen()) {
+    return false;
+  }
+#endif
+
+  return true;
+}
+
+// static
+bool CommandBarView::HandleAccelerator(BrowserView* browser_view,
+                                       int command_id) {
+  switch (command_id) {
+    case IDC_NEW_TAB:
+      if (!chrome::IsCommandEnabled(browser_view->browser(), IDC_NEW_TAB) ||
+          !IsAvailable(browser_view)) {
+        return false;
+      }
+      browser_view->GetOrCreateCommandBar()->Show(Mode::kNewTab);
+      return true;
+
+    // Not checking whether the command is enabled: it is disabled while the
+    // toolbar is hidden in browser fullscreen, where the bar still works.
+    case IDC_FOCUS_LOCATION:
+      if (!IsAvailable(browser_view)) {
+        return false;
+      }
+      browser_view->GetOrCreateCommandBar()->Show(Mode::kEditCurrentTab);
+      return true;
+
+    case IDC_FOCUS_SEARCH:
+      // Ctrl+K: edit mode, then default search provider keyword mode.
+      if (!IsAvailable(browser_view)) {
+        return false;
+      }
+      browser_view->GetOrCreateCommandBar()->Show(Mode::kEditCurrentTab);
+      browser_view->GetLocationBar()->FocusSearch();
+      return true;
+
+    case IDC_FOCUS_NEXT_PANE: {
+      // F6 from the page goes to the omnibox; with the toolbar hidden that is
+      // the command bar. F6 in the command bar goes back to the page.
+      if (browser_view->IsCommandBarShowing()) {
+        browser_view->command_bar()->Dismiss(DismissReason::kFocusContents);
+        return true;
+      }
+      if (!IsAvailable(browser_view) ||
+          IsLocationBarShownInToolbar(browser_view)) {
+        return false;
+      }
+      views::FocusManager* const focus_manager =
+          browser_view->GetFocusManager();
+      views::View* const focused =
+          focus_manager ? focus_manager->GetFocusedView() : nullptr;
+      views::View* const contents = browser_view->GetActiveContentsWebView();
+      if (focused && (!contents || !contents->Contains(focused))) {
+        return false;
+      }
+      browser_view->GetOrCreateCommandBar()->Show(Mode::kEditCurrentTab);
+      return true;
+    }
+
+    default:
+      return false;
+  }
+}
+
+// static
+bool CommandBarView::HandleFocusLocationRequest(BrowserView* browser_view,
+                                                bool is_user_initiated) {
+  if (!IsAvailable(browser_view)) {
+    return false;
+  }
+  if (is_user_initiated || browser_view->IsCommandBarShowing()) {
+    browser_view->GetOrCreateCommandBar()->Show(Mode::kEditCurrentTab);
+    return true;
+  }
+  if (IsLocationBarShownInToolbar(browser_view)) {
+    return false;
+  }
+  // Renderer-initiated focus (e.g. a new tab page asking for the omnibox)
+  // while the toolbar is hidden: open the bar on new tab pages, and don't
+  // focus an invisible omnibox anywhere else.
+  content::WebContents* const contents = browser_view->GetActiveWebContents();
+  if (contents &&
+      search::IsNTPOrRelatedURL(
+          contents->GetVisibleURL(),
+          Profile::FromBrowserContext(contents->GetBrowserContext()))) {
+    browser_view->GetOrCreateCommandBar()->Show(Mode::kEditCurrentTab);
+  }
+  return true;
+}
+
+// static
+void CommandBarView::ExecuteCommand(BrowserView* browser_view, int command_id) {
+  if (!IsAvailable(browser_view, /*ignore_prefs=*/true)) {
+    return;
+  }
+  browser_view->GetOrCreateCommandBar()->Show(
+      command_id == IDC_OPEN_COMMAND_BAR_NEW_TAB ? Mode::kNewTab
+                                                 : Mode::kEditCurrentTab);
+}
+
+// static
+bool CommandBarView::IsLocationBarShownInToolbar(BrowserView* browser_view) {
+  ToolbarView* const toolbar = browser_view->toolbar();
+  LocationBarView* const location_bar =
+      toolbar ? toolbar->location_bar_view() : nullptr;
+  return location_bar && !toolbar->IsLocationBarDetachedForCommandBar() &&
+         location_bar->IsDrawn() && !location_bar->GetVisibleBounds().IsEmpty();
+}
+
+CommandBarView::CommandBarView(BrowserView* browser_view,
+                               CommandBarShadowView* shadow_view)
+    : browser_view_(browser_view), shadow_view_(shadow_view) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetName("CommandBarView");
+  layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(kCardCornerRadius));
+  layer()->SetIsFastRoundedCorner(true);
+  SetBackground(views::CreateRoundedRectBackground(
+      kColorOmniboxResultsBackground, kCardCornerRadius));
+  views::SetCascadingColorProviderColor(this, views::kCascadingBackgroundColor,
+                                        kColorOmniboxResultsBackground);
+  SetVisible(false);
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kDialog);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_ACCNAME_LOCATION));
+  GetViewAccessibility().SetIsModal(true);
+
+  popup_style_.corner_radius = kCardCornerRadius;
+  popup_style_.alignment_insets = gfx::Insets(kCardPadding);
+  popup_style_.non_result_section_height = kInputSectionHeight;
+  popup_style_.bottom_padding = kResultsBottomPadding;
+  popup_style_.row_height = kResultRowHeight;
+  popup_style_.row_insets = kResultRowInsets;
+  popup_style_.selection_radius = kSelectionRadius;
+
+  glow_animation_.SetSlideDuration(
+      gfx::Animation::RichAnimationDuration(kGlowDuration));
+
+  view_observations_.AddObservation(browser_view_.get());
+  if (shadow_view_) {
+    view_observations_.AddObservation(shadow_view_.get());
+  }
+}
+
+CommandBarView::~CommandBarView() {
+  // BrowserView docks the location bar before tearing down its children.
+  DCHECK(state_ == State::kHidden);
+  StopObserving();
+}
+
+void CommandBarView::Show(Mode mode) {
+  ToolbarView* const toolbar = browser_view_->toolbar();
+  LocationBarView* const location_bar = GetLocationBarView();
+  if (!toolbar || !location_bar || !GetWidget()) {
+    return;
+  }
+
+  if (state_ == State::kOpen) {
+    if (mode_ != mode) {
+      // Ctrl+T while editing, or Ctrl+L while in new-tab mode.
+      mode_ = mode;
+      ApplyMode();
+    } else if (mode_ == Mode::kEditCurrentTab) {
+      // Ctrl+L again: select everything, like the toolbar omnibox does.
+      location_bar->FocusLocation(/*is_user_initiated=*/true,
+                                  /*clear_focus_if_failed=*/false);
+    }
+    return;
+  }
+
+  const bool reopening = state_ == State::kClosing;
+  if (reopening) {
+    // Still hosting the location bar; just cancel the pending dock.
+    close_weak_factory_.InvalidateWeakPtrs();
+  } else {
+    views::FocusManager* const focus_manager = GetFocusManager();
+    views::View* const focused =
+        focus_manager ? focus_manager->GetFocusedView() : nullptr;
+    restore_focus_tracker_.SetView(
+        focused && !location_bar->Contains(focused) ? focused : nullptr);
+
+    // Close any popup of the toolbar omnibox; it reopens restyled.
+    location_bar->omnibox_view()->RevertAll();
+    // Visible (if still transparent) before it receives the location bar, so
+    // a focused omnibox is never inside a hidden parent.
+    layer()->SetOpacity(0.0f);
+    SetVisible(true);
+    toolbar->DetachLocationBarForCommandBar(this);
+    location_bar_was_visible_ = location_bar->GetVisible();
+    location_bar->SetVisible(true);
+    location_bar->SetCommandBarHost(this);
+  }
+
+  state_ = State::kOpen;
+  mode_ = mode;
+  accepting_ = false;
+  shrink_timer_.Stop();
+  popup_bounds_.reset();
+
+  SetVisible(true);
+  if (shadow_view_) {
+    shadow_view_->SetVisible(true);
+  }
+  // Synchronously, so the popup is placed against the final geometry.
+  UpdateBounds();
+  AnimateOpen(/*from_current=*/reopening);
+
+  ApplyMode();
+  StartObserving();
+}
+
+void CommandBarView::Dismiss(DismissReason reason) {
+  if (state_ != State::kOpen) {
+    return;
+  }
+  state_ = State::kClosing;
+  dismiss_reason_ = reason;
+  StopObserving();
+  shrink_timer_.Stop();
+  glow_animation_.Hide();
+
+  if (LocationBarView* const location_bar = GetLocationBarView()) {
+    OmniboxViewViews* const omnibox_view = location_bar->omnibox_view();
+    if (ui::InputMethod* const input_method = omnibox_view->GetInputMethod()) {
+      input_method->CancelComposition(omnibox_view);
+    }
+    // While accepting, OmniboxEditModel::OpenMatch() ends the edit session
+    // itself; reverting from inside it would clobber the navigation.
+    if (!accepting_) {
+      omnibox_view->RevertAll();
+    }
+  }
+
+  AnimateClose();
+}
+
+void CommandBarView::DockNow() {
+  if (state_ == State::kHidden) {
+    return;
+  }
+  close_weak_factory_.InvalidateWeakPtrs();
+  StopObserving();
+  shrink_timer_.Stop();
+  glow_animation_.Reset(0);
+  if (shadow_view_) {
+    shadow_view_->SetGlowAmount(0);
+  }
+
+  ToolbarView* const toolbar = browser_view_->toolbar();
+  LocationBarView* const location_bar = GetLocationBarView();
+
+  // Move focus out of the location bar before it returns to a toolbar that may
+  // be hidden, so neither the focused nor the stored (restored on window
+  // activation) view is an invisible omnibox.
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    views::View* target = nullptr;
+    if (dismiss_reason_ == DismissReason::kEscape) {
+      views::View* const previous = restore_focus_tracker_.view();
+      if (previous && !Contains(previous) && previous->IsFocusable()) {
+        target = previous;
+      }
+    }
+    if (!target) {
+      target = browser_view_->GetActiveContentsWebView();
+    }
+    views::View* const focused = focus_manager->GetFocusedView();
+    if (focused && Contains(focused)) {
+      if (target && target->IsFocusable()) {
+        target->RequestFocus();
+      } else {
+        focus_manager->ClearFocus();
+      }
+    }
+    views::View* const stored = focus_manager->GetStoredFocusView();
+    if (stored && Contains(stored)) {
+      focus_manager->SetStoredFocusView(target);
+    }
+  }
+  restore_focus_tracker_.SetView(nullptr);
+
+  if (location_bar) {
+    location_bar->SetCommandBarHost(nullptr);
+    location_bar->SetVisible(location_bar_was_visible_);
+  }
+  if (toolbar) {
+    toolbar->ReattachLocationBarFromCommandBar();
+  }
+
+  state_ = State::kHidden;
+  mode_ = Mode::kEditCurrentTab;
+  accepting_ = false;
+  popup_bounds_.reset();
+  SetVisible(false);
+  if (shadow_view_) {
+    shadow_view_->SetVisible(false);
+  }
+}
+
+void CommandBarView::OnActiveTabChanging() {
+  if (state_ != State::kOpen) {
+    return;
+  }
+  // Clear focus first so the old tab doesn't store the command bar's omnibox
+  // as the view to refocus when it is activated again.
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    views::View* const focused = focus_manager->GetFocusedView();
+    if (focused && Contains(focused)) {
+      focus_manager->ClearFocus();
+    }
+  }
+  Dismiss(DismissReason::kTabChanged);
+}
+
+void CommandBarView::OnWindowDeactivated() {
+  // The omnibox context menu may briefly take activation.
+  if (state_ != State::kOpen || views::MenuController::GetActiveInstance()) {
+    return;
+  }
+  Dismiss(DismissReason::kDeactivated);
+}
+
+bool CommandBarView::IsCommandBarNewTabMode() const {
+  return state_ == State::kOpen && mode_ == Mode::kNewTab;
+}
+
+bool CommandBarView::IsCommandBarAccepting() const {
+  return accepting_;
+}
+
+const OmniboxPopupStyle& CommandBarView::GetPopupStyle() const {
+  return popup_style_;
+}
+
+void CommandBarView::OnPopupBoundsChanged(
+    const std::optional<gfx::Rect>& screen_bounds) {
+  if (state_ != State::kOpen) {
+    // Keep the card's size while it fades out.
+    return;
+  }
+  if (screen_bounds) {
+    shrink_timer_.Stop();
+    popup_bounds_ = screen_bounds;
+    UpdateBounds();
+    return;
+  }
+  if (!popup_bounds_ || shrink_timer_.IsRunning()) {
+    return;
+  }
+  // Let the popup fade out over the card before shrinking it.
+  shrink_timer_.Start(
+      FROM_HERE, gfx::Animation::RichAnimationDuration(kPopupFadeDuration),
+      base::BindOnce(&CommandBarView::ShrinkToInputSection,
+                     base::Unretained(this)));
+}
+
+void CommandBarView::OnKeywordModeChanged(bool active) {
+  if (state_ != State::kOpen) {
+    return;
+  }
+  if (active) {
+    glow_animation_.Show();
+  } else {
+    glow_animation_.Hide();
+  }
+}
+
+WindowOpenDisposition CommandBarView::AdjustOpenDisposition(
+    WindowOpenDisposition disposition) {
+  if (state_ != State::kOpen) {
+    return disposition;
+  }
+
+  accepting_ = true;
+  // Background tabs (middle click) keep the bar open, like Arc. Everything
+  // else closes it once OpenMatch() has returned.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &CommandBarView::OnAcceptFinished, weak_factory_.GetWeakPtr(),
+          disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB));
+
+  // In new-tab mode, plain accepts open a new foreground tab. Alt+Enter and
+  // Shift+Enter already ask for a new tab/window, and switch-to-tab matches
+  // switch. An untouched NTP is reused rather than left behind.
+  if (mode_ == Mode::kNewTab &&
+      disposition == WindowOpenDisposition::CURRENT_TAB &&
+      !IsActiveTabUntouchedNewTabPage()) {
+    return WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+  return disposition;
+}
