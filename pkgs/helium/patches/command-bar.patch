+// Card geometry. The width follows Zen's min(innerWidth / 1.5, 750px) with
+// Arc's 750px cap, the top edge stays fixed while results grow downwards.
+constexpr int kCardMaxWidth = 750;
+constexpr int kCardMinWidth = 480;
+constexpr float kCardWidthFraction = 1.0f / 1.5f;
+constexpr int kCardWindowMargin = 24;
+// Zen places the card's top edge at a quarter of the window height (226px in
+// an 892px window).
+constexpr float kCardTopFraction = 0.25f;
+constexpr int kMinTop = 48;
+constexpr int kCardCornerRadius = 16;
+constexpr int kCardPadding = 8;
+constexpr int kLocationBarHeight = 46;
+constexpr int kInputSectionHeight = kCardPadding + kLocationBarHeight +
+                                    kCardPadding;  // Zen's 62px input row.
+
+// Results. Navigation matches are two-line rows (title, then muted URL).
+constexpr int kResultRowHeight = 44;
+constexpr int kTwoLineResultRowHeight = 56;
+constexpr gfx::Insets kResultRowInsets = gfx::Insets::TLBR(2, 8, 0, 8);
+constexpr int kSelectionRadius = 10;
+constexpr int kResultsBottomPadding = 8;
+// Keep at least this much room for results below the input row when placing
+// the card in short windows.
+constexpr int kMinResultsSpace = 3 * kTwoLineResultRowHeight;
+// Hairline divider between the input row and the results.
+constexpr int kDividerHorizontalInset = 14;
+
+// Shadow: a tight contact shadow under a soft, offset key shadow, close to
+// Zen's `0 30px 140px -15px` box-shadow but a little tighter.
+struct ShadowLayer {
+  float sigma;
+  float offset_y;
+  // Shrinks the shadow shape, like a negative CSS spread.
+  float inset;
+  SkAlpha dark_alpha;
+  SkAlpha light_alpha;
+};
+constexpr ShadowLayer kContactShadow = {/*sigma=*/2.0f, /*offset_y=*/1.0f,
+                                        /*inset=*/0.0f, /*dark_alpha=*/0x33,
+                                        /*light_alpha=*/0x14};
+constexpr ShadowLayer kKeyShadow = {/*sigma=*/28.0f, /*offset_y=*/14.0f,
+                                    /*inset=*/6.0f, /*dark_alpha=*/0x5C,
+                                    /*light_alpha=*/0x30};
+// 3 sigma of the key shadow (beyond which it is below half an alpha step),
+// less its inset, shifted by its offset.
+constexpr int kShadowExtent = 3 * 28 - 6;
+constexpr gfx::Insets kShadowInsets =
+    gfx::Insets::TLBR(kShadowExtent - 14,
+                      kShadowExtent,
+                      kShadowExtent + 14,
+                      kShadowExtent);
+
+// Keyword (search) mode glow, in the keyword's site color. Deliberately faint.
+constexpr float kGlowSigma = 10.0f;
+constexpr SkAlpha kGlowAlpha = 0x22;
+
+// Why the shadow is a runtime shader rather than a blur mask filter:
+//
+// A blurred shadow is a wide, low-contrast ramp. Skia renders a blur mask
+// filter shadow into an 8-bit (A8) coverage mask; Ganesh's rrect blur either
+// uses a precomputed A8 nine-patch, or, when the card is too short for one
+// (ComputeBlurredRRectParams() wants it taller than 2 * (3 sigma + radius),
+// 188 px for sigma 18 at 1.33x, while the input row is 83 px), draws the rrect
+// into an A8 target that GaussianBlur() downscales by sigma / 4 (6x here),
+// blurs and stretches back with bilinear filtering. That coverage is then
+// multiplied by the shadow's peak alpha (0x4D) and written into the shadow
+// layer's RGBA8 tile, so the whole ramp has at most 77 distinct alpha values,
+// and the compositor
+// blends the tile over the page into an 8-bit framebuffer. Nothing in this
+// chain dithers: SkPaint::setDither() only affects shaders, and Skia's GPU
+// dither only perturbs premultiplied RGB (clamped to [0, a]), never alpha, so
+// it is a no-op for a black shadow in a transparent layer. In the flat tail of
+// the Gaussian one alpha step spans 5-10 device pixels, and on a smooth page
+// colour every step is a visible contour; as R, G and B round at different
+// places, the contours are even slightly coloured. Fractional scaling makes
+// it worse, as the same few steps spread over 1.33x as many pixels.
+//
+// The shader below instead evaluates the shadow analytically per device pixel
+// (a Gaussian-blurred rounded rect is approximated by the error function of
+// its signed distance, which is exact along the edges) in float, and adds
+// interleaved gradient noise of a few alpha steps before the value is
+// quantized into the tile. The noise turns each contour into a fine dither,
+// which survives the compositor's blend: an alpha step changes a page channel
+// by `page / 255` of a level, so +-1.25 alpha steps cover a whole output
+// level on any but very dark pages.
+constexpr char kShadowSkSL[] = R"(
+uniform float4 u_card;
+uniform float u_radius;
+uniform float4 u_layer0;
+uniform float4 u_layer1;
+uniform float4 u_color;
+uniform float u_scale;
+uniform float u_dither;
+
+float RRectDistance(float2 p, float inset) {
+  float2 center = 0.5 * (u_card.xy + u_card.zw);
+  float2 half_size = 0.5 * (u_card.zw - u_card.xy) - inset;
+  float radius = max(u_radius - inset, 0.0);
+  float2 q = abs(p - center) - half_size + radius;
+  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
+}
+
+float Erf(float x) {
+  float x2 = x * x;
+  float t = x2 * (1.2732395 + 0.147 * x2) / (1.0 + 0.147 * x2);
+  return sign(x) * sqrt(1.0 - exp(-t));
+}
+
+float LayerAlpha(float2 p, float4 layer) {
+  if (layer.w <= 0.0 || layer.x <= 0.0) {
+    return 0.0;
+  }
+  float d = RRectDistance(p - float2(0.0, layer.y), layer.z);
+  return layer.w * 0.5 * (1.0 - Erf(d / (1.4142136 * layer.x)));
+}
+
+half4 main(float2 p) {
+  float a0 = LayerAlpha(p, u_layer0);
+  float a1 = LayerAlpha(p, u_layer1);
+  float a = 1.0 - (1.0 - a0) * (1.0 - a1);
+  if (a < 0.25 / 255.0) {
+    return half4(0.0);
+  }
+  float2 pixel = floor(p * u_scale);
+  float noise =
+      fract(52.9829189 * fract(dot(pixel, float2(0.06711056, 0.00583715))));
+  a = clamp(a + (noise - 0.5) * u_dither, 0.0, 1.0);
+  return half4(half3(u_color.rgb * a), half(a));
+}
+)";
+
+// Peak-to-peak amplitude of the shadow's alpha dither, in alpha steps.
+constexpr float kShadowDitherSteps = 2.5f;
+
+// Keyword mode tints, as the fraction of the site color mixed into the card
+// surface: barely for the input section, a little more for the chip.
+constexpr float kInputTintDark = 0.10f;
+constexpr float kInputTintLight = 0.06f;
+constexpr float kChipTintDark = 0.30f;
+constexpr float kChipTintLight = 0.18f;
+// Size of the site favicon in the keyword chip.
+constexpr int kChipIconSize = 16;
+
+// Minimum WCAG contrast between text and the (tinted) surfaces.
+constexpr float kMinTextContrast = color_utils::kMinimumReadableContrastRatio;
+
+// Animations.
+constexpr base::TimeDelta kOpenDuration = base::Milliseconds(150);
+constexpr base::TimeDelta kCloseDuration = base::Milliseconds(100);
+// How long the window may be inactive before the bar closes, see
+// OnWindowDeactivated().
+constexpr base::TimeDelta kDeactivationGracePeriod = base::Milliseconds(250);
+constexpr base::TimeDelta kGlowDuration = base::Milliseconds(120);
+// Matches the omnibox popup's own fade.
+constexpr base::TimeDelta kPopupFadeDuration = base::Milliseconds(82);
+constexpr float kOpenInitialScale = 0.98f;
+
+// Paints a one physical pixel outline just inside `bounds`.
+void PaintHairlineOutline(gfx::Canvas* canvas,
+                          const gfx::Rect& bounds,
+                          int corner_radius,
+                          SkColor color) {
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const float dsf = canvas->UndoDeviceScaleFactor();
+  gfx::RectF outline(bounds);
+  outline.Scale(dsf);
+  outline.Inset(0.5f);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1);
+  flags.setColor(color);
+  canvas->DrawRoundRect(outline, corner_radius * dsf - 0.5f, flags);
+}
+
+// Paints the shadow `layer` of `card` with a blur mask filter. Only used if
+// the runtime shader is unavailable; it bands, see kShadowSkSL.
+void PaintBlurShadow(gfx::Canvas* canvas,
+                     const gfx::RectF& card,
+                     float corner_radius,
+                     const SkV4& layer,
+                     SkColor color) {
+  const float sigma = layer.x;
+  const float alpha = layer.w;
+  if (sigma <= 0 || alpha <= 0) {
+    return;
+  }
+  gfx::RectF rect = card;
+  rect.Inset(layer.z);
+  const SkColor shadow_color =
+      SkColorSetA(color, base::ClampRound<SkAlpha>(alpha * 255));
+  cc::DrawLooperBuilder looper_builder;
+  looper_builder.AddShadow(SkPoint::Make(0, layer.y), sigma,
+                           SkColor4f::FromColor(shadow_color),
+                           cc::DrawLooper::kOverrideAlphaFlag);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(shadow_color);
+  flags.setLooper(looper_builder.Detach());
+  canvas->DrawRoundRect(rect, std::max(0.0f, corner_radius - layer.z), flags);
+}
+
+// Paints up to two shadow layers of `card` (each `SkV4{sigma, offset_y,
+// inset, alpha}`, alpha 0 to skip) in `color` over `paint_bounds`, with the
+// dithered runtime shader. Falls back to PaintBlurShadow() if the shader
+// can't be created.
+void PaintShadow(gfx::Canvas* canvas,
+                 const gfx::Rect& paint_bounds,
+                 const gfx::RectF& card,
+                 float corner_radius,
+                 const SkV4& layer0,
+                 const SkV4& layer1,
+                 SkColor color,
+                 sk_sp<cc::PaintShader>& cached_shader) {
+  std::vector<cc::PaintShader::FloatUniform> float_uniforms = {
+      {.name = SkString("u_radius"), .value = corner_radius},
+      {.name = SkString("u_scale"), .value = canvas->image_scale()},
+      {.name = SkString("u_dither"), .value = kShadowDitherSteps / 255.0f},
+  };
+  std::vector<cc::PaintShader::Float4Uniform> float4_uniforms = {
+      {.name = SkString("u_card"),
+       .value = SkV4{card.x(), card.y(), card.right(), card.bottom()}},
+      {.name = SkString("u_layer0"), .value = layer0},
+      {.name = SkString("u_layer1"), .value = layer1},
+      {.name = SkString("u_color"),
+       .value = SkV4{SkColorGetR(color) / 255.0f, SkColorGetG(color) / 255.0f,
+                     SkColorGetB(color) / 255.0f, 1.0f}},
+  };
+  sk_sp<cc::PaintShader> shader = cc::PaintShader::MakeSkSLCommand(
+      kShadowSkSL, std::move(float_uniforms), /*float2_uniforms=*/{},
+      std::move(float4_uniforms), /*int_uniforms=*/{}, cached_shader);
+  if (!shader) {
+    PaintBlurShadow(canvas, card, corner_radius, layer0, color);
+    PaintBlurShadow(canvas, card, corner_radius, layer1, color);
+    return;
+  }
+  cached_shader = shader;
+  cc::PaintFlags flags;
+  flags.setShader(std::move(shader));
+  canvas->DrawRect(gfx::RectF(paint_bounds), flags);
+}
+
+SkV4 ToShadowParams(const ShadowLayer& layer, bool dark) {
+  return SkV4{layer.sigma, layer.offset_y, layer.inset,
+              (dark ? layer.dark_alpha : layer.light_alpha) / 255.0f};
+}
+
+// Moves `background` towards `toward` until `foreground` text on it reaches
+// the minimum readable contrast.
+SkColor EnsureTextContrast(SkColor background,
+                           SkColor foreground,
+                           SkColor toward) {
+  if (color_utils::GetContrastRatio(background, foreground) >=
+      kMinTextContrast) {
+    return background;
+  }
+  return color_utils::BlendForMinContrast(background, foreground, toward,
+                                          kMinTextContrast)
+      .color;
+}
+
+// Zen's card is a near-black solid surface; derive it from the omnibox
+// results background so light themes and custom themes still match.
+SkColor GetBaseSurfaceColor(const ui::ColorProvider* color_provider) {
+  const SkColor results_background =
+      color_provider->GetColor(kColorOmniboxResultsBackground);
+  return color_utils::IsDark(results_background)
+             ? color_utils::AlphaBlend(SK_ColorBLACK, results_background, 0.45f)
+             : results_background;
+}
+
+// Candidate page URLs whose favicon represents the site behind `turl`: the
+// search page's origin (any page on that host), then www.<domain> and
+// <domain>, so e.g. music.youtube.com falls back to youtube.com's icon.
+std::vector<GURL> GetFaviconCandidates(const TemplateURL& turl,
+                                       const SearchTermsData& search_terms) {
+  std::vector<GURL> candidates;
+  GURL search_url = turl.GenerateSearchURL(search_terms);
+  if (!search_url.is_valid() || !search_url.SchemeIsHTTPOrHTTPS()) {
+    search_url = turl.favicon_url();
+  }
+  if (!search_url.is_valid() || !search_url.SchemeIsHTTPOrHTTPS()) {
+    return candidates;
+  }
+  candidates.push_back(search_url.GetWithEmptyPath());
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          search_url,
+          net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (!domain.empty()) {
+    for (const std::string& host : {"www." + domain, domain}) {
+      const GURL url("https://" + host + "/");
+      if (url.is_valid() && url.host() != search_url.host()) {
+        candidates.push_back(url);
+      }
+    }
+  }
+  return candidates;
+}
