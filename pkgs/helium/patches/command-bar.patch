+CommandBarView::CommandBarView(BrowserView* browser_view,
+                               CommandBarShadowView* shadow_view)
+    : browser_view_(browser_view), shadow_view_(shadow_view) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetName("CommandBarView");
+  layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(kCardCornerRadius));
+  layer()->SetIsFastRoundedCorner(true);
+  // The solid surface is set (and re-tinted) by UpdateColors().
+  views::SetCascadingColorProviderColor(this, views::kCascadingBackgroundColor,
+                                        kColorOmniboxResultsBackground);
+  SetVisible(false);
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kDialog);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_ACCNAME_LOCATION));
+  GetViewAccessibility().SetIsModal(true);
+
+  popup_style_.corner_radius = kCardCornerRadius;
+  popup_style_.alignment_insets = gfx::Insets(kCardPadding);
+  popup_style_.non_result_section_height = kInputSectionHeight;
+  popup_style_.bottom_padding = kResultsBottomPadding;
+  popup_style_.row_height = kResultRowHeight;
+  popup_style_.two_line_row_height = kTwoLineResultRowHeight;
+  popup_style_.row_insets = kResultRowInsets;
+  popup_style_.selection_radius = kSelectionRadius;
+
+  glow_animation_.SetSlideDuration(
+      gfx::Animation::RichAnimationDuration(kGlowDuration));
+
+  view_observations_.AddObservation(browser_view_.get());
+  if (shadow_view_) {
+    view_observations_.AddObservation(shadow_view_.get());
+  }
+}
+
+CommandBarView::~CommandBarView() {
+  // BrowserView docks the location bar before tearing down its children.
+  DCHECK(state_ == State::kHidden);
+  StopObserving();
+}
+
+void CommandBarView::Show(Mode mode) {
+  ToolbarView* const toolbar = browser_view_->toolbar();
+  LocationBarView* const location_bar = GetLocationBarView();
+  if (!toolbar || !location_bar || !GetWidget()) {
+    return;
+  }
+
+  if (state_ == State::kOpen) {
+    if (mode_ != mode) {
+      // Ctrl+T while editing, or Ctrl+L while in new-tab mode: switch in
+      // place. The card stays open and the popup only swaps its suggestions.
+      mode_ = mode;
+      ApplyMode(/*switching=*/true);
+      if (!HasFocusWithin()) {
+        location_bar->omnibox_view()->RequestFocus();
+      }
+    } else if (!HasFocusWithin()) {
+      // Open, but focus ended up elsewhere: give it back to the input.
+      location_bar->omnibox_view()->RequestFocus();
+    }
+    return;
+  }
+
+  const bool reopening = state_ == State::kClosing;
+  // Set before the location bar is hosted, so everything it computes while
+  // being attached (page classification, URL, icons) already sees the final
+  // mode.
+  state_ = State::kOpen;
+  mode_ = mode;
+  accepting_ = false;
+  shrink_timer_.Stop();
+  popup_bounds_.reset();
+
+  if (reopening) {
+    // Still hosting the location bar; just cancel the pending dock and show
+    // the live location bar again.
+    close_weak_factory_.InvalidateWeakPtrs();
+    UnfreezeLocationBar();
+  } else {
+    views::FocusManager* const focus_manager = GetFocusManager();
+    views::View* const focused =
+        focus_manager ? focus_manager->GetFocusedView() : nullptr;
+    restore_focus_tracker_.SetView(
+        focused && !location_bar->Contains(focused) ? focused : nullptr);
+
+    location_bar->omnibox_view()->RevertAll();
+    // Visible but fully transparent before it receives the location bar, so
+    // a focused omnibox is never inside a hidden parent, and nothing of the
+    // intermediate states below can reach the screen.
+    layer()->SetOpacity(0.0f);
+    if (shadow_view_) {
+      shadow_view_->layer()->SetOpacity(0.0f);
+    }
+    SetVisible(true);
+    toolbar->DetachLocationBarForCommandBar(this);
+    location_bar_was_visible_ = location_bar->GetVisible();
+    location_bar->SetVisible(true);
+    keyword_.clear();
+    UpdateColors();
+    location_bar->SetCommandBarHost(this);
+  }
+
+  if (shadow_view_) {
+    shadow_view_->SetVisible(true);
+  }
+  // Synchronously, so the popup is placed against the final geometry.
+  UpdateBounds();
+
+  // Put text, keyword, icon and suggestions into their final state before the
+  // first frame of the open animation (the card is still at opacity 0 and
+  // animations only start ticking on the next frame), so Ctrl+T never shows
+  // the current page's URL or page info icon, not even for a frame.
+  ApplyMode(/*switching=*/false);
+  location_bar->location_icon_view()->Update(
+      /*suppress_animations=*/true,
+      location_bar->GetOmniboxController()->IsPopupOpen());
+
+  AnimateOpen(/*from_current=*/reopening);
+  StartObserving();
+}
+
+void CommandBarView::Dismiss(DismissReason reason) {
+  if (state_ != State::kOpen) {
+    return;
+  }
+  state_ = State::kClosing;
+  dismiss_reason_ = reason;
+  deactivation_timer_.Stop();
+  // Before anything below reverts the text. Changes that already happened in
+  // this task (e.g. the omnibox reverting on blur before the focus change that
+  // dismisses the bar) are not painted yet, so the frozen layer still shows
+  // the last frame.
+  FreezeLocationBar();
+  StopObserving();
+  shrink_timer_.Stop();
+  glow_animation_.Hide();
+
+  if (LocationBarView* const location_bar = GetLocationBarView()) {
+    OmniboxViewViews* const omnibox_view = location_bar->omnibox_view();
+    if (ui::InputMethod* const input_method = omnibox_view->GetInputMethod()) {
+      input_method->CancelComposition(omnibox_view);
+    }
+    // While accepting, OmniboxEditModel::OpenMatch() ends the edit session
+    // itself; reverting from inside it would clobber the navigation.
+    if (!accepting_) {
+      omnibox_view->RevertAll();
+    }
+  }
+
+  AnimateClose();
+}
+
+void CommandBarView::DockNow() {
+  if (state_ == State::kHidden) {
+    return;
+  }
+  close_weak_factory_.InvalidateWeakPtrs();
+  StopObserving();
+  shrink_timer_.Stop();
+  glow_animation_.Reset(0);
+  deactivation_timer_.Stop();
+  if (shadow_view_) {
+    shadow_view_->SetGlowAmount(0);
+  }
+
+  ToolbarView* const toolbar = browser_view_->toolbar();
+  LocationBarView* const location_bar = GetLocationBarView();
+  UnfreezeLocationBar();
+
+  // Move focus out of the location bar before it returns to a toolbar that may
+  // be hidden, so neither the focused nor the stored (restored on window
+  // activation) view is an invisible omnibox. Otherwise FocusManager advances
+  // focus to the next view in traversal order once the omnibox is hidden,
+  // which in frameless mode is the sidebar's site pill.
+  views::FocusManager* const focus_manager = GetFocusManager();
+  views::View* target = nullptr;
+  bool focus_was_in_bar = false;
+  if (focus_manager) {
+    if (dismiss_reason_ == DismissReason::kEscape) {
+      views::View* const previous = restore_focus_tracker_.view();
+      if (previous && !Contains(previous) &&
+          !(location_bar && location_bar->Contains(previous)) &&
+          previous->IsFocusable()) {
+        target = previous;
+      }
+    }
+    if (!target) {
+      target = browser_view_->GetActiveContentsWebView();
+    }
+    views::View* const focused = focus_manager->GetFocusedView();
+    focus_was_in_bar = !focused || Contains(focused);
+    if (focused && Contains(focused)) {
+      if (target && target->IsFocusable()) {
+        target->RequestFocus();
+      }
+      views::View* const now_focused = focus_manager->GetFocusedView();
+      if (now_focused && Contains(now_focused)) {
+        focus_manager->ClearFocus();
+      }
+    }
+    views::View* const stored = focus_manager->GetStoredFocusView();
+    if ((stored && Contains(stored)) || (!stored && focus_was_in_bar)) {
+      focus_manager->SetStoredFocusView(target);
+    }
+  }
+  restore_focus_tracker_.SetView(nullptr);
+
+  if (location_bar) {
+    location_bar->SetCommandBarHost(nullptr);
+    location_bar->SetVisible(location_bar_was_visible_);
+  }
+  if (toolbar) {
+    toolbar->ReattachLocationBarFromCommandBar();
+  }
+
+  state_ = State::kHidden;
+  mode_ = Mode::kEditCurrentTab;
+  accepting_ = false;
+  popup_bounds_.reset();
+  SetVisible(false);
+  if (shadow_view_) {
+    shadow_view_->SetVisible(false);
+  }
+
+  // Hiding and reparenting the location bar must not leave focus on whatever
+  // FocusManager advanced to (e.g. the sidebar's site pill): if focus was in
+  // the bar, it belongs to `target`. Also check once more after the current
+  // task, in case the reattach triggers a deferred focus advance.
+  if (focus_manager && focus_was_in_bar && target) {
+    dock_focus_target_.SetView(target);
+    EnsureDockFocus();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CommandBarView::EnsureDockFocus,
+                                  weak_factory_.GetWeakPtr()));
+  }
+}
+
+void CommandBarView::EnsureDockFocus() {
+  views::View* const target = dock_focus_target_.view();
+  views::FocusManager* const focus_manager = GetFocusManager();
+  if (state_ != State::kHidden || !target || !focus_manager || !GetWidget() ||
+      GetWidget()->IsClosed() || !GetWidget()->IsActive()) {
+    return;
+  }
+  views::View* const focused = focus_manager->GetFocusedView();
+  if (focused == target || !target->IsFocusable()) {
+    return;
+  }
+  // Only override focus that nobody chose: none, or what FocusManager picked
+  // by traversal/restoration.
+  const auto reason = focus_manager->focus_change_reason();
+  if (!focused ||
+      reason == views::FocusManager::FocusChangeReason::kFocusTraversal ||
+      reason == views::FocusManager::FocusChangeReason::kFocusRestore) {
+    target->RequestFocus();
+  }
+}
+
+void CommandBarView::OnActiveTabChanging() {
+  if (state_ != State::kOpen) {
+    return;
+  }
+  // Clear focus first so the old tab doesn't store the command bar's omnibox
+  // as the view to refocus when it is activated again.
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    views::View* const focused = focus_manager->GetFocusedView();
+    if (focused && Contains(focused)) {
+      focus_manager->ClearFocus();
+    }
+  }
+  Dismiss(DismissReason::kTabChanged);
+}
+
+void CommandBarView::OnWindowDeactivated() {
+  // The omnibox context menu may briefly take activation.
+  if (state_ != State::kOpen || views::MenuController::GetActiveInstance()) {
+    return;
+  }
+  // On Wayland the window can lose and regain activation (keyboard focus)
+  // around popup surface changes and virtual keyboard devices. Only close if
+  // the window is still inactive a moment later.
+  deactivation_timer_.Start(
+      FROM_HERE, kDeactivationGracePeriod,
+      base::BindOnce(&CommandBarView::OnDeactivationGracePeriodEnded,
+                     base::Unretained(this)));
+}
+
+void CommandBarView::OnDeactivationGracePeriodEnded() {
+  if (state_ != State::kOpen || !GetWidget() || GetWidget()->IsActive() ||
+      views::MenuController::GetActiveInstance()) {
+    return;
+  }
+  VLOG(1) << "Command bar: dismissed, window deactivated";
+  Dismiss(DismissReason::kDeactivated);
+}
+
+bool CommandBarView::IsCommandBarNewTabMode() const {
+  return state_ == State::kOpen && mode_ == Mode::kNewTab;
+}
