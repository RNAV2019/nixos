+void CommandBarView::RemovedFromWidget() {
+  StopObserving();
+  if (state_ != State::kHidden) {
+    // Don't reparent from inside the removal notification.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CommandBarView::DockNow, weak_factory_.GetWeakPtr()));
+  }
+}
+
+void CommandBarView::OnViewBoundsChanged(views::View* observed_view) {
+  if (observed_view == browser_view_.get() && state_ != State::kHidden) {
+    UpdateBounds();
+  }
+}
+
+void CommandBarView::OnViewIsDeleting(views::View* observed_view) {
+  view_observations_.RemoveObservation(observed_view);
+  if (observed_view == shadow_view_.get()) {
+    shadow_view_ = nullptr;
+  }
