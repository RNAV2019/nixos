+CommandBarShadowView::CommandBarShadowView() {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetName("CommandBarShadowView");
+  // Clicks on the page under the shadow must reach the page.
+  SetCanProcessEventsWithinSubtree(false);
+  SetVisible(false);
+}
+
+CommandBarShadowView::~CommandBarShadowView() = default;
+
+void CommandBarShadowView::SetCardBounds(const gfx::Rect& card_bounds) {
+  gfx::Rect bounds = card_bounds;
+  bounds.Inset(-kShadowInsets);
+  card_rect_ = gfx::Rect(kShadowInsets.left(), kShadowInsets.top(),
+                         card_bounds.width(), card_bounds.height());
+  SetBoundsRect(bounds);
+  SchedulePaint();
+}
+
+void CommandBarShadowView::SetGlowAmount(double amount) {
+  if (glow_amount_ == amount) {
+    return;
+  }
+  glow_amount_ = amount;
+  SchedulePaint();
+}
+
+void CommandBarShadowView::SetGlowColor(SkColor color) {
+  if (glow_color_ == color) {
+    return;
+  }
+  glow_color_ = color;
+  if (glow_amount_ > 0) {
+    SchedulePaint();
+  }
+}
+
+gfx::PointF CommandBarShadowView::GetCardTopCenter() const {
+  return gfx::PointF(card_rect_.x() + card_rect_.width() / 2.0f,
+                     card_rect_.y());
+}
+
+void CommandBarShadowView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  if (!color_provider || card_rect_.IsEmpty()) {
+    return;
+  }
+
+  const bool dark = color_utils::IsDark(
+      color_provider->GetColor(kColorOmniboxResultsBackground));
+  const gfx::RectF card(card_rect_);
+  PaintShadow(canvas, GetLocalBounds(), card, kCardCornerRadius,
+              ToShadowParams(kContactShadow, dark),
+              ToShadowParams(kKeyShadow, dark), SK_ColorBLACK, cached_shader_);
+
+  if (glow_amount_ > 0) {
+    const SkColor glow_color = glow_color_.value_or(
+        color_provider->GetColor(kColorOmniboxKeywordSelected));
+    PaintShadow(canvas, GetLocalBounds(), card, kCardCornerRadius,
+                SkV4{kGlowSigma, /*offset_y=*/0, /*inset=*/0,
+                     static_cast<float>(kGlowAlpha / 255.0 * glow_amount_)},
+                SkV4{0, 0, 0, 0}, glow_color, cached_shader_);
+  }
+}
+
+void CommandBarShadowView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  SchedulePaint();
+}
