+++ b/chrome/browser/ui/views/omnibox/omnibox_popup_style.h
@@ -0,0 +1,49 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_OMNIBOX_OMNIBOX_POPUP_STYLE_H_
+#define CHROME_BROWSER_UI_VIEWS_OMNIBOX_OMNIBOX_POPUP_STYLE_H_
+
+#include "ui/gfx/geometry/insets.h"
+
+// Geometry overrides for the classic omnibox popup while its location bar is
+// hosted by the floating command bar. The popup frame then sits exactly on top
+// of the command bar card, so that the input row and the results read as a
+// single surface. The card paints the surface, outline, input/results divider
+// and shadow. The (translucent) popup frame paints none of them, so the card
+// shows through it and can be re-tinted, e.g. in keyword mode, without
+// touching the popup. Only the rows paint their hover/selection highlights.
+struct OmniboxPopupStyle {
+  // Corner radius of the popup frame. Matches the card.
+  int corner_radius = 0;
+
+  // How the popup frame is outset from the location bar. Matches the card
+  // padding.
+  gfx::Insets alignment_insets;
+
+  // Height of the input section at the top of the frame (padding + location
+  // bar + padding).
+  int non_result_section_height = 0;
+
+  // Maximum height of the popup frame, or 0 for no limit.
+  int max_height = 0;
+
+  // Dead space below the last result.
+  int bottom_padding = 0;
+
+  // Height of a standard one-line result row.
+  int row_height = 0;
+
+  // Height of a two-line row (title above a muted URL), used for navigation
+  // matches that have both. 0 keeps every row on one line.
+  int two_line_row_height = 0;
+
+  // Insets of each result row inside the frame.
+  gfx::Insets row_insets;
+
+  // Corner radius of the hovered and selected row backgrounds.
+  int selection_radius = 0;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_OMNIBOX_OMNIBOX_POPUP_STYLE_H_
