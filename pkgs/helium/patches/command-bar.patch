+// Hairline outline and input/results divider of the popup frame while it is
+// merged with Helium's command bar card. The card paints the same outline, so
+// the surface keeps one silhouette whether or not results are shown.
+class CommandBarFrameBorder : public views::Border {
+ public:
+  CommandBarFrameBorder(int corner_radius, int divider_y)
+      : corner_radius_(corner_radius), divider_y_(divider_y) {}
+  CommandBarFrameBorder(const CommandBarFrameBorder&) = delete;
+  CommandBarFrameBorder& operator=(const CommandBarFrameBorder&) = delete;
+  ~CommandBarFrameBorder() override = default;
+
+  // views::Border:
+  void Paint(const views::View& view, gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = view.GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    const SkColor text_color = color_provider->GetColor(kColorOmniboxText);
+
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    const float dsf = canvas->UndoDeviceScaleFactor();
+
+    // Divider between the input section and the results.
+    constexpr int kDividerHorizontalInset = 14;
+    if (view.height() > divider_y_ + 1) {
+      gfx::RectF divider(kDividerHorizontalInset, divider_y_ - 1,
+                         view.width() - 2 * kDividerHorizontalInset, 1);
+      divider.Scale(dsf);
+      divider.set_height(1);
+      canvas->FillRect(gfx::ToEnclosingRect(divider),
+                       SkColorSetA(text_color, 0x14));
+    }
+
+    // One physical pixel outline.
+    gfx::RectF outline(view.GetLocalBounds());
+    outline.Scale(dsf);
+    outline.Inset(0.5f);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
