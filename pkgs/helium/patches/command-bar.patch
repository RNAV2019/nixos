+
+  // Returns the pivot for the open animation (the top centre of the card), in
+  // this view's coordinates.
+  gfx::PointF GetCardTopCenter() const;
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+
+ private:
+  // The card rect in this view's coordinates.
+  gfx::Rect card_rect_;
+  double glow_amount_ = 0;
+  std::optional<SkColor> glow_color_;
+  // Lets the shader reuse its compiled runtime effect across paints.
+  sk_sp<cc::PaintShader> cached_shader_;
+};
