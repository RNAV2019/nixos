+LocationBarView* ToolbarView::DetachLocationBarForCommandBar(
+    views::View* host) {
+  CHECK(location_bar_view_);
+  CHECK(location_bar_view_->parent() == this);
+  CHECK(host->GetWidget() == GetWidget());
+
+  const size_t index = GetIndexOf(location_bar_view_).value();
+  if (!location_bar_placeholder_) {
+    location_bar_placeholder_ =
+        AddChildViewAt(std::make_unique<views::View>(), index);
+  } else {
+    ReorderChildView(location_bar_placeholder_, index);
+  }
+  if (const auto* flex =
+          location_bar_view_->GetProperty(views::kFlexBehaviorKey)) {
+    location_bar_placeholder_->SetProperty(views::kFlexBehaviorKey, *flex);
+  }
+  if (const auto* margins =
+          location_bar_view_->GetProperty(views::kMarginsKey)) {
+    location_bar_placeholder_->SetProperty(views::kMarginsKey, *margins);
+  }
+  location_bar_placeholder_->SetPreferredSize(location_bar_view_->size());
+  location_bar_placeholder_->SetVisible(true);
+
+  // Same-widget reparent: focus, layers and observers move along without
+  // RemovedFromWidget()/AddedToWidget().
+  host->AddChildViewRaw(location_bar_view_.get());
+  InvalidateLayout();
+  return location_bar_view_;
+}
+
+void ToolbarView::ReattachLocationBarFromCommandBar() {
+  if (!IsLocationBarDetachedForCommandBar()) {
+    return;
+  }
+  const size_t index =
+      location_bar_placeholder_
+          ? GetIndexOf(location_bar_placeholder_).value_or(children().size())
+          : children().size();
+  AddChildViewAt(location_bar_view_.get(), index);
+  if (location_bar_placeholder_) {
+    location_bar_placeholder_->SetVisible(false);
+  }
+  InvalidateLayout();
+}
+
+bool ToolbarView::IsLocationBarDetachedForCommandBar() const {
+  return location_bar_view_ && location_bar_view_->parent() != this;
+}
