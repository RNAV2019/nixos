+
+void CommandBarView::OnDidChangeFocus(views::View* focused_before,
+                                      views::View* focused_now) {
+  if (state_ != State::kOpen || (focused_now && Contains(focused_now))) {
+    return;
+  }
+  // The omnibox context menu clears focus while it runs.
+  if (!focused_now && views::MenuController::GetActiveInstance()) {
+    return;
+  }
+  views::FocusManager* const focus_manager = GetFocusManager();
+  using FocusChangeReason = views::FocusManager::FocusChangeReason;
+  const FocusChangeReason reason =
+      focus_manager ? focus_manager->focus_change_reason()
+                    : FocusChangeReason::kDirectFocusChange;
+  // Not a decision to leave the bar:
+  // - focus cleared (nullptr), e.g. FocusManager::StoreFocusedView() while
+  //   the native window loses keyboard focus for a moment (window
+  //   deactivation is handled separately, with a grace period);
+  // - focus traversal or restoration, e.g. FocusManager::AdvanceFocus() /
+  //   AdvanceFocusIfNecessary() / RestoreFocusedView() picking the next view
+  //   in traversal order (the sidebar's site pill). Tab itself never
+  //   traverses out of the bar (see OmniboxViewViews).
+  // Take the focus back instead of closing.
+  if (!focused_now ||
+      reason == views::FocusManager::FocusChangeReason::kFocusTraversal ||
+      reason == views::FocusManager::FocusChangeReason::kFocusRestore) {
+    VLOG(1) << "Command bar: reclaiming focus lost to "
+            << (focused_now ? "a view by traversal or restore" : "nullptr");
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CommandBarView::ReclaimFocus,
+                                  weak_factory_.GetWeakPtr()));
+    return;
+  }
+  VLOG(1) << "Command bar: dismissed, focus moved to "
+          << focused_now->GetClassName();
+  Dismiss(DismissReason::kFocusLost);
+}
+
+void CommandBarView::ReclaimFocus() {
+  if (state_ != State::kOpen || !GetWidget() || !GetWidget()->IsActive()) {
+    // An inactive window restores its stored focus view (the omnibox) when
+    // it is reactivated.
+    return;
+  }
+  views::FocusManager* const focus_manager = GetFocusManager();
+  views::View* const focused =
+      focus_manager ? focus_manager->GetFocusedView() : nullptr;
+  if (focused && Contains(focused)) {
+    return;
+  }
+  if (LocationBarView* const location_bar = GetLocationBarView()) {
+    // Not FocusLocation(): that would select all and restart suggestions.
+    location_bar->omnibox_view()->RequestFocus();
+  }
+}
+
+bool CommandBarView::HasFocusWithin() {
+  views::FocusManager* const focus_manager = GetFocusManager();
+  views::View* const focused =
+      focus_manager ? focus_manager->GetFocusedView() : nullptr;
+  return focused && Contains(focused);
+}
+
+void CommandBarView::OnEvent(const ui::Event& event) {
+  if (state_ != State::kOpen || !event.IsLocatedEvent() || !GetWidget()) {
+    return;
+  }
+  gfx::Point location = event.AsLocatedEvent()->root_location();
+  views::View::ConvertPointToScreen(GetWidget()->GetRootView(), &location);
+  if (GetBoundsInScreen().Contains(location)) {
+    return;
+  }
+  // Don't consume the press so it still reaches the page or tab strip, and
+  // don't tear down the event monitor from inside its own dispatch.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CommandBarView::Dismiss,
+                                weak_factory_.GetWeakPtr(),
+                                DismissReason::kClickOutside));
+}
+
+void CommandBarView::AnimationProgressed(const gfx::Animation* animation) {
+  if (shadow_view_) {
+    shadow_view_->SetGlowAmount(glow_animation_.GetCurrentValue());
+  }
+}
+
+LocationBarView* CommandBarView::GetLocationBarView() const {
+  ToolbarView* const toolbar = browser_view_->toolbar();
+  return toolbar ? toolbar->location_bar_view() : nullptr;
+}
+
+void CommandBarView::ApplyMode(bool switching) {
+  LocationBarView* const location_bar = GetLocationBarView();
+  if (!location_bar) {
+    return;
+  }
+  OmniboxViewViews* const omnibox_view = location_bar->omnibox_view();
+  OmniboxEditModel* const edit_model =
+      location_bar->GetOmniboxController()->edit_model();
+
+  if (mode_ == Mode::kNewTab) {
+    if (!switching) {
+      omnibox_view->RevertAll();
+      // Focus without on-focus suggestions for the current page.
+      location_bar->FocusLocation(/*is_user_initiated=*/false,
+                                  /*clear_focus_if_failed=*/false);
+    }
+    // Clear the text and ask for new tab page suggestions instead
+    // (`IsCommandBarNewTabMode()` makes the omnibox client describe the
+    // context as an NTP). Restarting replaces the open popup's suggestions in
+    // place rather than closing and reopening it.
+    omnibox_view->SetUserText(std::u16string(), /*update_popup=*/false);
+    edit_model->RestartZeroSuggestRequest();
+  } else {
+    // The stock Ctrl+L path (unelide to the full URL, on-focus suggestions),
+    // but with the caret after the URL instead of the URL selected, so typing
+    // edits it rather than replacing it.
+    omnibox_view->RevertAll();
+    location_bar->FocusLocation(/*is_user_initiated=*/true,
+                                /*clear_focus_if_failed=*/false);
+    const size_t text_length = omnibox_view->GetText().length();
+    omnibox_view->SetSelectionBounds(gfx::Range(text_length, text_length));
+    if (switching) {
+      // FocusLocation() doesn't query while the popup is open.
+      edit_model->RestartZeroSuggestRequest();
+    }
+  }
+}
+
+gfx::Rect CommandBarView::GetInputSectionBounds() const {
+  const int window_width = browser_view_->width();
+  const int window_height = browser_view_->height();
+  const int min_width = std::max(
+      0, std::min(kCardMinWidth, window_width - 2 * kCardWindowMargin));
+  const int width =
+      std::clamp(base::ClampRound(window_width * kCardWidthFraction),
+                 min_width, kCardMaxWidth);
+  const int x = (window_width - width) / 2;
+  // A quarter of the way down (Zen), but low enough in short windows to leave
+  // room for a few results, and never above `kMinTop`. The popup's maximum
+  // height (see UpdateBounds()) keeps the rest on screen.
+  const int preferred_y = base::ClampRound(window_height * kCardTopFraction);
+  const int lowest_y =
+      window_height - kCardWindowMargin - kInputSectionHeight - kMinResultsSpace;
+  const int y = std::max(kMinTop, std::min(preferred_y, lowest_y));
+  return gfx::Rect(x, y, width, kInputSectionHeight);
+}
+
+void CommandBarView::UpdateBounds() {
+  if (updating_bounds_) {
+    // Moving the card moves the location bar, which re-places the popup,
+    // which reports new bounds.
+    bounds_dirty_ = true;
+    return;
+  }
+  base::AutoReset<bool> updating_bounds(&updating_bounds_, true);
+  for (int i = 0; i < 3; ++i) {
+    bounds_dirty_ = false;
+    gfx::Rect card_bounds = GetInputSectionBounds();
+    // Keep the popup, and so the card, inside the window, which also keeps a
+    // Wayland xdg_popup from being slid or flipped by the compositor.
+    popup_style_.max_height =
+        std::max(card_bounds.height(),
+                 browser_view_->height() - kCardWindowMargin - card_bounds.y());
+    if (popup_bounds_) {
+      card_bounds.set_height(
+          std::max(card_bounds.height(), popup_bounds_->height()));
+    }
+    SetBoundsRect(card_bounds);
+    LayoutLocationBar();
+    if (shadow_view_) {
+      shadow_view_->SetCardBounds(card_bounds);
+    }
+    if (!bounds_dirty_) {
+      break;
+    }
+  }
+}
+
+void CommandBarView::LayoutLocationBar() {
+  LocationBarView* const location_bar = GetLocationBarView();
+  if (!location_bar || location_bar->parent() != this) {
+    return;
+  }
+  location_bar->SetBoundsRect(
+      gfx::Rect(kCardPadding, kCardPadding,
+                std::max(0, width() - 2 * kCardPadding), kLocationBarHeight));
+}
+
+void CommandBarView::UpdateColors() {
+  const ui::ColorProvider* const color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  base_surface_color_ = GetBaseSurfaceColor(color_provider);
+  const bool dark = color_utils::IsDark(base_surface_color_);
+  const SkColor text_color = color_provider->GetColor(kColorOmniboxText);
+  const SkColor contrast_direction = dark ? SK_ColorBLACK : SK_ColorWHITE;
+
+  std::optional<SkColor> chip_background;
+  std::optional<SkColor> chip_foreground;
+  ui::ImageModel chip_icon;
+  input_surface_color_ = base_surface_color_;
+  if (!keyword_.empty()) {
+    const KeywordSite& site = GetKeywordSite(keyword_);
+    const SkColor site_color = site.color.value_or(
+        color_provider->GetColor(kColorOmniboxKeywordSelected));
+
+    // Only a hint of the site color: the input section takes a faint tint,
+    // the chip a muted one with the regular text color on it.
+    input_surface_color_ = EnsureTextContrast(
+        color_utils::AlphaBlend(site_color, base_surface_color_,
+                                dark ? kInputTintDark : kInputTintLight),
+        text_color, contrast_direction);
+    chip_foreground = text_color;
+    chip_background = EnsureTextContrast(
+        color_utils::AlphaBlend(site_color, base_surface_color_,
+                                dark ? kChipTintDark : kChipTintLight),
+        text_color, contrast_direction);
+    if (!site.icon.isNull()) {
+      chip_icon = ui::ImageModel::FromImageSkia(site.icon);
+    }
+
+    if (shadow_view_) {
+      shadow_view_->SetGlowColor(site_color);
+    }
+  }
+
+  SetBackground(views::CreateRoundedRectBackground(
+      base_surface_color_, static_cast<float>(kCardCornerRadius)));
+  if (LocationBarView* const location_bar = GetLocationBarView()) {
+    location_bar->SetCommandBarSurfaceColor(input_surface_color_);
+    location_bar->SetCommandBarKeywordChip(chip_background, chip_foreground,
+                                           chip_icon);
+  }
+  SchedulePaint();
+}
+
+const CommandBarView::KeywordSite& CommandBarView::GetKeywordSite(
+    const std::u16string& keyword) {
+  if (const auto it = keyword_sites_.find(keyword);
+      it != keyword_sites_.end()) {
+    return it->second;
+  }
+  // Add the entry right away so the lookup only runs once per keyword; a found
+  // favicon fills it in. (std::map references stay valid across inserts.)
+  const KeywordSite& site = keyword_sites_[keyword];
+
+  Profile* const profile = browser_view_->browser()->GetProfile();
+  TemplateURLService* const template_url_service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  const TemplateURL* const turl =
+      template_url_service
+          ? template_url_service->GetTemplateURLForKeyword(keyword)
+          : nullptr;
+  if (turl) {
+    FetchKeywordFavicon(
+        keyword,
+        GetFaviconCandidates(*turl, template_url_service->search_terms_data()));
+  }
+  return site;
+}
+
+void CommandBarView::FetchKeywordFavicon(const std::u16string& keyword,
+                                         std::vector<GURL> candidates) {
+  if (candidates.empty()) {
+    return;
+  }
+  favicon::FaviconService* const favicon_service =
+      FaviconServiceFactory::GetForProfile(
+          browser_view_->browser()->GetProfile(),
+          ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicon_service) {
+    return;
+  }
+  const GURL page_url = candidates.front();
+  candidates.erase(candidates.begin());
+  // Any favicon stored for a page on the host will do; prefer a large one,
+  // which gives a steadier dominant color and a sharp chip icon.
+  favicon_service->GetRawFaviconForPageURL(
+      page_url,
+      {favicon_base::IconType::kFavicon, favicon_base::IconType::kTouchIcon,
+       favicon_base::IconType::kTouchPrecomposedIcon,
+       favicon_base::IconType::kWebManifestIcon},
+      /*desired_size_in_pixel=*/32, /*fallback_to_host=*/true,
+      base::BindOnce(&CommandBarView::OnKeywordFaviconFetched,
+                     weak_factory_.GetWeakPtr(), keyword,
+                     std::move(candidates)),
+      &favicon_tracker_);
+}
+
+void CommandBarView::OnKeywordFaviconFetched(
+    const std::u16string& keyword,
+    std::vector<GURL> remaining_candidates,
+    const favicon_base::FaviconRawBitmapResult& result) {
+  SkBitmap bitmap;
+  if (result.is_valid()) {
+    bitmap = gfx::Image::CreateFrom1xPNGBytes(result.bitmap_data).AsBitmap();
+  }
+  if (bitmap.drawsNothing()) {
+    FetchKeywordFavicon(keyword, std::move(remaining_candidates));
+    return;
+  }
+  KeywordSite& site = keyword_sites_[keyword];
+  // K-means over the favicon, skipping near-black and near-white pixels, e.g.
+  // YouTube's red rather than its white play triangle.
+  site.color = SkColorSetA(color_utils::CalculateKMeanColorOfBitmap(bitmap),
+                           SK_AlphaOPAQUE);
+  // Resized from the full bitmap for each scale factor, so it stays sharp at
+  // fractional scales.
+  site.icon = gfx::ImageSkiaOperations::CreateResizedImage(
+      gfx::ImageSkia::CreateFrom1xBitmap(bitmap),
+      skia::ImageOperations::RESIZE_BEST,
+      gfx::Size(kChipIconSize, kChipIconSize));
+  if (state_ == State::kOpen && keyword == keyword_) {
+    UpdateColors();
+  }
+}
+
+void CommandBarView::FreezeLocationBar() {
+  LocationBarView* const location_bar = GetLocationBarView();
+  if (frozen_location_bar_layer_ || !location_bar ||
+      location_bar->parent() != this || !location_bar->layer()) {
+    return;
+  }
+  // RecreateLayer() gives the view a clone of its layer (stacked below the
+  // old one, with all child layers moved over) and returns the old layer
+  // without its delegate. Without a delegate, a textured layer never commits
+  // damage again, so it keeps showing its last recorded frame for the rest of
+  // the fade, which its parent (this card's layer) applies to it.
+  frozen_location_bar_layer_ = location_bar->RecreateLayer();
+  // Also hide the live layer, in case anything restacks the card's layers.
+  location_bar->layer()->SetOpacity(0.0f);
+}
+
+void CommandBarView::UnfreezeLocationBar() {
+  if (!frozen_location_bar_layer_) {
+    return;
+  }
+  // Destroying the layer removes it from its parent.
+  frozen_location_bar_layer_.reset();
+  if (LocationBarView* const location_bar = GetLocationBarView();
+      location_bar && location_bar->layer()) {
+    location_bar->layer()->SetOpacity(1.0f);
+  }
+}
+
+void CommandBarView::StartObserving() {
+  if (!focus_manager_) {
+    focus_manager_ = GetFocusManager();
+    if (focus_manager_) {
+      focus_manager_->AddFocusChangeListener(this);
+    }
+  }
+  if (!event_monitor_ && GetWidget()) {
+    event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, GetWidget()->GetNativeWindow(),
+        {ui::EventType::kMousePressed, ui::EventType::kGestureTap});
+  }
+}
+
+void CommandBarView::StopObserving() {
+  if (focus_manager_) {
+    focus_manager_->RemoveFocusChangeListener(this);
+    focus_manager_ = nullptr;
+  }
+  event_monitor_.reset();
+}
+
+void CommandBarView::AnimateOpen(bool from_current) {
+  const base::TimeDelta duration =
+      gfx::Animation::RichAnimationDuration(kOpenDuration);
+  gfx::Transform initial_scale;
+  initial_scale.Scale(kOpenInitialScale);
+
+  const auto animate = [&](ui::Layer* target, const gfx::PointF& pivot) {
+    target->GetAnimator()->AbortAllAnimations();
+    if (!from_current) {
+      target->SetOpacity(0.0f);
+      target->SetTransform(gfx::TransformAboutPivot(pivot, initial_scale));
+    }
+    ui::ScopedLayerAnimationSettings settings(target->GetAnimator());
+    settings.SetTransitionDuration(duration);
+    settings.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+    target->SetOpacity(1.0f);
+    target->SetTransform(gfx::Transform());
+  };
+
+  // Each layer scales about the card's top centre in its own coordinates.
+  // Layer transforms leave view bounds alone, so the popup is placed against
+  // the final geometry throughout.
+  animate(layer(), gfx::PointF(width() / 2.0f, 0));
+  if (shadow_view_) {
+    animate(shadow_view_->layer(), shadow_view_->GetCardTopCenter());
+  }
+}
+
+void CommandBarView::AnimateClose() {
+  close_weak_factory_.InvalidateWeakPtrs();
+  const base::TimeDelta duration =
+      gfx::Animation::RichAnimationDuration(kCloseDuration);
+
+  const auto animate = [&](ui::Layer* target, bool observe) {
+    target->GetAnimator()->AbortAllAnimations();
+    target->SetTransform(gfx::Transform());
+    ui::ScopedLayerAnimationSettings settings(target->GetAnimator());
+    settings.SetTransitionDuration(duration);
+    settings.SetTweenType(gfx::Tween::EASE_IN);
+    if (observe) {
+      // Deletes itself once the animation ends or is aborted.
+      settings.AddObserver(new ui::ClosureAnimationObserver(
+          base::BindOnce(&CommandBarView::OnCloseAnimationEnded,
+                         close_weak_factory_.GetWeakPtr())));
+    }
+    target->SetOpacity(0.0f);
+  };
+
+  if (shadow_view_) {
+    animate(shadow_view_->layer(), /*observe=*/false);
+  }
+  animate(layer(), /*observe=*/true);
+}
+
+void CommandBarView::OnCloseAnimationEnded() {
+  // Dismissal often happens inside OmniboxEditModel::OpenMatch() or a tab
+  // strip change; reparent the location bar from a fresh task.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CommandBarView::DockAfterClose,
+                                close_weak_factory_.GetWeakPtr()));
+}
+
+void CommandBarView::DockAfterClose() {
+  if (state_ == State::kClosing) {
+    DockNow();
+  }
+}
+
+void CommandBarView::OnAcceptFinished(bool dismiss) {
+  accepting_ = false;
+  if (dismiss) {
+    Dismiss(DismissReason::kAccepted);
+  }
+}
+
+void CommandBarView::ShrinkToInputSection() {
+  popup_bounds_.reset();
+  UpdateBounds();
+}
+
+// static
+bool CommandBarView::IsUntouchedNewTabPage(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  return search::IsNTPOrRelatedURL(
+             contents->GetVisibleURL(),
+             Profile::FromBrowserContext(contents->GetBrowserContext())) &&
+         contents->GetController().GetEntryCount() <= 1;
+}
+
+BEGIN_METADATA(CommandBarView)
+END_METADATA
