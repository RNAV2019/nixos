+}
+
+void CommandBarView::OnPopupBoundsChanged(
+    const std::optional<gfx::Rect>& screen_bounds) {
+  if (state_ != State::kOpen) {
+    // Keep the card's size while it fades out.
+    return;
+  }
+  if (screen_bounds) {
+    shrink_timer_.Stop();
+    popup_bounds_ = screen_bounds;
+    UpdateBounds();
+    return;
+  }
+  if (!popup_bounds_ || shrink_timer_.IsRunning()) {
+    return;
+  }
+  // Let the popup fade out over the card before shrinking it.
+  shrink_timer_.Start(
+      FROM_HERE, gfx::Animation::RichAnimationDuration(kPopupFadeDuration),
+      base::BindOnce(&CommandBarView::ShrinkToInputSection,
+                     base::Unretained(this)));
+}
+
+void CommandBarView::OnKeywordModeChanged(const std::u16string& keyword) {
+  // Called on every location bar layout; only act on changes.
+  if (state_ != State::kOpen || keyword == keyword_) {
+    return;
+  }
+  keyword_ = keyword;
+  if (keyword_.empty()) {
+    glow_animation_.Hide();
+  } else {
+    glow_animation_.Show();
+  }
+  // Called from inside LocationBarView::Layout(); recoloring only repaints.
+  UpdateColors();
+}
+
+WindowOpenDisposition CommandBarView::AdjustOpenDisposition(
+    WindowOpenDisposition disposition) {
+  if (state_ != State::kOpen) {
+    return disposition;
+  }
+
+  accepting_ = true;
+  // Background tabs (middle click) keep the bar open, like Arc. Everything
+  // else closes it once OpenMatch() has returned.
+  const bool dismiss = disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CommandBarView::OnAcceptFinished,
+                                weak_factory_.GetWeakPtr(), dismiss));
+  if (dismiss) {
+    // Keep showing the accepted text: OpenMatch() reverts the omnibox to the
+    // current (or new) page's URL right away, before the bar starts closing.
+    FreezeLocationBar();
+  }
+
+  // In new-tab mode, plain accepts open a new foreground tab. Alt+Enter and
+  // Shift+Enter already ask for a new tab/window, and switch-to-tab matches
+  // switch. An untouched NTP is reused rather than left behind.
+  if (mode_ == Mode::kNewTab &&
+      disposition == WindowOpenDisposition::CURRENT_TAB &&
+      !IsUntouchedNewTabPage(browser_view_->GetActiveWebContents())) {
+    return WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+  return disposition;
+}
