+  LayoutLocationBar();
+}
+
+void CommandBarView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const ui::ColorProvider* const color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  const SkColor text_color = color_provider->GetColor(kColorOmniboxText);
+
+  // The keyword tint only covers the input section; the results (painted by
+  // the transparent popup frame above the card) stay on the base surface.
+  if (input_surface_color_ != base_surface_color_) {
+    const float radius = kCardCornerRadius;
+    const bool has_results = height() > kInputSectionHeight;
+    const float bottom_radius = has_results ? 0.0f : radius;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(input_surface_color_);
+    const gfx::Rect input_section(0, 0, width(),
+                                  std::min(height(), kInputSectionHeight));
+    canvas->DrawPath(
+        SkPath::RRect(gfx::RoundedRectToSkRRect(
+            input_section, gfx::RoundedCornersF(radius, radius, bottom_radius,
+                                                bottom_radius))),
+        flags);
+  }
+
+  // Thin divider under the input row while results are shown. The popup frame
+  // above the card is transparent, so the card paints it.
+  if (height() > kInputSectionHeight + 1) {
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    const float dsf = canvas->UndoDeviceScaleFactor();
+    gfx::RectF divider(kDividerHorizontalInset, kInputSectionHeight - 1,
+                       width() - 2 * kDividerHorizontalInset, 1);
+    divider.Scale(dsf);
+    divider.set_height(1);
+    canvas->FillRect(gfx::ToEnclosingRect(divider),
+                     SkColorSetA(text_color, 0x1A));
+  }
+
+  PaintHairlineOutline(canvas, GetLocalBounds(), kCardCornerRadius,
+                       SkColorSetA(text_color, 0x1A));
+}
