+// Stands in for CodeTextEditor: forwards the CodeEdit's gui_input to the core first and accepts
+// consumed events, and records host commands.
+class HelixTestHost : public Object {
+public:
+	HelixMode *hm = nullptr;
+	CodeEdit *ce = nullptr;
+	Vector<Pair<int, Dictionary>> commands;
+
+	void on_gui_input(const Ref<InputEvent> &p_event) {
+		if (hm->handle_gui_input(p_event)) {
+			ce->accept_event();
+		}
+	}
+	void on_host_command(int p_cmd, const Dictionary &p_args) {
+		commands.push_back(Pair<int, Dictionary>(p_cmd, p_args));
+	}
+};
+
+struct Fixture {
+	CodeEdit *ce = nullptr;
+	HelixMode *hm = nullptr;
+	HelixTestHost *host = nullptr;
+
+	Fixture(const String &p_annotated, bool p_system_clipboard = false) {
+		ce = make_code_edit();
+		ce->set_text("\n");
+		ce->clear_undo_history();
+		HelixModeTestAccess::reset_shared();
+		hm = memnew(HelixMode);
+		host = memnew(HelixTestHost);
+		host->hm = hm;
+		host->ce = ce;
+		ce->connect(SceneStringName(gui_input), callable_mp(host, &HelixTestHost::on_gui_input));
+		hm->connect("host_command", callable_mp(host, &HelixTestHost::on_host_command));
+		hm->attach(ce);
+		hm->set_use_system_clipboard(p_system_clipboard);
+		hm->set_enabled(true);
+		hm->set_state_annotated(p_annotated);
+	}
+	~Fixture() {
+		hm->set_enabled(false);
+		hm->attach(nullptr);
+		memdelete(hm);
+		memdelete(host);
+		memdelete(ce);
+	}
+	String state() const { return hm->get_state_annotated(); }
+};
