+static Ref<InputEventKey> key(Key p_keycode, char32_t p_unicode, bool p_ctrl = false, bool p_alt = false, bool p_shift = false) {
+	Ref<InputEventKey> k;
+	k.instantiate();
+	k->set_keycode(p_keycode);
+	k->set_physical_keycode(p_keycode);
+	k->set_unicode(p_unicode);
+	k->set_ctrl_pressed(p_ctrl);
+	k->set_alt_pressed(p_alt);
+	k->set_shift_pressed(p_shift);
+	k->set_pressed(true);
+	return k;
+}
+
+// Sends a key through the display server, viewport and CodeEdit::gui_input like a real key press.
+static void send(const Ref<InputEventKey> &p_key) {
+	_SEND_DISPLAYSERVER_EVENT(p_key);
+	MessageQueue::get_singleton()->flush();
+}
