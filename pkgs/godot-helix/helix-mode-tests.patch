+// Workflow corpus: chained key sequences recorded from Helix after EVERY key (oracle/wf_gen.js).
+// Every recorded step is compared (text + selections + mode + default register; an absent "reg"
+// means the register is empty). Steps where Helix was still mid-command ("pending") are not
+// compared. After the first mismatching step the rest of the workflow is not compared (its state
+// has diverged). p_events: keys arrive as real key events through the display server and the
+// CodeEdit's gui_input (like in the editor) instead of feed_keys().
+static void run_workflow_corpus(bool p_events) {
+	Ref<FileAccess> f = FileAccess::open(TestUtils::get_data_path("helix/workflow_cases.jsonl"), FileAccess::READ);
+	REQUIRE(f.is_valid());
+	Vector<String> lines = f->get_as_utf8_string().split("\n", false);
+	REQUIRE(lines.size() > 100);
+
+	// <workflow id or glob>[#<step>]<TAB><reason>: that step (or the whole workflow) and the rest of it.
+	Vector<Pair<String, String>> skips;
+	Ref<FileAccess> sf = FileAccess::open(TestUtils::get_data_path("helix/workflow_skips.txt"), FileAccess::READ);
+	if (sf.is_valid()) {
+		Vector<String> sl = sf->get_as_utf8_string().split("\n", false);
+		for (int i = 0; i < sl.size(); i++) {
+			String l = sl[i].strip_edges();
+			if (l.is_empty() || l.begins_with("#")) {
+				continue;
+			}
+			int tab = l.find("\t");
+			String pat = tab >= 0 ? l.substr(0, tab).strip_edges() : l;
+			String reason = tab >= 0 ? l.substr(tab + 1).strip_edges() : String();
+			skips.push_back(Pair<String, String>(pat, reason));
+		}
+	}
+	// HELIX_WF=<glob> runs only matching workflow ids and prints every mismatch in full.
+	String filter = OS::get_singleton()->get_environment("HELIX_WF");
+	bool verbose = !filter.is_empty() || !OS::get_singleton()->get_environment("HELIX_VERBOSE").is_empty();
+	if (!OS::get_singleton()->get_environment("HELIX_NOSKIP").is_empty()) {
+		skips.clear();
+	}
+
+	CodeEdit *ce = make_code_edit();
+	HelixTestHost *host = memnew(HelixTestHost);
+	host->ce = ce;
+	if (p_events) {
+		ce->connect(SceneStringName(gui_input), callable_mp(host, &HelixTestHost::on_gui_input));
+	}
+	HashMap<String, AreaStats> stats;
+	Vector<String> groups;
+	int total_fail = 0;
+	int workflows = 0;
+	int not_reached = 0;
+	int status_mismatch = 0;
+	int printed = 0;
+	const char *pass_name = p_events ? "events" : "feed";
+
+	for (int li = 0; li < lines.size(); li++) {
+		Dictionary w = JSON::parse_string(lines[li]);
+		String id = w["id"];
+		if (!filter.is_empty() && !id.match(filter)) {
+			continue;
+		}
+		workflows++;
+		String group = id.get_slicec('/', 1);
+		if (!stats.has(group)) {
+			stats[group] = AreaStats();
+			groups.push_back(group);
+		}
+		AreaStats &st = stats[group];
+		Array steps = w["steps"];
+		Vector<String> keys = HelixModeTestAccess::parse_keys(w["keys"]);
+		Dictionary last_step = steps[steps.size() - 1];
+		if ((int)last_step["k"] != keys.size()) {
+			st.fail++;
+			total_fail++;
+			print_line(vformat("FAIL[%s] %s: key tokens differ from the recording (%d vs %d)", pass_name, id, keys.size(), (int)last_step["k"]));
+			continue;
+		}
+
+		ce->set_text("\n");
+		ce->clear_undo_history();
+		// Like Helix's fresh scratch buffer: cursor at 0 (seen when undoing past the setup).
+		ce->set_caret_line(0);
+		ce->set_caret_column(0);
+		ce->set_size(Size2());
+		HelixModeTestAccess::reset_shared();
+		// "keymap": "clipboard": the user's y = :clipboard-yank, p = :clipboard-paste-before
+		// (recorded with an in-memory clipboard, which starts empty).
+		const bool clipboard_keymap = String(w.get("keymap", String())) == "clipboard";
+		DisplayServer::get_singleton()->clipboard_set(String());
+		HelixMode *hm = memnew(HelixMode);
+		host->hm = hm;
+		hm->attach(ce);
+		hm->set_use_system_clipboard(clipboard_keymap);
+		hm->set_enabled(true);
+		hm->set_state_annotated(w["in"]);
+		MessageQueue::get_singleton()->flush();
+
+		bool diverged = false;
+		bool skipped = false;
+		String prev_out = w["in"];
+		int si = 0;
+		for (int k = 1; k <= keys.size(); k++) {
+			const String &key = keys[k - 1];
+			Ref<InputEventKey> ev = p_events ? HelixModeTestAccess::event_from_key(hm, key) : Ref<InputEventKey>();
+			if (ev.is_valid()) {
+				send(ev);
+			} else {
+				hm->feed_keys(key == "<" ? String("<lt>") : (key == ">" ? String("<gt>") : key));
+				MessageQueue::get_singleton()->flush();
+			}
+			Dictionary s;
+			while (si < steps.size()) {
+				Dictionary c = steps[si];
+				if ((int)c["k"] == k) {
+					s = c;
+					si++;
+					break;
+				}
+				if ((int)c["k"] > k) {
+					break;
+				}
+				si++;
+			}
+			if (s.is_empty() || s.has("pending")) {
+				continue;
+			}
+			if (diverged) {
+				if (skipped) {
+					st.skip++;
+				} else {
+					not_reached++;
+				}
+				continue;
+			}
+			String out = hm->get_state_annotated();
+			String mode = mode_name(hm->get_mode());
+			String exp_out = s["out"];
+			String exp_mode = s["mode"];
+			String reg_actual = reg_string(HelixModeTestAccess::default_register(hm));
+			String reg_expected = s.has("reg") ? JSON::stringify(s["reg"]) : String("[]");
+			bool ok = out == exp_out && mode == exp_mode && reg_actual == reg_expected;
+			if (s.has("clip")) {
+				String clip_actual = reg_string(HelixModeTestAccess::clipboard_register(hm));
+				String clip_expected = JSON::stringify(s["clip"]);
+				if (clip_actual != clip_expected) {
+					ok = false;
+					reg_expected += " clip=" + clip_expected;
+					reg_actual += " clip=" + clip_actual;
+				}
+			}
+			if (s.has("status") && String(s["status"]) != hm->get_status_message()) {
+				status_mismatch++;
+				if (verbose) {
+					print_line(vformat("STATUS[%s] %s#%d %s: expected %s, got %s", pass_name, id, k, JSON::stringify(s["keys"]), JSON::stringify(s["status"]), JSON::stringify(hm->get_status_message())));
+				}
+			}
+			if (ok) {
+				st.pass++;
+				prev_out = exp_out;
+				continue;
+			}
+			diverged = true;
+			String step_id = vformat("%s#%d", id, k);
+			for (int sk = 0; sk < skips.size(); sk++) {
+				const String &pat = skips[sk].first;
+				if (pat == id || pat == step_id || step_id.match(pat) || id.match(pat)) {
+					skipped = true;
+					break;
+				}
+			}
+			if (skipped) {
+				st.skip++;
+				if (verbose) {
+					print_line(vformat("SKIP[%s] %s %s", pass_name, step_id, JSON::stringify(s["keys"])));
+				}
+				continue;
+			}
+			st.fail++;
+			total_fail++;
+			if (verbose || printed < 60) {
+				printed++;
+				print_line(vformat("FAIL[%s] %s keys=%s (step %d of %s)\n   in : %s\n   prev: %s\n   exp: %s [%s] reg=%s\n   got: %s [%s] reg=%s", pass_name, step_id, JSON::stringify(s["keys"]), k, JSON::stringify(w["keys"]), JSON::stringify(w["in"]), JSON::stringify(prev_out), JSON::stringify(exp_out), exp_mode, reg_expected, JSON::stringify(out), mode, reg_actual));
+			}
+		}
+		if (!diverged) {
+			for (int sk = 0; sk < skips.size(); sk++) {
+				const String &pat = skips[sk].first;
+				String wid = pat.get_slicec('#', 0);
+				if (wid == id || id.match(wid)) {
+					st.skipped_but_passing++;
+					if (verbose) {
+						print_line(vformat("SKIPPED BUT PASSING[%s] %s", pass_name, pat));
+					}
+					break;
+				}
+			}
+		}
+		hm->set_enabled(false);
+		hm->attach(nullptr);
+		memdelete(hm);
+		host->hm = nullptr;
+	}
+
+	int tp = 0, ts = 0, tf = 0;
+	String summary = vformat("Helix workflows (%s, %d workflows): steps pass/skip/fail per group\n", pass_name, workflows);
+	for (int i = 0; i < groups.size(); i++) {
+		const AreaStats &st = stats[groups[i]];
+		summary += vformat("  %-10s %4d %4d %4d%s\n", groups[i], st.pass, st.skip, st.fail, st.skipped_but_passing ? vformat("  (%d skipped workflows pass)", st.skipped_but_passing) : String());
+		tp += st.pass;
+		ts += st.skip;
+		tf += st.fail;
+	}
+	summary += vformat("  %-10s %4d %4d %4d  (steps after a failure, not compared: %d; status mismatches: %d)", "total", tp, ts, tf, not_reached, status_mismatch);
+	print_line(summary);
+
+	if (p_events) {
+		ce->disconnect(SceneStringName(gui_input), callable_mp(host, &HelixTestHost::on_gui_input));
+	}
+	memdelete(host);
+	memdelete(ce);
+	CHECK_MESSAGE(total_fail == 0, "Workflow steps failing; run with HELIX_WF=<glob> for details.");
+}
+
+TEST_CASE("[SceneTree][HelixMode] Workflow corpus recorded from Helix 25.07.1 after every key (feed_keys)") {
+	run_workflow_corpus(false);
+}
