+// The user's remaps y = ":clipboard-yank", p = ":clipboard-paste-before" (normal and select mode),
+// against Helix 25.07.1's source: typed.rs yank_main_selection_to_clipboard ->
+// yank_primary_selection_impl(editor, '+'), paste_clipboard_before -> paste(editor, '+',
+// Paste::Before, 1) -> paste_impl; register.rs read_from_clipboard / contents_are_saved. Typed
+// commands run with PromptEvent::Validate and never call exit_select_mode. The workflow corpus
+// records these with an in-memory clipboard ("keymap": "clipboard"); the cases below need a real
+// clipboard (changed by another program, empty).
+TEST_CASE("[SceneTree][HelixMode] Clipboard remaps match :clipboard-yank / :clipboard-paste-before") {
+	DisplayServer *ds = DisplayServer::get_singleton();
+	SUBCASE("y: the primary selection only, as one value; selections, mode and \" untouched") {
+		Fixture f("#(foo|)# #[|bar]#\n", true);
+		ds->clipboard_set("old");
+		f.hm->feed_keys("y");
+		CHECK(ds->clipboard_get() == "bar");
+		CHECK(HelixModeTestAccess::clipboard_register(f.hm) == Vector<String>{ "bar" });
+		CHECK(HelixModeTestAccess::default_register(f.hm).is_empty());
+		CHECK(f.state() == "#(foo|)# #[|bar]#\n");
+		CHECK(f.hm->get_mode() == HelixMode::MODE_NORMAL);
+		CHECK(f.hm->get_status_message() == "yanked primary selection to register +");
+	}
+	SUBCASE("y in select mode stays in select mode; a count is ignored") {
+		Fixture f("#[f|]#oo bar\n", true);
+		f.hm->feed_keys("vl3y");
+		CHECK(ds->clipboard_get() == "fo");
+		CHECK(f.hm->get_mode() == HelixMode::MODE_SELECT);
+		f.hm->feed_keys("l");
+		CHECK(f.state() == "#[foo|]# bar\n"); // Still extending, and the 3 did not reach l.
+	}
+	SUBCASE("p: before every selection, the one value for each; selections become the pasted text, direction kept") {
+		Fixture f("#[foo|]# #(|bar)#\n", true);
+		ds->clipboard_set("X"); // Copied elsewhere: no saved values.
+		f.hm->feed_keys("p");
+		CHECK(f.state() == "#[X|]#foo #(|X)#bar\n");
+		CHECK(f.hm->get_mode() == HelixMode::MODE_NORMAL);
+		CHECK(f.hm->get_status_message().is_empty());
+		CHECK(HelixModeTestAccess::default_register(f.hm).is_empty());
+	}
+	SUBCASE("p ignores a count, which is consumed") {
+		Fixture f("ab #[c|]#d\n", true);
+		ds->clipboard_set("X");
+		f.hm->feed_keys("3p");
+		CHECK(f.state() == "ab #[X|]#cd\n");
+		f.hm->feed_keys("l");
+		CHECK(f.state() == "ab X#[c|]#d\n");
+	}
+	SUBCASE("p linewise: a value ending in a newline goes to the start of the first selected line") {
+		Fixture f("ab #[c|]#d\nef\n", true);
+		ds->clipboard_set("line\n");
+		f.hm->feed_keys("p");
+		CHECK(f.state() == "#[line\n|]#ab cd\nef\n");
+		Fixture g("ab\n#[cd\nef|]#\n", true);
+		ds->clipboard_set("L\n");
+		g.hm->feed_keys("p");
+		CHECK(g.state() == "ab\n#[L\n|]#cd\nef\n");
