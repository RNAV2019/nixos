+// [kind, from_line, from_column, to_line, to_column] spans as a compact string.
+static String spans_str(const Variant &p_spans) {
+	const PackedInt32Array a = p_spans;
+	const char *kinds[] = { "P", "s", "C", "c", "T" };
+	String out;
+	for (int i = 0; i + 4 < a.size(); i += 5) {
+		out += vformat("%s%d:%d-%d:%d ", kinds[a[i]], a[i + 1], a[i + 2], a[i + 3], a[i + 4]);
+	}
+	return out.strip_edges();
+}
