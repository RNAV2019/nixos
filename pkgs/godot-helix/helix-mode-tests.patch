+#include "tests/test_macros.h"
+
+TEST_FORCE_LINK(test_helix_mode)
+
+#ifdef TOOLS_ENABLED
+
+#include "core/io/file_access.h"
+#include "core/object/callable_mp.h"
+#include "core/object/message_queue.h"
+#include "core/io/json.h"
+#include "core/os/os.h"
+#include "editor/gui/helix_mode.h"
+#include "scene/gui/code_edit.h"
+#include "scene/main/scene_tree.h"
+#include "scene/main/window.h"
+#include "tests/display_server_mock.h"
+#include "tests/signal_watcher.h"
+#include "tests/test_tools.h"
+#include "tests/test_utils.h"
+
+struct HelixModeTestAccess {
+	static Vector<String> default_register(const HelixMode *p_hm) { return HelixMode::shared.reg_default; }
+	static Ref<InputEventKey> event_from_key(const HelixMode *p_hm, const String &p_key) { return p_hm->_event_from_key(p_key); }
+	static Vector<String> parse_keys(const String &p_keys) { return HelixMode::_parse_keys(p_keys); }
+	// The '+' register as Helix's clipboard register reads it: the values last yanked to it while
+	// the clipboard still holds them, no value when nothing was ever put there.
+	static Vector<String> clipboard_register(const HelixMode *p_hm) {
+		if (HelixMode::shared.clipboard_values.is_empty() && DisplayServer::get_singleton()->clipboard_get().is_empty()) {
+			return Vector<String>();
+		}
+		return p_hm->_read_register("+");
+	}
+	// Registers, search pattern and last insert / motion are editor-wide: clear them between cases.
+	static void reset_shared() { HelixMode::shared = HelixMode::Shared(); }
+};
+
+namespace TestHelixMode {
+
+
+// Configured like the script editor: tabs, indent size 4, auto-indent and auto-brace on.
+static CodeEdit *make_code_edit() {
+	CodeEdit *ce = memnew(CodeEdit);
+	SceneTree::get_singleton()->get_root()->add_child(ce);
+	ce->set_indent_using_spaces(false);
+	ce->set_indent_size(4);
+	ce->set_tab_size(4);
+	ce->set_auto_indent_enabled(true);
+	ce->set_auto_brace_completion_enabled(true);
+	ce->set_deselect_on_focus_loss_enabled(false);
+	ce->grab_focus();
+	return ce;
+}
+
+static String mode_name(HelixMode::Mode p_mode) {
+	switch (p_mode) {
+		case HelixMode::MODE_INSERT:
+			return "insert";
+		case HelixMode::MODE_SELECT:
+			return "select";
+		default:
+			return "normal";
+	}
+}
+
+static String reg_string(const Vector<String> &p_values) {
+	Array a;
+	for (int i = 0; i < p_values.size(); i++) {
+		a.push_back(p_values[i]);
+	}
+	return JSON::stringify(a);
+}
+
+struct AreaStats {
+	int pass = 0;
+	int skip = 0;
+	int fail = 0;
+	int skipped_but_passing = 0;
+};
+
+TEST_CASE("[SceneTree][HelixMode] Oracle corpus recorded from Helix 25.07.1") {
+	Ref<FileAccess> f = FileAccess::open(TestUtils::get_data_path("helix/oracle_cases.jsonl"), FileAccess::READ);
+	REQUIRE(f.is_valid());
+	Vector<String> lines = f->get_as_utf8_string().split("\n", false);
+	REQUIRE(lines.size() > 1000);
+
+	Vector<Pair<String, String>> skips;
+	Ref<FileAccess> sf = FileAccess::open(TestUtils::get_data_path("helix/oracle_skips.txt"), FileAccess::READ);
+	if (sf.is_valid()) {
+		Vector<String> sl = sf->get_as_utf8_string().split("\n", false);
+		for (int i = 0; i < sl.size(); i++) {
+			String l = sl[i].strip_edges();
+			if (l.is_empty() || l.begins_with("#")) {
+				continue;
+			}
+			int tab = l.find("\t");
+			String pat = tab >= 0 ? l.substr(0, tab).strip_edges() : l;
+			String reason = tab >= 0 ? l.substr(tab + 1).strip_edges() : String();
+			skips.push_back(Pair<String, String>(pat, reason));
+		}
+	}
+
+	// HELIX_CASE=<glob> runs only matching ids and prints every mismatch in full.
+	String filter = OS::get_singleton()->get_environment("HELIX_CASE");
+	bool verbose = !filter.is_empty() || !OS::get_singleton()->get_environment("HELIX_VERBOSE").is_empty();
+	if (!OS::get_singleton()->get_environment("HELIX_NOSKIP").is_empty()) {
+		skips.clear();
+	}
+
+	CodeEdit *ce = make_code_edit();
+	HashMap<String, AreaStats> stats;
+	Vector<String> areas;
+	int total_fail = 0;
+	int status_mismatch = 0;
+	int printed = 0;
+
+	for (int li = 0; li < lines.size(); li++) {
+		Dictionary c = JSON::parse_string(lines[li]);
+		String id = c["id"];
+		if (!filter.is_empty() && !id.match(filter)) {
+			continue;
+		}
+		String area = id.get_slicec('/', 0);
+		if (!stats.has(area)) {
+			stats[area] = AreaStats();
+			areas.push_back(area);
+		}
+		bool skipped = false;
+		for (int s = 0; s < skips.size(); s++) {
+			if (id == skips[s].first || id.match(skips[s].first)) {
+				skipped = true;
+				break;
+			}
+		}
+
+		ce->set_text("\n");
+		ce->clear_undo_history();
+		bool view_case = Array(c["tags"]).has("view");
+		if (view_case) {
+			// Helix's test view shows 148 rows.
+			int lh = MAX(ce->get_line_height(), 1);
+			for (int h = 140 * lh; h < 160 * lh; h++) {
+				ce->set_size(Size2(4000, h));
+				if (ce->get_visible_line_count() >= 148) {
+					break;
+				}
+			}
+		} else {
+			ce->set_size(Size2());
+		}
+		HelixModeTestAccess::reset_shared();
+		HelixMode *hm = memnew(HelixMode);
+		hm->attach(ce);
+		hm->set_use_system_clipboard(false);
+		hm->set_enabled(true);
+		hm->set_state_annotated(c["in"]);
+		if (view_case) {
+			MessageQueue::get_singleton()->flush();
+			ce->notification(Control::NOTIFICATION_RESIZED);
+			ce->set_line_as_first_visible(0);
+		}
+		hm->feed_keys(c["keys"]);
+
+		String out = hm->get_state_annotated();
+		String mode = mode_name(hm->get_mode());
+		String exp_out = c["out"];
+		String exp_mode = c["mode"];
+		bool ok = out == exp_out && mode == exp_mode;
+		String reg_actual = reg_string(HelixModeTestAccess::default_register(hm));
+		String reg_expected = "[]";
+		if (c.has("reg")) {
+			reg_expected = JSON::stringify(c["reg"]);
+			ok = ok && reg_actual == reg_expected;
+		}
+		if (c.has("status") && String(c["status"]) != hm->get_status_message()) {
+			status_mismatch++;
+			if (verbose) {
+				print_line(vformat("STATUS %s: expected %s, got %s", id, JSON::stringify(c["status"]), JSON::stringify(hm->get_status_message())));
+			}
+		}
+		hm->set_enabled(false);
+		hm->attach(nullptr);
+		memdelete(hm);
+
+		AreaStats &st = stats[area];
+		if (skipped) {
+			st.skip++;
+			if (ok) {
+				st.skipped_but_passing++;
+				if (verbose) {
+					print_line("SKIPPED BUT PASSING " + id);
+				}
+			}
+			continue;
+		}
+		if (ok) {
+			st.pass++;
+			continue;
+		}
+		st.fail++;
+		total_fail++;
+		if (verbose || printed < 40) {
+			printed++;
+			print_line(vformat("FAIL %s keys=%s\n   in : %s\n   exp: %s [%s] reg=%s\n   got: %s [%s] reg=%s", id, JSON::stringify(c["keys"]), JSON::stringify(c["in"]), JSON::stringify(exp_out), exp_mode, reg_expected, JSON::stringify(out), mode, reg_actual));
+		}
+	}
+
+	int tp = 0, ts = 0, tf = 0;
+	String summary = "Helix oracle: area pass/skip/fail\n";
+	for (int i = 0; i < areas.size(); i++) {
+		const AreaStats &st = stats[areas[i]];
+		summary += vformat("  %-10s %4d %4d %4d%s\n", areas[i], st.pass, st.skip, st.fail, st.skipped_but_passing ? vformat("  (%d skipped cases pass)", st.skipped_but_passing) : String());
+		tp += st.pass;
+		ts += st.skip;
+		tf += st.fail;
+	}
+	summary += vformat("  %-10s %4d %4d %4d  (status mismatches: %d)", "total", tp, ts, tf, status_mismatch);
+	print_line(summary);
+
+	memdelete(ce);
+	CHECK_MESSAGE(total_fail == 0, "Oracle cases failing; run with HELIX_CASE=<glob> for details.");
+}
