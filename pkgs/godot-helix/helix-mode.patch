+/* HelixRange (helix_core::selection::Range) */
+
+HelixRange HelixRange::merge(const HelixRange &p_other) const {
+	if (anchor > head && p_other.anchor > p_other.head) {
+		return HelixRange(MAX(anchor, p_other.anchor), MIN(head, p_other.head));
+	}
+	return HelixRange(MIN(from(), p_other.from()), MAX(to(), p_other.to()));
+}
+
+HelixRange HelixRange::extend(int64_t p_from, int64_t p_to) const {
+	if (anchor <= head) {
+		return HelixRange(MIN(anchor, p_from), MAX(head, p_to));
+	}
+	return HelixRange(MAX(anchor, p_to), MIN(head, p_from));
+}
+
+/* HelixSelection */
+
+HelixSelection HelixSelection::single(int64_t p_anchor, int64_t p_head) {
+	HelixSelection s;
+	s.ranges.write[0] = HelixRange(p_anchor, p_head);
+	s.primary = 0;
+	return s;
+}
+
+HelixSelection HelixSelection::from_ranges(const Vector<HelixRange> &p_ranges, int p_primary) {
+	HelixSelection s;
+	if (p_ranges.is_empty()) {
+		return s;
+	}
+	s.ranges = p_ranges;
+	s.primary = CLAMP(p_primary, 0, p_ranges.size() - 1);
+	s.normalize();
+	return s;
+}
+
+struct _HelixRangeFromCompare {
+	bool operator()(const HelixRange &p_a, const HelixRange &p_b) const { return p_a.from() < p_b.from(); }
+};
+
+void HelixSelection::normalize() {
+	if (ranges.size() < 2) {
+		primary = 0;
+		return;
+	}
+	HelixRange prim = ranges[primary];
+	ranges.sort_custom<_HelixRangeFromCompare>();
+	Vector<HelixRange> out;
+	out.push_back(ranges[0]);
+	for (int i = 1; i < ranges.size(); i++) {
+		HelixRange &prev = out.write[out.size() - 1];
+		const HelixRange &curr = ranges[i];
+		if (prev.overlaps(curr)) {
+			HelixRange merged = curr.merge(prev);
+			if (prev == prim || curr == prim) {
+				prim = merged;
+			}
+			prev = merged;
+		} else {
+			out.push_back(curr);
+		}
+	}
+	ranges = out;
+	primary = 0;
+	for (int i = 0; i < ranges.size(); i++) {
+		if (ranges[i] == prim) {
+			primary = i;
+			break;
+		}
+	}
+}
+
+void HelixSelection::merge_consecutive() {
+	HelixRange prim = ranges[primary];
+	Vector<HelixRange> out;
+	out.push_back(ranges[0]);
+	for (int i = 1; i < ranges.size(); i++) {
+		HelixRange &prev = out.write[out.size() - 1];
+		const HelixRange &curr = ranges[i];
+		if (prev.to() == curr.from()) {
+			HelixRange merged = curr.merge(prev);
+			if (prev == prim || curr == prim) {
+				prim = merged;
+			}
+			prev = merged;
+		} else {
+			out.push_back(curr);
+		}
+	}
+	ranges = out;
+	primary = 0;
+	for (int i = 0; i < ranges.size(); i++) {
+		if (ranges[i] == prim) {
+			primary = i;
+			break;
+		}
+	}
+}
+
+HelixSelection HelixSelection::merged_all() const {
+	HelixRange first = ranges[0];
+	HelixRange last = ranges[ranges.size() - 1];
+	HelixRange m = first.merge(last);
+	return single(m.anchor, m.head);
+}
+
+void HelixSelection::push(const HelixRange &p_range) {
+	ranges.push_back(p_range);
+	primary = ranges.size() - 1;
+	normalize();
+}
+
+void HelixSelection::remove(int p_index) {
+	ERR_FAIL_COND(ranges.size() <= 1);
+	ranges.remove_at(p_index);
+	if (p_index < primary || primary == ranges.size()) {
+		primary -= 1;
+	}
+}
+
+bool HelixSelection::operator==(const HelixSelection &p_other) const {
+	if (primary != p_other.primary || ranges.size() != p_other.ranges.size()) {
+		return false;
+	}
+	for (int i = 0; i < ranges.size(); i++) {
+		if (ranges[i].anchor != p_other.ranges[i].anchor || ranges[i].head != p_other.ranges[i].head) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* HelixDoc */
+
+void HelixDoc::_update() const {
+	if (!dirty) {
+		return;
+	}
+	dirty = false;
+	int lc = te ? te->get_line_count() : 1;
+	starts.resize(lc + 1);
+	int64_t s = 0;
+	for (int i = 0; i < lc; i++) {
+		starts[i] = s;
+		s += (te ? te->get_line(i).length() : 0) + (i < lc - 1 ? 1 : 0);
+	}
+	starts[lc] = s;
+}
+
+int64_t HelixDoc::len() const {
+	_update();
+	return starts[starts.size() - 1];
+}
+
+int HelixDoc::line_count() const {
+	_update();
+	return starts.size() - 1;
+}
+
+int64_t HelixDoc::line_to_char(int p_line) const {
+	_update();
+	p_line = CLAMP(p_line, 0, (int)starts.size() - 1);
+	return starts[p_line];
+}
+
+int HelixDoc::char_to_line(int64_t p_pos) const {
+	_update();
+	int lc = starts.size() - 1;
+	if (p_pos <= 0) {
+		return 0;
+	}
+	if (p_pos >= starts[lc]) {
+		return lc - 1;
+	}
+	int lo = 0;
+	int hi = lc - 1;
+	while (lo < hi) {
+		int mid = (lo + hi + 1) / 2;
+		if (starts[mid] <= p_pos) {
+			lo = mid;
+		} else {
+			hi = mid - 1;
+		}
+	}
+	return lo;
+}
+
+const String &HelixDoc::line(int p_line) const {
+	if (cache_line != p_line) {
+		cache_line = p_line;
+		cache_text = (te && p_line >= 0 && p_line < te->get_line_count()) ? te->get_line(p_line) : String();
+	}
+	return cache_text;
+}
+
+int HelixDoc::line_length(int p_line) const {
+	_update();
+	if (p_line < 0 || p_line >= (int)starts.size() - 1) {
+		return 0;
+	}
+	int64_t l = starts[p_line + 1] - starts[p_line];
+	if (p_line < (int)starts.size() - 2) {
+		l -= 1;
+	}
+	return (int)l;
+}
+
+int64_t HelixDoc::line_end(int p_line) const {
+	return line_to_char(p_line) + line_length(p_line);
+}
+
+char32_t HelixDoc::char_at(int64_t p_pos) const {
+	if (p_pos < 0 || p_pos >= len()) {
+		return 0;
+	}
+	int l = char_to_line(p_pos);
+	int col = (int)(p_pos - starts[l]);
+	const String &t = line(l);
+	if (col < t.length()) {
+		return t[col];
+	}
+	return '\n';
+}
+
+String HelixDoc::slice(int64_t p_from, int64_t p_to) const {
+	p_from = CLAMP(p_from, (int64_t)0, len());
+	p_to = CLAMP(p_to, p_from, len());
+	if (p_from == p_to) {
+		return String();
+	}
+	int l0 = char_to_line(p_from);
+	int l1 = char_to_line(p_to);
+	int c0 = (int)(p_from - line_to_char(l0));
+	int c1 = (int)(p_to - line_to_char(l1));
+	if (l0 == l1) {
+		String t = line(l0);
+		if (c1 > t.length()) {
+			return t.substr(c0) + "\n";
+		}
+		return t.substr(c0, c1 - c0);
+	}
+	String r = line(l0).substr(c0) + "\n";
+	for (int l = l0 + 1; l < l1; l++) {
+		r += line(l) + "\n";
+	}
+	String last = line(l1);
+	if (c1 > last.length()) {
+		r += last + "\n";
+	} else {
+		r += last.substr(0, c1);
+	}
+	return r;
+}
+
+void HelixDoc::pos_to_line_col(int64_t p_pos, int &r_line, int &r_col) const {
+	p_pos = CLAMP(p_pos, (int64_t)0, len());
+	r_line = char_to_line(p_pos);
+	r_col = (int)(p_pos - line_to_char(r_line));
+	r_col = MIN(r_col, line_length(r_line));
+}
+
+int64_t HelixDoc::line_col_to_pos(int p_line, int p_col) const {
+	p_line = CLAMP(p_line, 0, line_count() - 1);
+	p_col = CLAMP(p_col, 0, line_length(p_line));
+	return line_to_char(p_line) + p_col;
+}
+
+int64_t HelixDoc::first_non_whitespace(int p_line) const {
+	const String &t = line(p_line);
+	for (int i = 0; i < t.length(); i++) {
+		if (!HelixAlgo::is_whitespace(t[i])) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+void HelixDoc::_graphemes(int p_line) const {
+	if (g_line == p_line) {
+		return;
+	}
+	g_line = p_line;
+	g_breaks.clear();
+	const String &t = line(p_line);
+	g_simple = true;
+	for (int i = 0; i < t.length(); i++) {
+		if (t[i] >= 0x300) {
+			g_simple = false;
+			break;
+		}
+	}
+	if (g_simple) {
+		return;
+	}
+	g_breaks.push_back(0);
+	TextServer *ts = TextServerManager::get_singleton() ? TextServerManager::get_singleton()->get_primary_interface().ptr() : nullptr;
+	if (ts) {
+		PackedInt32Array br = ts->string_get_character_breaks(t);
+		for (int i = 0; i < br.size(); i++) {
+			if (br[i] > (int)g_breaks[g_breaks.size() - 1] && br[i] <= t.length()) {
+				g_breaks.push_back(br[i]);
+			}
+		}
+	}
+	if ((int)g_breaks[g_breaks.size() - 1] != t.length()) {
+		// No usable segmentation: fall back to one grapheme per character.
+		g_simple = true;
+		g_breaks.clear();
+	}
+}
+
+int64_t HelixDoc::next_grapheme(int64_t p_pos, int p_n) const {
+	int64_t l = len();
+	for (int i = 0; i < p_n; i++) {
+		if (p_pos >= l) {
+			return l;
+		}
+		if (p_pos < 0) {
+			p_pos = 0;
+		}
+		int ln = char_to_line(p_pos);
+		int col = (int)(p_pos - line_to_char(ln));
+		int ll = line_length(ln);
+		if (col >= ll) {
+			p_pos += 1;
+			continue;
+		}
+		_graphemes(ln);
+		if (g_simple) {
+			p_pos += 1;
+			continue;
+		}
+		int64_t start = line_to_char(ln);
+		for (uint32_t k = 0; k < g_breaks.size(); k++) {
+			if (g_breaks[k] > col) {
+				p_pos = start + g_breaks[k];
+				break;
+			}
+		}
+	}
+	return p_pos;
+}
+
+int64_t HelixDoc::prev_grapheme(int64_t p_pos, int p_n) const {
+	for (int i = 0; i < p_n; i++) {
+		if (p_pos <= 0) {
+			return 0;
+		}
+		p_pos = MIN(p_pos, len());
+		int ln = char_to_line(p_pos);
+		int64_t start = line_to_char(ln);
+		int col = (int)(p_pos - start);
+		if (col == 0) {
+			p_pos -= 1;
+			continue;
+		}
+		int ll = line_length(ln);
+		if (col > ll) {
+			p_pos -= 1;
+			continue;
+		}
+		_graphemes(ln);
+		if (g_simple) {
+			p_pos -= 1;
+			continue;
+		}
+		for (int k = (int)g_breaks.size() - 1; k >= 0; k--) {
+			if (g_breaks[k] < col) {
+				p_pos = start + g_breaks[k];
+				break;
+			}
+		}
+	}
+	return p_pos;
+}
+
+bool HelixDoc::is_grapheme_boundary(int64_t p_pos) const {
+	if (p_pos <= 0 || p_pos >= len()) {
+		return true;
+	}
+	int ln = char_to_line(p_pos);
+	int col = (int)(p_pos - line_to_char(ln));
+	if (col == 0 || col >= line_length(ln)) {
+		return true;
+	}
+	_graphemes(ln);
+	if (g_simple) {
+		return true;
+	}
+	for (uint32_t k = 0; k < g_breaks.size(); k++) {
+		if (g_breaks[k] == col) {
+			return true;
+		}
+	}
+	return false;
+}
+
+int64_t HelixDoc::ensure_grapheme_next(int64_t p_pos) const {
+	return is_grapheme_boundary(p_pos) ? p_pos : next_grapheme(p_pos);
+}
+
+int64_t HelixDoc::ensure_grapheme_prev(int64_t p_pos) const {
+	return is_grapheme_boundary(p_pos) ? p_pos : prev_grapheme(p_pos);
+}
+
+int HelixDoc::grapheme_width_at(int64_t p_pos, int64_t p_end, int p_visual_x, int p_tab_width) const {
+	char32_t c = char_at(p_pos);
+	if (c == '\t') {
+		return p_tab_width - (p_visual_x % p_tab_width);
+	}
+	if (c <= 127) {
+		return 1;
+	}
+	int w = 0;
+	for (int64_t i = p_pos; i < p_end; i++) {
+		w += HelixAlgo::char_width(char_at(i));
+	}
+	return MAX(w, 1);
+}
+
+/* HelixChangeSet */
+
+void HelixChangeSet::retain(int64_t p_n) {
+	if (p_n <= 0) {
+		return;
+	}
+	len += p_n;
+	len_after += p_n;
+	if (!ops.is_empty() && ops[ops.size() - 1].type == OP_RETAIN) {
+		ops[ops.size() - 1].n += p_n;
+	} else {
+		Op op;
+		op.type = OP_RETAIN;
+		op.n = p_n;
+		ops.push_back(op);
+	}
+}
+
+void HelixChangeSet::del(int64_t p_n) {
+	if (p_n <= 0) {
+		return;
+	}
+	len += p_n;
+	if (!ops.is_empty() && ops[ops.size() - 1].type == OP_DELETE) {
+		ops[ops.size() - 1].n += p_n;
+	} else {
+		Op op;
+		op.type = OP_DELETE;
+		op.n = p_n;
+		ops.push_back(op);
+	}
+}
+
+void HelixChangeSet::insert(const String &p_s) {
+	if (p_s.is_empty()) {
+		return;
+	}
+	len_after += p_s.length();
+	int n = ops.size();
+	if (n >= 1 && ops[n - 1].type == OP_INSERT) {
+		ops[n - 1].s += p_s;
+	} else if (n >= 2 && ops[n - 1].type == OP_DELETE && ops[n - 2].type == OP_INSERT) {
+		ops[n - 2].s += p_s;
+	} else if (n >= 1 && ops[n - 1].type == OP_DELETE) {
+		Op d = ops[n - 1];
+		ops[n - 1].type = OP_INSERT;
+		ops[n - 1].n = 0;
+		ops[n - 1].s = p_s;
+		ops.push_back(d);
+	} else {
+		Op op;
+		op.type = OP_INSERT;
+		op.s = p_s;
+		ops.push_back(op);
+	}
+}
+
+bool HelixChangeSet::is_empty() const {
+	for (uint32_t i = 0; i < ops.size(); i++) {
+		if (ops[i].type != OP_RETAIN) {
+			return false;
+		}
+	}
+	return true;
+}
+
+HelixChangeSet HelixChangeSet::from_changes(int64_t p_doc_len, const Vector<HelixChange> &p_changes) {
+	HelixChangeSet cs;
+	int64_t last = 0;
+	for (int i = 0; i < p_changes.size(); i++) {
+		const HelixChange &c = p_changes[i];
+		if (c.from < last || c.to < c.from || c.to > p_doc_len) {
+			continue;
+		}
+		cs.retain(c.from - last);
+		if (c.insert) {
+			cs.insert(c.text);
+		}
+		cs.del(c.to - c.from);
+		last = c.to;
+	}
+	cs.retain(p_doc_len - last);
+	return cs;
+}
+
+Vector<HelixChange> HelixChangeSet::to_changes() const {
+	Vector<HelixChange> out;
+	int64_t pos = 0;
+	for (uint32_t i = 0; i < ops.size(); i++) {
+		const Op &op = ops[i];
+		if (op.type == OP_RETAIN) {
+			pos += op.n;
+		} else if (op.type == OP_INSERT) {
+			if (i + 1 < ops.size() && ops[i + 1].type == OP_DELETE) {
+				out.push_back(HelixChange(pos, pos + ops[i + 1].n, op.s));
+				pos += ops[i + 1].n;
+				i++;
+			} else {
+				out.push_back(HelixChange(pos, pos, op.s));
+			}
+		} else {
+			out.push_back(HelixChange(pos, pos + op.n));
+			pos += op.n;
+		}
+	}
+	return out;
+}
+
+static int64_t _insert_offset(HelixChangeSet::Assoc p_assoc, const String &p_s) {
+	switch (p_assoc) {
+		case HelixChangeSet::ASSOC_AFTER:
+		case HelixChangeSet::ASSOC_AFTER_STICKY:
+			return p_s.length();
+		case HelixChangeSet::ASSOC_AFTER_WORD: {
+			int n = 0;
+			while (n < p_s.length() && HelixAlgo::is_word(p_s[n])) {
+				n++;
+			}
+			return n;
+		}
+		case HelixChangeSet::ASSOC_BEFORE_WORD: {
+			int n = 0;
+			while (n < p_s.length() && HelixAlgo::is_word(p_s[p_s.length() - 1 - n])) {
+				n++;
+			}
+			return p_s.length() - n;
+		}
+		default:
+			return 0;
+	}
+}
+
+int64_t HelixChangeSet::map_pos(int64_t p_pos, Assoc p_assoc) const {
+	int64_t old_pos = 0;
+	int64_t new_pos = 0;
+	bool sticky = p_assoc == ASSOC_BEFORE_STICKY || p_assoc == ASSOC_AFTER_STICKY;
+	bool stay_at_gaps = p_assoc != ASSOC_BEFORE_WORD && p_assoc != ASSOC_AFTER_WORD;
+	for (uint32_t i = 0; i < ops.size(); i++) {
+		const Op &op = ops[i];
+		if (op.type == OP_RETAIN) {
+			int64_t old_end = old_pos + op.n;
+			if (p_pos < old_end) {
+				return new_pos + (p_pos - old_pos);
+			}
+			new_pos += op.n;
+			old_pos = old_end;
+		} else if (op.type == OP_DELETE) {
+			int64_t old_end = old_pos + op.n;
+			if (p_pos < old_end) {
+				return new_pos;
+			}
+			old_pos = old_end;
+		} else {
+			if (i + 1 < ops.size() && ops[i + 1].type == OP_DELETE) {
+				int64_t dlen = ops[i + 1].n;
+				i++;
+				int64_t old_end = old_pos + dlen;
+				if (p_pos < old_end) {
+					if (p_pos == old_pos && stay_at_gaps) {
+						return new_pos;
+					}
+					int64_t ins = _insert_offset(p_assoc, op.s);
+					if (dlen == ins && sticky) {
+						return new_pos + (p_pos - old_pos);
+					}
+					return new_pos + ins;
+				}
+				new_pos += op.s.length();
+				old_pos = old_end;
+			} else {
+				if (p_pos == old_pos) {
+					return new_pos + _insert_offset(p_assoc, op.s);
+				}
+				new_pos += op.s.length();
+			}
+		}
+	}
+	return new_pos + (p_pos - old_pos);
+}
+
+HelixRange HelixChangeSet::map_range(const HelixRange &p_range) const {
+	HelixRange r = p_range;
+	r.old_col = -1;
+	if (p_range.anchor == p_range.head) {
+		r.anchor = map_pos(p_range.anchor, ASSOC_AFTER_STICKY);
