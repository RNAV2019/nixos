+template <typename F>
+HelixSelection _transform(const HelixSelection &p_sel, F p_f) {
+	HelixSelection s = p_sel;
+	for (int i = 0; i < s.ranges.size(); i++) {
+		s.ranges.write[i] = p_f(s.ranges[i]);
+	}
+	s.normalize();
+	return s;
+}
+
+bool _key_char(const String &p_key, char32_t &r_c) {
+	if (p_key.length() == 1) {
+		r_c = p_key[0];
+		return true;
+	}
+	if (p_key == "<space>") {
+		r_c = ' ';
+		return true;
+	}
+	return false;
+}
+
+const char32_t _auto_pairs[][2] = {
+	{ '(', ')' },
+	{ '{', '}' },
+	{ '[', ']' },
+	{ '\'', '\'' },
+	{ '"', '"' },
+	{ '`', '`' },
+};
+
+bool _is_auto_pair(char32_t p_open, char32_t p_close) {
+	for (int i = 0; i < 6; i++) {
+		if (_auto_pairs[i][0] == p_open && _auto_pairs[i][1] == p_close) {
+			return true;
+		}
+	}
+	return false;
+}
+
+struct _HelixChangeCompare {
+	bool operator()(const HelixChange &p_a, const HelixChange &p_b) const { return p_a.from < p_b.from || (p_a.from == p_b.from && p_a.to < p_b.to); }
+};
+
+struct _HelixPosCharCompare {
+	bool operator()(const Pair<int64_t, char32_t> &p_a, const Pair<int64_t, char32_t> &p_b) const { return p_a.first < p_b.first || (p_a.first == p_b.first && p_a.second < p_b.second); }
+};
+
+// Counts are accepted up to 1e8 (like Helix), but commands that repeat themselves or
+// produce text from the count are bounded, so "99999999p" cannot exhaust memory or hang.
+const int REPEAT_CAP = 10000; // Self-repeating commands (n, <A-.>, ., o, ]<space>, >).
+const int64_t TEXT_CAP = 4 * 1024 * 1024; // Characters a single paste / open may produce.
+
+int _cap_for_text(int p_count, int64_t p_unit_len) {
+	return (int)CLAMP((int64_t)p_count, (int64_t)1, MAX(TEXT_CAP / MAX(p_unit_len, (int64_t)1), (int64_t)1));
+}
+
+enum InsertDelete {
