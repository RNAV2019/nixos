+void TextEdit::_modal_line_spans(const Vector<ModalSpan> &p_spans, int p_line, LocalVector<ModalLineSpan> &r_spans) const {
+	// The spans are sorted and do not overlap: binary search the first one ending on or after
+	// this line, then take every one starting on or before it.
+	int lo = 0;
+	int hi = p_spans.size();
+	while (lo < hi) {
+		const int mid = (lo + hi) / 2;
+		if (p_spans[mid].to_line < p_line) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	const int len = text[p_line].length();
+	for (int i = lo; i < p_spans.size() && p_spans[i].from_line <= p_line; i++) {
+		const ModalSpan &s = p_spans[i];
+		ModalLineSpan ls;
+		ls.kind = s.kind;
+		ls.from = s.from_line < p_line ? 0 : s.from_column;
+		ls.to = s.to_line > p_line ? len + 1 : s.to_column; // Continues on the next line: includes the newline.
+		if (ls.to > ls.from) {
+			r_spans.push_back(ls);
+		}
+	}
+}
