+/* Annotated state */
+
+String HelixMode::get_state_annotated() const {
+	if (!text_edit) {
+		return String();
+	}
+	HelixSelection s = mode == MODE_INSERT ? _insert_selection() : sel;
+	String text = text_edit->get_text();
+	int64_t len = text.length();
+	String out;
+	int ri = 0; // Next range to open.
+	int open_idx = -1;
+	for (int64_t p = 0; p <= len; p++) {
+		if (open_idx >= 0 && s.ranges[open_idx].to() == p) {
+			const HelixRange &r = s.ranges[open_idx];
+			if (r.is_forward()) {
+				out += "|";
+			}
+			out += open_idx == s.primary ? "]#" : ")#";
+			open_idx = -1;
+		}
+		while (ri < s.ranges.size() && s.ranges[ri].from() == p) {
+			const HelixRange &r = s.ranges[ri];
+			bool prim = ri == s.primary;
+			out += prim ? "#[" : "#(";
+			if (r.is_empty()) {
+				out += "|";
+				out += prim ? "]#" : ")#";
+				ri++;
+				continue;
+			}
+			if (!r.is_forward()) {
+				out += "|";
+			}
+			open_idx = ri;
+			ri++;
+			break;
+		}
+		if (p < len) {
+			out += String::chr(text[p]);
+		}
+	}
+	return out;
+}
+
+void HelixMode::set_state_annotated(const String &p_annotated) {
+	if (!_alive()) {
+		return;
+	}
+	String text;
+	Vector<HelixRange> ranges;
+	int primary = 0;
+	int64_t start = -1;
+	bool head_at_start = false;
+	bool open_primary = false;
+	int i = 0;
+	while (i < p_annotated.length()) {
+		char32_t c = p_annotated[i];
+		if (c == '#' && i + 1 < p_annotated.length() && (p_annotated[i + 1] == '[' || p_annotated[i + 1] == '(') && start < 0) {
+			open_primary = p_annotated[i + 1] == '[';
+			start = text.length();
+			head_at_start = false;
+			i += 2;
+			if (i < p_annotated.length() && p_annotated[i] == '|') {
+				head_at_start = true;
+				i++;
+			}
+			continue;
+		}
+		if (start >= 0 && c == '|' && i + 2 < p_annotated.length() + 1 && i + 2 <= p_annotated.length() && (p_annotated.substr(i + 1, 2) == "]#" || p_annotated.substr(i + 1, 2) == ")#")) {
+			int64_t end = text.length();
+			ranges.push_back(head_at_start ? HelixRange(end, start) : HelixRange(start, end));
+			if (open_primary) {
+				primary = ranges.size() - 1;
+			}
+			start = -1;
+			i += 3;
+			continue;
+		}
+		if (start >= 0 && head_at_start && (p_annotated.substr(i, 2) == "]#" || p_annotated.substr(i, 2) == ")#")) {
+			int64_t end = text.length();
+			ranges.push_back(HelixRange(end, start));
+			if (open_primary) {
+				primary = ranges.size() - 1;
+			}
+			start = -1;
+			i += 2;
+			continue;
+		}
+		text += String::chr(c);
+		i++;
+	}
+
+	if (mode == MODE_INSERT) {
+		text_edit->start_action(TextEdit::ACTION_NONE);
+	}
+	if (complex_open) {
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+	mode = MODE_NORMAL;
+	pending = String();
+	count = 0;
+	pending_register = false;
+	prompt_kind = PROMPT_NONE;
+	status = String();
+	status_error = false;
+	step_open = false;
+
+	_sync_from_native();
+	HelixSelection before = sel;
+	uint32_t v_before = text_edit->get_version();
+	if (text_edit->get_text() != text) {
+		text_edit->begin_complex_operation();
+		int last = text_edit->get_line_count() - 1;
+		text_edit->remove_text(0, 0, last, text_edit->get_line(last).length());
+		text_edit->insert_text(text, 0, 0);
+		text_edit->close_complex_operation();
+	}
+	doc.invalidate();
+	if (ranges.is_empty()) {
+		ranges.push_back(HelixRange::point(0));
+	}
+	HelixSelection s = HelixSelection::from_ranges(ranges, primary);
+	_set_selection(s);
+	uint32_t v_after = text_edit->get_version();
+	if (v_after != v_before) {
+		UndoInfo u;
+		u.target = v_before;
+		u.selection = before;
+		undo_info[v_after] = u;
+		UndoInfo r;
+		r.target = v_after;
+		r.selection = sel;
+		redo_info[v_before] = r;
+	}
+	_push_selection();
+	_emit_if_changed();
+}
+
+/* Rendering */
+
+HelixSelection HelixMode::_visible_selection() const {
+	// What the CodeEdit shows right now, also between keys: native carets moved by the mouse,
+	// Find or an edit made elsewhere are drawn as the selection they become on the next key.
+	if (mode == MODE_INSERT) {
+		return _insert_selection();
+	}
+	if (_native_matches_pushed()) {
+		return sel;
+	}
+	return _selection_from_native(_native_is_pushed_layout());
+}
+
+Variant HelixMode::get_selection_highlights(bool p_cursor_is_block, int p_first_line, int p_last_line) const {
+	if (!enabled || !text_edit || ObjectDB::get_instance(text_edit_id) != text_edit) {
+		return Variant();
+	}
+	if (mode == MODE_INSERT) {
+		for (int i = 0; i < text_edit->get_caret_count(); i++) {
+			if (text_edit->has_selection(i)) {
+				return Variant(); // A native selection made in insert mode (Shift+arrows): typing replaces it, show it as such.
+			}
+		}
+	}
+	const HelixSelection s = _visible_selection();
+	const int64_t len = doc.len();
+	const int64_t vis_from = doc.line_to_char(CLAMP(p_first_line, 0, doc.line_count()));
+	const int64_t vis_to = doc.line_to_char(CLAMP(p_last_line + 1, 0, doc.line_count()));
+
+	PackedInt32Array out;
+	auto add = [&](int p_kind, int64_t p_from, int64_t p_to) {
+		if (p_to <= p_from) {
+			return;
+		}
+		// Positions past the end of the text (the end-of-buffer cursor) are virtual columns.
+		int fl, fc, tl, tc;
+		doc.pos_to_line_col(MIN(p_from, len), fl, fc);
+		doc.pos_to_line_col(MIN(p_to, len), tl, tc);
+		fc += (int)MAX(p_from - len, (int64_t)0);
+		tc += (int)MAX(p_to - len, (int64_t)0);
+		const int v[5] = { p_kind, fl, fc, tl, tc };
+		for (int k = 0; k < 5; k++) {
+			out.push_back(v[k]);
+		}
+	};
+
+	// The primary selection's text, for the editor's "highlight all occurrences" (Helix has no
+	// such feature; it is a Godot setting): normal and select mode, more than one character, not
+	// starting or ending with whitespace. A cursor, typing, or the word-plus-space that w / W
+	// select on every move highlight nothing; miw, e, b, *, a search match do, like a
+	// double-clicked word in stock Godot.
+	const HelixRange &pr = s.primary_range();
+	if (mode != MODE_INSERT && pr.to() > pr.from() && !is_single_grapheme(doc, pr) && !HelixAlgo::is_whitespace(doc.char_at(pr.from())) && !HelixAlgo::is_whitespace(doc.char_at(MIN(pr.to(), len) - 1))) {
+		add(TextEdit::MODAL_SPAN_PRIMARY_TEXT, pr.from(), MIN(pr.to(), len));
+	}
+
+	// helix-term ui::EditorView::doc_selection_highlights (25.07.1), with the terminal focused:
+	// the block cursor of every range is a painted cell; a primary bar / underline cursor is the
+	// TextEdit caret (native caret 0), and with it the primary selection includes the cursor
+	// character outside insert mode.
+	const bool insert = mode == MODE_INSERT;
+	for (int i = 0; i < s.ranges.size(); i++) {
+		const HelixRange &range = s.ranges[i];
+		if (range.to() < vis_from || range.from() > vis_to) {
+			continue;
+		}
+		const bool primary = i == s.primary;
+		const int sel_kind = primary ? TextEdit::MODAL_SPAN_PRIMARY_SELECTION : TextEdit::MODAL_SPAN_SECONDARY_SELECTION;
+		const int cursor_kind = primary ? TextEdit::MODAL_SPAN_PRIMARY_CURSOR : TextEdit::MODAL_SPAN_SECONDARY_CURSOR;
+		const bool paint_cursor = !primary || p_cursor_is_block;
+		if (range.head == range.anchor && range.head == len) {
+			// Cursor at the end of the text: one cell past it.
+			if (paint_cursor) {
+				add(cursor_kind, range.head, range.head + 1);
+			}
+			continue;
+		}
+		const HelixRange r = min_width_1(doc, range);
+		if (r.head > r.anchor) {
+			const int64_t cursor_start = doc.prev_grapheme(r.head);
+			const int64_t selection_end = primary && !p_cursor_is_block && !insert ? r.head : cursor_start;
+			add(sel_kind, r.anchor, selection_end);
+			if (paint_cursor) {
+				add(cursor_kind, cursor_start, r.head);
+			}
+		} else {
+			const int64_t cursor_end = doc.next_grapheme(r.head);
+			if (paint_cursor) {
+				add(cursor_kind, r.head, cursor_end);
+			}
+			const int64_t selection_start = primary && !p_cursor_is_block && !(insert && cursor_end == r.anchor) ? r.head : cursor_end;
+			add(sel_kind, selection_start, r.anchor);
+		}
+	}
+	return out;
+}
