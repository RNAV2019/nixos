+}
+
+HelixMode::~HelixMode() {
+	if (_alive() && mode == MODE_INSERT) {
+		text_edit->start_action(TextEdit::ACTION_NONE);
+	}
+	if (_alive() && complex_open) {
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+}
