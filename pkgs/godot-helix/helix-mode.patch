+#pragma once
+
+// Text model and editing algorithms of the editor's Helix mode, ported from helix-core
+// (selection.rs, movement.rs, textobject.rs, surround.rs, match_brackets.rs, transaction.rs).
+// All positions are character (code point) offsets into the whole buffer, exactly like Helix;
+// the buffer is read line by line from the TextEdit, never copied as a whole.
+
+#include "core/string/ustring.h"
+#include "core/templates/local_vector.h"
+#include "core/templates/vector.h"
+
+class TextEdit;
+
+// One selection range (helix_core::Range). Gap indices; the block cursor sits on the
+// grapheme at the head side.
+struct HelixRange {
+	int64_t anchor = 0;
+	int64_t head = 0;
+	int32_t old_col = -1; // Sticky visual column for vertical motions, -1 = none.
+
+	HelixRange() {}
+	HelixRange(int64_t p_anchor, int64_t p_head) :
+			anchor(p_anchor), head(p_head) {}
+	static HelixRange point(int64_t p_pos) { return HelixRange(p_pos, p_pos); }
+
+	int64_t from() const { return MIN(anchor, head); }
+	int64_t to() const { return MAX(anchor, head); }
+	int64_t len() const { return to() - from(); }
+	bool is_empty() const { return anchor == head; }
+	bool is_forward() const { return head >= anchor; }
+	HelixRange flip() const {
+		HelixRange r(head, anchor);
+		r.old_col = old_col;
+		return r;
+	}
+	HelixRange with_direction(bool p_forward) const { return is_forward() == p_forward ? *this : flip(); }
+	bool overlaps(const HelixRange &p_other) const {
+		return from() == p_other.from() || (to() > p_other.from() && p_other.to() > from());
+	}
+	bool contains_range(const HelixRange &p_other) const { return from() <= p_other.from() && to() >= p_other.to(); }
+	HelixRange merge(const HelixRange &p_other) const;
+	HelixRange extend(int64_t p_from, int64_t p_to) const;
+
+	bool operator==(const HelixRange &p_other) const { return anchor == p_other.anchor && head == p_other.head && old_col == p_other.old_col; }
+	bool operator!=(const HelixRange &p_other) const { return !(*this == p_other); }
+};
+
+// helix_core::Selection. Never empty once initialized.
+struct HelixSelection {
+	Vector<HelixRange> ranges;
+	int primary = 0;
+
+	HelixSelection() { ranges.push_back(HelixRange()); }
+	static HelixSelection single(int64_t p_anchor, int64_t p_head);
+	static HelixSelection from_ranges(const Vector<HelixRange> &p_ranges, int p_primary);
+
+	int size() const { return ranges.size(); }
+	const HelixRange &primary_range() const { return ranges[primary]; }
+	void normalize();
+	void merge_consecutive();
+	HelixSelection merged_all() const;
+	HelixSelection into_single() const { return single(primary_range().anchor, primary_range().head); }
+	void push(const HelixRange &p_range); // Adds as primary, then normalizes.
+	void remove(int p_index);
+
+	bool operator==(const HelixSelection &p_other) const;
+	bool operator!=(const HelixSelection &p_other) const { return !(*this == p_other); }
+};
+
+// Read access to the buffer of a TextEdit in Helix terms. Line start offsets are cached and
+// recomputed lazily (O(lines), no text copy) after invalidate().
+class HelixDoc {
+	const TextEdit *te = nullptr;
+	mutable LocalVector<int64_t> starts; // starts[i] = offset of line i; one extra entry = len.
+	mutable bool dirty = true;
+	mutable int cache_line = -1;
+	mutable String cache_text;
+	mutable int g_line = -1;
+	mutable bool g_simple = true;
+	mutable LocalVector<int> g_breaks; // Grapheme boundaries (columns) of g_line, ascending, 0 and len included.
+
+	void _update() const;
+	void _graphemes(int p_line) const;
+
+public:
+	void set_text_edit(const TextEdit *p_te) {
+		te = p_te;
+		invalidate();
+	}
+	void invalidate() {
+		dirty = true;
+		cache_line = -1;
+		g_line = -1;
+	}
+
+	int64_t len() const;
+	int line_count() const; // Helix len_lines(): the empty line after a final newline counts.
+	int64_t line_to_char(int p_line) const; // p_line == line_count() gives len().
+	int char_to_line(int64_t p_pos) const;
+	const String &line(int p_line) const; // Without line ending.
+	int line_length(int p_line) const; // Without line ending.
+	int64_t line_end(int p_line) const; // helix line_end_char_index.
+	bool line_is_empty(int p_line) const { return line_length(p_line) == 0; } // rope_is_line_ending.
+	char32_t char_at(int64_t p_pos) const; // '\n' at line ends, 0 out of range.
+	String slice(int64_t p_from, int64_t p_to) const;
+	void pos_to_line_col(int64_t p_pos, int &r_line, int &r_col) const;
+	int64_t line_col_to_pos(int p_line, int p_col) const;
+	int64_t first_non_whitespace(int p_line) const; // Column, or -1 (helix first_non_whitespace_char).
+
+	// Graphemes (extended grapheme clusters from the TextServer; a line ending is its own).
+	int64_t next_grapheme(int64_t p_pos, int p_n = 1) const;
+	int64_t prev_grapheme(int64_t p_pos, int p_n = 1) const;
+	bool is_grapheme_boundary(int64_t p_pos) const;
+	int64_t ensure_grapheme_next(int64_t p_pos) const;
+	int64_t ensure_grapheme_prev(int64_t p_pos) const;
+	int grapheme_width_at(int64_t p_pos, int64_t p_end, int p_visual_x, int p_tab_width) const;
+};
+
+struct HelixChange {
+	int64_t from = 0;
+	int64_t to = 0;
+	String text;
+	bool insert = false; // false: pure deletion of from..to.
+
+	HelixChange() {}
+	HelixChange(int64_t p_from, int64_t p_to) :
+			from(p_from), to(p_to) {}
+	HelixChange(int64_t p_from, int64_t p_to, const String &p_text) :
+			from(p_from), to(p_to), text(p_text), insert(true) {}
+};
+
+// helix_core::ChangeSet (Retain / Delete / Insert operations) with Helix's position mapping.
+class HelixChangeSet {
+public:
+	enum OpType {
+		OP_RETAIN,
+		OP_DELETE,
+		OP_INSERT,
+	};
+	struct Op {
+		OpType type = OP_RETAIN;
+		int64_t n = 0;
+		String s;
+	};
+	enum Assoc {
+		ASSOC_BEFORE,
+		ASSOC_AFTER,
+		ASSOC_AFTER_WORD,
+		ASSOC_BEFORE_WORD,
+		ASSOC_BEFORE_STICKY,
+		ASSOC_AFTER_STICKY,
+	};
+
+	LocalVector<Op> ops;
+	int64_t len = 0;
+	int64_t len_after = 0;
+
+	void retain(int64_t p_n);
+	void del(int64_t p_n);
+	void insert(const String &p_s);
+	bool is_empty() const;
+
+	// p_changes must be sorted; overlapping changes are dropped.
+	static HelixChangeSet from_changes(int64_t p_doc_len, const Vector<HelixChange> &p_changes);
+	Vector<HelixChange> to_changes() const; // Original coordinates, sorted.
+	int64_t map_pos(int64_t p_pos, Assoc p_assoc) const;
+	HelixRange map_range(const HelixRange &p_range) const;
+	HelixSelection map_selection(const HelixSelection &p_sel) const; // Normalized.
+};
