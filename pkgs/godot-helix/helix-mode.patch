+// Bidirectional char iterator over the document (ropey Chars).
+struct _HelixChars {
+	const HelixDoc *doc;
+	int64_t it;
+	bool reversed = false;
+	int64_t len;
+
+	_HelixChars(const HelixDoc &p_doc, int64_t p_at) :
+			doc(&p_doc), it(p_at), len(p_doc.len()) {}
+
+	bool _fwd_next(char32_t &r_c) {
+		if (it >= len) {
+			return false;
+		}
+		r_c = doc->char_at(it);
+		it++;
+		return true;
+	}
+	bool _fwd_prev(char32_t &r_c) {
+		if (it <= 0) {
+			return false;
+		}
+		it--;
+		r_c = doc->char_at(it);
+		return true;
+	}
+	bool next(char32_t &r_c) { return reversed ? _fwd_prev(r_c) : _fwd_next(r_c); }
+	bool prev(char32_t &r_c) { return reversed ? _fwd_next(r_c) : _fwd_prev(r_c); }
+};
+
+static bool _is_word_boundary(char32_t p_a, char32_t p_b) {
+	return categorize(p_a) != categorize(p_b);
+}
+
+static bool _is_long_word_boundary(char32_t p_a, char32_t p_b) {
+	CharCategory a = categorize(p_a);
+	CharCategory b = categorize(p_b);
+	if ((a == CAT_WORD && b == CAT_PUNCTUATION) || (a == CAT_PUNCTUATION && b == CAT_WORD)) {
+		return false;
+	}
+	return a != b;
+}
+
+static bool _reached_target(WordTarget p_target, char32_t p_prev, char32_t p_next) {
+	switch (p_target) {
+		case NEXT_WORD_START:
+		case PREV_WORD_END:
+			return _is_word_boundary(p_prev, p_next) && (is_line_ending(p_next) || !is_whitespace(p_next));
+		case NEXT_WORD_END:
+		case PREV_WORD_START:
+			return _is_word_boundary(p_prev, p_next) && (!is_whitespace(p_prev) || is_line_ending(p_next));
+		case NEXT_LONG_WORD_START:
+		case PREV_LONG_WORD_END:
+			return _is_long_word_boundary(p_prev, p_next) && (is_line_ending(p_next) || !is_whitespace(p_next));
+		case NEXT_LONG_WORD_END:
+		case PREV_LONG_WORD_START:
+			return _is_long_word_boundary(p_prev, p_next) && (!is_whitespace(p_prev) || is_line_ending(p_next));
+	}
+	return false;
+}
+
+static bool _is_prev_target(WordTarget p_target) {
+	return p_target == PREV_WORD_START || p_target == PREV_WORD_END || p_target == PREV_LONG_WORD_START || p_target == PREV_LONG_WORD_END;
+}
+
+static HelixRange _range_to_target(const HelixDoc &p_doc, WordTarget p_target, const HelixRange &p_origin) {
+	bool is_prev = _is_prev_target(p_target);
+	_HelixChars chars(p_doc, p_origin.head);
+	chars.reversed = is_prev;
+
+	int64_t anchor = p_origin.anchor;
+	int64_t head = p_origin.head;
+	auto advance = [&](int64_t &r_idx) {
+		if (is_prev) {
+			r_idx = MAX(r_idx - 1, (int64_t)0);
+		} else {
+			r_idx += 1;
+		}
+	};
+
+	char32_t prev_ch = 0;
+	bool has_prev = false;
+	{
+		char32_t c;
+		if (chars.prev(c)) {
+			prev_ch = c;
+			has_prev = true;
+			chars.next(c);
+		}
+	}
+
+	// Skip any initial newline characters.
+	char32_t ch;
+	while (chars.next(ch)) {
+		if (is_line_ending(ch)) {
+			prev_ch = ch;
+			has_prev = true;
+			advance(head);
+		} else {
+			chars.prev(ch);
+			break;
+		}
+	}
+	if (has_prev && is_line_ending(prev_ch)) {
+		anchor = head;
+	}
+
+	int64_t head_start = head;
+	char32_t next_ch;
+	while (chars.next(next_ch)) {
+		if (!has_prev || _reached_target(p_target, prev_ch, next_ch)) {
+			if (head == head_start) {
+				anchor = head;
+			} else {
+				break;
+			}
+		}
+		prev_ch = next_ch;
+		has_prev = true;
+		advance(head);
+	}
+	return HelixRange(anchor, head);
+}
+
+HelixRange word_move(const HelixDoc &p_doc, const HelixRange &p_range, int p_count, WordTarget p_target) {
+	bool is_prev = _is_prev_target(p_target);
+	if ((is_prev && p_range.head == 0) || (!is_prev && p_range.head == p_doc.len())) {
+		return p_range;
+	}
+	HelixRange start;
+	if (is_prev) {
+		if (p_range.anchor < p_range.head) {
+			start = HelixRange(p_range.head, p_doc.prev_grapheme(p_range.head));
+		} else {
+			start = HelixRange(p_doc.next_grapheme(p_range.head), p_range.head);
+		}
+	} else {
+		if (p_range.anchor < p_range.head) {
+			start = HelixRange(p_doc.prev_grapheme(p_range.head), p_range.head);
+		} else {
+			start = HelixRange(p_range.head, p_doc.next_grapheme(p_range.head));
+		}
+	}
+	HelixRange r = start;
+	for (int i = 0; i < p_count; i++) {
+		HelixRange n = _range_to_target(p_doc, p_target, r);
+		if (n.anchor == r.anchor && n.head == r.head) {
+			break;
+		}
+		r = n;
+	}
+	return r;
+}
+
+// rope_is_line_ending(slice.line(l)): the line holds nothing but its line ending (or nothing).
+static bool _line_blank(const HelixDoc &p_doc, int p_line) {
+	return p_doc.line_length(p_line) == 0;
+}
+
+HelixRange move_prev_paragraph(const HelixDoc &p_doc, const HelixRange &p_range, int p_count, bool p_extend) {
+	int line = cursor_line(p_doc, p_range);
+	int64_t cur = cursor(p_doc, p_range);
+	bool first_char = p_doc.line_to_char(line) == cur;
+	bool prev_line_empty = _line_blank(p_doc, MAX(line - 1, 0));
+	bool curr_line_empty = _line_blank(p_doc, line);
+	bool prev_empty_to_line = prev_line_empty && !curr_line_empty;
+	if (prev_empty_to_line && !first_char) {
+		line += 1;
+	}
+	int k = line - 1; // Next line yielded by the reversed lines iterator.
+	int last_line = line;
+	for (int i = 0; i < p_count; i++) {
+		while (k >= 0 && _line_blank(p_doc, k)) {
+			line--;
+			k--;
+		}
+		while (k >= 0 && !_line_blank(p_doc, k)) {
+			line--;
+			k--;
+		}
+		if (line == last_line) {
+			break;
+		}
+		last_line = line;
+	}
+	int64_t head = p_doc.line_to_char(line);
+	int64_t anchor;
+	if (!p_extend) {
+		anchor = (prev_empty_to_line && first_char) ? cur : p_range.head;
+	} else {
+		anchor = put_cursor(p_doc, p_range, head, true).anchor;
+	}
+	return HelixRange(anchor, head);
+}
+
+HelixRange move_next_paragraph(const HelixDoc &p_doc, const HelixRange &p_range, int p_count, bool p_extend) {
+	int line = cursor_line(p_doc, p_range);
+	int64_t cur = cursor(p_doc, p_range);
+	int lc = p_doc.line_count();
+	bool last_char = p_doc.prev_grapheme(p_doc.line_to_char(line + 1)) == cur;
+	bool curr_line_empty = _line_blank(p_doc, line);
+	bool next_line_empty = _line_blank(p_doc, MIN(lc - 1, line + 1));
+	bool curr_empty_to_line = curr_line_empty && !next_line_empty;
+	if (curr_empty_to_line && last_char) {
+		line += 1;
+	}
+	int k = line;
+	int last_line = line;
+	for (int i = 0; i < p_count; i++) {
+		while (k < lc && !_line_blank(p_doc, k)) {
+			line++;
+			k++;
+		}
+		while (k < lc && _line_blank(p_doc, k)) {
+			line++;
+			k++;
+		}
+		if (line == last_line) {
+			break;
+		}
+		last_line = line;
+	}
+	int64_t head = p_doc.line_to_char(line);
+	int64_t anchor;
+	if (!p_extend) {
+		anchor = (curr_empty_to_line && last_char) ? p_range.head : cur;
+	} else {
+		anchor = put_cursor(p_doc, p_range, head, true).anchor;
+	}
+	return HelixRange(anchor, head);
+}
+
+int64_t find_nth_next(const HelixDoc &p_doc, char32_t p_c, int64_t p_pos, int p_n) {
+	int64_t l = p_doc.len();
+	if (p_pos >= l || p_n == 0) {
+		return -1;
+	}
+	for (int i = 0; i < p_n; i++) {
+		while (true) {
+			if (p_pos >= l) {
+				return -1;
+			}
+			char32_t c = p_doc.char_at(p_pos);
+			p_pos++;
+			if (c == p_c) {
+				break;
+			}
+		}
+	}
+	return p_pos - 1;
+}
+
+int64_t find_nth_prev(const HelixDoc &p_doc, char32_t p_c, int64_t p_pos, int p_n) {
+	if (p_pos <= 0 || p_n == 0) {
+		return -1;
+	}
+	for (int i = 0; i < p_n; i++) {
+		while (true) {
+			if (p_pos <= 0) {
+				return -1;
+			}
+			p_pos--;
+			if (p_doc.char_at(p_pos) == p_c) {
+				break;
+			}
+		}
+	}
+	return p_pos;
+}
+
+static int64_t _find_word_boundary(const HelixDoc &p_doc, int64_t p_pos, bool p_forward, bool p_long) {
+	int64_t l = p_doc.len();
+	CharCategory prev_cat;
+	if (p_forward) {
+		prev_cat = p_pos == 0 ? CAT_WHITESPACE : categorize(p_doc.char_at(p_pos - 1));
+	} else {
+		prev_cat = p_pos == l ? CAT_WHITESPACE : categorize(p_doc.char_at(p_pos));
+	}
+	_HelixChars chars(p_doc, p_pos);
+	chars.reversed = !p_forward;
+	char32_t ch;
+	while (chars.next(ch)) {
+		CharCategory cat = categorize(ch);
+		if (cat == CAT_EOL || cat == CAT_WHITESPACE) {
+			return p_pos;
+		}
+		if (!p_long && cat != prev_cat && p_pos != 0 && p_pos != l) {
+			return p_pos;
+		}
+		if (p_forward) {
+			p_pos += 1;
+		} else {
+			p_pos = MAX(p_pos - 1, (int64_t)0);
+		}
+		prev_cat = cat;
+	}
+	return p_pos;
+}
+
+HelixRange textobject_word(const HelixDoc &p_doc, const HelixRange &p_range, bool p_inside, bool p_long) {
+	int64_t pos = cursor(p_doc, p_range);
+	int64_t word_start = _find_word_boundary(p_doc, pos, false, p_long);
+	int64_t word_end;
+	if (pos >= p_doc.len()) {
+		word_end = pos;
+	} else {
+		CharCategory cat = categorize(p_doc.char_at(pos));
+		if (cat == CAT_WHITESPACE || cat == CAT_EOL) {
+			word_end = pos;
+		} else {
+			word_end = _find_word_boundary(p_doc, pos + 1, true, p_long);
+		}
+	}
+	if (word_start == word_end) {
+		return HelixRange(word_start, word_end);
+	}
+	if (p_inside) {
+		return HelixRange(word_start, word_end);
+	}
+	int64_t right = 0;
+	int64_t l = p_doc.len();
+	while (word_end + right < l && is_blank(p_doc.char_at(word_end + right))) {
+		right++;
+	}
+	if (right > 0) {
+		return HelixRange(word_start, word_end + right);
+	}
+	int64_t left = 0;
+	while (word_start - left - 1 >= 0 && is_blank(p_doc.char_at(word_start - left - 1))) {
+		left++;
+	}
+	return HelixRange(word_start - left, word_end);
+}
+
+HelixRange textobject_paragraph(const HelixDoc &p_doc, const HelixRange &p_range, bool p_inside, int p_count) {
+	int lc = p_doc.line_count();
+	int line = cursor_line(p_doc, p_range);
+	bool prev_line_empty = _line_blank(p_doc, MAX(line - 1, 0));
+	bool curr_line_empty = _line_blank(p_doc, line);
+	bool next_line_empty = _line_blank(p_doc, MAX(line - 1, 0)); // Sic (helix-core).
+	bool last_char = p_doc.prev_grapheme(p_doc.line_to_char(line + 1)) == cursor(p_doc, p_range);
+	bool prev_empty_to_line = prev_line_empty && !curr_line_empty;
+	bool curr_empty_to_line = curr_line_empty && !next_line_empty;
+
+	int line_back = line;
+	if (prev_empty_to_line || curr_empty_to_line) {
+		line_back += 1;
+	}
+	if (!(curr_empty_to_line && last_char)) {
+		int k = line_back - 1;
+		while (k >= 0 && _line_blank(p_doc, k)) {
+			line_back--;
+			k--;
+		}
+		while (k >= 0 && !_line_blank(p_doc, k)) {
+			line_back--;
+			k--;
+		}
+	}
+	if (curr_empty_to_line && last_char) {
+		line += 1;
+	}
+	int k = line;
+	int count_done = 0;
+	for (int i = 0; i < p_count; i++) {
+		bool done = false;
+		while (k < lc && !_line_blank(p_doc, k)) {
+			line++;
+			k++;
+			done = true;
+		}
+		while (k < lc && _line_blank(p_doc, k)) {
+			line++;
+			k++;
+		}
+		count_done += done ? 1 : 0;
+	}
+	bool last_paragraph = count_done != p_count && k >= lc;
+	if (last_paragraph) {
+		int kb = line_back - 1;
+		while (kb >= 0 && _line_blank(p_doc, kb)) {
+			line_back--;
+			kb--;
+		}
+		while (kb >= 0 && !_line_blank(p_doc, kb)) {
+			line_back--;
+			kb--;
+		}
+	}
+	if (p_inside) {
+		int kb = line - 1;
+		while (kb >= 0 && _line_blank(p_doc, kb)) {
+			line--;
+			kb--;
+		}
+	}
+	return HelixRange(p_doc.line_to_char(line_back), p_doc.line_to_char(line));
+}
+
+static const char32_t _brackets[][2] = {
+	{ '(', ')' },
+	{ '{', '}' },
+	{ '[', ']' },
+	{ '<', '>' },
+	{ 0x2018, 0x2019 },
+	{ 0x201c, 0x201d },
+	{ 0xab, 0xbb },
+	{ 0x300c, 0x300d },
+	{ 0xff08, 0xff09 },
+};
+static const int _brackets_count = 9;
+static const char32_t _extra_pairs[] = { '"', '\'', '`' };
+
+void get_pair(char32_t p_c, char32_t &r_open, char32_t &r_close) {
+	for (int i = 0; i < _brackets_count; i++) {
+		if (_brackets[i][0] == p_c || _brackets[i][1] == p_c) {
+			r_open = _brackets[i][0];
+			r_close = _brackets[i][1];
+			return;
+		}
+	}
+	r_open = p_c;
+	r_close = p_c;
+}
+
+bool is_open_bracket(char32_t p_c) {
+	for (int i = 0; i < _brackets_count; i++) {
+		if (_brackets[i][0] == p_c) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool is_close_bracket(char32_t p_c) {
+	for (int i = 0; i < _brackets_count; i++) {
+		if (_brackets[i][1] == p_c) {
+			return true;
+		}
+	}
+	return false;
+}
+
+int64_t find_matching_bracket_plaintext(const HelixDoc &p_doc, int64_t p_pos) {
+	if (p_pos < 0 || p_pos >= p_doc.len()) {
+		return -1;
+	}
+	char32_t bracket = p_doc.char_at(p_pos);
+	if (!is_open_bracket(bracket) && !is_close_bracket(bracket)) {
+		return -1;
+	}
+	char32_t open, close;
+	get_pair(bracket, open, close);
+	char32_t matching = open == bracket ? close : open;
+	bool fwd = is_open_bracket(bracket);
+	int open_cnt = 1;
+	int64_t l = p_doc.len();
+	for (int i = 0; i < 10000; i++) {
+		int64_t p = fwd ? p_pos + 1 + i : p_pos - 1 - i;
+		if (p < 0 || p >= l) {
+			break;
+		}
+		char32_t c = p_doc.char_at(p);
+		if (c == bracket) {
+			open_cnt++;
+		} else if (c == matching) {
+			if (open_cnt == 1) {
+				return p;
+			}
+			open_cnt--;
+		}
+	}
+	return -1;
+}
+
+String surround_error_message(SurroundError p_error) {
+	switch (p_error) {
+		case SURROUND_PAIR_NOT_FOUND:
+			return "Surround pair not found around all cursors";
+		case SURROUND_CURSOR_OVERLAP:
+			return "Cursors overlap for a single surround pair range";
+		case SURROUND_RANGE_EXCEEDS_TEXT:
+			return "Cursor range exceeds text length";
+		case SURROUND_CURSOR_ON_AMBIGUOUS_PAIR:
+			return "Cursor on ambiguous surround pair";
+		default:
+			return String();
+	}
+}
+
+static int64_t _find_nth_open_pair(const HelixDoc &p_doc, char32_t p_open, char32_t p_close, int64_t p_pos, int p_n) {
+	if (p_pos >= p_doc.len()) {
+		return -1;
+	}
+	int64_t it = p_pos + 1;
+	// chars.prev() gives the char at p_pos first.
+	if (it <= 0) {
+		return -1;
+	}
+	it--;
+	if (p_doc.char_at(it) == p_open) {
+		return p_pos;
+	}
+	for (int i = 0; i < p_n; i++) {
+		int step_over = 0;
+		while (true) {
+			if (it <= 0) {
+				return -1;
+			}
+			it--;
+			char32_t c = p_doc.char_at(it);
+			p_pos = MAX(p_pos - 1, (int64_t)0);
+			if (c == p_close) {
+				step_over++;
+			} else if (c == p_open) {
+				if (step_over == 0) {
+					break;
+				}
+				step_over = MAX(step_over - 1, 0);
+			}
+		}
+	}
+	return p_pos;
+}
+
+static int64_t _find_nth_close_pair(const HelixDoc &p_doc, char32_t p_open, char32_t p_close, int64_t p_pos, int p_n) {
+	int64_t l = p_doc.len();
+	if (p_pos >= l) {
+		return -1;
+	}
+	int64_t it = p_pos;
+	if (p_doc.char_at(it) == p_close) {
+		return p_pos;
+	}
+	it++;
+	for (int i = 0; i < p_n; i++) {
+		int step_over = 0;
+		while (true) {
+			if (it >= l) {
+				return -1;
+			}
+			char32_t c = p_doc.char_at(it);
+			it++;
+			p_pos += 1;
+			if (c == p_open) {
+				step_over++;
+			} else if (c == p_close) {
+				if (step_over == 0) {
+					break;
+				}
+				step_over = MAX(step_over - 1, 0);
+			}
+		}
+	}
+	return p_pos;
+}
+
+SurroundError find_nth_pairs_pos(const HelixDoc &p_doc, char32_t p_ch, const HelixRange &p_range, int p_n, int64_t &r_anchor, int64_t &r_head) {
+	int64_t l = p_doc.len();
+	if (l < 2) {
+		return SURROUND_PAIR_NOT_FOUND;
+	}
+	if (p_range.to() >= l) {
+		return SURROUND_RANGE_EXCEEDS_TEXT;
+	}
+	char32_t open, close;
+	get_pair(p_ch, open, close);
+	int64_t pos = cursor(p_doc, p_range);
+	int64_t o, c;
+	if (open == close) {
+		if (p_doc.char_at(pos) == open) {
+			return SURROUND_CURSOR_ON_AMBIGUOUS_PAIR;
+		}
+		o = find_nth_prev(p_doc, open, pos, p_n);
+		c = find_nth_next(p_doc, close, pos, p_n);
+	} else {
+		o = _find_nth_open_pair(p_doc, open, close, pos, p_n);
+		c = _find_nth_close_pair(p_doc, open, close, pos, p_n);
+	}
+	if (o < 0 || c < 0) {
+		return SURROUND_PAIR_NOT_FOUND;
+	}
+	if (p_range.is_forward()) {
+		r_anchor = o;
+		r_head = c;
+	} else {
+		r_anchor = c;
+		r_head = o;
+	}
+	return SURROUND_OK;
+}
+
+SurroundError find_nth_closest_pairs_pos(const HelixDoc &p_doc, const HelixRange &p_range, int p_skip, int64_t &r_anchor, int64_t &r_head) {
+	Vector<char32_t> stack;
+	int64_t pos = p_range.from();
+	int64_t close_pos = MAX(pos - 1, (int64_t)0);
+	int64_t l = p_doc.len();
+	for (int64_t i = pos; i < l; i++) {
+		char32_t ch = p_doc.char_at(i);
+		close_pos += 1;
+		if (is_open_bracket(ch)) {
+			stack.push_back(ch);
+			continue;
+		}
+		if (!is_close_bracket(ch)) {
+			continue;
+		}
+		char32_t open, close;
+		get_pair(ch, open, close);
+		if (!stack.is_empty() && stack[stack.size() - 1] == open) {
+			stack.remove_at(stack.size() - 1);
+			continue;
+		}
+		int64_t open_pos = _find_nth_open_pair(p_doc, open, close, close_pos, 1);
+		if (open_pos >= 0 && open_pos <= pos + 1 && close_pos >= MAX(p_range.to() - 1, (int64_t)0)) {
+			if (p_skip > 1) {
+				p_skip--;
+				continue;
+			}
+			if (p_range.is_forward()) {
+				r_anchor = open_pos;
+				r_head = close_pos;
+			} else {
+				r_anchor = close_pos;
+				r_head = open_pos;
+			}
+			return SURROUND_OK;
+		}
+	}
+	return SURROUND_PAIR_NOT_FOUND;
+}
+
+HelixRange textobject_pair(const HelixDoc &p_doc, const HelixRange &p_range, bool p_inside, char32_t p_ch, int p_count) {
+	int64_t anchor, head;
+	SurroundError err = p_ch ? find_nth_pairs_pos(p_doc, p_ch, p_range, p_count, anchor, head) : find_nth_closest_pairs_pos(p_doc, p_range, p_count, anchor, head);
+	if (err != SURROUND_OK) {
+		return p_range;
+	}
+	if (p_inside) {
+		if (anchor < head) {
+			return HelixRange(p_doc.next_grapheme(anchor), head);
+		}
+		return HelixRange(anchor, p_doc.next_grapheme(head));
+	}
+	if (anchor < head) {
+		return HelixRange(anchor, p_doc.next_grapheme(head));
+	}
+	return HelixRange(p_doc.next_grapheme(anchor), head);
+}
+
+SurroundError get_surround_pos(const HelixDoc &p_doc, const HelixSelection &p_sel, char32_t p_ch, int p_skip, Vector<int64_t> &r_positions) {
+	r_positions.clear();
+	for (int i = 0; i < p_sel.ranges.size(); i++) {
+		int64_t a, h;
+		SurroundError err = p_ch ? find_nth_pairs_pos(p_doc, p_ch, p_sel.ranges[i], p_skip, a, h) : find_nth_closest_pairs_pos(p_doc, p_sel.ranges[i], p_skip, a, h);
+		if (err != SURROUND_OK) {
+			return err;
+		}
+		int64_t open_pos = MIN(a, h);
+		int64_t close_pos = MAX(a, h);
+		if (r_positions.has(open_pos) || r_positions.has(close_pos)) {
+			return SURROUND_CURSOR_OVERLAP;
+		}
+		r_positions.push_back(open_pos);
+		r_positions.push_back(close_pos);
+	}
+	return SURROUND_OK;
+}
+
+static String _char_upper(char32_t p_c) {
+	if (p_c == 0xdf) {
+		return "SS";
+	}
+	return String::chr(p_c).to_upper();
+}
+
+String switch_case(const String &p_text) {
+	String r;
+	for (int i = 0; i < p_text.length(); i++) {
+		char32_t c = p_text[i];
+		if (is_lower(c)) {
+			r += _char_upper(c);
+		} else if (is_upper(c)) {
+			r += String::chr(c).to_lower();
+		} else {
+			r += String::chr(c);
+		}
+	}
+	return r;
+}
+
+String to_upper(const String &p_text) {
+	String r;
+	for (int i = 0; i < p_text.length(); i++) {
+		r += _char_upper(p_text[i]);
+	}
+	return r;
+}
+
+String to_lower(const String &p_text) {
+	return p_text.to_lower();
+}
+
+static String _pad_number(int64_t p_value, int p_width) {
+	bool neg = p_value < 0;
+	String digits = String::num_int64(neg ? -p_value : p_value);
+	int pad = p_width - digits.length() - (neg ? 1 : 0);
+	String r = neg ? "-" : "";
+	for (int i = 0; i < pad; i++) {
+		r += "0";
+	}
+	return r + digits;
+}
+
+static String _to_radix(uint64_t p_value, int p_radix, bool p_upper, int p_width) {
+	String digits;
+	if (p_value == 0) {
+		digits = "0";
+	}
+	while (p_value > 0) {
+		int d = p_value % p_radix;
+		char32_t c = d < 10 ? char32_t('0' + d) : char32_t((p_upper ? 'A' : 'a') + d - 10);
+		digits = String::chr(c) + digits;
+		p_value /= p_radix;
+	}
+	while (digits.length() < p_width) {
+		digits = "0" + digits;
+	}
+	return digits;
+}
+
+bool increment_integer(const String &p_text, int64_t p_amount, String &r_result) {
+	if (p_text.is_empty() || p_text.ends_with("_") || p_text.begins_with("_")) {
+		return false;
+	}
+	int radix = 10;
+	if (p_text.begins_with("0x")) {
+		radix = 16;
+	} else if (p_text.begins_with("0o")) {
+		radix = 8;
+	} else if (p_text.begins_with("0b")) {
+		radix = 2;
+	}
+	Vector<int> sep_rtl;
+	for (int i = 0; i < p_text.length(); i++) {
+		if (p_text[p_text.length() - 1 - i] == '_') {
+			sep_rtl.push_back(i);
+		}
+	}
+	String word = p_text.remove_char('_');
+	String new_text;
+	if (radix == 10) {
+		String number = word;
+		int i = 0;
+		bool neg = false;
+		if (i < number.length() && (number[i] == '-' || number[i] == '+')) {
+			neg = number[i] == '-';
+			i++;
+		}
+		if (i >= number.length()) {
+			return false;
+		}
+		int64_t value = 0;
+		for (; i < number.length(); i++) {
+			if (!is_digit(number[i])) {
+				return false;
+			}
+			if (value > (INT64_MAX - 9) / 10) {
+				return false;
+			}
+			value = value * 10 + (number[i] - '0');
+		}
+		if (neg) {
+			value = -value;
+		}
+		int64_t nv = value + p_amount;
+		int format_length = number.length();
+		if (value < 0 && nv >= 0) {
+			format_length -= 1;
+		} else if (value >= 0 && nv < 0) {
+			format_length += 1;
+		}
+		format_length -= sep_rtl.size();
+		if (number.begins_with("0") || number.begins_with("-0")) {
+			new_text = _pad_number(nv, format_length);
+		} else {
+			new_text = String::num_int64(nv);
+		}
+	} else {
+		String number = word.substr(2);
+		if (number.is_empty()) {
+			return false;
+		}
+		uint64_t value = 0;
+		int lower = 0;
+		int upper = 0;
+		for (int i = 0; i < number.length(); i++) {
+			char32_t c = number[i];
+			int d;
+			if (is_digit(c)) {
+				d = c - '0';
+			} else if (c >= 'a' && c <= 'z') {
+				d = c - 'a' + 10;
+				lower++;
+			} else if (c >= 'A' && c <= 'Z') {
+				d = c - 'A' + 10;
+				upper++;
+			} else {
+				return false;
+			}
+			if (d >= radix) {
+				return false;
+			}
+			value = value * radix + d;
+		}
+		int64_t nv = (int64_t)value + p_amount;
+		if (nv < 0) {
+			nv = 0;
+		}
+		int format_length = p_text.length() - 2 - sep_rtl.size();
+		String prefix = radix == 2 ? "0b" : (radix == 8 ? "0o" : "0x");
+		new_text = prefix + _to_radix((uint64_t)nv, radix, radix == 16 && upper > lower, format_length);
+	}
+	for (int k = 0; k < sep_rtl.size(); k++) {
+		int rtl = sep_rtl[k];
+		if (rtl < new_text.length()) {
+			int idx = new_text.length() - rtl;
+			if (idx > 0) {
+				new_text = new_text.insert(idx, "_");
+			}
+		}
+	}
+	if (new_text.length() > p_text.length() && !sep_rtl.is_empty()) {
+		int spacing = sep_rtl.size() >= 2 ? sep_rtl[sep_rtl.size() - 1] - sep_rtl[sep_rtl.size() - 2] - 1 : sep_rtl[0];
+		int prefix_length = radix == 10 ? 0 : 2;
+		int index = new_text.find("_");
+		if (index >= 0 && spacing > 0) {
+			while (index - prefix_length > spacing) {
+				index -= spacing;
+				new_text = new_text.insert(index, "_");
+			}
+		}
+	}
+	r_result = new_text;
+	return true;
+}
+
+String regex_escape(const String &p_text) {
+	String r;
+	for (int i = 0; i < p_text.length(); i++) {
+		char32_t c = p_text[i];
+		switch (c) {
+			case '\\':
+			case '.':
+			case '+':
+			case '*':
+			case '?':
+			case '(':
+			case ')':
+			case '|':
+			case '[':
+			case ']':
+			case '{':
+			case '}':
+			case '^':
+			case '$':
+			case '#':
+			case '&':
+			case '-':
+			case '~':
+				r += "\\";
+				break;
+			default:
+				break;
+		}
+		r += String::chr(c);
+	}
+	return r;
+}
+
+} // namespace HelixAlgo
