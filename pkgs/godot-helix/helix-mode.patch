+/**************************************************************************/
+
+#pragma once
+
+#include "core/input/input_event.h"
+#include "core/object/object.h"
+#include "core/templates/hash_map.h"
+#include "core/templates/vector.h"
+#include "editor/gui/helix_text.h"
+
+class CodeEdit;
+
+// Helix-style modal editing (normal / insert / select) for one CodeEdit.
+//
+// This class is the *core*: it owns all modal state and edits the attached CodeEdit through
+// its public API. It knows nothing about the editor around it (no EditorNode, EditorSettings,
+// ScriptEditor), so it can be unit tested against a bare CodeEdit. Everything that needs the
+// surrounding editor goes through the `host_command` signal, and everything the surrounding
+// editor has to display (mode label, which-key popup, prompt) is read back through getters
+// after the `state_changed` signal.
+//
+// PUBLIC SECTION = CONTRACT between the core and the editor integration (CodeTextEditor).
+// Do not change it without updating both sides.
+//
+// Selection model (same as Helix): every selection is a range `anchor`..`head` of gap
+// offsets; a "cursor" is a range one character wide and the cursor sits on the character at
+// the head side. On the CodeEdit this is represented as:
+//   - caret            = the character the Helix cursor is on,
+//   - native selection = the rest of the range (for a forward range the cursor character is
+//                        not part of the native selection; the block caret covers it),
+//   - one native caret per Helix selection; the PRIMARY selection is always native caret 0.
+// In insert mode the native carets are plain collapsed carets at the insertion points.
+//
+// Division of labour: the core never touches visuals. Caret shape (block / bar / underline),
+// relative line numbers, the mode label, the which-key popup and the prompt LineEdit all
+// belong to the host, which derives them from the getters below on every `state_changed`.
+// Selections are drawn by the CodeEdit from get_selection_highlights() (Helix's own rules:
+// painted cursor cells, primary / secondary, highlights kept in insert mode), which the host
+// installs as the CodeEdit's modal draw provider; the native layout above is then never drawn
+// as such.
+class HelixMode : public Object {
+	GDCLASS(HelixMode, Object);
+
+public:
+	enum Mode {
+		MODE_NORMAL,
+		MODE_INSERT,
+		MODE_SELECT,
+	};
+
+	// Things only the surrounding editor can do. Emitted through `host_command(int, Dictionary)`.
+	// Args always contain "line" and "column" (0-based, of the primary cursor) and, where it
+	// makes sense, "symbol" (word under the primary cursor, or the primary selection if it is
+	// a single-line multi-character selection).
+	enum HostCommand {
+		HOST_GOTO_DEFINITION, // gd
+		HOST_SHOW_DOCS, // <space>k
+		HOST_QUICK_OPEN, // <space>f
+		HOST_FIND_IN_FILES, // <space>/   args: "query"
+		HOST_COMMAND_PALETTE, // <space>?
+		HOST_NEXT_TAB, // gn, :bn
+		HOST_PREV_TAB, // gp, :bp
+		HOST_LAST_TAB, // ga (last accessed file)
+		HOST_SAVE, // :w        args: "force" (bool)
+		HOST_SAVE_ALL, // :wa
+		HOST_CLOSE, // :q, :bc   args: "force" (bool), "save_first" (bool, for :wq / :x)
+		HOST_FORMAT, // = (unsupported by most hosts; host may ignore)
+	};
+
+	enum PromptKind {
+		PROMPT_NONE,
+		PROMPT_SEARCH_FORWARD, // /
+		PROMPT_SEARCH_BACKWARD, // ?
+		PROMPT_SELECT_REGEX, // s
+		PROMPT_SPLIT_REGEX, // S
+		PROMPT_KEEP_REGEX, // K
+		PROMPT_REMOVE_REGEX, // <A-K>
+		PROMPT_COMMAND, // :
+	};
+
+	struct KeyHint {
+		String key; // Helix notation, e.g. "g", "<space>", "<A-;>".
+		String description; // Short, e.g. "Goto line end".
+	};
+
+private:
+	CodeEdit *text_edit = nullptr;
+	bool enabled = false;
+	Mode mode = MODE_NORMAL;
+
+	// ---- private implementation (not part of the contract) ---------------------------
+	friend struct HelixModeTestAccess; // Unit tests read the default register.
+
+	ObjectID text_edit_id;
+	HelixDoc doc;
+	HelixSelection sel;
+
+	struct NativeCaret {
+		int line = 0;
+		int column = 0;
+		bool has_selection = false;
+		int origin_line = 0;
+		int origin_column = 0;
+		bool operator==(const NativeCaret &p_o) const { return line == p_o.line && column == p_o.column && has_selection == p_o.has_selection && (!has_selection || (origin_line == p_o.origin_line && origin_column == p_o.origin_column)); }
+		bool operator!=(const NativeCaret &p_o) const { return !(*this == p_o); }
+	};
+	Vector<NativeCaret> pushed_carets;
+	uint32_t pushed_version = 0;
+	bool pushed_valid = false;
+
+	// Pending input.
+	String pending; // Prefix keys of an unfinished command ("g", "mi", "f", "mr(" ...).
+	int count = 0; // 0 = no count typed.
+	bool pending_register = false;
+	String command_keys; // Keys (count included) of the command being typed, for '.'.
+
+	String status;
+	bool status_error = false;
+	bool use_system_clipboard = true;
+
+	enum MotionKind {
+		MOTION_NONE,
+		MOTION_FIND,
+		MOTION_PARA,
+		MOTION_TEXTOBJECT,
+	};
+	struct LastMotion {
+		MotionKind kind = MOTION_NONE;
+		char32_t ch = 0;
+		bool forward = true;
+		bool inclusive = true;
+		bool extend = false;
+		bool newline = false;
+		bool inside = true;
+		int count = 1;
+	};
+
+	// Editor-wide state, shared by every code editor like in Helix (one Editor, many
+	// documents): registers, the search pattern, the last motion (<A-.>) and the last insert
+	// (.). Yank in one script, paste in another.
+	struct Shared {
+		Vector<String> reg_default;
+		Vector<String> clipboard_values;
+		String clipboard_joined;
+		String search_pattern; // The '/' register.
+		bool has_search_pattern = false;
+		LastMotion last_motion;
+		String last_insert_command;
+		Vector<String> last_insert_keys;
+		bool has_last_insert = false;
+	};
+	static Shared shared;
+
+	// Insert session.
+	struct InsertTrack {
+		bool forward = false;
+		bool anchor_from_prev = false;
+		int64_t gap = 0;
+		int64_t off = 0;
+		String after; // The text between the caret and the anchor (backward), or the previous caret and the anchor (forward).
+		bool single = false; // Backward ranges: one grapheme wide.
+	};
+	Vector<InsertTrack> ins_track;
+	int64_t ins_track_len = 0; // Buffer length when ins_track was built.
+	Vector<int> ins_caret; // Native caret index of each range.
+	int ins_primary = 0;
+	bool ins_restore_cursor = false;
+	Vector<NativeCaret> ins_snap_carets;
+	uint32_t ins_snap_version = 0;
+	HelixSelection ins_snap_sel; // Helix selection at the snapshot.
+	char32_t ins_typed = 0; // Character of the last key delivered in insert mode, 0 for other keys.
+	bool ins_from_open = false;
+	int ins_count = 1;
+	String ins_command_keys;
+	Vector<String> ins_keys;
+	int replaying = 0;
+
+	// Undo steps.
+	bool step_open = false;
+	uint32_t step_version = 0;
+	bool step_sel_set = false;
+	HelixSelection step_sel_before;
+	bool complex_open = false;
+	uint32_t complex_start_version = 0; // Version when the open complex operation began.
+	struct UndoInfo {
+		uint32_t target = 0;
+		HelixSelection selection;
+	};
+	HashMap<uint32_t, UndoInfo> undo_info;
+	HashMap<uint32_t, UndoInfo> redo_info;
+
+	// Prompt.
+	PromptKind prompt_kind = PROMPT_NONE;
+	String prompt_text;
+	HelixSelection prompt_snapshot;
+	bool prompt_extend = false;
+
+	struct ObservedState {
+		int mode = 0;
+		String pending;
+		String status;
+		bool status_error = false;
+		int prompt_kind = 0;
+		String prompt_text;
+		int selections = 0;
+		bool operator==(const ObservedState &p_o) const { return mode == p_o.mode && pending == p_o.pending && status == p_o.status && status_error == p_o.status_error && prompt_kind == p_o.prompt_kind && prompt_text == p_o.prompt_text && selections == p_o.selections; }
+	};
+	ObservedState observed;
+
+	// Native cut / copy / paste (Edit menu, Ctrl+X ...) act on the true Helix selections.
+	int clipboard_scope_depth = 0;
+	bool clipboard_scope_changed_native = false;
+	bool clipboard_scope_cursors = false;
+	bool native_command_pending = false;
+	Vector<NativeCaret> exact_carets; // Native carets as left by _push_exact().
+	HelixSelection pushed_sel; // Selection of the last _push_selection().
+	void _end_native_command_deferred();
+
+	// Full text for regex searches, rebuilt only when the buffer changed.
+	mutable String text_cache;
+	mutable uint32_t text_cache_version = 0;
+	mutable int64_t text_cache_len = -1;
+	mutable Ref<RefCounted> regex_cache; // Last compiled pattern (RegEx).
+	mutable String regex_cache_pattern;
+
+	bool _alive();
+	void _on_lines_edited(int p_from, int p_to);
+	void _on_caret_changed();
+	void _on_focus_entered();
+	void _on_focus_exited();
+	void _on_text_set();
+	void _insert_begin_edit();
+	void _insert_close_segment();
+	void _on_native_clipboard_op(int p_op, bool p_begin);
+	void _adopt_native();
+	const String &_full_text() const;
+	void _begin_complex();
+	void _connect_text_edit(bool p_connect);
+	ObservedState _observe() const;
+	void _emit_if_changed();
+
+	// Native carets.
+	Vector<NativeCaret> _read_native() const;
+	bool _native_matches_pushed() const;
+	void _sync_from_native();
+	bool _native_is_pushed_layout() const;
+	bool _native_is_exact_push() const;
+	HelixSelection _selection_from_native(bool p_pushed_layout) const;
+	void _push_selection();
+	void _push_exact(bool p_cursors_as_selections);
+	void _unfold_carets();
+	void _push_insert_carets();
+	HelixSelection _visible_selection() const;
+	void _scroll_to_primary();
+	void _restore_native_for_stock();
+
+	// Input.
+	String _key_from_event(const Ref<InputEventKey> &p_key, bool &r_function_key) const;
+	Ref<InputEventKey> _event_from_key(const String &p_key) const;
+	static Vector<String> _parse_keys(const String &p_keys);
+	bool _is_bound_combo(const String &p_key) const;
+	bool _is_insert_binding(const String &p_key) const;
+	void _handle_key(const String &p_key);
+	void _deliver_native(const String &p_key);
+	void _dispatch(const String &p_key);
+	bool _dispatch_pending(const String &p_key);
+	void _dispatch_normal(const String &p_key);
+	void _dispatch_insert(const String &p_key);
+	void _repeat_last_insert(int p_count);
+	void _set_status(const String &p_msg, bool p_error = false);
+
+	// Steps / undo / edits.
+	void _begin_step();
+	void _end_step();
+	bool _check_editable();
+	bool _apply(const HelixChangeSet &p_cs, const HelixSelection *p_new_sel = nullptr);
+	bool _apply_changes(const Vector<HelixChange> &p_changes, const HelixSelection *p_new_sel = nullptr);
+	void _set_selection(const HelixSelection &p_sel);
+	void _drop_highlighting_cache();
+	void _history_moved();
+	void _undo(int p_count);
+	void _redo(int p_count);
+
+	// Insert mode.
+	void _enter_insert(bool p_restore_cursor);
+	void _track_insert();
+	void _build_insert_track();
+	void _insert_retrack();
+	int64_t _insert_match_after(int64_t p_pos, const String &p_text, int64_t &r_inserted) const;
+	HelixSelection _insert_selection() const;
+	void _insert_snapshot();
+	void _insert_guard_undo();
+	bool _insert_nav_detected() const;
+	bool _insert_skip_over(HelixSelection &r_sel) const;
+	void _insert_check_nav();
+	HelixSelection _carets_as_cursors() const;
+	void _exit_insert();
+	void _insert_delete(int p_kind);
+
+	// Commands.
+	int _count() const { return count > 0 ? count : 1; }
+	bool _extending() const { return mode == MODE_SELECT; }
+	void _exit_select() {
+		if (mode == MODE_SELECT) {
+			mode = MODE_NORMAL;
+		}
+	}
+	String _indent_unit() const;
+	int _tab_width() const;
+	void _move_horizontal(bool p_forward, bool p_extend);
+	void _move_vertical(bool p_forward, bool p_extend, bool p_visual = true);
+	bool _is_line_hidden(int p_line) const;
+	HelixRange _move_rows(const HelixRange &p_range, bool p_forward, int p_count, bool p_extend, bool p_visual) const;
+	void _move_word(HelixAlgo::WordTarget p_target, bool p_extend);
+	void _goto_line_start(bool p_extend);
+	void _goto_line_end(bool p_extend);
+	void _goto_first_nonwhitespace(bool p_extend);
+	void _goto_file_start(bool p_extend);
+	void _goto_last_line(bool p_extend);
+	void _goto_line(int p_line, bool p_extend);
+	void _goto_column(bool p_extend);
+	void _run_motion(const LastMotion &p_motion, int p_times);
+	void _find_char(char32_t p_ch, bool p_newline, bool p_forward, bool p_inclusive, bool p_extend, int p_count);
+	void _paragraph(bool p_forward, int p_count);
+	void _textobject(bool p_inside, char32_t p_ch, int p_count);
+	void _replace_char(const String &p_with);
+	void _switch_case(int p_kind);
+	void _extend_line_below();
+	void _extend_to_line_bounds();
+	void _shrink_to_line_bounds();
+	void _copy_selection_on_line(bool p_forward);
+	void _rotate_contents(bool p_forward);
+	void _trim_selections();
+	void _align_selections();
+	void _split_on_newline();
+	void _join_selections(bool p_select_space);
+	void _delete_selection(bool p_yank, bool p_change);
+	void _insert_mode();
+	void _append_mode();
+	void _insert_with_indent(bool p_line_end);
+	void _open(bool p_below);
+	void _yank(const String &p_register);
+	void _yank_primary_to_clipboard();
+	Vector<String> _read_register(const String &p_register) const;
+	void _write_register(const String &p_register, const Vector<String> &p_values);
+	void _paste(const Vector<String> &p_values, bool p_after, int p_count);
+	void _replace_with(const Vector<String> &p_values, int p_count);
+	void _indent(int p_count);
+	void _unindent(int p_count);
+	void _toggle_comments();
+	void _increment(int64_t p_amount);
+	void _add_newline(bool p_below, int p_count);
+	void _match_brackets();
+	void _surround_add(const String &p_key);
+	void _surround_delete(char32_t p_ch, int p_count);
+	void _surround_replace(char32_t p_from, const String &p_to_key, int p_count);
+	void _select_mode();
+	void _scroll(int p_lines, bool p_forward, bool p_sync_cursor);
+	void _goto_window(int p_align);
+	void _align_view(int p_align);
+	int _view_height() const;
+
+	// Search & regex.
+	Ref<RefCounted> _make_regex(const String &p_pattern, String *r_error = nullptr) const;
+	bool _search_impl(const Ref<RefCounted> &p_regex, bool p_extend, bool p_forward, bool p_show_warnings);
+	void _search_next(bool p_forward, bool p_extend);
+	void _search_selection(bool p_word_boundaries);
+	bool _regex_apply(PromptKind p_kind, const String &p_input);
+
+	// Prompt / host.
+	void _open_prompt(PromptKind p_kind);
+	void _close_prompt();
+	void _prompt_key(const String &p_key);
+	void _run_command_line(const String &p_text);
+	Dictionary _host_args() const;
+	void _host(HostCommand p_cmd, const Dictionary &p_extra = Dictionary());
+	String _symbol_at_primary() const;
+
+protected:
+	static void _bind_methods();
+
+public:
+	// ---- lifecycle -------------------------------------------------------------------
+	// Attach to a CodeEdit (nullptr detaches). Does not take ownership and does not connect
+	// to gui_input: the host forwards events through handle_gui_input().
+	void attach(CodeEdit *p_text_edit);
+	CodeEdit *get_text_edit() const { return text_edit; }
+
+	// Disabled (the default) = the CodeEdit behaves exactly like stock Godot. Disabling or
+	// detaching closes any undo group the core left open and leaves the native carets and
+	// selections in a state stock Godot is happy with.
+	void set_enabled(bool p_enabled);
+	bool is_enabled() const { return enabled; }
+
+	// ---- input -----------------------------------------------------------------------
+	// The host calls this FIRST for every event of the CodeEdit's gui_input signal. Returns
+	// true when the event was consumed (the host then calls accept_event() and stops).
+	// Returns false for everything Helix mode does not handle, which must then reach the
+	// CodeEdit / editor shortcuts untouched (typing in insert mode, Ctrl+S, mouse, ...).
+	bool handle_gui_input(const Ref<InputEvent> &p_event);
+
+	// Feeds keys in Helix's own notation, exactly as Helix's test-suite and macros write
+	// them: "3w", "<esc>", "<ret>", "<space>f", "<A-;>", "<C-d>", "<tab>", "<backspace>",
+	// "<del>", "<lt>", "<gt>", "<minus>", "<left>", ... Printable keys reach the CodeEdit
+	// as real key events when in insert mode, so native behaviour (auto-indent, auto-brace,
+	// completion) is exercised. While a prompt is open, fed keys edit the prompt text
+	// (<ret> submits, <esc> cancels). Used by tests.
+	void feed_keys(const String &p_keys);
+
+	// Drops an unfinished command (count, register, prefix keys such as "g"), e.g. when the
+	// editor loses focus or its tab is switched away.
+	void cancel_pending();
+
+	// The host wraps native editing commands (Edit / context menu items) in these, so they act
+	// on the true Helix selections; see also handle_gui_input() for shortcuts. Nestable.
+	void begin_native_command();
+	void end_native_command();
+
+	// ---- state for the host UI (re-read on `state_changed`) --------------------------
+	Mode get_mode() const { return mode; }
+	// Count + keys typed so far of an unfinished command, e.g. "2m" or "g". Empty when idle.
+	String get_pending_keys() const;
+	// Title and entries of the which-key popup for the current pending prefix; empty vector
+	// when no popup should be shown.
+	String get_pending_menu_title() const;
+	Vector<KeyHint> get_pending_menu() const;
+	// Last status message ("Surround pair not found", "Pattern not found: foo", ...). Cleared
+	// by the next key press.
+	String get_status_message() const;
+	bool is_status_message_error() const;
+	// Number of selections (for the status bar, like Helix's "2 sels").
+	int get_selection_count() const;
+
+	// ---- rendering (the host's TextEdit modal draw provider calls this on every draw) ----
+	// Helix's selection highlights (helix-term doc_selection_highlights) for lines
+	// p_first_line..p_last_line, in TextEdit::set_modal_draw_provider() format. Ranges are
+	// those visible right now: during insert mode as tracked so far, after a mouse selection or
+	// Find as they will be adopted. p_cursor_is_block: the current mode's cursor shape is a
+	// block (otherwise the primary cursor is the native caret). Returns null when the CodeEdit
+	// should be drawn natively (disabled; native selections made in insert mode).
+	Variant get_selection_highlights(bool p_cursor_is_block, int p_first_line, int p_last_line) const;
+
+	// ---- options (the host sets these from editor settings) ---------------------------
+	// true (default): `y` yanks the primary selection to the system clipboard and `p` pastes
+	// the system clipboard before the selection (the user's Helix config: y = :clipboard-yank,
+	// p = :clipboard-paste-before). false: stock Helix `y` / `p` on the default register.
+	// Everything else is stock in both cases (d/c yank to the default register, P/R use it,
+	// <space>y/p/P/R use the system clipboard).
+	void set_use_system_clipboard(bool p_enabled);
+	bool is_using_system_clipboard() const;
+
+	// ---- prompt (search, regex select/split/keep/remove, ':' command line) ------------
+	// When a command needs text input, the core switches to a prompt state and emits
+	// `state_changed`. The host shows a LineEdit and reports back with the calls below.
+	// The core never creates UI.
+	PromptKind get_prompt_kind() const;
+	String get_prompt_prefix() const; // "/", "?", "select:", "split:", "keep:", "remove:", ":".
+	String get_prompt_text() const; // Text the prompt should start with / currently has.
+	void prompt_update(const String &p_text); // Live preview while typing (incremental search).
+	void prompt_submit(const String &p_text);
+	void prompt_cancel();
+
+	// ---- test / debug helpers ---------------------------------------------------------
+	// Buffer and selections in Helix's test notation: "#[" "]#" delimit the primary selection
+	// and "#(" ")#" the others, with "|" on the head side: "#[foo|]#" is a forward range,
+	// "#[|foo]#" a backward one. set_state_annotated() also resets mode to normal.
+	String get_state_annotated() const;
+	void set_state_annotated(const String &p_annotated);
+
+	HelixMode();
+	~HelixMode();
+};
+
+VARIANT_ENUM_CAST(HelixMode::Mode);
+VARIANT_ENUM_CAST(HelixMode::HostCommand);
+VARIANT_ENUM_CAST(HelixMode::PromptKind);
