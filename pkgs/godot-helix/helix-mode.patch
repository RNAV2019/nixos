+HelixSelection HelixChangeSet::map_selection(const HelixSelection &p_sel) const {
+	HelixSelection s = p_sel;
+	if (is_empty()) {
+		return s;
+	}
+	for (int i = 0; i < s.ranges.size(); i++) {
