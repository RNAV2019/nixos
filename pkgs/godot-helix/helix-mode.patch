+		_hint(out, "d", "Goto definition");
+		_hint(out, "t", "Goto window top");
+		_hint(out, "c", "Goto window center");
+		_hint(out, "b", "Goto window bottom");
+		_hint(out, "a", "Goto last accessed file");
+		_hint(out, "n", "Goto next buffer");
+		_hint(out, "p", "Goto previous buffer");
+		_hint(out, "k", sel_mode ? "Extend up" : "Move up");
+		_hint(out, "j", sel_mode ? "Extend down" : "Move down");
+	} else if (pending == "m") {
+		_hint(out, "m", "Goto matching bracket");
