+bool is_line_ending(char32_t p_c);
+bool is_whitespace(char32_t p_c); // Rust char::is_whitespace (line endings included).
+bool is_blank(char32_t p_c); // helix char_is_whitespace (no line endings).
+bool is_word(char32_t p_c);
+bool is_punctuation(char32_t p_c);
+bool is_lower(char32_t p_c);
+bool is_upper(char32_t p_c);
+CharCategory categorize(char32_t p_c);
+int char_width(char32_t p_c);
+
+// Range helpers.
+int64_t cursor(const HelixDoc &p_doc, const HelixRange &p_range);
+int cursor_line(const HelixDoc &p_doc, const HelixRange &p_range);
+HelixRange put_cursor(const HelixDoc &p_doc, const HelixRange &p_range, int64_t p_pos, bool p_extend);
+HelixRange grapheme_aligned(const HelixDoc &p_doc, const HelixRange &p_range);
+HelixRange min_width_1(const HelixDoc &p_doc, const HelixRange &p_range);
+void line_range(const HelixDoc &p_doc, const HelixRange &p_range, int &r_start, int &r_end);
+void ensure_invariants(const HelixDoc &p_doc, HelixSelection &r_sel);
+bool is_single_grapheme(const HelixDoc &p_doc, const HelixRange &p_range);
+
+// Visual columns (tabs, wide characters) on one line.
+int visual_col(const HelixDoc &p_doc, int64_t p_pos, int p_tab_width);
+int64_t pos_at_visual_col(const HelixDoc &p_doc, int p_line, int p_col, int p_tab_width, bool p_block_semantics);
+
+// Motions.
+HelixRange move_horizontally(const HelixDoc &p_doc, const HelixRange &p_range, bool p_forward, int p_count, bool p_extend);
+HelixRange move_vertically(const HelixDoc &p_doc, const HelixRange &p_range, bool p_forward, int p_count, bool p_extend, int p_tab_width);
+
+enum WordTarget {
+	NEXT_WORD_START,
+	NEXT_WORD_END,
+	PREV_WORD_START,
+	PREV_WORD_END,
+	NEXT_LONG_WORD_START,
+	NEXT_LONG_WORD_END,
+	PREV_LONG_WORD_START,
+	PREV_LONG_WORD_END,
+};
+HelixRange word_move(const HelixDoc &p_doc, const HelixRange &p_range, int p_count, WordTarget p_target);
+HelixRange move_next_paragraph(const HelixDoc &p_doc, const HelixRange &p_range, int p_count, bool p_extend);
+HelixRange move_prev_paragraph(const HelixDoc &p_doc, const HelixRange &p_range, int p_count, bool p_extend);
+
+int64_t find_nth_next(const HelixDoc &p_doc, char32_t p_c, int64_t p_pos, int p_n); // -1 when not found.
+int64_t find_nth_prev(const HelixDoc &p_doc, char32_t p_c, int64_t p_pos, int p_n);
+
+// Text objects.
+HelixRange textobject_word(const HelixDoc &p_doc, const HelixRange &p_range, bool p_inside, bool p_long);
+HelixRange textobject_paragraph(const HelixDoc &p_doc, const HelixRange &p_range, bool p_inside, int p_count);
+HelixRange textobject_pair(const HelixDoc &p_doc, const HelixRange &p_range, bool p_inside, char32_t p_ch, int p_count); // p_ch == 0: closest pair.
+
+// Brackets and surround pairs.
+void get_pair(char32_t p_c, char32_t &r_open, char32_t &r_close);
+bool is_open_bracket(char32_t p_c);
+bool is_close_bracket(char32_t p_c);
+int64_t find_matching_bracket_plaintext(const HelixDoc &p_doc, int64_t p_pos); // -1 when none.
+enum SurroundError {
+	SURROUND_OK,
+	SURROUND_PAIR_NOT_FOUND,
+	SURROUND_CURSOR_OVERLAP,
+	SURROUND_RANGE_EXCEEDS_TEXT,
+	SURROUND_CURSOR_ON_AMBIGUOUS_PAIR,
+};
+String surround_error_message(SurroundError p_error);
+SurroundError find_nth_pairs_pos(const HelixDoc &p_doc, char32_t p_ch, const HelixRange &p_range, int p_n, int64_t &r_anchor, int64_t &r_head);
+SurroundError find_nth_closest_pairs_pos(const HelixDoc &p_doc, const HelixRange &p_range, int p_skip, int64_t &r_anchor, int64_t &r_head);
+SurroundError get_surround_pos(const HelixDoc &p_doc, const HelixSelection &p_sel, char32_t p_ch, int p_skip, Vector<int64_t> &r_positions);
+
+// Misc.
+String switch_case(const String &p_text);
+String to_upper(const String &p_text);
+String to_lower(const String &p_text);
+bool increment_integer(const String &p_text, int64_t p_amount, String &r_result);
+String regex_escape(const String &p_text);
+
+} // namespace HelixAlgo
