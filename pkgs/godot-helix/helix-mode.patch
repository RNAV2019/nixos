+void TextEdit::_draw_caret_cell(int p_caret, RID p_rid, const Glyph *p_glyphs, int p_glyph_count, int p_char_margin, int p_baseline_y, float p_text_height, float p_line_ascent, float p_space_width, int p_xmargin_beg, int p_xmargin_end, bool p_rtl) const {
+	const int caret_width = theme_cache.caret_width * MAX(1, theme_cache.base_scale);
+	const int column = get_caret_column(p_caret);
+	const Vector2i range = TS->shaped_text_get_range(p_rid);
+
+	// Horizontal extent of the character (grapheme) under the caret. Tabs and wide characters
+	// cover their full advance; past the end of the line (or on an empty line) the cell is one
+	// space wide.
+	int next_column = column;
+	Vector<Vector2> cell;
+	if (column >= range.x && column < range.y) {
+		next_column = MAX(column + 1, (int)TS->shaped_text_next_character_pos(p_rid, column));
+		cell = TS->shaped_text_get_selection(p_rid, column, next_column);
+	}
+	if (cell.is_empty()) {
+		const float x = get_caret_draw_pos(p_caret).x - p_char_margin;
+		cell.push_back(p_rtl ? Vector2(x - p_space_width, x) : Vector2(x, x + p_space_width));
+	}
+
+	const float top = p_baseline_y - theme_cache.font->get_ascent(theme_cache.font_size);
+	const float height = theme_cache.font->get_height(theme_cache.font_size);
+	const bool block = caret_shape_override == CARET_SHAPE_OVERRIDE_BLOCK;
+
+	for (const Vector2 &span : cell) {
+		Rect2 rect(p_char_margin + MIN(span.x, span.y), top, Math::abs(span.y - span.x), height);
+		if (rect.position.x + rect.size.x <= p_xmargin_beg || rect.position.x >= p_xmargin_end) {
+			continue;
+		}
+		if (rect.position.x < p_xmargin_beg) {
+			rect.size.x -= p_xmargin_beg - rect.position.x;
+			rect.position.x = p_xmargin_beg;
+		}
+		if (rect.position.x + rect.size.x > p_xmargin_end) {
+			rect.size.x = p_xmargin_end - rect.position.x;
+		}
+		if (!block) {
+			const int thickness = MAX(2, 2 * caret_width);
+			rect.position.y += rect.size.y - thickness;
+			rect.size.y = thickness;
+		}
+		RS::get_singleton()->canvas_item_add_rect(text_ci, rect, theme_cache.caret_color);
+	}
+
+	if (!block || next_column == column) {
+		return;
+	}
+
+	// Redraw the character under the block in the caret background color, so it stays legible.
+	const Color color = theme_cache.caret_background_color;
+	float ofs = 0.0;
+	for (int j = 0; j < p_glyph_count; j++) {
+		const Glyph &glyph = p_glyphs[j];
+		const bool covered = glyph.start < next_column && glyph.end > column;
+		for (int k = 0; k < glyph.repeat; k++) {
+			const float x = p_char_margin + ofs;
+			if (covered && x >= p_xmargin_beg && x + glyph.advance <= p_xmargin_end) {
+				if (draw_tabs && (glyph.flags & TextServer::GRAPHEME_IS_TAB) == TextServer::GRAPHEME_IS_TAB) {
+					const int yofs = (p_text_height - theme_cache.tab_icon->get_height()) / 2 - p_line_ascent;
+					theme_cache.tab_icon->draw(text_ci, Point2(x, p_baseline_y + yofs), color);
+				} else if (draw_spaces && (glyph.flags & TextServer::GRAPHEME_IS_SPACE) == TextServer::GRAPHEME_IS_SPACE && (glyph.flags & TextServer::GRAPHEME_IS_VIRTUAL) != TextServer::GRAPHEME_IS_VIRTUAL) {
+					const int yofs = (p_text_height - theme_cache.space_icon->get_height()) / 2 - p_line_ascent;
+					const int xofs = (glyph.advance * glyph.repeat - theme_cache.space_icon->get_width()) / 2;
+					theme_cache.space_icon->draw(text_ci, Point2(x + xofs, p_baseline_y + yofs), color);
+				}
+				if (glyph.font_rid != RID()) {
+					TS->font_draw_glyph(glyph.font_rid, text_ci, glyph.font_size, Vector2(x + glyph.x_off, p_baseline_y + glyph.y_off), glyph.index, color);
+				} else if ((glyph.flags & TextServer::GRAPHEME_IS_VIRTUAL) != TextServer::GRAPHEME_IS_VIRTUAL && (glyph.flags & TextServer::GRAPHEME_IS_EMBEDDED_OBJECT) != TextServer::GRAPHEME_IS_EMBEDDED_OBJECT) {
+					TS->draw_hex_code_box(text_ci, glyph.font_size, Vector2(x + glyph.x_off, p_baseline_y + glyph.y_off), glyph.index, color);
+				}
+			}
+			ofs += glyph.advance;
+		}
+	}
+}
