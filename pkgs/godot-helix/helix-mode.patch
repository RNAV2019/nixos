+int64_t cursor(const HelixDoc &p_doc, const HelixRange &p_range) {
+	if (p_range.head > p_range.anchor) {
+		return p_doc.prev_grapheme(p_range.head);
+	}
+	return p_range.head;
+}
+
+int cursor_line(const HelixDoc &p_doc, const HelixRange &p_range) {
+	return p_doc.char_to_line(cursor(p_doc, p_range));
+}
+
+HelixRange put_cursor(const HelixDoc &p_doc, const HelixRange &p_range, int64_t p_pos, bool p_extend) {
+	if (!p_extend) {
+		return HelixRange::point(p_pos);
+	}
+	int64_t anchor = p_range.anchor;
+	if (p_range.head >= p_range.anchor && p_pos < p_range.anchor) {
+		anchor = p_doc.next_grapheme(p_range.anchor);
+	} else if (p_range.head < p_range.anchor && p_pos >= p_range.anchor) {
+		anchor = p_doc.prev_grapheme(p_range.anchor);
+	}
+	if (anchor <= p_pos) {
+		return HelixRange(anchor, p_doc.next_grapheme(p_pos));
+	}
+	return HelixRange(anchor, p_pos);
+}
+
+HelixRange grapheme_aligned(const HelixDoc &p_doc, const HelixRange &p_range) {
+	int64_t a;
+	int64_t h;
+	if (p_range.anchor == p_range.head) {
+		a = h = p_doc.ensure_grapheme_prev(p_range.anchor);
+	} else if (p_range.anchor < p_range.head) {
+		a = p_doc.ensure_grapheme_prev(p_range.anchor);
+		h = p_doc.ensure_grapheme_next(p_range.head);
+	} else {
+		a = p_doc.ensure_grapheme_next(p_range.anchor);
+		h = p_doc.ensure_grapheme_prev(p_range.head);
+	}
+	HelixRange r(a, h);
+	r.old_col = a == p_range.anchor ? p_range.old_col : -1;
+	return r;
+}
+
+HelixRange min_width_1(const HelixDoc &p_doc, const HelixRange &p_range) {
+	if (p_range.anchor == p_range.head) {
+		HelixRange r(p_range.anchor, p_doc.next_grapheme(p_range.head));
+		r.old_col = p_range.old_col;
+		return r;
+	}
+	return p_range;
+}
+
+void line_range(const HelixDoc &p_doc, const HelixRange &p_range, int &r_start, int &r_end) {
+	int64_t from = p_range.from();
+	int64_t to = p_range.is_empty() ? p_range.to() : MAX(p_doc.prev_grapheme(p_range.to()), from);
+	r_start = p_doc.char_to_line(from);
+	r_end = p_doc.char_to_line(to);
+}
+
+void ensure_invariants(const HelixDoc &p_doc, HelixSelection &r_sel) {
+	int64_t l = p_doc.len();
+	for (int i = 0; i < r_sel.ranges.size(); i++) {
+		HelixRange r = r_sel.ranges[i];
+		r.anchor = CLAMP(r.anchor, (int64_t)0, l);
+		r.head = CLAMP(r.head, (int64_t)0, l);
+		r_sel.ranges.write[i] = grapheme_aligned(p_doc, min_width_1(p_doc, r));
+	}
+	r_sel.normalize();
+}
+
+bool is_single_grapheme(const HelixDoc &p_doc, const HelixRange &p_range) {
+	if (p_range.is_empty()) {
+		return false;
+	}
+	return p_doc.next_grapheme(p_range.from()) >= p_range.to();
+}
+
+int visual_col(const HelixDoc &p_doc, int64_t p_pos, int p_tab_width) {
+	int line = p_doc.char_to_line(p_pos);
+	int64_t start = p_doc.line_to_char(line);
+	int64_t pos = p_doc.ensure_grapheme_prev(p_pos);
+	int col = 0;
+	int64_t i = start;
+	while (i < pos) {
+		int64_t n = p_doc.next_grapheme(i);
+		col += p_doc.grapheme_width_at(i, n, col, p_tab_width);
+		i = n;
+	}
+	return col;
+}
+
+int64_t pos_at_visual_col(const HelixDoc &p_doc, int p_line, int p_col, int p_tab_width, bool p_block_semantics) {
+	(void)p_block_semantics;
+	int64_t i = p_doc.line_to_char(p_line);
+	int64_t end = p_doc.line_end(p_line);
+	int col = 0;
+	while (i < end) {
+		int64_t n = p_doc.next_grapheme(i);
+		int w = p_doc.grapheme_width_at(i, n, col, p_tab_width);
+		if (col + w > p_col) {
+			return i;
+		}
+		col += w;
+		i = n;
+	}
+	return end;
+}
+
+HelixRange move_horizontally(const HelixDoc &p_doc, const HelixRange &p_range, bool p_forward, int p_count, bool p_extend) {
+	int64_t pos = cursor(p_doc, p_range);
+	int64_t np = p_forward ? p_doc.next_grapheme(pos, p_count) : p_doc.prev_grapheme(pos, p_count);
+	return put_cursor(p_doc, p_range, np, p_extend);
+}
+
+HelixRange move_vertically(const HelixDoc &p_doc, const HelixRange &p_range, bool p_forward, int p_count, bool p_extend, int p_tab_width) {
+	int64_t pos = cursor(p_doc, p_range);
+	int line = p_doc.char_to_line(pos);
+	int col = p_range.old_col >= 0 ? p_range.old_col : visual_col(p_doc, pos, p_tab_width);
+	int lc = p_doc.line_count();
+	int64_t new_line = p_forward ? (int64_t)line + p_count : MAX((int64_t)line - p_count, (int64_t)0);
+	if (new_line >= lc - 1) {
+		new_line = lc - 1;
+	}
+	int64_t new_pos = pos_at_visual_col(p_doc, (int)new_line, col, p_tab_width, true);
+	// Special case to avoid moving to the end of the last non-empty line.
+	if (p_extend && new_line == lc - 1 && p_doc.line_length((int)new_line) == 0) {
+		return p_range;
+	}
+	HelixRange r = put_cursor(p_doc, p_range, new_pos, p_extend);
+	r.old_col = col;
+	return r;
+}
