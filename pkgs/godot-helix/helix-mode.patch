+bool ScriptEditor::helix_host_command(int p_command, const Dictionary &p_args) {
+	switch (p_command) {
+		case HelixMode::HOST_NEXT_TAB:
+		case HelixMode::HOST_PREV_TAB: {
+			// Same as the "Next Script" / "Previous Script" shortcuts.
+			const int count = script_list->get_item_count();
+			if (count > 1) {
+				const int step = p_command == HelixMode::HOST_NEXT_TAB ? 1 : -1;
+				const int next = (script_list->get_current() + step + count) % count;
+				_go_to_tab(script_list->get_item_metadata(next));
+				_update_script_names();
+			}
+		} break;
+		case HelixMode::HOST_LAST_TAB: {
+			const int previous = tab_container->get_previous_tab();
+			if (previous >= 0 && previous != tab_container->get_current_tab()) {
+				_go_to_tab(previous);
+				_update_script_names();
+			}
+		} break;
+		case HelixMode::HOST_SAVE: {
+			_menu_option(FILE_MENU_SAVE);
+		} break;
+		case HelixMode::HOST_SAVE_ALL: {
+			_menu_option(FILE_MENU_SAVE_ALL);
+		} break;
+		case HelixMode::HOST_CLOSE: {
+			ScriptEditorBase *current = _get_current_editor();
+			if (p_args.get("save_first", false)) {
+				_menu_option(FILE_MENU_SAVE);
+				if (current && current->is_unsaved()) {
+					// Not saved (yet): a new script opened the Save As dialog, or saving failed.
+					// Close nothing; :wq again once it is saved.
+					return true;
+				}
+			}
+			if (p_args.get("force", false) && current && current->is_unsaved()) {
+				_close_discard_current_tab(String());
+			} else {
+				// Asks before closing a tab with unsaved changes.
+				_menu_option(FILE_MENU_CLOSE);
+			}
+		} break;
+		default: {
+			return false;
+		}
+	}
+	return true;
+}
