+		_hint(out, "r", "Surround replace");
+		_hint(out, "d", "Surround delete");
+		_hint(out, "a", "Select around object");
+		_hint(out, "i", "Select inside object");
+	} else if (pending == "z" || pending == "Z") {
+		_hint(out, "z, c", "Align view center");
+		_hint(out, "t", "Align view top");
+		_hint(out, "b", "Align view bottom");
+		_hint(out, "k, <up>", "Scroll view up");
+		_hint(out, "j, <down>", "Scroll view down");
+		_hint(out, "<C-b>, <pageup>", "Move page up");
+		_hint(out, "<C-f>, <pagedown>", "Move page down");
+		_hint(out, "<C-u>, <backspace>", "Move page and cursor half up");
+		_hint(out, "<C-d>, <space>", "Move page and cursor half down");
+		_hint(out, "/", "Search for regex pattern");
+		_hint(out, "?", "Reverse search for regex pattern");
+		_hint(out, "n", "Select next search match");
+		_hint(out, "N", "Select previous search match");
+	} else if (pending == "<space>") {
+		_hint(out, "f", "Open file picker");
+		_hint(out, "k", "Show docs for item under cursor");
+		_hint(out, "/", "Global search in workspace folder");
+		_hint(out, "?", "Open command palette");
+		_hint(out, "y", "Yank selections to clipboard");
+		_hint(out, "Y", "Yank main selection to clipboard");
+		_hint(out, "p", "Paste clipboard after selections");
+		_hint(out, "P", "Paste clipboard before selections");
+		_hint(out, "R", "Replace selections by clipboard content");
+		_hint(out, "c", "Comment/uncomment selections");
+		_hint(out, "<A-c>", "Line comment/uncomment selections");
+	} else if (pending == "[") {
+		_hint(out, "p", "Goto previous paragraph");
+		_hint(out, "<space>", "Add newline above");
+	} else if (pending == "]") {
+		_hint(out, "p", "Goto next paragraph");
+		_hint(out, "<space>", "Add newline below");
+	} else if (pending == "mi" || pending == "ma") {
+		_hint(out, "w", "Word");
+		_hint(out, "W", "WORD");
+		_hint(out, "p", "Paragraph");
+		_hint(out, "m", "Closest surrounding pair");
+		_hint(out, "<space>", "... or any character acting as a pair");
+	} else if (pending == "ms" || (pending.begins_with("mr") && pending.length() == 3)) {
+		_hint(out, "( or )", "Parentheses");
+		_hint(out, "{ or }", "Curly braces");
+		_hint(out, "< or >", "Angled brackets");
+		_hint(out, "[ or ]", "Square brackets");
+		_hint(out, "<space>", "... or any character");
+	} else if (pending == "mr" || pending == "md") {
+		_hint(out, "m", "Nearest matching pair");
+		_hint(out, "( or )", "Parentheses");
+		_hint(out, "{ or }", "Curly braces");
+		_hint(out, "< or >", "Angled brackets");
+		_hint(out, "[ or ]", "Square brackets");
+		_hint(out, "<space>", "... or any character");
+	}
+	return out;
