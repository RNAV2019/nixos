+int CodeEdit::_relative_line_number(int p_line) {
+	// Distance in rows on screen from the primary caret's row to the first row of p_line:
+	// lines hidden by folds do not count and soft-wrapped lines count one per row, like the
+	// caret moving up / down.
+	const int caret_line = get_caret_line(0);
+	if (get_line_wrapping_mode() == LINE_WRAPPING_NONE && !is_line_folding_enabled()) {
+		return Math::abs(p_line - caret_line);
+	}
+	const int caret_wrap = get_caret_wrap_index(0);
+	// Lines are drawn top to bottom: continue from the previous line of the same draw instead
+	// of counting from the caret every time.
+	const uint64_t frame = Engine::get_singleton()->get_frames_drawn();
+	auto &memo = relative_line_number_memo;
+	const bool same_side = (memo.line < caret_line) == (p_line < caret_line);
+	int rows;
+	if (memo.frame == frame && memo.caret_line == caret_line && memo.caret_wrap == caret_wrap && memo.line >= 0 && memo.line < p_line && same_side) {
+		// Rows from the first row of memo.line to the first row of p_line.
+		const int step = get_visible_line_count_in_range(memo.line, p_line) - get_line_wrap_count(p_line) - 1;
+		rows = p_line > caret_line ? memo.rows + step : memo.rows - step;
+	} else if (p_line > caret_line) {
+		rows = get_visible_line_count_in_range(caret_line, p_line) - caret_wrap - get_line_wrap_count(p_line) - 1;
+	} else {
+		rows = get_visible_line_count_in_range(p_line, caret_line) - get_line_wrap_count(caret_line) - 1 + caret_wrap;
+	}
+	memo.frame = frame;
+	memo.caret_line = caret_line;
+	memo.caret_wrap = caret_wrap;
+	memo.line = p_line;
+	memo.rows = rows;
+	return MAX(rows, 1);
+}
