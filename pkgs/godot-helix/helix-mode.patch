+/*** HELIX MODE ***/
+
+bool CodeTextEditor::is_helix_mode_enabled() const {
+	return helix && helix->is_enabled();
+}
+
+void CodeTextEditor::helix_native_command(bool p_begin) {
+	if (!helix) {
+		return;
+	}
+	if (p_begin) {
+		helix->begin_native_command();
+	} else {
+		helix->end_native_command();
+	}
+}
+
+void CodeTextEditor::set_helix_message(const String &p_message, bool p_error) {
+	helix_host_message = p_message;
+	helix_host_message_error = p_error;
+	_helix_update_status();
+}
+
+void CodeTextEditor::_helix_state_changed() {
+	// A host message only lives until the next state change (i.e. the next key press).
+	helix_host_message = String();
+	helix_host_message_error = false;
+	_helix_update_visuals();
+}
+
+void CodeTextEditor::_helix_update_visuals() {
+	const bool enabled = helix->is_enabled();
+	const HelixMode::Mode mode = helix->get_mode();
+
+	TextEdit::CaretShapeOverride shape = TextEdit::CARET_SHAPE_OVERRIDE_NONE;
+	if (enabled) {
+		switch (mode) {
+			case HelixMode::MODE_NORMAL:
+				shape = TextEdit::CARET_SHAPE_OVERRIDE_BLOCK;
+				break;
+			case HelixMode::MODE_INSERT:
+				shape = TextEdit::CARET_SHAPE_OVERRIDE_BAR;
+				break;
+			case HelixMode::MODE_SELECT:
+				shape = TextEdit::CARET_SHAPE_OVERRIDE_UNDERLINE;
+				break;
+		}
+	}
+	text_editor->set_caret_shape_override(shape);
+	text_editor->set_line_numbers_relative(enabled && helix_relative_line_numbers && mode != HelixMode::MODE_INSERT);
+
+	// Selections and cursors are drawn the Helix way (painted cells, primary / secondary colors),
+	// from the core's selection highlights. Colors derive from the text editor theme: the primary
+	// selection and cursor use the stock selection and caret colors, secondary ones are dimmer,
+	// secondary cursors in select mode take the SELECT mode color (like Helix's ui.cursor.select).
+	if (enabled) {
+		const Color selection = text_editor->get_theme_color(SNAME("selection_color"));
+		const Color caret = text_editor->get_theme_color(SNAME("caret_color"));
+		const Color background = EDITOR_GET("text_editor/theme/highlighting/background_color");
+		Color secondary_cursor = caret.lerp(background, 0.45);
+		if (mode == HelixMode::MODE_SELECT) {
+			secondary_cursor = get_theme_color(SNAME("warning_color"), EditorStringName(Editor));
+		}
+		secondary_cursor.a = 1.0;
+		text_editor->set_modal_draw_colors(selection, Color(selection, selection.a * 0.5), Color(caret, 1.0), secondary_cursor, text_editor->get_theme_color(SNAME("caret_background_color")));
+		text_editor->set_modal_draw_provider(callable_mp(this, &CodeTextEditor::_helix_draw_spans));
+	} else {
+		text_editor->set_modal_draw_provider(Callable());
+	}
+	text_editor->queue_redraw();
+
+	_helix_update_status();
+	_helix_update_key_hints();
+	_helix_update_prompt();
+}
+
+Variant CodeTextEditor::_helix_draw_spans(int p_first_line, int p_last_line) const {
+	if (!is_helix_mode_enabled()) {
+		return Variant();
+	}
+	return helix->get_selection_highlights(text_editor->get_caret_shape_override() == TextEdit::CARET_SHAPE_OVERRIDE_BLOCK, p_first_line, p_last_line);
+}
+
+void CodeTextEditor::_helix_update_status() {
+	if (!is_helix_mode_enabled()) {
+		helix_mode_label->hide();
+		helix_status->hide();
+		return;
+	}
+
+	String mode_text;
+	Color mode_color;
+	switch (helix->get_mode()) {
+		case HelixMode::MODE_NORMAL:
+			mode_text = "NORMAL";
+			mode_color = get_theme_color(SNAME("accent_color"), EditorStringName(Editor));
+			break;
+		case HelixMode::MODE_INSERT:
+			mode_text = "INSERT";
+			mode_color = get_theme_color(SNAME("success_color"), EditorStringName(Editor));
+			break;
+		case HelixMode::MODE_SELECT:
+			mode_text = "SELECT";
+			mode_color = get_theme_color(SNAME("warning_color"), EditorStringName(Editor));
+			break;
+	}
+
+	if (helix_mode_label->get_text() != mode_text || !helix_mode_label->is_visible()) {
+		Ref<StyleBoxFlat> style;
+		style.instantiate();
+		style->set_bg_color(Color(mode_color, 0.2));
+		style->set_corner_radius_all(Math::round(3 * EDSCALE));
+		style->set_content_margin_individual(6 * EDSCALE, 0, 6 * EDSCALE, 0);
+		helix_mode_label->begin_bulk_theme_override();
+		helix_mode_label->add_theme_style_override(CoreStringName(normal), style);
+		helix_mode_label->add_theme_color_override(SceneStringName(font_color), mode_color);
+		helix_mode_label->end_bulk_theme_override();
+		helix_mode_label->set_text(mode_text);
+		helix_mode_label->set_tooltip_text(vformat(TTR("Helix mode: %s"), mode_text.capitalize()));
+		helix_mode_label->show();
+	}
+
+	const String pending = helix->get_pending_keys();
+	helix_pending_label->set_text(pending);
+	helix_pending_label->set_visible(!pending.is_empty());
+
+	const int selections = helix->get_selection_count();
+	helix_selections_label->set_text(vformat(TTR("%d sels"), selections));
+	helix_selections_label->set_visible(selections > 1);
+
+	String message = helix->get_status_message();
+	bool message_error = helix->is_status_message_error();
+	if (message.is_empty()) {
+		message = helix_host_message;
+		message_error = helix_host_message_error;
+	}
+	helix_message_label->set_text(message);
+	if (message_error) {
+		helix_message_label->add_theme_color_override(SceneStringName(font_color), get_theme_color(SNAME("error_color"), EditorStringName(Editor)));
+	} else {
+		helix_message_label->remove_theme_color_override(SceneStringName(font_color));
+	}
+	helix_message_label->set_visible(!message.is_empty());
+
+	helix_status->set_visible(helix_pending_label->is_visible() || helix_selections_label->is_visible() || helix_message_label->is_visible());
+}
+
+void CodeTextEditor::_helix_update_key_hints() {
+	const Vector<HelixMode::KeyHint> menu = is_helix_mode_enabled() && helix_show_key_hints ? helix->get_pending_menu() : Vector<HelixMode::KeyHint>();
+	if (menu.is_empty()) {
+		helix_key_hints->hide();
+		helix_key_hints_shown = String();
+		return;
+	}
+
+	// Rebuilt only when the menu changes (state_changed fires on every key).
+	const String title = helix->get_pending_menu_title();
+	String signature = title;
+	for (const HelixMode::KeyHint &hint : menu) {
+		signature += "\n" + hint.key + "\t" + hint.description;
+	}
+	if (signature == helix_key_hints_shown && helix_key_hints->is_visible()) {
+		return;
+	}
+	helix_key_hints_shown = signature;
+	helix_key_hints_keys.clear();
+	helix_key_hints_descriptions.clear();
+	for (const HelixMode::KeyHint &hint : menu) {
+		helix_key_hints_keys.push_back(hint.key);
+		helix_key_hints_descriptions.push_back(hint.description);
+	}
+	helix_key_hints_title->set_text(title);
+	helix_key_hints_title->set_visible(!title.is_empty());
+	helix_key_hints->show();
+	_helix_update_key_hints_position();
+}
+
+void CodeTextEditor::_helix_layout_key_hints(int p_rows_per_column) {
+	// Like Helix's info box: one line per key, keys in the accent color, tight rows. The menu
+	// is split into several key / description column pairs when it would be too tall.
+	const int count = helix_key_hints_keys.size();
+	const int rows = CLAMP(p_rows_per_column, 1, MAX(count, 1));
+	const int columns = (count + rows - 1) / rows;
+	while (helix_key_hints_columns->get_child_count() > columns * 2) {
+		Node *child = helix_key_hints_columns->get_child(helix_key_hints_columns->get_child_count() - 1);
+		helix_key_hints_columns->remove_child(child);
+		memdelete(child);
+	}
+	const Ref<Font> key_font = get_theme_font(SNAME("source"), EditorStringName(EditorFonts));
+	const int font_size = get_theme_font_size(SNAME("status_source_size"), EditorStringName(EditorFonts));
+	const Color key_color = get_theme_color(SNAME("accent_color"), EditorStringName(Editor));
+	Ref<StyleBoxEmpty> empty;
+	empty.instantiate();
+	while (helix_key_hints_columns->get_child_count() < columns * 2) {
+		const bool is_key = helix_key_hints_columns->get_child_count() % 2 == 0;
+		Label *label = memnew(Label);
+		label->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+		label->set_mouse_filter(MOUSE_FILTER_IGNORE);
+		label->set_v_size_flags(SIZE_SHRINK_BEGIN); // Columns start at the top.
+		label->begin_bulk_theme_override();
+		label->add_theme_style_override(CoreStringName(normal), empty);
+		label->add_theme_constant_override("line_spacing", 0);
+		label->add_theme_font_size_override(SceneStringName(font_size), font_size);
+		if (is_key) {
+			label->add_theme_font_override(SceneStringName(font), key_font);
+			label->add_theme_color_override(SceneStringName(font_color), key_color);
+		}
+		label->end_bulk_theme_override();
+		helix_key_hints_columns->add_child(label);
+	}
+	for (int c = 0; c < columns; c++) {
+		PackedStringArray keys;
+		PackedStringArray descriptions;
+		for (int r = 0; r < rows && c * rows + r < count; r++) {
+			keys.push_back(helix_key_hints_keys[c * rows + r]);
+			descriptions.push_back(helix_key_hints_descriptions[c * rows + r]);
+		}
+		Object::cast_to<Label>(helix_key_hints_columns->get_child(c * 2))->set_text(String("\n").join(keys));
+		Object::cast_to<Label>(helix_key_hints_columns->get_child(c * 2 + 1))->set_text(String("\n").join(descriptions));
+	}
+}
+
+void CodeTextEditor::_helix_update_key_hints_position() {
+	if (!helix_key_hints->is_visible()) {
+		return;
+	}
+
+	// Bottom-right corner of the text area, clear of the scrollbars and the minimap.
+	Vector2 corner = text_editor->get_size();
+	const VScrollBar *v_scroll = text_editor->get_v_scroll_bar();
+	if (v_scroll && v_scroll->is_visible()) {
+		corner.x -= v_scroll->get_size().x;
+	}
+	const HScrollBar *h_scroll = text_editor->get_h_scroll_bar();
+	if (h_scroll && h_scroll->is_visible()) {
+		corner.y -= h_scroll->get_size().y;
+	}
+	if (text_editor->is_drawing_minimap()) {
+		corner.x -= text_editor->get_minimap_width();
+	}
+	const float margin = 4 * EDSCALE;
+	const Vector2 available = (corner - Vector2(margin, margin) * 2).max(Vector2());
+
+	// As many rows per column as fit; more columns when the editor is short.
+	_helix_layout_key_hints(helix_key_hints_keys.size());
+	helix_key_hints->reset_size();
+	Size2 size = helix_key_hints->get_combined_minimum_size();
+	if (size.y > available.y && helix_key_hints_keys.size() > 1) {
+		// Measured row height: the key and description columns use different fonts.
+		float row_height = 1.0f;
+		for (int i = 0; i < MIN(2, helix_key_hints_columns->get_child_count()); i++) {
+			const Label *label = Object::cast_to<Label>(helix_key_hints_columns->get_child(i));
+			row_height = MAX(row_height, label->get_combined_minimum_size().y / MAX(1, label->get_line_count()));
+		}
+		const float chrome = size.y - row_height * helix_key_hints_keys.size();
+		_helix_layout_key_hints(MAX(1, (int)Math::floor((available.y - chrome) / row_height)));
+		helix_key_hints->reset_size();
+		size = helix_key_hints->get_combined_minimum_size();
+	}
+	// Never over the edges of the text area: when even that does not fit (a tiny editor), no
+	// popup; the pending keys are still shown in the status bar.
+	if (size.x > available.x || size.y > available.y) {
+		helix_key_hints->hide();
+		return;
+	}
+	helix_key_hints->set_size(size);
+	helix_key_hints->set_position((corner - size - Vector2(margin, margin)).max(Vector2()));
+}
+
+void CodeTextEditor::_helix_update_prompt() {
+	const HelixMode::PromptKind kind = is_helix_mode_enabled() ? helix->get_prompt_kind() : HelixMode::PROMPT_NONE;
+
+	if (kind != HelixMode::PROMPT_NONE) {
+		if (!helix_prompt_bar->is_visible() || helix_prompt_kind != kind) {
+			helix_prompt_kind = kind;
+			helix_prompt_prefix->set_text(helix->get_prompt_prefix());
+			const String text = helix->get_prompt_text();
+			helix_prompt_line->set_text(text);
+			helix_prompt_line->set_caret_column(text.length());
+			helix_prompt_bar->show();
+			if (is_visible_in_tree()) {
+				helix_prompt_line->grab_focus();
+			}
+		}
+		return;
+	}
+
+	helix_prompt_kind = HelixMode::PROMPT_NONE;
+	if (!helix_prompt_bar->is_visible()) {
+		return;
+	}
+
+	// Hiding the focused LineEdit makes it lose focus; that must not cancel again.
+	const bool had_focus = helix_prompt_line->has_focus();
+	helix_prompt_closing = true;
+	helix_prompt_bar->hide();
+	helix_prompt_line->clear();
+	helix_prompt_closing = false;
+	if (had_focus && text_editor->is_visible_in_tree()) {
+		text_editor->grab_focus();
+	}
+}
+
+void CodeTextEditor::_helix_prompt_text_changed(const String &p_text) {
+	if (helix_prompt_closing || helix_prompt_kind == HelixMode::PROMPT_NONE) {
+		return;
+	}
+	helix->prompt_update(p_text);
+}
+
+void CodeTextEditor::_helix_prompt_submitted(const String &p_text) {
+	if (helix_prompt_closing || helix_prompt_kind == HelixMode::PROMPT_NONE) {
+		return;
+	}
+	helix_prompt_closing = true;
+	helix->prompt_submit(p_text);
+	helix_prompt_closing = false;
+	_helix_update_prompt();
+}
+
+void CodeTextEditor::_helix_prompt_gui_input(const Ref<InputEvent> &p_event) {
+	if (helix_prompt_kind == HelixMode::PROMPT_NONE || !p_event->is_action_pressed(SNAME("ui_cancel"), false, true)) {
+		return;
+	}
+	helix_prompt_line->accept_event();
+	if (helix_prompt_closing) {
+		return;
+	}
+	helix_prompt_closing = true;
+	helix->prompt_cancel();
+	helix_prompt_closing = false;
+	_helix_update_prompt();
+}
+
+void CodeTextEditor::_helix_prompt_focus_exited() {
+	if (helix_prompt_closing || helix_prompt_kind == HelixMode::PROMPT_NONE) {
+		return;
+	}
+	// Focus went elsewhere (click outside, tab switch): cancel, but leave focus where it went.
+	helix_prompt_closing = true;
+	helix->prompt_cancel();
+	helix_prompt_closing = false;
+	_helix_update_prompt();
+}
+
