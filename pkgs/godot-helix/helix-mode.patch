+void HelixMode::_on_lines_edited(int p_from, int p_to) {
+	doc.invalidate();
+}
+
+bool HelixMode::_alive() {
+	if (text_edit && ObjectDB::get_instance(text_edit_id) != text_edit) {
+		// The CodeEdit was freed while attached.
+		text_edit = nullptr;
+		doc.set_text_edit(nullptr);
+		complex_open = false;
+		mode = MODE_NORMAL;
+		prompt_kind = PROMPT_NONE;
+	}
+	return text_edit != nullptr;
+}
+
+void HelixMode::attach(CodeEdit *p_text_edit) {
+	_alive();
+	if (text_edit == p_text_edit) {
+		return;
+	}
+	if (text_edit) {
+		if (enabled) {
+			_restore_native_for_stock();
+		}
+		_connect_text_edit(false);
+	}
+	text_edit = p_text_edit;
+	text_edit_id = text_edit ? text_edit->get_instance_id() : ObjectID();
+	doc.set_text_edit(text_edit);
+	pushed_valid = false;
+	undo_info.clear();
+	redo_info.clear();
+	mode = MODE_NORMAL;
+	pending = String();
+	count = 0;
+	pending_register = false;
+	prompt_kind = PROMPT_NONE;
+	if (text_edit) {
+		_connect_text_edit(true);
+		if (enabled) {
+			_sync_from_native();
+			_push_selection();
+		}
+	}
+	_emit_if_changed();
+}
+
+void HelixMode::_connect_text_edit(bool p_connect) {
+	struct Conn {
+		StringName signal;
+		Callable callable;
+	};
+	const Conn conns[] = {
+		{ SNAME("lines_edited_from"), callable_mp(this, &HelixMode::_on_lines_edited) },
+		{ SNAME("caret_changed"), callable_mp(this, &HelixMode::_on_caret_changed) },
+		{ SceneStringName(focus_entered), callable_mp(this, &HelixMode::_on_focus_entered) },
+		{ SceneStringName(focus_exited), callable_mp(this, &HelixMode::_on_focus_exited) },
+		{ SNAME("text_set"), callable_mp(this, &HelixMode::_on_text_set) },
+	};
+	for (const Conn &c : conns) {
+		if (p_connect) {
+			text_edit->connect(c.signal, c.callable);
+		} else if (text_edit->is_connected(c.signal, c.callable)) {
+			text_edit->disconnect(c.signal, c.callable);
+		}
+	}
+	// Native cut / copy / paste go through the core only while Helix mode is on.
+	text_edit->set_clipboard_op_hook(p_connect && enabled ? callable_mp(this, &HelixMode::_on_native_clipboard_op) : Callable());
+}
+
+void HelixMode::_begin_complex() {
+	if (!complex_open) {
+		text_edit->begin_complex_operation();
+		complex_open = true;
+		complex_start_version = text_edit->get_version();
+	}
+}
+
+void HelixMode::_on_focus_exited() {
+	if (!enabled || !_alive()) {
+		return;
+	}
+	// An unfinished command does not survive a focus change (tab switch, click elsewhere).
+	cancel_pending();
+	if (mode == MODE_INSERT && complex_open) {
+		// (Same as _insert_close_segment().) While the editor is not focused, other code (saving, reloading the file, Find and
+		// Replace...) may edit the buffer: keep that out of the insert session's native undo
+		// step. The session continues (and 'u' still undoes all of it) when focus returns.
+		text_edit->start_action(TextEdit::ACTION_NONE);
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+}
+
+void HelixMode::_on_focus_entered() {
+	if (!enabled || !_alive() || mode != MODE_INSERT) {
+		return;
+	}
+	_insert_check_nav();
+	// The session's complex operation reopens with the next edit, see _insert_begin_edit().
+	text_edit->start_action(TextEdit::ACTION_NONE);
+}
+
+void HelixMode::_insert_close_segment() {
+	// Closes the insert session's native complex operation (it reopens with the next edit):
+	// before a native undo / redo, or other native commands, so they see a well-formed undo
+	// chain and undo the session typed so far as one step, like a stock typing burst.
+	if (mode == MODE_INSERT && complex_open) {
+		text_edit->start_action(TextEdit::ACTION_NONE);
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+}
+
+void HelixMode::_insert_begin_edit() {
+	// Called before a key reaches the CodeEdit in insert mode. The session's native complex
+	// operation is opened lazily, right before the first edit: a buffer change made in the
+	// meantime by other code (a reload from disk) stays an undo step of its own.
+	if (mode == MODE_INSERT && !complex_open && text_edit->is_editable()) {
+		_begin_complex();
+	}
+}
+
+void HelixMode::_on_text_set() {
+	// The whole text was replaced (reload from disk): u must not revert that, so the current
+	// Helix undo step starts again from here.
+	if (!enabled || !_alive()) {
+		return;
+	}
+	doc.invalidate();
+	if (step_open) {
+		step_version = text_edit->get_version();
+		step_sel_set = false;
+	}
+}
+
+void HelixMode::cancel_pending() {
+	if (pending.is_empty() && count == 0 && !pending_register) {
+		return;
+	}
+	pending = String();
+	count = 0;
+	pending_register = false;
+	if (step_open && prompt_kind == PROMPT_NONE && mode != MODE_INSERT && _alive()) {
+		_end_step();
+	}
+	_emit_if_changed();
+}
+
+void HelixMode::_restore_native_for_stock() {
+	// Leave the native carets in a state stock Godot is happy with: every Helix range becomes a
+	// native selection covering exactly the range (caret at its head); 1-wide cursors become
+	// plain carets on their character.
+	if (text_edit && mode == MODE_INSERT) {
+		text_edit->start_action(TextEdit::ACTION_NONE);
+	}
+	if (complex_open && text_edit) {
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+	if (!text_edit) {
+		return;
+	}
+	if (mode == MODE_INSERT) {
+		// Native carets are already collapsed insertion points.
+		step_open = false;
+		mode = MODE_NORMAL;
+		return;
+	}
+	if (!_native_matches_pushed()) {
+		if (!_native_is_pushed_layout()) {
+			return; // Native state changed under us; it is already a native state.
+		}
+		_sync_from_native(); // Moved along by an edit: re-derive, then convert.
+	}
+	_push_exact(false);
+}
+
+void HelixMode::_push_exact(bool p_cursors_as_selections) {
+	// Every Helix range becomes a native selection covering exactly the range, caret at its
+	// head. 1-wide cursors become plain carets on their character, or, with
+	// p_cursors_as_selections, one-character selections.
+	text_edit->begin_multicaret_edit();
+	text_edit->remove_secondary_carets();
+	text_edit->deselect();
+	Vector<int> order;
+	order.push_back(sel.primary);
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		if (i != sel.primary) {
+			order.push_back(i);
+		}
+	}
+	struct Pending {
+		int caret;
+		int ol, oc, cl, cc;
+	};
+	Vector<Pending> sels;
+	for (int k = 0; k < order.size(); k++) {
+		const HelixRange &r = sel.ranges[order[k]];
+		int cl, cc, ol, oc;
+		bool single = r.is_empty() || (!p_cursors_as_selections && is_single_grapheme(doc, r));
+		if (single) {
+			doc.pos_to_line_col(cursor(doc, r), cl, cc);
+			ol = cl;
+			oc = cc;
+		} else {
+			doc.pos_to_line_col(r.head, cl, cc);
+			doc.pos_to_line_col(r.anchor, ol, oc);
+		}
+		int ci = 0;
+		if (k == 0) {
+			text_edit->set_caret_line(cl, false, true, -1, 0);
+			text_edit->set_caret_column(cc, false, 0);
+		} else {
+			ci = text_edit->add_caret(cl, cc);
+			if (ci < 0) {
+				continue;
+			}
+		}
+		if (!single) {
+			Pending p = { ci, ol, oc, cl, cc };
+			sels.push_back(p);
+		}
+	}
+	for (int i = 0; i < sels.size(); i++) {
+		text_edit->select(sels[i].ol, sels[i].oc, sels[i].cl, sels[i].cc, sels[i].caret);
+	}
+	text_edit->end_multicaret_edit();
+	text_edit->merge_overlapping_carets();
+	pushed_valid = false;
+	exact_carets = _read_native();
+}
+
+void HelixMode::_on_native_clipboard_op(int p_op, bool p_begin) {
+	// Native editing commands (cut 0, copy 1, paste 2 through the TextEdit hook; any other
+	// command (-1) through begin/end_native_command()): in normal and select mode the native
+	// selection lacks the character under a forward range's block cursor, so these would act
+	// on one character too few. For their duration the native selections become the exact
+	// Helix selections. 1-wide cursors stay plain carets (Ctrl+V inserts before the cursor,
+	// Ctrl+Backspace deletes the word before it), except for cut and copy, which take the
+	// character under the cursor like Helix's y / d.
+	if (p_begin) {
+		if (_alive() && enabled) {
+			_insert_close_segment(); // Edit menu Undo etc. during insert mode.
+		}
+		const bool cursors_as_selections = p_op == 0 || p_op == 1;
+		if (clipboard_scope_depth++ > 0) {
+			if (cursors_as_selections && clipboard_scope_changed_native && !clipboard_scope_cursors && _alive() && text_edit->get_version() == pushed_version) {
+				_push_exact(true); // Copy / Cut from a menu inside an outer command scope.
+				clipboard_scope_cursors = true;
+			}
+			return;
+		}
+		clipboard_scope_changed_native = false;
+		clipboard_scope_cursors = false;
+		if (enabled && _alive() && mode != MODE_INSERT && prompt_kind == PROMPT_NONE && _native_matches_pushed()) {
+			_push_exact(cursors_as_selections);
+			clipboard_scope_changed_native = true;
+			clipboard_scope_cursors = cursors_as_selections;
+		}
+		return;
+	}
+	if (clipboard_scope_depth == 0 || --clipboard_scope_depth > 0) {
+		return;
+	}
+	if (clipboard_scope_changed_native && enabled && _alive() && mode != MODE_INSERT) {
+		// Copy leaves the text alone: show the Helix selections again. After an edit the native
+		// carets (exact selections now) are the new selections.
+		bool text_changed = text_edit->get_version() != pushed_version;
+		pushed_valid = false;
+		doc.invalidate();
+		if (text_changed) {
+			pending = String();
+			count = 0;
+		}
+		if (text_changed || !_native_is_exact_push()) {
+			sel = _selection_from_native(false);
+		}
+		_push_selection();
+	}
+	if (_alive()) {
+		_emit_if_changed();
+	}
+}
+
+void HelixMode::begin_native_command() {
+	_on_native_clipboard_op(-1, true);
+}
+
+void HelixMode::end_native_command() {
+	_on_native_clipboard_op(-1, false);
+}
+
+void HelixMode::_end_native_command_deferred() {
+	native_command_pending = false;
+	end_native_command();
+}
+
+void HelixMode::_adopt_native() {
+	// Selections made with the mouse (drag, double-click, shift+click) become Helix selections
+	// at once, so they keep their visible extent: drawn the Helix way, the character after a
+	// native forward selection would otherwise show the block cursor without being selected.
+	if (!enabled || !_alive() || mode == MODE_INSERT || prompt_kind != PROMPT_NONE) {
+		return;
+	}
+	if (_native_matches_pushed()) {
+		return;
+	}
+	_sync_from_native();
+	_push_selection();
+	_emit_if_changed();
+}
+
+void HelixMode::_unfold_carets() {
+	// Like the native caret: a cursor never sits on a line hidden by a fold.
+	for (int i = 0; i < text_edit->get_caret_count(); i++) {
+		int l = text_edit->get_caret_line(i);
+		if (_is_line_hidden(l)) {
+			text_edit->unfold_line(l);
+		}
+		if (text_edit->has_selection(i)) {
+			l = text_edit->get_selection_origin_line(i);
+			if (_is_line_hidden(l)) {
+				text_edit->unfold_line(l);
+			}
+		}
+	}
+}
+
+bool HelixMode::_is_line_hidden(int p_line) const {
+	if (!text_edit || p_line < 0 || p_line >= text_edit->get_line_count()) {
+		return false;
+	}
+	return text_edit->get_next_visible_line_offset_from(p_line, 1) != 1;
+}
+
+void HelixMode::set_enabled(bool p_enabled) {
+	_alive();
+	if (enabled == p_enabled) {
+		return;
+	}
+	if (!p_enabled) {
+		if (prompt_kind != PROMPT_NONE) {
+			prompt_cancel();
+		}
+		_restore_native_for_stock();
+		step_open = false;
+		enabled = false;
+		mode = MODE_NORMAL;
+		pending = String();
+		count = 0;
+		pending_register = false;
+		status = String();
+		status_error = false;
+		pushed_valid = false;
+		if (text_edit) {
+			text_edit->set_clipboard_op_hook(Callable());
+		}
+	} else {
+		enabled = true;
+		mode = MODE_NORMAL;
+		pushed_valid = false;
+		if (text_edit) {
+			text_edit->set_clipboard_op_hook(callable_mp(this, &HelixMode::_on_native_clipboard_op));
+			text_edit->cancel_code_completion();
+			_sync_from_native();
+			_push_selection();
+		}
+	}
+	_emit_if_changed();
+}
+
+void HelixMode::_on_caret_changed() {
+	// Native caret changes (mouse, goto line, debugger) only affect what the host shows (the
+	// selection count); the Helix selections are re-derived lazily before the next key.
+	if (enabled && _alive()) {
+		_emit_if_changed();
+	}
+}
+
+HelixMode::ObservedState HelixMode::_observe() const {
+	ObservedState o;
+	o.mode = mode;
+	o.pending = get_pending_keys();
+	o.status = status;
+	o.status_error = status_error;
+	o.prompt_kind = prompt_kind;
+	o.prompt_text = prompt_text;
+	o.selections = get_selection_count();
+	return o;
+}
+
+void HelixMode::_emit_if_changed() {
+	ObservedState o = _observe();
+	if (!(o == observed)) {
+		observed = o;
+		emit_signal(SNAME("state_changed"));
+	}
+}
+
+/* Native caret mirroring */
+
+Vector<HelixMode::NativeCaret> HelixMode::_read_native() const {
+	Vector<NativeCaret> out;
+	if (!text_edit) {
+		return out;
+	}
+	for (int i = 0; i < text_edit->get_caret_count(); i++) {
+		NativeCaret c;
+		c.line = text_edit->get_caret_line(i);
+		c.column = text_edit->get_caret_column(i);
+		c.has_selection = text_edit->has_selection(i);
+		if (c.has_selection) {
+			c.origin_line = text_edit->get_selection_origin_line(i);
+			c.origin_column = text_edit->get_selection_origin_column(i);
+		}
+		out.push_back(c);
+	}
+	return out;
+}
+
+bool HelixMode::_native_matches_pushed() const {
+	if (!pushed_valid || !text_edit) {
+		return false;
+	}
+	if (text_edit->get_version() != pushed_version) {
+		return false;
+	}
+	Vector<NativeCaret> now = _read_native();
+	if (now.size() != pushed_carets.size()) {
+		return false;
+	}
+	for (int i = 0; i < now.size(); i++) {
+		if (now[i] != pushed_carets[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool HelixMode::_native_is_pushed_layout() const {
+	// The native carets are still the ones pushed, only moved along by an edit made elsewhere
+	// (save with trim trailing whitespace, Find and Replace on other lines...): same carets
+	// and selections, same columns, all shifted by the same number of lines.
+	if (!pushed_valid || !text_edit) {
+		return false;
+	}
+	Vector<NativeCaret> now = _read_native();
+	if (now.size() != pushed_carets.size() || now.is_empty()) {
+		return false;
+	}
+	const int delta = now[0].line - pushed_carets[0].line;
+	for (int i = 0; i < now.size(); i++) {
+		const NativeCaret &a = now[i];
+		const NativeCaret &b = pushed_carets[i];
+		if (a.has_selection != b.has_selection || a.column != b.column || a.line - b.line != delta) {
+			return false;
+		}
+		if (a.has_selection && (a.origin_column != b.origin_column || a.origin_line - b.origin_line != delta)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool HelixMode::_native_is_exact_push() const {
+	Vector<NativeCaret> now = _read_native();
+	if (now.size() != exact_carets.size()) {
+		return false;
+	}
+	for (int i = 0; i < now.size(); i++) {
+		if (now[i] != exact_carets[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+HelixSelection HelixMode::_selection_from_native(bool p_pushed_layout) const {
+	// p_pushed_layout: the carets follow the Helix layout of _push_selection() (a forward
+	// range's cursor character is under the caret, outside the native selection); otherwise
+	// they are plain native selections (mouse, Find, menu commands).
+	Vector<HelixRange> ranges;
+	int64_t l = doc.len();
+	for (int i = 0; i < text_edit->get_caret_count(); i++) {
+		int64_t c = doc.line_col_to_pos(text_edit->get_caret_line(i), text_edit->get_caret_column(i));
+		if (text_edit->has_selection(i)) {
+			int64_t o = doc.line_col_to_pos(text_edit->get_selection_origin_line(i), text_edit->get_selection_origin_column(i));
+			ranges.push_back(HelixRange(o, p_pushed_layout && c > o ? MIN(doc.next_grapheme(c), l) : c));
+		} else if (c >= l) {
+			ranges.push_back(HelixRange::point(l));
+		} else {
+			ranges.push_back(HelixRange(c, doc.next_grapheme(c)));
+		}
+	}
+	if (ranges.is_empty()) {
+		ranges.push_back(HelixRange::point(0));
+	}
+	HelixSelection s = HelixSelection::from_ranges(ranges, 0);
+	ensure_invariants(doc, s);
+	return s;
+}
+
+void HelixMode::_sync_from_native() {
+	if (!text_edit) {
+		return;
+	}
+	if (_native_matches_pushed()) {
+		return;
+	}
+	doc.invalidate();
+	sel = _selection_from_native(_native_is_pushed_layout());
+	if (pushed_valid && text_edit->get_version() != pushed_version) {
+		// Text changed outside of Helix mode: pending prefixes refer to stale state.
+		pending = String();
+	}
+}
+
+void HelixMode::_push_selection() {
+	if (!text_edit) {
+		return;
+	}
+	if (_native_matches_pushed() && sel == pushed_sel) {
+		return; // Nothing to do (thousands of selections would otherwise be re-added).
+	}
+	const HelixSelection &s = sel;
+	// Inside a multicaret edit add_caret() skips its overlap check against every other caret
+	// (quadratic with thousands of selections); Helix selections never overlap anyway.
+	text_edit->begin_multicaret_edit();
+	text_edit->remove_secondary_carets();
+	text_edit->deselect();
+	Vector<int> order;
+	order.push_back(s.primary);
+	for (int i = 0; i < s.ranges.size(); i++) {
+		if (i != s.primary) {
+			order.push_back(i);
+		}
+	}
+	struct Pending {
+		int caret;
+		int ol, oc, cl, cc;
+	};
+	Vector<Pending> sels;
+	for (int k = 0; k < order.size(); k++) {
+		const HelixRange &r = s.ranges[order[k]];
+		int64_t c = cursor(doc, r);
+		int cl, cc;
+		doc.pos_to_line_col(c, cl, cc);
+		bool has = false;
+		int ol = 0, oc = 0;
+		if (!r.is_empty() && (r.head < r.anchor || r.anchor < c)) {
+			has = true;
+			doc.pos_to_line_col(r.anchor, ol, oc);
+		}
+		int ci = 0;
+		if (k == 0) {
+			text_edit->set_caret_line(cl, false, true, -1, 0);
+			text_edit->set_caret_column(cc, false, 0);
+		} else {
+			ci = text_edit->add_caret(cl, cc);
+			if (ci < 0) {
+				continue;
+			}
+		}
+		if (has) {
+			Pending p = { ci, ol, oc, cl, cc };
+			sels.push_back(p);
+		}
+	}
+	for (int i = 0; i < sels.size(); i++) {
+		text_edit->select(sels[i].ol, sels[i].oc, sels[i].cl, sels[i].cc, sels[i].caret);
+	}
+	text_edit->end_multicaret_edit();
+	_unfold_carets();
+	pushed_sel = sel;
+	pushed_carets = _read_native();
+	pushed_version = text_edit->get_version();
+	pushed_valid = true;
+}
+
+void HelixMode::_push_insert_carets() {
+	if (!text_edit) {
+		return;
+	}
+	text_edit->remove_secondary_carets();
+	text_edit->deselect();
+	ins_caret.resize(sel.ranges.size());
+	ins_primary = sel.primary;
+	for (int pass = 0; pass < 2; pass++) {
+		for (int i = 0; i < sel.ranges.size(); i++) {
+			if ((pass == 0) != (i == sel.primary)) {
+				continue;
+			}
+			int cl, cc;
+			doc.pos_to_line_col(cursor(doc, sel.ranges[i]), cl, cc);
+			if (pass == 0) {
+				text_edit->set_caret_line(cl, false, true, -1, 0);
+				text_edit->set_caret_column(cc, false, 0);
+				ins_caret.write[i] = 0;
+			} else {
+				ins_caret.write[i] = text_edit->add_caret(cl, cc);
+			}
+		}
+	}
+	pushed_carets = _read_native();
+	pushed_version = text_edit->get_version();
+	pushed_valid = true;
+}
+
+void HelixMode::_scroll_to_primary() {
+	if (!text_edit || !text_edit->is_inside_tree()) {
+		return;
+	}
+	text_edit->adjust_viewport_to_caret(0);
+	int vis = text_edit->get_visible_line_count();
+	if (vis <= 0) {
+		return;
+	}
+	int so = MIN(5, (vis - 1) / 2);
+	int line = text_edit->get_caret_line(0);
+	int first = text_edit->get_first_visible_line();
+	int lc = text_edit->get_line_count();
+	// Keep `so` lines above and below the cursor (Helix scrolloff), within the scrollable range.
+	int new_first = CLAMP(first, line + so - vis + 1, line - so);
+	new_first = CLAMP(new_first, 0, MAX(lc - vis, 0));
+	if (new_first != first) {
+		text_edit->set_line_as_first_visible(new_first);
+	}
+}
+
+/* Input translation */
+
+static String _key_name_for_char(char32_t p_c) {
+	switch (p_c) {
+		case '-':
+			return "minus";
+		case '<':
+			return "lt";
+		case '>':
+			return "gt";
+		case ' ':
+			return "space";
+		default:
+			return String::chr(p_c);
+	}
+}
+
+static char32_t _us_shifted(char32_t p_c) {
+	switch (p_c) {
+		case '1':
+			return '!';
+		case '2':
+			return '@';
+		case '3':
+			return '#';
+		case '4':
+			return '$';
+		case '5':
+			return '%';
+		case '6':
+			return '^';
+		case '7':
+			return '&';
+		case '8':
+			return '*';
+		case '9':
+			return '(';
+		case '0':
+			return ')';
+		case '-':
+			return '_';
+		case '=':
+			return '+';
+		case '[':
+			return '{';
+		case ']':
+			return '}';
+		case '\\':
+			return '|';
+		case ';':
+			return ':';
+		case '\'':
+			return '"';
+		case ',':
+			return '<';
+		case '.':
+			return '>';
+		case '/':
+			return '?';
+		case '`':
+			return '~';
+		default:
+			return p_c;
+	}
+}
+
+String HelixMode::_key_from_event(const Ref<InputEventKey> &p_key, bool &r_function_key) const {
+	r_function_key = false;
+	Key code = p_key->get_keycode();
+	if (code == Key::NONE) {
+		code = p_key->get_physical_keycode();
+	}
+	char32_t u = p_key->get_unicode();
+	bool ctrl = p_key->is_ctrl_pressed();
+	bool alt = p_key->is_alt_pressed();
+	bool shift = p_key->is_shift_pressed();
+	if (p_key->is_meta_pressed()) {
+		return String();
+	}
+	if (code >= Key::F1 && code <= Key::F35) {
+		r_function_key = true;
+		return String();
+	}
+	String special;
+	switch (code) {
+		case Key::ESCAPE:
+			special = "esc";
+			break;
+		case Key::ENTER:
+		case Key::KP_ENTER:
+			special = "ret";
+			break;
+		case Key::TAB:
+			special = "tab";
+			break;
+		case Key::BACKTAB:
+			special = "tab";
+			shift = true;
+			break;
+		case Key::BACKSPACE:
+			special = "backspace";
+			break;
+		case Key::KEY_DELETE:
+			special = "del";
+			break;
+		case Key::INSERT:
+			special = "ins";
+			break;
+		case Key::HOME:
+			special = "home";
+			break;
+		case Key::END:
+			special = "end";
+			break;
+		case Key::PAGEUP:
+			special = "pageup";
+			break;
+		case Key::PAGEDOWN:
+			special = "pagedown";
+			break;
+		case Key::LEFT:
+			special = "left";
+			break;
+		case Key::RIGHT:
+			special = "right";
+			break;
+		case Key::UP:
+			special = "up";
+			break;
+		case Key::DOWN:
+			special = "down";
+			break;
+		case Key::SPACE:
+			special = "space";
+			break;
+		case Key::SHIFT:
+		case Key::CTRL:
+		case Key::ALT:
+		case Key::META:
+		case Key::CAPSLOCK:
+		case Key::NUMLOCK:
+		case Key::SCROLLLOCK:
+			return String();
+		default:
+			break;
+	}
+	if (!special.is_empty()) {
+		String mods = String(ctrl ? "C-" : "") + String(alt ? "A-" : "") + String(shift && special != "space" ? "S-" : "");
+		return "<" + mods + special + ">";
+	}
+	char32_t c = 0;
+	if (!ctrl && !alt) {
+		if (u < 32) {
+			return String();
+		}
+		c = u;
+		return String::chr(c);
+	}
+	if (u >= 32 && !ctrl) {
+		c = u;
+	} else {
+		char32_t kc = (char32_t)code;
+		if (kc >= 'A' && kc <= 'Z') {
+			c = shift ? kc : kc + 32;
+		} else if (kc > 32 && kc < 127) {
+			c = shift ? _us_shifted(kc) : kc;
+		} else if (u >= 32) {
+			c = u;
+		} else {
+			return String();
+		}
+	}
+	return "<" + String(ctrl ? "C-" : "") + String(alt ? "A-" : "") + _key_name_for_char(c) + ">";
+}
+
+Vector<String> HelixMode::_parse_keys(const String &p_keys) {
+	Vector<String> out;
+	int i = 0;
+	while (i < p_keys.length()) {
+		char32_t c = p_keys[i];
+		if (c == '<') {
+			int close = p_keys.find(">", i + 1);
+			if (close > i + 1) {
+				String inner = p_keys.substr(i + 1, close - i - 1);
+				String mods;
+				String name = inner;
+				while (name.length() > 2 && name[1] == '-' && (name[0] == 'C' || name[0] == 'A' || name[0] == 'S' || name[0] == 'M')) {
+					mods += name.substr(0, 2);
+					name = name.substr(2);
+				}
+				// Normalize modifier order to C-A-S-.
+				String norm;
+				if (mods.contains("C-")) {
+					norm += "C-";
+				}
+				if (mods.contains("A-")) {
+					norm += "A-";
+				}
+				if (mods.contains("S-")) {
+					norm += "S-";
+				}
+				if (norm.is_empty()) {
+					if (name == "lt") {
+						out.push_back("<");
+					} else if (name == "gt") {
+						out.push_back(">");
+					} else if (name == "minus") {
+						out.push_back("-");
+					} else if (name.length() == 1) {
+						out.push_back(name);
+					} else {
+						out.push_back("<" + name + ">");
+					}
+				} else {
+					if (name == "-") {
+						name = "minus";
+					} else if (name == "<") {
+						name = "lt";
+					} else if (name == ">") {
+						name = "gt";
+					} else if (name == " ") {
+						name = "space";
+					}
+					if (norm == "S-" && name.length() == 1) {
+						out.push_back(name.to_upper());
+					} else {
+						out.push_back("<" + norm + name + ">");
+					}
+				}
+				i = close + 1;
+				continue;
+			}
+		}
+		if (c == ' ') {
+			out.push_back("<space>");
+		} else if (c == '\n') {
+			out.push_back("<ret>");
+		} else if (c == '\t') {
+			out.push_back("<tab>");
+		} else {
+			out.push_back(String::chr(c));
+		}
+		i++;
+	}
+	return out;
+}
+
+Ref<InputEventKey> HelixMode::_event_from_key(const String &p_key) const {
+	Ref<InputEventKey> ev;
+	ev.instantiate();
+	ev->set_pressed(true);
+	String name = p_key;
+	bool ctrl = false, alt = false, shift = false;
+	if (name.length() > 2 && name[0] == '<' && name[name.length() - 1] == '>') {
+		name = name.substr(1, name.length() - 2);
+		while (name.length() > 2 && name[1] == '-') {
+			if (name[0] == 'C') {
+				ctrl = true;
+			} else if (name[0] == 'A') {
+				alt = true;
+			} else if (name[0] == 'S') {
+				shift = true;
+			}
+			name = name.substr(2);
+		}
+		Key k = Key::NONE;
+		char32_t u = 0;
+		if (name == "ret") {
+			k = Key::ENTER;
+		} else if (name == "tab") {
+			k = Key::TAB;
+		} else if (name == "backspace") {
+			k = Key::BACKSPACE;
+		} else if (name == "del") {
+			k = Key::KEY_DELETE;
+		} else if (name == "esc") {
+			k = Key::ESCAPE;
+		} else if (name == "left") {
+			k = Key::LEFT;
+		} else if (name == "right") {
+			k = Key::RIGHT;
+		} else if (name == "up") {
+			k = Key::UP;
+		} else if (name == "down") {
+			k = Key::DOWN;
+		} else if (name == "home") {
+			k = Key::HOME;
+		} else if (name == "end") {
+			k = Key::END;
+		} else if (name == "pageup") {
+			k = Key::PAGEUP;
+		} else if (name == "pagedown") {
+			k = Key::PAGEDOWN;
+		} else if (name == "ins") {
+			k = Key::INSERT;
+		} else if (name == "space") {
+			k = Key::SPACE;
+			u = ' ';
+		} else {
+			char32_t c = name == "minus" ? '-' : (name == "lt" ? '<' : (name == "gt" ? '>' : (name.length() == 1 ? name[0] : 0)));
+			if (c == 0) {
+				return Ref<InputEventKey>();
+			}
+			if (c < 128) {
+				k = (Key)(c >= 'a' && c <= 'z' ? c - 32 : c);
+			}
+			if (c >= 'A' && c <= 'Z') {
+				shift = true;
+			}
+			u = c;
+		}
+		ev->set_keycode(k);
+		if (!ctrl && !alt) {
+			ev->set_unicode(u);
+		}
+	} else if (name.length() == 1) {
+		char32_t c = name[0];
+		Key k = Key::NONE;
+		if (c < 128) {
+			k = (Key)(c >= 'a' && c <= 'z' ? c - 32 : c);
+		}
+		if (c >= 'A' && c <= 'Z') {
+			shift = true;
+		}
+		ev->set_keycode(k);
+		ev->set_unicode(c);
+	} else {
+		return Ref<InputEventKey>();
+	}
+	ev->set_ctrl_pressed(ctrl);
+	ev->set_alt_pressed(alt);
+	ev->set_shift_pressed(shift);
+	return ev;
+}
+
+bool HelixMode::_is_bound_combo(const String &p_key) const {
+	static const char *bound[] = {
+		"<C-d>", "<C-u>", "<C-f>", "<C-b>", "<C-c>", "<C-a>", "<C-x>", "<C-e>", "<C-y>",
+		"<A-.>", "<A-;>", "<A-:>", "<A-,>", "<A-C>", "<A-(>", "<A-)>", "<A-minus>", "<A-_>",
+		"<A-s>", "<A-K>", "<A-J>", "<A-d>", "<A-c>", "<A-`>", "<A-x>", "<A-*>", "<A-u>", "<A-U>",
+		// Tree-sitter motions: bound by Helix, unavailable here, swallowed.
+		// (Alt+arrows are not swallowed: they are the editor's "Move Line Up/Down".)
+		"<A-o>", "<A-i>", "<A-I>", "<A-p>", "<A-n>", "<A-e>", "<A-b>", "<A-a>",
+		nullptr
+	};
+	for (int i = 0; bound[i]; i++) {
+		if (p_key == bound[i]) {
+			return true;
+		}
+	}
+	// Ctrl/Alt keys inside pending prefixes that Helix binds there.
+	if (pending == "z" || pending == "Z") {
+		return p_key == "<C-b>" || p_key == "<C-f>" || p_key == "<C-u>" || p_key == "<C-d>";
+	}
+	if (pending == "<space>") {
+		return p_key == "<A-c>";
+	}
+	return false;
+}
+
+bool HelixMode::_is_insert_binding(const String &p_key) const {
+	return p_key == "<C-w>" || p_key == "<A-backspace>" || p_key == "<C-u>" || p_key == "<C-k>" || p_key == "<C-h>" || p_key == "<C-d>" || p_key == "<del>" || p_key == "<A-d>" || p_key == "<A-del>";
+}
+
+bool HelixMode::handle_gui_input(const Ref<InputEvent> &p_event) {
+	if (!enabled || !_alive()) {
+		return false;
+	}
+	Ref<InputEventKey> k = p_event;
+	if (k.is_null()) {
+		Ref<InputEventMouseButton> mb = p_event;
+		if (mb.is_valid() && mb->get_button_index() == MouseButton::LEFT && !mb->is_pressed() && mode != MODE_INSERT) {
+			// After the CodeEdit has handled the release (end of a drag, double-click...).
+			callable_mp(this, &HelixMode::_adopt_native).call_deferred();
+		}
+		if (mb.is_valid() && mb->is_pressed() && mode == MODE_INSERT) {
+			// Snapshot before the click moves the carets, so the move counts as navigation (every
+			// selection collapses to a cursor) also right after typing; otherwise the tracked
+			// ranges would be applied to the clicked position (drawn, and kept on <esc>).
+			_insert_check_nav();
+		}
+		return false;
+	}
+	if (!k->is_pressed()) {
+		return false;
+	}
+	bool fkey = false;
+	String key = _key_from_event(k, fkey);
+	if (key.is_empty()) {
+		return false;
+	}
+	bool modified = key.begins_with("<C-") || key.begins_with("<A-") || key.begins_with("<M-");
+	if (prompt_kind != PROMPT_NONE) {
+		// Normally the host's prompt LineEdit has the focus; keys that still reach the CodeEdit edit
+		// the prompt, except shortcuts.
+		if (modified && key != "<C-c>") {
+			return false;
+		}
+		_prompt_key(key);
+		_emit_if_changed();
+		return true;
+	}
+	if (mode == MODE_INSERT) {
+		if (key == "<esc>" || _is_insert_binding(key)) {
+			_handle_key(key);
+			_emit_if_changed();
+			return true;
+		}
+		_insert_guard_undo();
+		_insert_check_nav();
+		ins_typed = !modified && key.length() == 1 ? key[0] : 0;
+		if (k->is_action_pressed(SNAME("ui_undo"), false, true) || k->is_action_pressed(SNAME("ui_redo"), false, true)) {
+			_insert_close_segment(); // Native undo / redo act on the session typed so far.
+			return false;
+		}
+		_insert_begin_edit();
+		if (text_edit->get_caret_count() > 32) {
+			_drop_highlighting_cache(); // Native typing edits once per caret.
+		}
+		if (!modified) {
+			// Recorded for '.'; shortcuts (Ctrl+S, Ctrl+Z ...) are not part of the insert.
+			ins_keys.push_back(key);
+		}
+		return false;
+	}
+	if (modified && !_is_bound_combo(key)) {
+		if (!pending.is_empty() || count > 0 || pending_register) {
+			pending = String();
+			count = 0;
+			pending_register = false;
+			_emit_if_changed();
+		}
+		// The key goes on to the CodeEdit and the editor's shortcuts (Ctrl+V, Ctrl+Backspace,
+		// Edit menu shortcuts such as convert case or toggle comment...): let them see the
+		// exact Helix selections until the event has been handled.
+		if (!native_command_pending) {
+			native_command_pending = true;
+			begin_native_command();
+			callable_mp(this, &HelixMode::_end_native_command_deferred).call_deferred();
+		}
+		return false;
+	}
+	_handle_key(key);
+	_emit_if_changed();
+	return true;
+}
+
+void HelixMode::feed_keys(const String &p_keys) {
+	if (!_alive()) {
+		return;
+	}
+	Vector<String> keys = _parse_keys(p_keys);
+	for (int i = 0; i < keys.size(); i++) {
+		if (prompt_kind != PROMPT_NONE) {
+			_prompt_key(keys[i]);
+		} else {
+			_handle_key(keys[i]);
+		}
+		_emit_if_changed();
+	}
+}
+
+void HelixMode::_deliver_native(const String &p_key) {
+	Ref<InputEventKey> ev = _event_from_key(p_key);
+	ins_keys.push_back(p_key);
+	if (ev.is_null()) {
+		return;
+	}
+	_insert_check_nav();
+	ins_typed = p_key.length() == 1 ? p_key[0] : 0;
+	_insert_begin_edit();
+	text_edit->gui_input(ev);
+	doc.invalidate();
+	_insert_check_nav();
+}
+
+void HelixMode::_set_status(const String &p_msg, bool p_error) {
+	status = p_msg;
+	status_error = p_error;
+}
+
+/* Key handling */
+
+void HelixMode::_handle_key(const String &p_key) {
+	if (!text_edit) {
+		return;
+	}
+	status = String();
+	status_error = false;
+
+	if (mode == MODE_INSERT) {
+		_dispatch_insert(p_key);
+		return;
+	}
+
+	_sync_from_native();
+	bool fresh = pending.is_empty() && count == 0 && !pending_register;
+	if (fresh && p_key == ".") {
+		// Repeat last insert.
+		_repeat_last_insert(1);
+		return;
+	}
+	if (pending.is_empty() && !pending_register && count > 0 && p_key == ".") {
+		int n = count;
+		count = 0;
+		_repeat_last_insert(n);
+		return;
+	}
+	if (fresh) {
+		command_keys = String();
+		_begin_step();
+	}
+	command_keys += p_key.length() == 1 && p_key[0] == '<' ? String("<lt>") : (p_key.length() == 1 && p_key[0] == '>' ? String("<gt>") : (p_key == "-" ? String("<minus>") : p_key));
+
+	int64_t old_cursor = cursor(doc, sel.primary_range());
+	uint32_t old_version = text_edit->get_version();
+
+	_dispatch(p_key);
+
+	if (complex_open && mode != MODE_INSERT) {
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+	bool done = pending.is_empty() && count == 0 && !pending_register;
+	if (mode == MODE_INSERT) {
+		return; // Carets were pushed when entering insert mode; the step ends on <esc>.
+	}
+	if (done && prompt_kind == PROMPT_NONE) {
+		_end_step();
+	}
+	_push_selection();
+	if (old_cursor != cursor(doc, sel.primary_range()) || old_version != text_edit->get_version()) {
+		_scroll_to_primary();
+	}
+}
+
+void HelixMode::_repeat_last_insert(int p_count) {
+	if (!shared.has_last_insert) {
+		return;
+	}
+	String cmd = shared.last_insert_command;
+	Vector<String> keys = shared.last_insert_keys;
+	Vector<String> cmd_keys = _parse_keys(cmd);
+	replaying++;
+	p_count = MIN(p_count, 1000);
+	for (int n = 0; n < p_count; n++) {
+		for (int i = 0; i < cmd_keys.size(); i++) {
+			_handle_key(cmd_keys[i]);
+		}
+		if (mode != MODE_INSERT) {
+			break;
+		}
+		for (int i = 0; i < keys.size(); i++) {
+			_handle_key(keys[i]);
+		}
+		if (mode == MODE_INSERT) {
+			_handle_key("<esc>");
+		}
+	}
+	replaying--;
+}
+
+void HelixMode::_dispatch(const String &p_key) {
+	if (pending_register) {
+		// Only the default register exists; the register name is swallowed.
+		pending_register = false;
+		return;
+	}
+	if (!pending.is_empty()) {
+		_dispatch_pending(p_key);
+		if (pending.is_empty()) {
+			count = 0;
+		}
+		return;
+	}
+	if (p_key.length() == 1 && is_digit(p_key[0]) && (p_key[0] != '0' || count > 0)) {
+		count = MIN(count * 10 + (int)(p_key[0] - '0'), 100000000);
+		return;
+	}
+	_dispatch_normal(p_key);
+	if (pending.is_empty()) {
+		count = 0;
+	}
+}
+
+/* Steps / undo / edits */
+
+void HelixMode::_begin_step() {
+	step_open = true;
+	step_version = text_edit->get_version();
+	step_sel_set = false;
+}
+
+void HelixMode::_end_step() {
+	if (!step_open) {
+		return;
+	}
+	step_open = false;
+	if (complex_open) {
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+	uint32_t v = text_edit->get_version();
+	if (undo_info.size() > 4096) {
+		// Selections of very old steps fall back to the native carets.
+		undo_info.clear();
+		redo_info.clear();
+	}
+	if (v != step_version) {
+		UndoInfo u;
+		u.target = step_version;
+		u.selection = step_sel_set ? step_sel_before : sel;
+		undo_info[v] = u;
+		UndoInfo r;
+		r.target = v;
+		r.selection = sel;
+		redo_info[step_version] = r;
+	}
+	step_sel_set = false;
+}
+
+bool HelixMode::_check_editable() {
+	if (!text_edit->is_editable()) {
+		_set_status("Buffer is read-only", true);
+		return false;
+	}
+	return true;
+}
+
+void HelixMode::_set_selection(const HelixSelection &p_sel) {
+	HelixSelection s = p_sel;
+	ensure_invariants(doc, s);
+	sel = s;
+}
+
+bool HelixMode::_apply_changes(const Vector<HelixChange> &p_changes, const HelixSelection *p_new_sel) {
+	HelixChangeSet cs = HelixChangeSet::from_changes(doc.len(), p_changes);
+	return _apply(cs, p_new_sel);
+}
+
+bool HelixMode::_apply(const HelixChangeSet &p_cs, const HelixSelection *p_new_sel) {
+	if (p_cs.is_empty()) {
+		if (p_new_sel) {
+			_set_selection(*p_new_sel);
+		}
+		return true;
+	}
+	if (!_check_editable()) {
+		return false;
+	}
+	if (!step_sel_set) {
+		step_sel_before = sel;
+		step_sel_set = true;
+	}
+	_begin_complex();
+	// Every native edit moves every native caret: with many selections, edit with a single
+	// caret (the new selections are pushed afterwards anyway).
+	if (text_edit->get_caret_count() > 1) {
+		text_edit->remove_secondary_carets();
+	}
+	text_edit->deselect();
+	pushed_valid = false;
+	Vector<HelixChange> changes = p_cs.to_changes();
+	if (changes.size() > 32) {
+		_drop_highlighting_cache();
+	}
+	struct LC {
+		int fl, fc, tl, tc;
+	};
+	Vector<LC> lcs;
+	lcs.resize(changes.size());
+	for (int i = 0; i < changes.size(); i++) {
+		LC lc;
+		doc.pos_to_line_col(changes[i].from, lc.fl, lc.fc);
+		doc.pos_to_line_col(changes[i].to, lc.tl, lc.tc);
+		lcs.write[i] = lc;
+	}
+	HelixSelection mapped = p_new_sel ? *p_new_sel : p_cs.map_selection(sel);
+	for (int i = changes.size() - 1; i >= 0; i--) {
+		const HelixChange &c = changes[i];
+		const LC &lc = lcs[i];
+		if (c.to > c.from) {
+			text_edit->remove_text(lc.fl, lc.fc, lc.tl, lc.tc);
+		}
+		if (c.insert && !c.text.is_empty()) {
+			text_edit->insert_text(c.text, lc.fl, lc.fc);
+		}
+	}
+	doc.invalidate();
+	_set_selection(mapped);
+	return true;
+}
+
+void HelixMode::_drop_highlighting_cache() {
+	// The syntax highlighter forgets its cached lines from each edited line down to the last
+	// cached one, on every single edit: with thousands of edits in one command (many
+	// selections, or undoing them) that is quadratic. Drop the cache once instead; the visible
+	// lines are highlighted again on the next draw.
+	Ref<SyntaxHighlighter> sh = text_edit->get_syntax_highlighter();
+	if (sh.is_valid()) {
+		sh->clear_highlighting_cache();
+	}
+}
+
+void HelixMode::_history_moved() {
+	// Undo / redo move through the history, they are not a change of their own: the step of the
+	// u / U key must not record one (it would overwrite the entry of the revision just undone).
+	if (step_open) {
+		step_version = text_edit->get_version();
+		step_sel_set = false;
+	}
+}
+
+void HelixMode::_undo(int p_count) {
+	if (!_check_editable()) {
+		return;
+	}
+	_drop_highlighting_cache();
+	for (int i = 0; i < p_count; i++) {
+		if (!text_edit->has_undo()) {
+			_set_status("Already at oldest change");
+			break;
+		}
+		uint32_t v = text_edit->get_version();
+		if (undo_info.has(v)) {
+			UndoInfo info = undo_info[v];
+			int guard = 0;
+			while (text_edit->get_version() != info.target && text_edit->has_undo() && guard++ < 100000) {
+				uint32_t before = text_edit->get_version();
+				text_edit->undo();
+				if (text_edit->get_version() == before || text_edit->get_version() < info.target) {
+					break;
+				}
+			}
+			doc.invalidate();
+			_set_selection(info.selection);
+		} else {
+			text_edit->undo();
+			doc.invalidate();
+			sel = _selection_from_native(false);
+		}
+	}
+	_history_moved();
+}
+
+void HelixMode::_redo(int p_count) {
+	if (!_check_editable()) {
+		return;
+	}
+	_drop_highlighting_cache();
+	for (int i = 0; i < p_count; i++) {
+		if (!text_edit->has_redo()) {
+			_set_status("Already at newest change");
+			break;
+		}
+		uint32_t v = text_edit->get_version();
+		if (redo_info.has(v)) {
+			UndoInfo info = redo_info[v];
+			int guard = 0;
+			while (text_edit->get_version() != info.target && text_edit->has_redo() && guard++ < 100000) {
+				uint32_t before = text_edit->get_version();
+				text_edit->redo();
+				if (text_edit->get_version() == before || text_edit->get_version() > info.target) {
+					break;
+				}
+			}
+			doc.invalidate();
+			_set_selection(info.selection);
+		} else {
+			text_edit->redo();
+			doc.invalidate();
+			sel = _selection_from_native(false);
+		}
+	}
+	_history_moved();
+}
+
+/* Insert mode */
+
+void HelixMode::_enter_insert(bool p_restore_cursor) {
+	mode = MODE_INSERT;
+	ins_restore_cursor = p_restore_cursor;
+	ins_keys.clear();
+	ins_command_keys = command_keys;
+	if (!step_sel_set) {
+		step_sel_before = sel;
+		step_sel_set = true;
+	}
+	// Native typing must not merge with an earlier typing action into one undo step, and the
+	// whole session (with the command that started it) is one native undo step: the complex
+	// operation (opened by the command's edit, or lazily by the first typed key) stays open
+	// until <esc>.
+	text_edit->start_action(TextEdit::ACTION_NONE);
+	_track_insert();
+}
+
+void HelixMode::_track_insert() {
+	_build_insert_track();
+	_push_insert_carets();
+	_insert_snapshot();
+}
+
+void HelixMode::_insert_retrack() {
+	// Before each key: continue from the Helix selection as it is now (like Helix, which maps
+	// the selection through every edit), not from the one the session started with. A forward
+	// range whose anchor has reached its cursor (backspace) then moves with what is typed at
+	// that point (Assoc::After), and the text after a backward range's caret is re-read.
+	HelixSelection s = _insert_selection();
+	if (s.ranges.size() != ins_track.size() || text_edit->get_caret_count() != ins_track.size()) {
+		sel = s;
+		_track_insert();
+		return;
+	}
+	sel = s;
+	_build_insert_track();
+}
+
+void HelixMode::_build_insert_track() {
+	ins_track_len = doc.len();
+	ins_track.resize(sel.ranges.size());
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		int64_t c = cursor(doc, r);
+		int64_t prev_c = i > 0 ? cursor(doc, sel.ranges[i - 1]) : 0;
+		InsertTrack t;
+		if (r.head > r.anchor) {
+			t.forward = true;
+			t.off = r.head - c;
+			if (r.anchor < c) {
+				t.anchor_from_prev = true;
+				t.gap = r.anchor - prev_c;
+				if (i > 0 && t.gap <= 256) {
+					t.after = doc.slice(prev_c, r.anchor); // Read back after the previous caret.
+				}
+			}
+		} else {
+			t.forward = false;
+			t.off = r.anchor - r.head;
+			t.after = doc.slice(c, c + MIN(t.off, (int64_t)256));
+			t.single = is_single_grapheme(doc, r);
+		}
+		ins_track.write[i] = t;
+	}
+}
+
+void HelixMode::_insert_guard_undo() {
+	// A native undo during the session (Ctrl+Z, Edit menu). While the session's first native
+	// operation (the one that starts our complex operation's undo chain) is still applied,
+	// nothing needs to happen: typing drops the undone operations and <esc> closes the chain
+	// on the last one. Once the undo went back past it, that chain start is about to be
+	// dropped too: restart the complex operation so the rest of the session is a well-formed
+	// chain of its own (closing it on an undone operation would leave a chain without an end,
+	// and a later redo would run past it).
+	if (complex_open && text_edit->has_redo() && text_edit->get_version() <= complex_start_version) {
+		text_edit->close_complex_operation();
+		complex_open = false;
+		_begin_complex();
+	}
+}
+
+void HelixMode::_insert_snapshot() {
+	ins_snap_carets = _read_native();
+	ins_snap_version = text_edit->get_version();
+	ins_snap_sel = _insert_selection();
+}
+
+bool HelixMode::_insert_skip_over(HelixSelection &r_sel) const {
+	// Typing a closing character in front of the same one: CodeEdit's auto-brace moves the
+	// caret over it without an edit. That is not a cursor motion: Helix (auto_pairs.rs, an
+	// insertion of length 0 in get_next_range) moves a 1-wide range along, direction kept, and
+	// only the head of a longer one.
+	if (ins_typed == 0 || text_edit->get_version() != ins_snap_version) {
+		return false;
+	}
+	Vector<NativeCaret> now = _read_native();
+	int n = ins_snap_sel.ranges.size();
+	if (now.size() != ins_snap_carets.size() || now.size() != n || ins_caret.size() != n) {
+		return false;
+	}
+	for (int i = 0; i < now.size(); i++) {
+		const NativeCaret &a = ins_snap_carets[i];
+		const NativeCaret &b = now[i];
+		if (b.has_selection || a.has_selection || b.line != a.line || b.column != a.column + 1 || doc.char_at(doc.line_col_to_pos(a.line, a.column)) != ins_typed) {
+			return false;
+		}
+	}
+	HelixSelection s = ins_snap_sel;
+	for (int i = 0; i < n; i++) {
+		const HelixRange &r = s.ranges[i];
+		bool single = is_single_grapheme(doc, r);
+		s.ranges.write[i] = HelixRange(single ? doc.next_grapheme(r.anchor) : r.anchor, doc.next_grapheme(r.head));
+	}
+	ensure_invariants(doc, s);
+	r_sel = s;
+	return true;
+}
+
+bool HelixMode::_insert_nav_detected() const {
+	if (text_edit->get_version() != ins_snap_version) {
+		return false;
+	}
+	Vector<NativeCaret> now = _read_native();
+	if (now.size() != ins_snap_carets.size()) {
+		return true;
+	}
+	for (int i = 0; i < now.size(); i++) {
+		if (now[i] != ins_snap_carets[i]) {
+			return true;
+		}
+	}
+	return false;
+}
+
+HelixSelection HelixMode::_carets_as_cursors() const {
+	Vector<HelixRange> ranges;
+	int64_t l = doc.len();
+	for (int i = 0; i < text_edit->get_caret_count(); i++) {
+		int64_t c = doc.line_col_to_pos(text_edit->get_caret_line(i), text_edit->get_caret_column(i));
+		ranges.push_back(HelixRange(c, MIN(doc.next_grapheme(c), l)));
+	}
+	HelixSelection s = HelixSelection::from_ranges(ranges, 0);
+	ensure_invariants(doc, s);
+	return s;
+}
+
+void HelixMode::_insert_check_nav() {
+	if (mode != MODE_INSERT) {
+		return;
+	}
+	if (_insert_nav_detected()) {
+		// The carets moved without an edit (arrows, Home/End, mouse): like Helix's insert-mode
+		// motions, every selection collapses to a cursor at its caret.
+		if (!_insert_skip_over(sel)) {
+			sel = _carets_as_cursors();
+		}
+		_track_insert();
+		return;
+	}
+	if (text_edit->get_version() != ins_snap_version) {
+		_insert_retrack();
+	}
+	_insert_snapshot();
+}
+
+int64_t HelixMode::_insert_match_after(int64_t p_pos, const String &p_text, int64_t &r_inserted) const {
+	// How the text that followed a caret before the last key (p_text) follows it now: its new
+	// length (minus what was deleted from either end of it: Delete at this caret, Backspace at
+	// the next one), with r_inserted = characters inserted between the caret and it (an
+	// auto-closed pair). -1 when it cannot be found.
+	r_inserted = 0;
+	const int64_t n = p_text.length();
+	if (doc.slice(p_pos, p_pos + n) == p_text) {
+		return n;
+	}
+	if (doc.len() > ins_track_len) {
+		for (int k = 1; k <= 2; k++) {
+			if (doc.slice(p_pos + k, p_pos + k + n) == p_text) {
+				r_inserted = k;
+				return n;
+			}
+		}
+	}
+	const int lim = MIN(n, (int64_t)64);
+	for (int k = 1; k <= lim; k++) {
+		if (doc.slice(p_pos, p_pos + n - k) == p_text.substr(k) || doc.slice(p_pos, p_pos + n - k) == p_text.substr(0, n - k)) {
+			return n - k;
+		}
+	}
+	return -1;
+}
+
+HelixSelection HelixMode::_insert_selection() const {
+	if (!text_edit) {
+		return sel;
+	}
+	int n = ins_track.size();
+	int64_t l = doc.len();
+	bool valid = n > 0 && text_edit->get_caret_count() == n && ins_caret.size() == n && !_insert_nav_detected();
+	if (valid) {
+		for (int i = 0; i < n; i++) {
+			if (ins_caret[i] < 0 || ins_caret[i] >= text_edit->get_caret_count()) {
+				valid = false;
+				break;
+			}
+		}
+	}
+	if (!valid) {
+		HelixSelection s;
+		if (_insert_skip_over(s)) {
+			return s;
+		}
+		return _carets_as_cursors();
+	}
+	Vector<int64_t> cs;
+	cs.resize(n);
+	for (int i = 0; i < n; i++) {
+		int ci = ins_caret[i];
+		cs.write[i] = doc.line_col_to_pos(text_edit->get_caret_line(ci), text_edit->get_caret_column(ci));
+	}
+	Vector<HelixRange> ranges;
+	for (int i = 0; i < n; i++) {
+		const InsertTrack &t = ins_track[i];
+		int64_t c = cs[i];
+		HelixRange r;
+		if (t.forward) {
+			r.head = t.off > 0 ? MIN(doc.next_grapheme(c), l) : c;
+			if (t.anchor_from_prev) {
+				// The anchor keeps its distance from the previous caret, unless the edit there
+				// changed the text in between (an auto-closed pair, Delete).
+				int64_t base = i > 0 ? cs[i - 1] : 0;
+				int64_t a = base + t.gap;
+				if (!t.after.is_empty()) {
+					int64_t inserted = 0;
+					int64_t m = _insert_match_after(base, t.after, inserted);
+					if (m >= 0) {
+						a = base + inserted + m;
+					}
+				}
+				r.anchor = MIN(a, c);
+			} else {
+				r.anchor = c;
+			}
+		} else {
+			// The anchor stays behind the text between the caret and it: text deleted from that
+			// (Delete here, Backspace at the next caret) shrinks the range like in Helix.
+			int64_t w = t.off;
+			int64_t removed = 0;
+			int64_t closed = 0;
+			if (!t.after.is_empty()) {
+				int64_t m = _insert_match_after(c, t.after, closed);
+				removed = m >= 0 ? t.after.length() - m : w;
+			}
+			r.head = c;
+			if (closed > 0) {
+				// Text inserted right after the caret: an auto-closed pair. Helix
+				// (auto_pairs.rs get_next_range) keeps a 1-wide cursor 1 wide, on the closing
+				// character, and moves a longer range's anchor over what was inserted.
+				r.anchor = t.single ? doc.next_grapheme(c) : MIN(c + closed + w, l);
+			} else {
+				r.anchor = MIN(c + MAX(w - removed, (int64_t)0), l);
+			}
+		}
+		ranges.push_back(r);
+	}
+	HelixSelection s;
+	s.ranges = ranges;
+	s.primary = CLAMP(ins_primary, 0, n - 1);
+	s.normalize();
+	ensure_invariants(doc, s);
+	return s;
+}
+
+void HelixMode::_exit_insert() {
+	text_edit->cancel_code_completion();
+	text_edit->start_action(TextEdit::ACTION_NONE);
+	_insert_check_nav();
+	HelixSelection s = _insert_selection();
+	sel = s;
+	// try_restore_indent: leaving right after opening a blank, auto-indented line removes the indent.
+	if (s.size() == 1 && ((ins_from_open && ins_keys.is_empty() && ins_count == 1) || (ins_keys.size() == 1 && ins_keys[0] == "<ret>")) && text_edit->is_editable()) {
+		int64_t pos = cursor(doc, s.primary_range());
+		int line = doc.char_to_line(pos);
+		int64_t ls = doc.line_to_char(line);
+		if (pos == doc.line_end(line) && pos > ls) {
+			bool blank = true;
+			for (int64_t p = ls; p < pos; p++) {
+				char32_t c = doc.char_at(p);
+				if (c != ' ' && c != '\t') {
+					blank = false;
+					break;
+				}
+			}
+			if (blank) {
+				Vector<HelixChange> ch;
+				ch.push_back(HelixChange(ls, pos));
+				_apply_changes(ch);
+			}
+		}
+	}
+	if (ins_restore_cursor) {
+		HelixSelection t = sel;
+		for (int i = 0; i < t.ranges.size(); i++) {
+			const HelixRange &r = t.ranges[i];
+			int64_t head = r.to();
+			if (r.head > r.anchor) {
+				head = doc.prev_grapheme(head);
+			}
+			t.ranges.write[i] = HelixRange(r.from(), head);
+		}
+		t.normalize();
+		sel = t;
+	}
+	ins_restore_cursor = false;
+	ins_from_open = false;
+	mode = MODE_NORMAL;
+	_set_selection(sel);
+	if (!replaying) {
+		// Like Helix (EditorView::last_insert): the command that entered insert mode, without
+		// its count or register; '.' runs it with its own count of repetitions, each with count 1.
+		int skip = 0;
+		while (skip < ins_command_keys.length()) {
+			if (is_digit(ins_command_keys[skip])) {
+				skip++;
+			} else if (ins_command_keys[skip] == '"' && skip + 1 < ins_command_keys.length()) {
+				skip += 2;
+			} else {
+				break;
+			}
+		}
+		shared.last_insert_command = ins_command_keys.substr(skip);
+		shared.last_insert_keys = ins_keys;
+		shared.has_last_insert = true;
+	}
+	if (complex_open) {
+		text_edit->close_complex_operation();
+		complex_open = false;
+	}
+	_end_step();
+	_push_selection();
+	_scroll_to_primary();
+}
+
+void HelixMode::_dispatch_insert(const String &p_key) {
+	_insert_guard_undo();
+	if (p_key == "<esc>") {
+		_exit_insert();
+		return;
+	}
+	if (p_key == "<C-w>" || p_key == "<A-backspace>") {
+		ins_keys.push_back(p_key);
+		_insert_delete(DEL_WORD_BACKWARD);
+	} else if (p_key == "<A-d>" || p_key == "<A-del>") {
+		ins_keys.push_back(p_key);
+		_insert_delete(DEL_WORD_FORWARD);
+	} else if (p_key == "<C-u>") {
+		ins_keys.push_back(p_key);
+		_insert_delete(DEL_TO_LINE_START);
+	} else if (p_key == "<C-k>") {
+		ins_keys.push_back(p_key);
+		_insert_delete(DEL_TO_LINE_END);
+	} else if (p_key == "<C-h>") {
+		ins_keys.push_back(p_key);
+		_insert_delete(DEL_CHAR_BACKWARD);
+	} else if (p_key == "<C-d>" || p_key == "<del>") {
+		// Helix binds both to delete_char_forward, which keeps a final newline (Godot's own
+		// Delete would remove it).
+		ins_keys.push_back(p_key);
+		_insert_delete(DEL_CHAR_FORWARD);
+	} else {
+		_deliver_native(p_key);
+	}
+}
+
+// Transaction::delete: deletions in selection order, each clipped to start where the previous
+// one ended (overlapping deletions of neighbouring cursors delete their union).
+static void _clip_deletions(Vector<HelixChange> &r_changes) {
+	Vector<HelixChange> out;
+	int64_t last = 0;
+	for (int i = 0; i < r_changes.size(); i++) {
+		int64_t from = r_changes[i].from;
+		int64_t to = r_changes[i].to;
+		if (last > to) {
+			continue;
+		}
+		from = MAX(from, last);
+		if (to > from) {
+			out.push_back(HelixChange(from, to));
+		}
+		last = to;
+	}
+	r_changes = out;
+}
+
+void HelixMode::_insert_delete(int p_kind) {
+	if (!_check_editable()) {
+		return;
+	}
+	_insert_check_nav();
+	sel = _insert_selection();
+	int64_t len = doc.len();
+	Vector<HelixChange> changes;
+	if (p_kind == DEL_CHAR_BACKWARD) {
+		int tab_width = _tab_width();
+		int indent_width = text_edit->is_indent_using_spaces() ? MAX(text_edit->get_indent_size(), 1) : tab_width;
+		for (int i = 0; i < sel.ranges.size(); i++) {
+			const HelixRange &r = sel.ranges[i];
+			int64_t pos = cursor(doc, r);
+			if (pos == 0) {
+				continue;
+			}
+			int64_t ls = doc.line_to_char(cursor_line(doc, r));
+			bool all_ws = pos > ls;
+			for (int64_t p = ls; p < pos && all_ws; p++) {
+				char32_t c = doc.char_at(p);
+				if (c != ' ' && c != '\t') {
+					all_ws = false;
+				}
+			}
+			if (all_ws) {
+				if (doc.char_at(pos - 1) == '\t') {
+					changes.push_back(HelixChange(doc.prev_grapheme(pos), pos));
+				} else {
+					int width = 0;
+					for (int64_t p = ls; p < pos; p++) {
+						width += doc.char_at(p) == '\t' ? tab_width : 1;
+					}
+					int drop = width % indent_width;
+					if (drop == 0) {
+						drop = indent_width;
+					}
+					int64_t start = pos;
+					for (int k = 0; k < drop; k++) {
+						if (start - 1 >= ls && doc.char_at(start - 1) == ' ') {
+							start--;
+						} else {
+							break;
+						}
+					}
+					changes.push_back(HelixChange(start, pos));
+				}
+			} else {
+				char32_t x = doc.char_at(pos - 1);
+				char32_t y = doc.char_at(pos);
+				if (pos < len && is_single_grapheme(doc, r) && _is_auto_pair(x, y)) {
+					changes.push_back(HelixChange(doc.prev_grapheme(pos), doc.next_grapheme(pos)));
+				} else {
+					changes.push_back(HelixChange(doc.prev_grapheme(pos), pos));
+				}
+			}
+		}
+		_clip_deletions(changes);
+		_apply_changes(changes);
+		_track_insert();
+		return;
+	}
+
+	bool forward = p_kind == DEL_WORD_FORWARD || p_kind == DEL_TO_LINE_END || p_kind == DEL_CHAR_FORWARD;
+	bool insert_newline = false;
+	Vector<HelixRange> new_ranges;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		int64_t start = 0, end = 0;
+		int64_t pos = cursor(doc, r);
+		switch (p_kind) {
+			case DEL_WORD_BACKWARD: {
+				int64_t anchor = word_move(doc, r, 1, PREV_WORD_START).from();
+				HelixRange next(anchor, pos);
+				if (next.to() == r.to() && len != r.to()) {
+					next = HelixRange(next.from(), doc.prev_grapheme(r.to()));
+				}
+				start = next.from();
+				end = next.to();
+			} break;
+			case DEL_WORD_FORWARD: {
+				start = pos;
+				end = word_move(doc, r, 1, NEXT_WORD_END).to();
+			} break;
+			case DEL_TO_LINE_START: {
+				int line = cursor_line(doc, r);
+				int64_t first_char = doc.line_to_char(line);
+				int64_t head;
+				if (pos == first_char && line != 0) {
+					head = doc.line_end(line - 1);
+				} else {
+					int64_t fnw = doc.first_non_whitespace(line);
+					if (fnw >= 0 && first_char + fnw < pos) {
+						head = first_char + fnw;
+					} else {
+						head = first_char;
+					}
+				}
+				start = head;
+				end = pos;
+			} break;
+			case DEL_TO_LINE_END: {
+				int line = cursor_line(doc, r);
+				int64_t le = doc.line_end(line);
+				if (pos == le) {
+					start = pos;
+					end = doc.line_to_char(line + 1);
+				} else {
+					start = pos;
+					end = le;
+				}
+			} break;
+			case DEL_CHAR_FORWARD: {
+				start = pos;
+				end = doc.next_grapheme(pos);
+			} break;
+		}
+		if (end < start) {
+			SWAP(start, end);
+		}
+		changes.push_back(HelixChange(start, end));
+		if (forward) {
+			HelixRange rr = r;
+			if (rr.head > rr.anchor) {
+				insert_newline = insert_newline || end == len;
+				rr.head += 1;
+			}
+			new_ranges.push_back(rr);
+		}
+	}
+	_clip_deletions(changes);
+	if (insert_newline) {
+		changes.push_back(HelixChange(len, len, "\n"));
+	}
+	if (forward) {
+		HelixSelection s;
+		s.ranges = new_ranges;
+		s.primary = sel.primary;
+		s.normalize();
+		for (int i = 0; i < s.ranges.size(); i++) {
+			s.ranges.write[i].head = MIN(s.ranges[i].head, len);
+		}
+		_set_selection(s);
+	}
+	_apply_changes(changes);
+	_track_insert();
+}
+
+/* Commands */
+
+String HelixMode::_indent_unit() const {
+	if (text_edit->is_indent_using_spaces()) {
+		return String(" ").repeat(MAX(text_edit->get_indent_size(), 1));
+	}
+	return "\t";
+}
+
+int HelixMode::_tab_width() const {
+	return MAX(text_edit->get_tab_size(), 1);
+}
+
+void HelixMode::_move_horizontal(bool p_forward, bool p_extend) {
+	int n = _count();
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return move_horizontally(doc, r, p_forward, n, p_extend); }));
+}
+
+void HelixMode::_move_vertical(bool p_forward, bool p_extend, bool p_visual) {
+	int n = _count();
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return _move_rows(r, p_forward, n, p_extend, p_visual); }));
+}
+
+HelixRange HelixMode::_move_rows(const HelixRange &p_range, bool p_forward, int p_count, bool p_extend, bool p_visual) const {
+	// Vertical motion over what the CodeEdit shows, like its native caret: lines hidden by a
+	// fold are skipped, and with p_visual (j / k, Helix's move_visual_line_*) a soft-wrapped
+	// line counts one row per wrap. gj / gk (move_line_*) count lines. The relative line
+	// numbers count the same rows, so "<n>j" lands on the line showing n.
+	// Without folds and wraps on the way this is exactly Helix's move_vertically().
+	const int tw = _tab_width();
+	if (!text_edit) {
+		return move_vertically(doc, p_range, p_forward, p_count, p_extend, tw);
+	}
+	const int64_t pos = cursor(doc, p_range);
+	const int line = doc.char_to_line(pos);
+	const int lc = MIN(doc.line_count(), text_edit->get_line_count());
+	auto wraps = [&](int p_line) { return p_visual ? text_edit->get_line_wrap_count(p_line) : 0; };
+	const int col_in_line = (int)(pos - doc.line_to_char(line));
+	int row = p_visual && wraps(line) > 0 ? text_edit->get_line_wrap_index_at_column(line, MIN(col_in_line, text_edit->get_line(line).length())) : 0;
+	bool special = wraps(line) > 0;
+	int tl = line;
+	int trow = row;
+	for (int i = 0; i < p_count; i++) {
+		if (p_forward) {
+			if (trow < wraps(tl)) {
+				trow++;
+				continue;
+			}
+			int next = tl + 1;
+			if (next >= lc) {
+				break;
+			}
+			if (_is_line_hidden(next)) {
+				special = true;
+				next = tl + text_edit->get_next_visible_line_offset_from(next, 1);
+				if (next >= lc || _is_line_hidden(next)) {
+					break;
+				}
+			}
+			tl = next;
+			trow = 0;
+		} else {
+			if (trow > 0) {
+				trow--;
+				continue;
+			}
+			int prev = tl - 1;
+			if (prev < 0) {
+				break;
+			}
+			if (_is_line_hidden(prev)) {
+				special = true;
+				prev = tl - text_edit->get_next_visible_line_offset_from(prev, -1);
+				if (prev < 0 || _is_line_hidden(prev)) {
+					break;
+				}
+			}
+			tl = prev;
+			trow = wraps(tl);
+		}
+		special = special || wraps(tl) > 0;
+	}
+	if (!special) {
+		return move_vertically(doc, p_range, p_forward, p_count, p_extend, tw);
+	}
+	if (!p_visual) {
+		// Logical lines, hidden ones skipped: the same motion with the count that reaches tl.
+		if (tl == line) {
+			return p_range;
+		}
+		return move_vertically(doc, p_range, tl > line, Math::abs(tl - line), p_extend, tw);
+	}
+
+	// Visual rows: keep the visual column within the row.
+	auto row_start = [&](int p_line, int p_row) {
+		int c = 0;
+		if (p_row > 0) {
+			Vector<String> rows = text_edit->get_line_wrapped_text(p_line);
+			for (int k = 0; k < p_row && k < rows.size(); k++) {
+				c += rows[k].length();
+			}
+		}
+		return c;
+	};
+	int64_t ls = doc.line_to_char(line);
+	int64_t rs = ls + row_start(line, row);
+	int vcol = p_range.old_col >= 0 ? p_range.old_col : visual_col(doc, pos, tw) - visual_col(doc, rs, tw);
+	if (tl == line && trow == row) {
+		return p_range;
+	}
+	int64_t tls = doc.line_to_char(tl);
+	int64_t start = tls + row_start(tl, trow);
+	bool last_row = trow >= text_edit->get_line_wrap_count(tl);
+	int64_t end = last_row ? doc.line_end(tl) : tls + row_start(tl, trow + 1);
+	int64_t new_pos = start;
+	int x = visual_col(doc, start, tw);
+	const int target = x + vcol;
+	while (new_pos < end) {
+		int64_t nx = doc.next_grapheme(new_pos);
+		int w = doc.grapheme_width_at(new_pos, nx, x, tw);
+		if (x + w > target) {
+			break;
+		}
+		x += w;
+		new_pos = nx;
+	}
+	if (!last_row && new_pos >= end) {
+		new_pos = MAX(doc.prev_grapheme(end), start); // Stay on this row.
+	}
+	if (p_extend && tl == lc - 1 && doc.line_length(tl) == 0) {
+		return p_range;
+	}
+	HelixRange r = put_cursor(doc, p_range, new_pos, p_extend);
+	r.old_col = vcol;
+	return r;
+}
+
+void HelixMode::_move_word(WordTarget p_target, bool p_extend) {
+	int n = _count();
+	if (p_extend) {
+		_set_selection(_transform(sel, [&](const HelixRange &r) {
+			HelixRange w = word_move(doc, r, n, p_target);
+			return put_cursor(doc, r, cursor(doc, w), true);
+		}));
+	} else {
+		_set_selection(_transform(sel, [&](const HelixRange &r) { return word_move(doc, r, n, p_target); }));
+	}
+}
+
+void HelixMode::_goto_line_start(bool p_extend) {
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int line = cursor_line(doc, r);
+		return put_cursor(doc, r, doc.line_to_char(line), p_extend);
+	}));
+}
+
+void HelixMode::_goto_line_end(bool p_extend) {
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int line = cursor_line(doc, r);
+		int64_t ls = doc.line_to_char(line);
+		int64_t pos = MAX(doc.prev_grapheme(doc.line_end(line)), ls);
+		return put_cursor(doc, r, pos, p_extend);
+	}));
+}
+
+void HelixMode::_goto_first_nonwhitespace(bool p_extend) {
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int line = cursor_line(doc, r);
+		int64_t f = doc.first_non_whitespace(line);
+		if (f < 0) {
+			return r;
+		}
+		return put_cursor(doc, r, doc.line_to_char(line) + f, p_extend);
+	}));
+}
+
+void HelixMode::_goto_line(int p_line, bool p_extend) {
+	int lc = doc.line_count();
+	int max_line = doc.line_length(lc - 1) == 0 && lc >= 2 ? lc - 2 : lc - 1;
+	if (doc.line_length(lc - 1) == 0 && lc < 2) {
+		max_line = 0;
+	}
+	int line_idx = MIN(MAX(p_line - 1, 0), max_line);
+	int64_t pos = doc.line_to_char(line_idx);
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return put_cursor(doc, r, pos, p_extend); }));
+}
+
+void HelixMode::_goto_file_start(bool p_extend) {
+	if (count > 0) {
+		_goto_line(count, p_extend);
+		return;
+	}
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return put_cursor(doc, r, 0, p_extend); }));
+}
+
+void HelixMode::_goto_last_line(bool p_extend) {
+	int lc = doc.line_count();
+	int line_idx = doc.line_length(lc - 1) == 0 ? MAX(lc - 2, 0) : lc - 1;
+	int64_t pos = doc.line_to_char(line_idx);
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return put_cursor(doc, r, pos, p_extend); }));
+}
+
+void HelixMode::_goto_column(bool p_extend) {
+	int n = _count();
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int line = cursor_line(doc, r);
+		int64_t ls = doc.line_to_char(line);
+		int64_t pos = MIN(doc.next_grapheme(ls, n - 1), doc.line_end(line));
+		if (n - 1 == 0) {
+			pos = ls;
+		}
+		return put_cursor(doc, r, pos, p_extend);
+	}));
+}
+
+void HelixMode::_find_char(char32_t p_ch, bool p_newline, bool p_forward, bool p_inclusive, bool p_extend, int p_count) {
+	int64_t len = doc.len();
+	if (p_newline) {
+		_set_selection(_transform(sel, [&](const HelixRange &r) {
+			int64_t cur = cursor(doc, r);
+			int cl = cursor_line(doc, r);
+			int lc = doc.line_count();
+			int64_t find_on_line;
+			if (p_forward) {
+				bool on_edge = doc.line_end(cl) == cur;
+				int64_t line = (int64_t)cl + p_count - 1 + (on_edge ? 1 : 0);
+				if (line >= lc - 1) {
+					return r;
+				}
+				find_on_line = line;
+			} else {
+				bool on_edge = doc.line_to_char(cl) == cur && !p_inclusive;
+				int64_t line = (int64_t)cl - ((int64_t)p_count - 1 + (on_edge ? 1 : 0));
+				if (line <= 0) {
+					return r;
+				}
+				find_on_line = line;
+			}
+			int64_t pos;
+			if (p_forward && p_inclusive) {
+				pos = doc.line_end((int)find_on_line);
+			} else if (p_forward) {
+				pos = doc.line_end((int)find_on_line) - 1;
+			} else if (p_inclusive) {
+				pos = doc.line_end((int)find_on_line - 1);
+			} else {
+				pos = doc.line_to_char((int)find_on_line);
+			}
+			if (p_extend) {
+				return put_cursor(doc, r, pos, true);
+			}
+			return put_cursor(doc, HelixRange::point(cursor(doc, r)), pos, true);
+		}));
+		return;
+	}
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int64_t start = r.anchor < r.head ? r.head - 1 : r.head;
+		int64_t found = -1;
+		if (p_forward) {
+			int64_t pos = MIN(start + 1, len);
+			if (p_inclusive) {
+				found = find_nth_next(doc, p_ch, pos, p_count);
+			} else {
+				int n = (pos < len && doc.char_at(pos) == p_ch) ? p_count + 1 : p_count;
+				found = find_nth_next(doc, p_ch, pos, n);
+				if (found >= 0) {
+					found = MAX(found - 1, (int64_t)0);
+				}
+			}
+		} else {
+			if (p_inclusive) {
+				found = find_nth_prev(doc, p_ch, start, p_count);
+			} else {
+				int n = (start > 0 && doc.char_at(start - 1) == p_ch) ? p_count + 1 : p_count;
+				if (start == 0 && doc.char_at(0) == p_ch) {
+					n = p_count + 1;
+				}
+				found = find_nth_prev(doc, p_ch, start, n);
+				if (found >= 0) {
+					found = MIN(found + 1, len);
+				}
+			}
+		}
+		if (found < 0) {
+			return r;
+		}
+		if (p_extend) {
+			return put_cursor(doc, r, found, true);
+		}
+		return put_cursor(doc, HelixRange::point(cursor(doc, r)), found, true);
+	}));
+}
+
+void HelixMode::_paragraph(bool p_forward, int p_count) {
+	bool ext = _extending();
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		return p_forward ? move_next_paragraph(doc, r, p_count, ext) : move_prev_paragraph(doc, r, p_count, ext);
+	}));
+}
+
+void HelixMode::_textobject(bool p_inside, char32_t p_ch, int p_count) {
+	if (p_ch == 'g') {
+		_set_status("Diff is not available in current buffer");
+		return;
+	}
+	if (p_ch == 't' || p_ch == 'f' || p_ch == 'a' || p_ch == 'c' || p_ch == 'T' || p_ch == 'e') {
+		_set_status("Tree-sitter text objects are not available in this buffer", true);
+		return;
+	}
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		switch (p_ch) {
+			case 'w':
+				return textobject_word(doc, r, p_inside, false);
+			case 'W':
+				return textobject_word(doc, r, p_inside, true);
+			case 'p':
+				return textobject_paragraph(doc, r, p_inside, p_count);
+			case 'm':
+				return textobject_pair(doc, r, p_inside, 0, p_count);
+			default:
+				if (p_ch < 128 && is_ascii_alphanumeric_char(p_ch)) {
+					return r;
+				}
+				return textobject_pair(doc, r, p_inside, p_ch, p_count);
+		}
+	}));
+}
+
+void HelixMode::_run_motion(const LastMotion &p_motion, int p_times) {
+	p_times = MIN(p_times, REPEAT_CAP);
+	for (int i = 0; i < p_times; i++) {
+		HelixSelection before = sel; // Stop once repeating changes nothing (no more matches).
+		switch (p_motion.kind) {
+			case MOTION_FIND:
+				_find_char(p_motion.ch, p_motion.newline, p_motion.forward, p_motion.inclusive, p_motion.extend, p_motion.count);
+				break;
+			case MOTION_PARA:
+				_paragraph(p_motion.forward, p_motion.count);
+				break;
+			case MOTION_TEXTOBJECT:
+				_textobject(p_motion.inside, p_motion.ch, p_motion.count);
+				break;
+			default:
+				return;
+		}
+		if (sel == before) {
+			break;
+		}
+	}
+}
+
+void HelixMode::_replace_char(const String &p_with) {
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<HelixChange> changes;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		if (r.is_empty()) {
+			continue;
+		}
+		String t;
+		int64_t p = r.from();
+		while (p < r.to()) {
+			t += p_with;
+			p = doc.next_grapheme(p);
+		}
+		changes.push_back(HelixChange(r.from(), r.to(), t));
+	}
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_switch_case(int p_kind) {
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<HelixChange> changes;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		String t = doc.slice(r.from(), r.to());
+		String n = p_kind == 0 ? switch_case(t) : (p_kind == 1 ? to_lower(t) : to_upper(t));
+		changes.push_back(HelixChange(r.from(), r.to(), n));
+	}
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_extend_line_below() {
+	int n = _count();
+	int lc = doc.line_count();
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int sl, el;
+		line_range(doc, r, sl, el);
+		int64_t start = doc.line_to_char(sl);
+		int64_t end = doc.line_to_char(MIN(el + 1, lc));
+		if (r.from() == start && r.to() == end) {
+			return HelixRange(start, doc.line_to_char(MIN(el + n + 1, lc)));
+		}
+		return HelixRange(start, doc.line_to_char(MIN(el + n, lc)));
+	}));
+}
+
+void HelixMode::_extend_to_line_bounds() {
+	int lc = doc.line_count();
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int sl, el;
+		line_range(doc, r, sl, el);
+		return HelixRange(doc.line_to_char(sl), doc.line_to_char(MIN(el + 1, lc))).with_direction(r.is_forward());
+	}));
+}
+
+void HelixMode::_shrink_to_line_bounds() {
+	int lc = doc.line_count();
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int sl, el;
+		line_range(doc, r, sl, el);
+		if (sl == el) {
+			return r;
+		}
+		int64_t start = doc.line_to_char(sl);
+		int64_t end = doc.line_to_char(MIN(el + 1, lc));
+		if (start != r.from()) {
+			start = doc.line_to_char(MIN(sl + 1, lc));
+		}
+		if (end != r.to()) {
+			end = doc.line_to_char(el);
+		}
+		return HelixRange(start, end).with_direction(r.is_forward());
+	}));
+}
+
+void HelixMode::_copy_selection_on_line(bool p_forward) {
+	int n = _count();
+	int tw = _tab_width();
+	int lc = doc.line_count();
+	Vector<HelixRange> ranges = sel.ranges;
+	int primary_index = 0;
+	for (int ri = 0; ri < sel.ranges.size(); ri++) {
+		const HelixRange &r = sel.ranges[ri];
+		bool is_primary = ri == sel.primary;
+		int64_t head, anchor;
+		if (r.anchor < r.head) {
+			head = r.head - 1;
+			anchor = r.anchor;
+		} else {
+			head = r.head;
+			anchor = MAX(r.anchor - 1, (int64_t)0);
+		}
+		int head_row = doc.char_to_line(head);
+		int anchor_row = doc.char_to_line(anchor);
+		int head_col = visual_col(doc, head, tw);
+		int anchor_col = visual_col(doc, anchor, tw);
+		int height = MAX(head_row, anchor_row) - MIN(head_row, anchor_row) + 1;
+		if (is_primary) {
+			primary_index = ranges.size();
+		}
+		ranges.push_back(r);
+		int sels = 0;
+		int i = 0;
+		while (sels < n) {
+			int offset = (i + 1) * height;
+			int64_t arow = p_forward ? (int64_t)anchor_row + offset : MAX((int64_t)anchor_row - offset, (int64_t)0);
+			int64_t hrow = p_forward ? (int64_t)head_row + offset : MAX((int64_t)head_row - offset, (int64_t)0);
+			if (arow >= lc || hrow >= lc) {
+				break;
+			}
+			int64_t na = pos_at_visual_col(doc, (int)arow, anchor_col, tw, false);
+			int64_t nh = pos_at_visual_col(doc, (int)hrow, head_col, tw, false);
+			if (visual_col(doc, na, tw) == anchor_col && visual_col(doc, nh, tw) == head_col) {
+				if (is_primary) {
+					primary_index = ranges.size();
+				}
+				ranges.push_back(put_cursor(doc, HelixRange::point(na), nh, true));
+				sels++;
+			}
+			if (arow == 0 && hrow == 0) {
+				break;
+			}
+			i++;
+		}
+	}
+	_set_selection(HelixSelection::from_ranges(ranges, primary_index));
+}
+
+void HelixMode::_rotate_contents(bool p_forward) {
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<String> frags;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		frags.push_back(doc.slice(sel.ranges[i].from(), sel.ranges[i].to()));
+	}
+	int group = count > 0 ? MIN(count, frags.size()) : frags.size();
+	for (int start = 0; start < frags.size(); start += group) {
+		int end = MIN(start + group, frags.size());
+		if (end - start < 2) {
+			continue;
+		}
+		if (p_forward) {
+			String last = frags[end - 1];
+			for (int k = end - 1; k > start; k--) {
+				frags.write[k] = frags[k - 1];
+			}
+			frags.write[start] = last;
+		} else {
+			String first = frags[start];
+			for (int k = start; k < end - 1; k++) {
+				frags.write[k] = frags[k + 1];
+			}
+			frags.write[end - 1] = first;
+		}
+	}
+	Vector<HelixChange> changes;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		changes.push_back(HelixChange(sel.ranges[i].from(), sel.ranges[i].to(), frags[i]));
+	}
+	_apply_changes(changes);
+}
+
+void HelixMode::_trim_selections() {
+	Vector<HelixRange> ranges;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		if (r.is_empty()) {
+			continue;
+		}
+		bool all_ws = true;
+		for (int64_t p = r.from(); p < r.to(); p++) {
+			if (!HelixAlgo::is_whitespace(doc.char_at(p))) {
+				all_ws = false;
+				break;
+			}
+		}
+		if (all_ws) {
+			continue;
+		}
+		int64_t start = r.from();
+		int64_t end = r.to();
+		while (start < doc.len() && HelixAlgo::is_whitespace(doc.char_at(start))) {
+			start++;
+		}
+		while (end > 0 && HelixAlgo::is_whitespace(doc.char_at(end - 1))) {
+			end--;
+		}
+		ranges.push_back(HelixRange(start, end).with_direction(r.is_forward()));
+	}
+	if (!ranges.is_empty()) {
+		HelixRange prim = sel.primary_range();
+		int idx = ranges.size() - 1;
+		for (int i = 0; i < ranges.size(); i++) {
+			if (ranges[i].overlaps(prim)) {
+				idx = i;
+				break;
+			}
+		}
+		_set_selection(HelixSelection::from_ranges(ranges, idx));
+	} else {
+		HelixSelection s = _transform(sel, [&](const HelixRange &r) { return HelixRange::point(cursor(doc, r)); });
+		_set_selection(s.into_single());
+	}
+}
+
+void HelixMode::_align_selections() {
+	if (!_check_editable()) {
+		return;
+	}
+	int tw = _tab_width();
+	Vector<Vector<Pair<int64_t, int>>> column_widths;
+	int last_line = doc.line_count() + 1;
+	int col = 0;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		int hrow = doc.char_to_line(r.head);
+		int arow = doc.char_to_line(r.anchor);
+		if (hrow != arow) {
+			_set_status("align cannot work with multi line selections", true);
+			return;
+		}
+		int hcol = visual_col(doc, r.head, tw);
+		col = hrow == last_line ? col + 1 : 0;
+		if (col >= column_widths.size()) {
+			column_widths.push_back(Vector<Pair<int64_t, int>>());
+		}
+		column_widths.write[col].push_back(Pair<int64_t, int>(r.from(), hcol));
+		last_line = hrow;
+	}
+	Vector<HelixChange> changes;
+	int len0 = column_widths.is_empty() ? 0 : column_widths[0].size();
+	Vector<int> offs;
+	offs.resize(len0);
+	offs.fill(0);
+	for (int c = 0; c < column_widths.size(); c++) {
+		const Vector<Pair<int64_t, int>> &colv = column_widths[c];
+		int max_col = 0;
+		for (int row = 0; row < colv.size(); row++) {
+			max_col = MAX(max_col, colv[row].second + (row < offs.size() ? offs[row] : 0));
+		}
+		for (int row = 0; row < colv.size(); row++) {
+			int o = row < offs.size() ? offs[row] : 0;
+			int ins = max_col - (colv[row].second + o);
+			if (ins == 0) {
+				continue;
+			}
+			if (row < offs.size()) {
+				offs.write[row] += ins;
+			}
+			changes.push_back(HelixChange(colv[row].first, colv[row].first, String(" ").repeat(ins)));
+		}
+	}
+	changes.sort_custom<_HelixChangeCompare>();
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_split_on_newline() {
+	Vector<HelixRange> result;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		if (r.from() == r.to()) {
+			result.push_back(r);
+			continue;
+		}
+		int64_t start = r.from();
+		int64_t end = r.to();
+		for (int64_t p = start; p < end; p++) {
+			if (doc.char_at(p) == '\n') {
+				result.push_back(HelixRange(start, p));
+				start = p + 1;
+			}
+		}
+		if (start < end) {
+			result.push_back(HelixRange(start, end));
+		}
+	}
+	if (result.is_empty()) {
+		return;
+	}
+	_set_selection(HelixSelection::from_ranges(result, 0));
+}
+
+void HelixMode::_join_selections(bool p_select_space) {
+	if (!_check_editable()) {
+		return;
+	}
+	int lc = doc.line_count();
+	// Line comment tokens of the buffer's language, longest first (Rust's /// before //).
+	Vector<String> tokens;
+	TypedArray<String> delims = text_edit->get_comment_delimiters();
+	for (int i = 0; i < delims.size(); i++) {
+		String d = delims[i];
+		if (!d.is_empty() && !d.contains(" ")) {
+			int at = 0;
+			while (at < tokens.size() && tokens[at].length() >= d.length()) {
+				at++;
+			}
+			tokens.insert(at, d);
+		}
+	}
+	auto skip_blank = [&](int64_t p_pos) {
+		while (p_pos < doc.len() && (doc.char_at(p_pos) == ' ' || doc.char_at(p_pos) == '\t')) {
+			p_pos++;
+		}
+		return p_pos;
+	};
+	auto token_at = [&](int64_t p_pos) {
+		for (int t = 0; t < tokens.size(); t++) {
+			if (doc.slice(p_pos, p_pos + tokens[t].length()) == tokens[t]) {
+				return t;
+			}
+		}
+		return -1;
+	};
+	Vector<HelixChange> changes;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		int start, end;
+		line_range(doc, sel.ranges[i], start, end);
+		if (start == end) {
+			end = MIN(end + 1, lc - 1);
+		}
+		int current_token = token_at(skip_blank(doc.line_to_char(start)));
+		for (int line = start; line < end; line++) {
+			int64_t s = doc.line_end(line);
+			int64_t e = skip_blank(doc.line_to_char(line + 1));
+			int t = token_at(e);
+			if (t >= 0) {
+				if (t == current_token) {
+					e = skip_blank(e + tokens[t].length());
+				} else {
+					current_token = t;
+				}
+			}
+			HelixChange c;
+			c.from = s;
+			c.to = e;
+			if (e != doc.line_end(line + 1)) {
+				c.insert = true;
+				c.text = " ";
+			}
+			changes.push_back(c);
+		}
+	}
+	if (changes.is_empty()) {
+		return;
+	}
+	changes.sort_custom<_HelixChangeCompare>();
+	// Dedup identical changes.
+	Vector<HelixChange> dedup;
+	for (int i = 0; i < changes.size(); i++) {
+		if (!dedup.is_empty() && dedup[dedup.size() - 1].from == changes[i].from && dedup[dedup.size() - 1].to == changes[i].to && dedup[dedup.size() - 1].insert == changes[i].insert) {
+			continue;
+		}
+		dedup.push_back(changes[i]);
+	}
+	if (p_select_space) {
+		int64_t offset = 0;
+		Vector<HelixRange> ranges;
+		for (int i = 0; i < dedup.size(); i++) {
+			const HelixChange &c = dedup[i];
+			if (c.insert) {
+				ranges.push_back(HelixRange::point(c.from - offset));
+				offset += c.to - c.from - 1;
+			} else {
+				offset += c.to - c.from;
+			}
+		}
+		if (!ranges.is_empty()) {
+			HelixSelection s = HelixSelection::from_ranges(ranges, 0);
+			_apply_changes(dedup, &s);
+			return;
+		}
+	}
+	_apply_changes(dedup);
+}
+
+void HelixMode::_delete_selection(bool p_yank, bool p_change) {
+	if (!_check_editable()) {
+		return;
+	}
+	int lc = doc.line_count();
+	bool only_whole_lines = true;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		bool has_newline = false;
+		for (int64_t p = r.from(); p < r.to(); p++) {
+			if (doc.char_at(p) == '\n') {
+				has_newline = true;
+				break;
+			}
+		}
+		if (!has_newline) {
+			only_whole_lines = false;
+			break;
+		}
+		int sl, el;
+		line_range(doc, r, sl, el);
+		if (doc.line_to_char(sl) != r.from() || doc.line_to_char(MIN(el + 1, lc)) != r.to()) {
+			only_whole_lines = false;
+			break;
+		}
+	}
+	if (p_yank) {
+		Vector<String> values;
+		for (int i = 0; i < sel.ranges.size(); i++) {
+			values.push_back(doc.slice(sel.ranges[i].from(), sel.ranges[i].to()));
+		}
+		shared.reg_default = values;
+	}
+	Vector<HelixChange> changes;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		changes.push_back(HelixChange(sel.ranges[i].from(), sel.ranges[i].to()));
+	}
+	_apply_changes(changes);
+	if (!p_change) {
+		_exit_select();
+		return;
+	}
+	if (only_whole_lines) {
+		_open(false);
+	} else {
+		mode = MODE_NORMAL;
+		_enter_insert(false);
+	}
+}
+
+void HelixMode::_insert_mode() {
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return HelixRange(r.to(), r.from()); }));
+	mode = MODE_NORMAL;
+	_enter_insert(false);
+}
+
+void HelixMode::_append_mode() {
+	int64_t end = doc.len();
+	const HelixRange &last = sel.ranges[sel.ranges.size() - 1];
+	if (!last.is_empty() && last.to() == end) {
+		Vector<HelixChange> ch;
+		ch.push_back(HelixChange(end, end, "\n"));
+		_apply_changes(ch);
+	}
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return HelixRange(r.from(), doc.next_grapheme(r.to())); }));
+	mode = MODE_NORMAL;
+	_enter_insert(true);
+}
+
+void HelixMode::_insert_with_indent(bool p_line_end) {
+	// Helix's insert_with_indent switches to insert mode before it moves the cursors, so its
+	// put_cursor(.., mode == Select) never extends: A / I in select mode leave a cursor too.
+	const bool ext = false;
+	Vector<HelixRange> ranges;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		int line = cursor_line(doc, r);
+		int64_t ls = doc.line_to_char(line);
+		if (doc.line_end(line) == ls) {
+			ranges.push_back(HelixRange::point(ls));
+		} else {
+			int64_t pos;
+			if (p_line_end) {
+				pos = doc.line_end(line);
+			} else {
+				int64_t f = doc.first_non_whitespace(line);
+				pos = f >= 0 ? ls + f : ls;
+			}
+			ranges.push_back(put_cursor(doc, r, pos, ext));
+		}
+	}
+	_set_selection(HelixSelection::from_ranges(ranges, sel.primary));
+	mode = MODE_NORMAL;
+	_enter_insert(false);
+}
+
+void HelixMode::_open(bool p_below) {
+	int n = MIN(_count(), MAX(REPEAT_CAP / MAX(sel.ranges.size(), 1), 1));
+	if (!_check_editable()) {
+		return;
+	}
+	String indent_unit = _indent_unit();
+	int indent_size = MAX(text_edit->get_indent_size(), 1);
+	TypedArray<String> prefixes_arr = text_edit->get_auto_indent_prefixes();
+	Vector<HelixChange> changes;
+	Vector<HelixRange> ranges;
+	int64_t offs = 0;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		int curr_line = doc.char_to_line(p_below ? doc.prev_grapheme(r.to()) : r.from());
+		int next_new_line = p_below ? curr_line + 1 : curr_line;
+		int above = MAX(next_new_line - 1, 0);
+		int64_t above_end;
+		int64_t above_width;
+		if (next_new_line == 0) {
+			above_end = 0;
+			above_width = 0;
+		} else {
+			above_end = doc.line_end(above);
+			above_width = 1;
+		}
+		// Indentation like CodeEdit's own new line: the current line's indent (in whole
+		// indent units), plus one level after an auto-indent prefix such as ':' when opening below.
+		const String &line = doc.line(curr_line);
+		String indent;
+		int space_count = 0;
+		int col = 0;
+		for (; col < line.length(); col++) {
+			if (line[col] == '\t') {
+				indent += indent_unit;
+				space_count = 0;
+				continue;
+			}
+			if (line[col] == ' ') {
+				space_count++;
+				if (space_count == indent_size) {
+					indent += indent_unit;
+					space_count = 0;
+				}
+				continue;
+			}
+			break;
+		}
+		if (p_below && text_edit->is_auto_indent_enabled() && line.length() > 0 && text_edit->is_in_comment(curr_line) == -1) {
+			bool should_indent = false;
+			for (int c = col; c < line.length(); c++) {
+				char32_t ch = line[c];
+				if (prefixes_arr.has(String::chr(ch)) && text_edit->is_in_comment(curr_line, c) == -1) {
+					should_indent = true;
+					continue;
+				}
+				if (should_indent && !HelixAlgo::is_whitespace(ch) && text_edit->is_in_comment(curr_line, c + 1) == -1) {
+					should_indent = false;
+				}
+			}
+			if (should_indent) {
+				indent += indent_unit;
+			}
+		}
+		String text;
+		if (!p_below && next_new_line == 0) {
+			text = indent + "\n";
+		} else {
+			text = "\n" + indent;
+		}
+		text = text.repeat(n);
+		int64_t pos = offs + above_end + above_width;
+		for (int k = 0; k < n; k++) {
+			ranges.push_back(HelixRange::point(pos + k * (1 + indent.length()) + indent.length()));
+		}
+		offs += text.length();
+		changes.push_back(HelixChange(above_end, above_end, text));
+	}
+	HelixSelection s;
+	s.ranges = ranges;
+	s.primary = CLAMP(sel.primary, 0, ranges.size() - 1);
+	s.normalize();
+	_apply_changes(changes, &s);
+	mode = MODE_NORMAL;
+	ins_from_open = true;
+	ins_count = n;
+	_enter_insert(false);
+}
+
+// helix-view register.rs contents_are_saved(): the clipboard still holds the values last yanked to
+// it (joined with newlines) if it starts with them; what follows them is not looked at.
+static bool _clipboard_holds(const Vector<String> &p_values, const String &p_text) {
+	if (p_values.is_empty()) {
+		return p_text.is_empty();
+	}
+	int64_t pos = 0;
+	for (int i = 0; i < p_values.size(); i++) {
+		if (i > 0) {
+			if (p_text.substr(pos, 1) != "\n") {
+				return false;
+			}
+			pos++;
+		}
+		if (p_text.substr(pos, p_values[i].length()) != p_values[i]) {
+			return false;
+		}
+		pos += p_values[i].length();
+	}
+	return true;
+}
+
+Vector<String> HelixMode::_read_register(const String &p_register) const {
+	if (p_register == "+") {
+		String text = DisplayServer::get_singleton() ? DisplayServer::get_singleton()->clipboard_get() : String();
+		if (!shared.clipboard_values.is_empty() && _clipboard_holds(shared.clipboard_values, text)) {
+			return shared.clipboard_values;
+		}
+		Vector<String> v;
+		v.push_back(text);
+		return v;
+	}
+	return shared.reg_default;
+}
+
+void HelixMode::_write_register(const String &p_register, const Vector<String> &p_values) {
+	if (p_register == "+") {
+		shared.clipboard_values = p_values;
+		shared.clipboard_joined = String("\n").join(p_values);
+		if (DisplayServer::get_singleton()) {
+			DisplayServer::get_singleton()->clipboard_set(shared.clipboard_joined);
+		}
+		return;
+	}
+	shared.reg_default = p_values;
+}
+
+void HelixMode::_yank(const String &p_register) {
+	Vector<String> values;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		values.push_back(doc.slice(sel.ranges[i].from(), sel.ranges[i].to()));
+	}
+	_write_register(p_register, values);
+	_set_status(vformat("yanked %d selection%s to register %s", values.size(), values.size() == 1 ? "" : "s", p_register));
+	_exit_select();
+}
+
+void HelixMode::_yank_primary_to_clipboard() {
+	// yank_primary_selection_impl: the primary selection only, as one value. Callers decide
+	// about select mode (<space>Y leaves it, the typed :clipboard-yank does not).
+	Vector<String> values;
+	values.push_back(doc.slice(sel.primary_range().from(), sel.primary_range().to()));
+	_write_register("+", values);
+	_set_status("yanked primary selection to register +");
+}
+
+void HelixMode::_paste(const Vector<String> &p_values, bool p_after, int p_count) {
+	if (p_values.is_empty()) {
+		return;
+	}
+	if (!_check_editable()) {
+		return;
+	}
+	bool linewise = false;
+	for (int i = 0; i < p_values.size(); i++) {
+		if (p_values[i].ends_with("\n")) {
+			linewise = true;
+		}
+	}
+	Vector<String> mapped;
+	for (int i = 0; i < p_values.size(); i++) {
+		String v = p_values[i].replace("\r\n", "\n").replace("\r", "\n");
+		mapped.push_back(v.repeat(_cap_for_text(p_count, v.length() * (int64_t)sel.ranges.size())));
+	}
+	int lc = doc.line_count();
+	Vector<HelixChange> changes;
+	Vector<HelixRange> ranges;
+	int64_t offset = 0;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		int64_t pos;
+		if (linewise) {
+			if (p_after) {
+				int sl, el;
+				line_range(doc, r, sl, el);
+				pos = doc.line_to_char(MIN(el + 1, lc));
+			} else {
+				pos = doc.line_to_char(doc.char_to_line(r.from()));
+			}
+		} else {
+			pos = p_after ? r.to() : r.from();
+		}
+		const String &value = i < mapped.size() ? mapped[i] : mapped[mapped.size() - 1];
+		int64_t anchor = offset + pos;
+		ranges.push_back(HelixRange(anchor, anchor + value.length()).with_direction(r.is_forward()));
+		offset += value.length();
+		changes.push_back(HelixChange(pos, pos, value));
+	}
+	if (mode == MODE_NORMAL) {
+		HelixSelection s;
+		s.ranges = ranges;
+		s.primary = sel.primary;
+		s.normalize();
+		_apply_changes(changes, &s);
+	} else {
+		_apply_changes(changes);
+	}
+}
+
+void HelixMode::_replace_with(const Vector<String> &p_values, int p_count) {
+	if (p_values.is_empty()) {
+		return;
+	}
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<String> mapped;
+	for (int i = 0; i < p_values.size(); i++) {
+		String v = p_values[i].replace("\r\n", "\n").replace("\r", "\n");
+		mapped.push_back(v.repeat(_cap_for_text(p_count, v.length() * (int64_t)sel.ranges.size())));
+	}
+	Vector<HelixChange> changes;
+	int vi = 0;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		if (!r.is_empty()) {
+			const String &value = vi < mapped.size() ? mapped[vi] : mapped[mapped.size() - 1];
+			vi++;
+			changes.push_back(HelixChange(r.from(), r.to(), value));
+		}
+	}
+	_apply_changes(changes);
+}
+
+void HelixMode::_indent(int p_count) {
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<int> lines;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		int s, e;
+		line_range(doc, sel.ranges[i], s, e);
+		for (int l = s; l <= e; l++) {
+			if (lines.is_empty() || lines[lines.size() - 1] < l) {
+				lines.push_back(l);
+			}
+		}
+	}
+	String indent = _indent_unit().repeat(MIN(p_count, 100));
+	Vector<HelixChange> changes;
+	for (int i = 0; i < lines.size(); i++) {
+		const String &t = doc.line(lines[i]);
+		if (t.strip_edges().is_empty()) {
+			continue;
+		}
+		int64_t pos = doc.line_to_char(lines[i]);
+		changes.push_back(HelixChange(pos, pos, indent));
+	}
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_unindent(int p_count) {
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<int> lines;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		int s, e;
+		line_range(doc, sel.ranges[i], s, e);
+		for (int l = s; l <= e; l++) {
+			if (lines.is_empty() || lines[lines.size() - 1] < l) {
+				lines.push_back(l);
+			}
+		}
+	}
+	int tab_width = _tab_width();
+	int unit = text_edit->is_indent_using_spaces() ? MAX(text_edit->get_indent_size(), 1) : tab_width;
+	int indent_width = p_count * unit;
+	Vector<HelixChange> changes;
+	for (int i = 0; i < lines.size(); i++) {
+		const String &t = doc.line(lines[i]);
+		int width = 0;
+		int pos = 0;
+		for (int k = 0; k < t.length(); k++) {
+			char32_t c = t[k];
+			if (c == ' ') {
+				width += 1;
+			} else if (c == '\t') {
+				width = (width / tab_width + 1) * tab_width;
+			} else {
+				break;
+			}
+			pos++;
+			if (width >= indent_width) {
+				break;
+			}
+		}
+		if (pos > 0) {
+			int64_t start = doc.line_to_char(lines[i]);
+			changes.push_back(HelixChange(start, start + pos));
+		}
+	}
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_toggle_comments() {
+	if (!_check_editable()) {
+		return;
+	}
+	String token = "#";
+	TypedArray<String> delims = text_edit->get_comment_delimiters();
+	for (int i = 0; i < delims.size(); i++) {
+		String d = delims[i];
+		if (!d.contains(" ") && !d.is_empty()) {
+			token = d;
+			break;
+		}
+	}
+	int lc = doc.line_count();
+	Vector<int> lines;
+	int min_next_line = 0;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		int s, e;
+		line_range(doc, sel.ranges[i], s, e);
+		s = CLAMP(s, min_next_line, lc);
+		e = MIN(e + 1, lc);
+		for (int l = s; l < e; l++) {
+			lines.push_back(l);
+		}
+		min_next_line = e;
+	}
+	bool commented = true;
+	Vector<int> to_change;
+	int min = INT32_MAX;
+	int margin = 1;
+	int token_len = token.length();
+	for (int i = 0; i < lines.size(); i++) {
+		const String &t = doc.line(lines[i]);
+		int pos = -1;
+		for (int k = 0; k < t.length(); k++) {
+			if (!HelixAlgo::is_whitespace(t[k])) {
+				pos = k;
+				break;
+			}
+		}
+		if (pos < 0) {
+			continue;
+		}
+		min = MIN(min, pos);
+		if (t.substr(pos, token_len) != token) {
+			commented = false;
+		}
+		if (!(pos + token_len < t.length() && t[pos + token_len] == ' ')) {
+			margin = 0;
+		}
+		to_change.push_back(lines[i]);
+	}
+	Vector<HelixChange> changes;
+	for (int i = 0; i < to_change.size(); i++) {
+		int64_t pos = doc.line_to_char(to_change[i]) + min;
+		if (!commented) {
+			changes.push_back(HelixChange(pos, pos, token + " "));
+		} else {
+			changes.push_back(HelixChange(pos, pos + token_len + margin));
+		}
+	}
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_increment(int64_t p_amount) {
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<HelixRange> new_ranges;
+	Vector<HelixChange> changes;
+	int64_t diff = 0;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		String t = doc.slice(r.from(), r.to());
+		int64_t new_from = r.from() + diff;
+		String result;
+		if (increment_integer(t, p_amount, result)) {
+			new_ranges.push_back(HelixRange(new_from, new_from + result.length()));
+			diff += result.length() - t.length();
+			changes.push_back(HelixChange(r.from(), r.to(), result));
+		} else {
+			new_ranges.push_back(HelixRange(new_from, r.to() + diff));
+		}
+	}
+	if (!changes.is_empty()) {
+		HelixSelection s;
+		s.ranges = new_ranges;
+		s.primary = sel.primary;
+		s.normalize();
+		_apply_changes(changes, &s);
+		_exit_select();
+	}
+}
+
+void HelixMode::_add_newline(bool p_below, int p_count) {
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<HelixChange> changes;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		int s, e;
+		line_range(doc, sel.ranges[i], s, e);
+		int line = p_below ? e + 1 : s;
+		int64_t pos = doc.line_to_char(line);
+		changes.push_back(HelixChange(pos, pos, String("\n").repeat(MIN(p_count, REPEAT_CAP))));
+	}
+	changes.sort_custom<_HelixChangeCompare>();
+	_apply_changes(changes);
+}
+
+void HelixMode::_match_brackets() {
+	bool ext = _extending();
+	_set_selection(_transform(sel, [&](const HelixRange &r) {
+		int64_t pos = cursor(doc, r);
+		int64_t m = find_matching_bracket_plaintext(doc, pos);
+		if (m < 0) {
+			return r;
+		}
+		return put_cursor(doc, r, m, ext);
+	}));
+}
+
+void HelixMode::_surround_add(const String &p_key) {
+	String open, close;
+	int64_t surround_len = 2;
+	char32_t c;
+	if (p_key == "<ret>") {
+		open = "\n";
+		close = "\n";
+	} else if (_key_char(p_key, c)) {
+		char32_t o, cl;
+		get_pair(c, o, cl);
+		open = String::chr(o);
+		close = String::chr(cl);
+	} else {
+		return;
+	}
+	if (!_check_editable()) {
+		return;
+	}
+	Vector<HelixChange> changes;
+	Vector<HelixRange> ranges;
+	int64_t offs = 0;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		changes.push_back(HelixChange(r.from(), r.from(), open));
+		changes.push_back(HelixChange(r.to(), r.to(), close));
+		ranges.push_back(HelixRange(offs + r.from(), offs + r.to() + surround_len).with_direction(r.is_forward()));
+		offs += surround_len;
+	}
+	HelixSelection s;
+	s.ranges = ranges;
+	s.primary = sel.primary;
+	s.normalize();
+	_apply_changes(changes, &s);
+	_exit_select();
+}
+
+void HelixMode::_surround_delete(char32_t p_ch, int p_count) {
+	Vector<int64_t> pos;
+	SurroundError err = get_surround_pos(doc, sel, p_ch, p_count, pos);
+	if (err != SURROUND_OK) {
+		_set_status(surround_error_message(err), true);
+		return;
+	}
+	if (!_check_editable()) {
+		return;
+	}
+	pos.sort();
+	Vector<HelixChange> changes;
+	for (int i = 0; i < pos.size(); i++) {
+		changes.push_back(HelixChange(pos[i], pos[i] + 1));
+	}
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_surround_replace(char32_t p_from, const String &p_to_key, int p_count) {
+	Vector<int64_t> pos;
+	SurroundError err = get_surround_pos(doc, sel, p_from, p_count, pos);
+	if (err != SURROUND_OK) {
+		_set_status(surround_error_message(err), true);
+		return;
+	}
+	char32_t to;
+	if (!_key_char(p_to_key, to)) {
+		return;
+	}
+	if (!_check_editable()) {
+		return;
+	}
+	char32_t open, close;
+	get_pair(to, open, close);
+	Vector<Pair<int64_t, char32_t>> sorted;
+	for (int i = 0; i + 1 < pos.size(); i += 2) {
+		sorted.push_back(Pair<int64_t, char32_t>(pos[i], open));
+		sorted.push_back(Pair<int64_t, char32_t>(pos[i + 1], close));
+	}
+	sorted.sort_custom<_HelixPosCharCompare>();
+	Vector<HelixChange> changes;
+	for (int i = 0; i < sorted.size(); i++) {
+		changes.push_back(HelixChange(sorted[i].first, sorted[i].first + 1, String::chr(sorted[i].second)));
+	}
+	_apply_changes(changes);
+	_exit_select();
+}
+
+void HelixMode::_select_mode() {
+	int64_t len = doc.len();
+	HelixSelection s = _transform(sel, [&](const HelixRange &r) {
+		if (r.is_empty() && r.head == len) {
+			return HelixRange(doc.prev_grapheme(r.anchor), r.head);
+		}
+		return r;
+	});
+	_set_selection(s);
+	mode = MODE_SELECT;
+}
+
+int HelixMode::_view_height() const {
+	if (!text_edit || !text_edit->is_inside_tree()) {
+		return 1;
+	}
+	return MAX(text_edit->get_visible_line_count(), 1);
+}
+
+void HelixMode::_scroll(int p_lines, bool p_forward, bool p_sync_cursor) {
+	int height = _view_height();
+	int so = MIN(5, (height - 1) / 2);
+	int lc = doc.line_count();
+	if (text_edit->is_inside_tree()) {
+		int first = text_edit->get_first_visible_line();
+		int nf = CLAMP(first + (p_forward ? p_lines : -p_lines), 0, MAX(lc - 1, 0));
+		text_edit->set_line_as_first_visible(nf);
+	}
+	if (p_sync_cursor) {
+		bool ext = _extending();
+		_set_selection(_transform(sel, [&](const HelixRange &r) { return _move_rows(r, p_forward, p_lines, ext, true); }));
+		return;
+	}
+	int first = text_edit->is_inside_tree() ? text_edit->get_first_visible_line() : 0;
+	const HelixRange &prim = sel.primary_range();
+	int64_t cur = cursor(doc, prim);
+	int64_t head;
+	if (p_forward) {
+		head = doc.line_to_char(MIN(first + so, lc - 1));
+		if (head <= cur) {
+			return;
+		}
+	} else {
+		head = doc.line_to_char(MIN(first + height - so - 1, lc - 1));
+		if (head >= cur) {
+			return;
+		}
+	}
+	int64_t anchor = _extending() ? prim.anchor : head;
+	HelixSelection s = sel;
+	s.ranges.write[s.primary] = HelixRange(anchor, head);
+	s.normalize();
+	_set_selection(s);
+}
+
+void HelixMode::_goto_window(int p_align) {
+	int c = _count() - 1;
+	int height = _view_height();
+	int so = MIN(5, (height - 1) / 2);
+	int lc = doc.line_count();
+	int first = text_edit->is_inside_tree() ? text_edit->get_first_visible_line() : 0;
+	int last_visual_line = MIN(height, lc - first) - 1;
+	last_visual_line = MAX(last_visual_line, 0);
+	int line;
+	if (p_align == 0) {
+		line = first + so + c;
+	} else if (p_align == 1) {
+		line = first + last_visual_line / 2;
+	} else {
+		line = first + MAX(last_visual_line - (so + c), 0);
+	}
+	line = MIN(MAX(line, first + so), first + MAX(last_visual_line - so, 0));
+	line = CLAMP(line, 0, lc - 1);
+	int64_t pos = doc.line_to_char(line);
+	bool ext = _extending();
+	_set_selection(_transform(sel, [&](const HelixRange &r) { return put_cursor(doc, r, pos, ext); }));
+}
+
+void HelixMode::_align_view(int p_align) {
+	if (!text_edit->is_inside_tree()) {
+		return;
+	}
+	int line = doc.char_to_line(cursor(doc, sel.primary_range()));
+	if (p_align == 0) {
+		text_edit->set_line_as_first_visible(line);
+	} else if (p_align == 1) {
+		text_edit->set_line_as_center_visible(line);
+	} else {
+		text_edit->set_line_as_first_visible(MAX(line - _view_height() + 1, 0));
+	}
+}
+
+/* Search */
+
+Ref<RefCounted> HelixMode::_make_regex(const String &p_pattern, String *r_error) const {
+#ifdef MODULE_REGEX_ENABLED
+	if (regex_cache.is_valid() && regex_cache_pattern == p_pattern) {
+		return regex_cache; // n / N and incremental search reuse the compiled pattern.
+	}
+	bool case_insensitive = true;
+	for (int i = 0; i < p_pattern.length(); i++) {
+		if (is_upper(p_pattern[i])) {
+			case_insensitive = false;
+			break;
+		}
+	}
+	Ref<RegEx> re;
+	re.instantiate();
+	String full = String("(*UTF)(*UCP)(?m)") + (case_insensitive ? "(?i)" : "") + p_pattern;
+	if (re->compile(full, false) != OK || !re->is_valid()) {
+		if (r_error) {
+			*r_error = "Invalid regex: " + p_pattern;
+		}
+		return Ref<RefCounted>();
+	}
+	regex_cache = re;
+	regex_cache_pattern = p_pattern;
+	return re;
+#else
+	if (r_error) {
+		*r_error = "Regular expressions are not available";
+	}
+	return Ref<RefCounted>();
+#endif
+}
+
+bool HelixMode::_search_impl(const Ref<RefCounted> &p_regex, bool p_extend, bool p_forward, bool p_show_warnings) {
+#ifdef MODULE_REGEX_ENABLED
+	Ref<RegEx> re = p_regex;
+	if (re.is_null()) {
+		return false;
+	}
+	const HelixRange &prim = sel.primary_range();
+	int64_t start = p_forward ? doc.ensure_grapheme_next(prim.to()) : doc.ensure_grapheme_prev(prim.from());
+	const String &text = _full_text();
+	// Last match in text[p_from, p_to): Helix takes the last of the matches found left to
+	// right. Scanning the whole range creates an object per match, so scan growing windows
+	// that start at a line start, back from p_to, and take the last match of the first window
+	// that has one.
+	auto last_match = [&](int64_t p_from, int64_t p_to) {
+		Ref<RegExMatch> last;
+		int64_t window = 4096;
+		while (true) {
+			int64_t ws = MAX(p_to - window, p_from);
+			if (ws > p_from) {
+				ws = MAX(doc.line_to_char(doc.char_to_line(ws)), p_from);
+			}
+			TypedArray<RegExMatch> all = re->search_all(text, ws, p_to);
+			if (!all.is_empty()) {
+				last = all[all.size() - 1];
+				break;
+			}
+			if (ws <= p_from) {
+				break;
+			}
+			window *= 8;
+		}
+		return last;
+	};
+	Ref<RegExMatch> m;
+	if (p_forward) {
+		m = re->search(text, start);
+	} else {
+		m = last_match(0, start);
+	}
+	if (m.is_null()) {
+		bool wrapped = false;
+		if (p_forward) {
+			m = re->search(text, 0);
+		} else {
+			m = last_match(start, text.length());
+		}
+		wrapped = m.is_valid();
+		if (p_show_warnings) {
+			if (wrapped) {
+				_set_status("Wrapped around document");
+			} else {
+				_set_status("No more matches", true);
+			}
+		}
+	}
+	if (m.is_null()) {
+		return false;
+	}
+	int64_t s = m->get_start(0);
+	int64_t e = m->get_end(0);
+	if (e == 0) {
+		return false;
+	}
+	HelixRange r = HelixRange(s, e).with_direction(prim.is_forward());
+	HelixSelection ns = sel;
+	if (p_extend) {
+		ns.push(r);
+	} else {
+		ns.ranges.write[ns.primary] = r;
+		ns.normalize();
+	}
+	_set_selection(ns);
+	// Like Helix's ensure_cursor_in_view_center: a match outside the view is centered.
+	if (text_edit->is_inside_tree() && text_edit->get_visible_line_count() > 0) {
+		int line = doc.char_to_line(cursor(doc, sel.primary_range()));
+		if (line < text_edit->get_first_visible_line() || line > text_edit->get_last_full_visible_line()) {
+			text_edit->set_line_as_center_visible(line);
+		}
+	}
+	return true;
+#else
+	return false;
+#endif
+}
+
+void HelixMode::_search_next(bool p_forward, bool p_extend) {
+	if (!shared.has_search_pattern) {
+		return;
+	}
+	String err;
+	Ref<RefCounted> re = _make_regex(shared.search_pattern, &err);
+	if (re.is_null()) {
+		_set_status(err, true);
+		return;
+	}
+	int n = MIN(_count(), REPEAT_CAP);
+	for (int i = 0; i < n; i++) {
+		HelixSelection before = sel;
+		if (!_search_impl(re, p_extend, p_forward, true) || sel == before) {
+			break;
+		}
+	}
+}
+
+void HelixMode::_search_selection(bool p_word_boundaries) {
+	int64_t len = doc.len();
+	Vector<String> parts;
+	for (int i = 0; i < sel.ranges.size(); i++) {
+		const HelixRange &r = sel.ranges[i];
+		bool prefix = false;
+		bool suffix = false;
+		if (p_word_boundaries) {
+			int64_t f = r.from();
+			if (f != len) {
+				char32_t ch = doc.char_at(f);
+				prefix = f == 0 ? is_word(ch) : (!is_word(doc.char_at(f - 1)) && is_word(ch));
+			}
+			int64_t t = r.to();
+			if (t != 0 && t != len) {
+				suffix = is_word(doc.char_at(t - 1)) && !is_word(doc.char_at(t));
+			}
+		}
+		String part = String(prefix ? "\\b" : "") + regex_escape(doc.slice(r.from(), r.to())) + String(suffix ? "\\b" : "");
+		if (!parts.has(part)) {
+			parts.push_back(part);
+		}
+	}
+	String regex = String("|").join(parts);
+	shared.search_pattern = regex;
+	shared.has_search_pattern = true;
+	_set_status("register '/' set to '" + regex + "'");
+}
+
+#ifdef MODULE_REGEX_ENABLED
+// Calls p_f(start, end) for every match in text[p_from, p_to), like RegEx::search_all().
+// PCRE2 validates the UTF of the whole remaining subject on every match attempt, which makes
+// search_all() over a large buffer quadratic (seconds for "%s" on a big file). So the subject
+// is cut at a line start a few thousand characters ahead; only matches starting well before
+// that cut are taken from a window, and a match reaching the cut is redone without it.
+template <typename F>
+static void _for_each_match(const Ref<RegEx> &p_re, const String &p_text, const HelixDoc &p_doc, int64_t p_from, int64_t p_to, F p_f) {
+	const int64_t window = 8192;
+	const int64_t margin = 2048;
+	int64_t pos = p_from;
+	while (pos <= p_to) {
+		int64_t wend = p_to;
+		int64_t accept = p_to + 1;
+		if (p_to - pos > window) {
+			wend = MIN(p_doc.line_to_char(p_doc.char_to_line(pos + window) + 1), p_to);
+			if (wend < p_to) {
+				accept = MAX(wend - margin, pos + 1);
+			}
+		}
+		Ref<RegExMatch> m = p_re->search(p_text, pos, wend);
+		if (m.is_null() || m->get_start(0) >= accept) {
+			if (wend >= p_to) {
+				break;
+			}
+			pos = accept;
+			continue;
+		}
+		if (wend < p_to && m->get_end(0) >= wend) {
+			m = p_re->search(p_text, m->get_start(0), p_to);
+			if (m.is_null()) {
+				break;
+			}
+		}
+		int64_t s = m->get_start(0);
+		int64_t e = m->get_end(0);
+		p_f(s, e);
+		pos = e == s ? e + 1 : e;
+	}
+}
+#endif
+
+bool HelixMode::_regex_apply(PromptKind p_kind, const String &p_input) {
+#ifdef MODULE_REGEX_ENABLED
+	if (p_input.is_empty()) {
+		return false;
+	}
+	String err;
+	Ref<RegEx> re = _make_regex(p_input, &err);
+	sel = prompt_snapshot;
+	if (re.is_null()) {
+		return false;
+	}
+	if (p_kind == PROMPT_SEARCH_FORWARD || p_kind == PROMPT_SEARCH_BACKWARD) {
+		return _search_impl(re, prompt_extend, p_kind == PROMPT_SEARCH_FORWARD, false);
+	}
+	const String &text = _full_text();
+	if (p_kind == PROMPT_SELECT_REGEX) {
+		Vector<HelixRange> result;
+		for (int i = 0; i < sel.ranges.size(); i++) {
+			const HelixRange &r = sel.ranges[i];
+			_for_each_match(re, text, doc, r.from(), r.to(), [&](int64_t p_s, int64_t p_e) {
+				if (!(p_s == r.to() && p_e == r.to())) {
+					result.push_back(HelixRange(p_s, p_e));
+				}
+			});
+		}
+		if (result.is_empty()) {
+			_set_status("nothing selected", true);
+		} else {
+			_set_selection(HelixSelection::from_ranges(result, 0));
+		}
+	} else if (p_kind == PROMPT_SPLIT_REGEX) {
+		Vector<HelixRange> result;
+		for (int i = 0; i < sel.ranges.size(); i++) {
+			const HelixRange &r = sel.ranges[i];
+			if (r.from() == r.to()) {
+				result.push_back(r);
+				continue;
+			}
+			int64_t start = r.from();
+			_for_each_match(re, text, doc, r.from(), r.to(), [&](int64_t p_s, int64_t p_e) {
+				result.push_back(HelixRange(start, p_s));
+				start = p_e;
+			});
+			if (start < r.to()) {
+				result.push_back(HelixRange(start, r.to()));
+			}
+		}
+		if (!result.is_empty()) {
+			_set_selection(HelixSelection::from_ranges(result, 0));
+		}
+	} else if (p_kind == PROMPT_KEEP_REGEX || p_kind == PROMPT_REMOVE_REGEX) {
+		bool remove = p_kind == PROMPT_REMOVE_REGEX;
+		Vector<HelixRange> result;
+		for (int i = 0; i < sel.ranges.size(); i++) {
+			const HelixRange &r = sel.ranges[i];
+			bool matched = re->search(text, r.from(), r.to()).is_valid();
+			if (matched != remove) {
+				result.push_back(r);
+			}
+		}
+		if (result.is_empty()) {
+			_set_status("no selections remaining", true);
+		} else {
+			_set_selection(HelixSelection::from_ranges(result, 0));
+		}
+	}
+	return true;
+#else
+	return false;
+#endif
+}
+
+const String &HelixMode::_full_text() const {
+	// The whole buffer as one string (regex input), rebuilt only after an edit: incremental
+	// search re-runs the regex on every typed character.
+	uint32_t v = text_edit->get_version();
+	int64_t l = doc.len();
+	if (text_cache_len != l || text_cache_version != v) {
+		text_cache = text_edit->get_text();
+		text_cache_version = v;
+		text_cache_len = l;
+	}
+	return text_cache;
+}
+
+/* Prompt */
+
+void HelixMode::_open_prompt(PromptKind p_kind) {
+	prompt_kind = p_kind;
+	prompt_text = String();
+	prompt_snapshot = sel;
+	prompt_extend = mode == MODE_SELECT;
+}
+
+void HelixMode::_close_prompt() {
+	prompt_kind = PROMPT_NONE;
+	prompt_text = String();
+}
+
+void HelixMode::_prompt_key(const String &p_key) {
+	if (p_key == "<esc>" || p_key == "<C-c>") {
+		prompt_cancel();
+	} else if (p_key == "<ret>") {
+		prompt_submit(prompt_text);
+	} else if (p_key == "<backspace>") {
+		if (!prompt_text.is_empty()) {
+			prompt_update(prompt_text.substr(0, prompt_text.length() - 1));
+		}
+	} else if (p_key == "<space>") {
+		prompt_update(prompt_text + " ");
+	} else if (p_key == "<tab>") {
+		prompt_update(prompt_text + "\t");
+	} else if (p_key.length() == 1) {
+		prompt_update(prompt_text + p_key);
+	}
+}
+
+HelixMode::PromptKind HelixMode::get_prompt_kind() const {
+	return prompt_kind;
+}
+
+String HelixMode::get_prompt_prefix() const {
+	switch (prompt_kind) {
+		case PROMPT_SEARCH_FORWARD:
+			return "/";
+		case PROMPT_SEARCH_BACKWARD:
+			return "?";
+		case PROMPT_SELECT_REGEX:
+			return "select:";
+		case PROMPT_SPLIT_REGEX:
+			return "split:";
+		case PROMPT_KEEP_REGEX:
+			return "keep:";
+		case PROMPT_REMOVE_REGEX:
+			return "remove:";
+		case PROMPT_COMMAND:
+			return ":";
+		default:
+			return String();
+	}
+}
+
+String HelixMode::get_prompt_text() const {
+	return prompt_text;
+}
+
+void HelixMode::prompt_update(const String &p_text) {
+	if (prompt_kind == PROMPT_NONE || !_alive()) {
+		return;
+	}
+	prompt_text = p_text;
+	if (prompt_kind != PROMPT_COMMAND && !p_text.is_empty()) {
+		status = String();
+		status_error = false;
+		_regex_apply(prompt_kind, p_text);
+		_push_selection();
+		_scroll_to_primary();
+	}
+	_emit_if_changed();
+}
+
+void HelixMode::prompt_submit(const String &p_text) {
+	if (prompt_kind == PROMPT_NONE || !_alive()) {
+		return;
+	}
+	PromptKind kind = prompt_kind;
+	String input = p_text;
+	_close_prompt();
+	status = String();
+	status_error = false;
+	if (kind == PROMPT_COMMAND) {
+		_begin_step();
+		_run_command_line(input);
+		_end_step();
+	} else {
+		if (input.is_empty() && shared.has_search_pattern) {
+			input = shared.search_pattern;
+		}
+		if (!input.is_empty()) {
+			bool found = _regex_apply(kind, input);
+			if (!found && (kind == PROMPT_SEARCH_FORWARD || kind == PROMPT_SEARCH_BACKWARD)) {
+				_set_status("Pattern not found: " + input, true);
+			}
+			shared.search_pattern = input;
+			shared.has_search_pattern = true;
+		} else {
+			sel = prompt_snapshot;
+		}
+	}
+	if (mode != MODE_INSERT) {
+		_push_selection();
+		_scroll_to_primary();
+	}
+	_emit_if_changed();
+}
+
+void HelixMode::prompt_cancel() {
+	if (prompt_kind == PROMPT_NONE) {
+		return;
+	}
+	_alive();
+	_close_prompt();
+	sel = prompt_snapshot;
+	if (text_edit) {
+		_push_selection();
+		_scroll_to_primary();
+	}
+	_emit_if_changed();
+}
+
+void HelixMode::_run_command_line(const String &p_text) {
+	String line = p_text.strip_edges();
+	if (line.is_empty()) {
+		return;
+	}
+	String cmd = line;
+	String arg;
+	int sp = line.find(" ");
+	if (sp >= 0) {
+		cmd = line.substr(0, sp);
+		arg = line.substr(sp + 1).strip_edges();
+	}
+	if (cmd.is_valid_int()) {
+		_goto_line((int)CLAMP(cmd.to_int(), (int64_t)1, (int64_t)doc.line_count()), mode == MODE_SELECT);
+		return;
+	}
+	bool force = cmd.ends_with("!");
+	String base = force ? cmd.substr(0, cmd.length() - 1) : cmd;
+	Dictionary extra;
+	if (base == "w" || base == "write") {
+		extra["force"] = force;
+		_host(HOST_SAVE, extra);
+	} else if (base == "wa" || base == "write-all") {
+		extra["force"] = force;
+		_host(HOST_SAVE_ALL, extra);
+	} else if (base == "q" || base == "quit" || base == "bc" || base == "bclose" || base == "buffer-close") {
+		extra["force"] = force;
+		extra["save_first"] = false;
+		_host(HOST_CLOSE, extra);
+	} else if (base == "wq" || base == "x" || base == "write-quit" || base == "xit") {
+		extra["force"] = force;
+		extra["save_first"] = true;
+		_host(HOST_CLOSE, extra);
+	} else if (base == "bn" || base == "bnext" || base == "buffer-next") {
+		_host(HOST_NEXT_TAB);
+	} else if (base == "bp" || base == "bprev" || base == "buffer-previous") {
+		_host(HOST_PREV_TAB);
+	} else if (base == "g" || base == "goto") {
+		if (arg.is_valid_int()) {
+			_goto_line((int)CLAMP(arg.to_int(), (int64_t)1, (int64_t)doc.line_count()), mode == MODE_SELECT);
+		} else {
+			_set_status("invalid line number: '" + arg + "'", true);
+		}
+	} else {
+		_set_status("no such command: '" + cmd + "'", true);
+	}
+}
+
+String HelixMode::_symbol_at_primary() const {
+	HelixRange r = mode == MODE_INSERT ? _insert_selection().primary_range() : sel.primary_range();
+	if (r.len() > 1) {
+		String t = doc.slice(r.from(), r.to());
+		if (!t.contains("\n") && !is_single_grapheme(doc, r)) {
+			return t;
+		}
+	}
+	int64_t c = cursor(doc, r);
+	int64_t s = c;
+	int64_t e = c;
+	int64_t l = doc.len();
+	while (s > 0 && is_word(doc.char_at(s - 1))) {
+		s--;
+	}
+	while (e < l && is_word(doc.char_at(e))) {
+		e++;
+	}
+	return doc.slice(s, e);
+}
+
+Dictionary HelixMode::_host_args() const {
+	Dictionary d;
+	HelixRange r = mode == MODE_INSERT ? _insert_selection().primary_range() : sel.primary_range();
+	int line, col;
+	doc.pos_to_line_col(cursor(doc, r), line, col);
+	d["line"] = line;
+	d["column"] = col;
+	d["symbol"] = _symbol_at_primary();
+	return d;
+}
+
+void HelixMode::_host(HostCommand p_cmd, const Dictionary &p_extra) {
+	Dictionary args = _host_args();
+	Array keys = p_extra.keys();
+	for (int i = 0; i < keys.size(); i++) {
+		args[keys[i]] = p_extra[keys[i]];
+	}
+	emit_signal(SNAME("host_command"), (int)p_cmd, args);
+}
+
+/* Dispatch tables */
+
+bool HelixMode::_dispatch_pending(const String &p_key) {
+	bool ext = _extending();
+	int n = _count();
+	char32_t c = 0;
+	bool is_char = _key_char(p_key, c);
+	String p = pending;
+
+	if (p == "f" || p == "t" || p == "F" || p == "T") {
+		pending = String();
+		bool fwd = p == "f" || p == "t";
+		bool incl = p == "f" || p == "F";
+		LastMotion m;
+		m.kind = MOTION_FIND;
+		m.forward = fwd;
+		m.inclusive = incl;
+		m.extend = ext;
+		m.count = n;
+		if (p_key == "<ret>") {
+			m.newline = true;
+		} else if (p_key == "<tab>") {
+			m.ch = '\t';
+		} else if (is_char) {
+			m.ch = c;
+		} else {
+			return true;
+		}
+		shared.last_motion = m;
+		_run_motion(m, 1);
+		return true;
+	}
+	if (p == "r") {
+		pending = String();
+		if (p_key == "<ret>") {
+			_replace_char("\n");
+		} else if (p_key == "<tab>") {
+			_replace_char("\t");
+		} else if (is_char) {
+			_replace_char(String::chr(c));
+		}
+		return true;
+	}
+	if (p == "g") {
+		pending = String();
+		if (p_key == "g") {
+			_goto_file_start(ext);
+		} else if (p_key == "e") {
+			_goto_last_line(ext);
+		} else if (p_key == "h") {
+			_goto_line_start(ext);
+		} else if (p_key == "l") {
+			_goto_line_end(ext);
+		} else if (p_key == "s") {
+			_goto_first_nonwhitespace(ext);
+		} else if (p_key == "|") {
+			_goto_column(ext);
+		} else if (p_key == "j") {
+			_move_vertical(true, ext, false);
+		} else if (p_key == "k") {
+			_move_vertical(false, ext, false);
+		} else if (p_key == "t") {
+			_goto_window(0);
+		} else if (p_key == "c") {
+			_goto_window(1);
+		} else if (p_key == "b") {
+			_goto_window(2);
+		} else if (p_key == "d") {
+			_host(HOST_GOTO_DEFINITION);
+		} else if (p_key == "a") {
+			_host(HOST_LAST_TAB);
+		} else if (p_key == "n") {
+			_host(HOST_NEXT_TAB);
+		} else if (p_key == "p") {
+			_host(HOST_PREV_TAB);
+		}
+		return true;
+	}
+	if (p == "z" || p == "Z") {
+		pending = String();
+		int h = _view_height();
+		if (p_key == "z" || p_key == "c") {
+			_align_view(1);
+		} else if (p_key == "t") {
+			_align_view(0);
+		} else if (p_key == "b") {
+			_align_view(2);
+		} else if (p_key == "m") {
+			// Horizontal centering: TextEdit scrolls horizontally to the caret by itself.
+		} else if (p_key == "k" || p_key == "<up>") {
+			_scroll(n, false, false);
+		} else if (p_key == "j" || p_key == "<down>") {
+			_scroll(n, true, false);
+		} else if (p_key == "<C-b>" || p_key == "<pageup>") {
+			_scroll(h, false, false);
+		} else if (p_key == "<C-f>" || p_key == "<pagedown>") {
+			_scroll(h, true, false);
+		} else if (p_key == "<C-u>" || p_key == "<backspace>") {
+			_scroll(h / 2, false, true);
+		} else if (p_key == "<C-d>" || p_key == "<space>") {
+			_scroll(h / 2, true, true);
+		} else if (p_key == "/") {
+			_open_prompt(PROMPT_SEARCH_FORWARD);
+		} else if (p_key == "?") {
+			_open_prompt(PROMPT_SEARCH_BACKWARD);
+		} else if (p_key == "n") {
+			_search_next(true, ext);
+		} else if (p_key == "N") {
+			_search_next(false, ext);
+		}
+		return true;
+	}
+	if (p == "<space>") {
+		pending = String();
+		if (p_key == "f") {
+			_host(HOST_QUICK_OPEN);
+		} else if (p_key == "k") {
+			_host(HOST_SHOW_DOCS);
+		} else if (p_key == "/") {
+			Dictionary extra;
+			extra["query"] = _symbol_at_primary();
+			_host(HOST_FIND_IN_FILES, extra);
+		} else if (p_key == "?") {
+			_host(HOST_COMMAND_PALETTE);
+		} else if (p_key == "y") {
+			_yank("+");
+		} else if (p_key == "Y") {
+			_yank_primary_to_clipboard();
+			_exit_select();
+		} else if (p_key == "p") {
+			_paste(_read_register("+"), true, n);
+			_exit_select();
+		} else if (p_key == "P") {
+			_paste(_read_register("+"), false, n);
+			_exit_select();
+		} else if (p_key == "R") {
+			_replace_with(_read_register("+"), n);
+			_exit_select();
+		} else if (p_key == "c" || p_key == "<A-c>") {
+			_toggle_comments();
+		}
+		return true;
+	}
+	if (p == "[" || p == "]") {
+		pending = String();
+		bool fwd = p == "]";
+		if (p_key == "p") {
+			LastMotion m;
+			m.kind = MOTION_PARA;
+			m.forward = fwd;
+			m.count = n;
+			shared.last_motion = m;
+			_run_motion(m, 1);
+		} else if (p_key == "<space>") {
+			_add_newline(fwd, n);
+		}
+		return true;
+	}
+	if (p == "m") {
+		if (p_key == "m") {
+			pending = String();
+			_match_brackets();
+		} else if (p_key == "s" || p_key == "r" || p_key == "d" || p_key == "a" || p_key == "i") {
+			pending = "m" + p_key;
+			return false;
+		} else {
+			pending = String();
+		}
+		return true;
+	}
+	if (p == "ms") {
+		pending = String();
+		_surround_add(p_key);
+		return true;
+	}
+	if (p == "md") {
+		pending = String();
+		if (is_char) {
+			_surround_delete(c == 'm' ? 0 : c, n);
+		}
+		return true;
+	}
+	if (p == "mr") {
+		if (!is_char) {
+			pending = String();
+			return true;
+		}
+		Vector<int64_t> pos;
+		SurroundError err = get_surround_pos(doc, sel, c == 'm' ? 0 : c, n, pos);
+		if (err != SURROUND_OK) {
+			pending = String();
+			_set_status(surround_error_message(err), true);
+			return true;
+		}
+		pending = "mr" + String::chr(c);
+		return false;
+	}
+	if (p.begins_with("mr") && p.length() == 3) {
+		pending = String();
+		char32_t from = p[2];
+		_surround_replace(from == 'm' ? 0 : from, p_key, n);
+		return true;
+	}
+	if (p == "mi" || p == "ma") {
+		pending = String();
+		if (!is_char) {
+			return true;
+		}
+		LastMotion m;
+		m.kind = MOTION_TEXTOBJECT;
+		m.inside = p == "mi";
+		m.ch = c;
+		m.count = n;
+		shared.last_motion = m;
+		_run_motion(m, 1);
+		return true;
+	}
+	pending = String();
+	return true;
+}
+
+void HelixMode::_dispatch_normal(const String &k) {
+	bool ext = _extending();
+	int n = _count();
+
+	// Motions.
+	if (k == "h" || k == "<left>") {
+		_move_horizontal(false, ext);
+	} else if (k == "l" || k == "<right>") {
+		_move_horizontal(true, ext);
+	} else if (k == "j" || k == "<down>") {
+		_move_vertical(true, ext);
+	} else if (k == "k" || k == "<up>") {
+		_move_vertical(false, ext);
+	} else if (k == "w") {
+		_move_word(NEXT_WORD_START, ext);
+	} else if (k == "b") {
+		_move_word(PREV_WORD_START, ext);
+	} else if (k == "e") {
+		_move_word(NEXT_WORD_END, ext);
+	} else if (k == "W") {
+		_move_word(NEXT_LONG_WORD_START, ext);
+	} else if (k == "B") {
+		_move_word(PREV_LONG_WORD_START, ext);
+	} else if (k == "E") {
+		_move_word(NEXT_LONG_WORD_END, ext);
+	} else if (k == "f" || k == "t" || k == "F" || k == "T" || k == "r" || k == "g" || k == "m" || k == "z" || k == "Z" || k == "<space>" || k == "[" || k == "]") {
+		pending = k;
+	} else if (k == "\"") {
+		pending_register = true;
+	} else if (k == "<A-.>") {
+		if (shared.last_motion.kind != MOTION_NONE) {
+			LastMotion m = shared.last_motion;
+			if (m.kind == MOTION_FIND) {
+				// The captured extend flag is kept, like Helix's motion closure.
+			}
+			_run_motion(m, n);
+		}
+	} else if (k == "<home>") {
+		_goto_line_start(ext);
+	} else if (k == "<end>") {
+		_goto_line_end(ext);
+	} else if (k == "G") {
+		if (count > 0) {
+			_goto_line(count, false);
+		}
+	} else if (k == "v") {
+		if (mode == MODE_SELECT) {
+			mode = MODE_NORMAL;
+		} else {
+			_select_mode();
+		}
+	} else if (k == "<esc>") {
+		_exit_select();
+	} else if (k == "<C-d>") {
+		_scroll(_view_height() / 2, true, true);
+	} else if (k == "<C-u>") {
+		_scroll(_view_height() / 2, false, true);
+	} else if (k == "<C-f>" || k == "<pagedown>") {
+		_scroll(_view_height(), true, false);
+	} else if (k == "<C-b>" || k == "<pageup>") {
+		_scroll(_view_height(), false, false);
+	} else if (k == "<C-e>") {
+		_scroll(n, true, false);
+	} else if (k == "<C-y>") {
+		_scroll(n, false, false);
+	}
+	// Selection manipulation.
+	else if (k == "x") {
+		_extend_line_below();
+	} else if (k == "X") {
+		_extend_to_line_bounds();
+	} else if (k == "<A-x>") {
+		_shrink_to_line_bounds();
+	} else if (k == "%") {
+		_set_selection(HelixSelection::single(0, doc.len()));
+	} else if (k == ";") {
+		_set_selection(_transform(sel, [&](const HelixRange &r) { return HelixRange::point(cursor(doc, r)); }));
+	} else if (k == "<A-;>") {
+		_set_selection(_transform(sel, [&](const HelixRange &r) { return r.flip(); }));
+	} else if (k == "<A-:>") {
+		_set_selection(_transform(sel, [&](const HelixRange &r) { return r.with_direction(true); }));
+	} else if (k == ",") {
+		_set_selection(sel.into_single());
+	} else if (k == "<A-,>") {
+		if (sel.size() == 1) {
+			_set_status("no selections remaining", true);
+		} else {
+			HelixSelection s = sel;
+			s.remove(s.primary);
+			_set_selection(s);
+		}
+	} else if (k == "C") {
+		_copy_selection_on_line(true);
+	} else if (k == "<A-C>") {
+		_copy_selection_on_line(false);
+	} else if (k == "(" || k == ")") {
+		HelixSelection s = sel;
+		int len = s.size();
+		if (k == ")") {
+			s.primary = (s.primary + n) % len;
+		} else {
+			s.primary = (s.primary + (MAX(len - n, 0) % len)) % len;
+		}
+		sel = s;
+	} else if (k == "<A-(>") {
+		_rotate_contents(false);
+	} else if (k == "<A-)>") {
+		_rotate_contents(true);
+	} else if (k == "_") {
+		_trim_selections();
+	} else if (k == "&") {
+		_align_selections();
+	} else if (k == "<A-minus>") {
+		_set_selection(sel.merged_all());
+	} else if (k == "<A-_>") {
+		HelixSelection s = sel;
+		s.merge_consecutive();
+		_set_selection(s);
+	} else if (k == "s") {
+		_open_prompt(PROMPT_SELECT_REGEX);
+	} else if (k == "S") {
+		_open_prompt(PROMPT_SPLIT_REGEX);
+	} else if (k == "K") {
+		_open_prompt(PROMPT_KEEP_REGEX);
+	} else if (k == "<A-K>") {
+		_open_prompt(PROMPT_REMOVE_REGEX);
+	} else if (k == "<A-s>") {
+		_split_on_newline();
+	} else if (k == "J") {
+		_join_selections(false);
+	} else if (k == "<A-J>") {
+		_join_selections(true);
+	}
+	// Editing.
+	else if (k == "d") {
+		_delete_selection(true, false);
+	} else if (k == "<A-d>") {
+		_delete_selection(false, false);
+	} else if (k == "c") {
+		_delete_selection(true, true);
+	} else if (k == "<A-c>") {
+		_delete_selection(false, true);
+	} else if (k == "i") {
+		if (_check_editable()) {
+			_insert_mode();
+		}
+	} else if (k == "a") {
+		if (_check_editable()) {
+			_append_mode();
+		}
+	} else if (k == "I") {
+		if (_check_editable()) {
+			_insert_with_indent(false);
+		}
+	} else if (k == "A") {
+		if (_check_editable()) {
+			_insert_with_indent(true);
+		}
+	} else if (k == "o") {
+		_open(true);
+	} else if (k == "O") {
+		_open(false);
+	} else if (k == "y") {
+		if (use_system_clipboard) {
+			// y = ":clipboard-yank": a typed command, which (unlike the static yank commands)
+			// does not leave select mode; the count is ignored.
+			_yank_primary_to_clipboard();
+		} else {
+			_yank("\"");
+		}
+	} else if (k == "p") {
+		if (use_system_clipboard) {
+			// p = ":clipboard-paste-before": paste(editor, '+', Paste::Before, 1). In select mode
+			// the selection is mapped over the pasted text and select mode stays.
+			_paste(_read_register("+"), false, 1);
+		} else {
+			_paste(_read_register("\""), true, n);
+			_exit_select();
+		}
+	} else if (k == "P") {
+		_paste(_read_register("\""), false, n);
+		_exit_select();
+	} else if (k == "R") {
+		_replace_with(_read_register("\""), n);
+		_exit_select();
+	} else if (k == "~") {
+		_switch_case(0);
+	} else if (k == "`") {
+		_switch_case(1);
+	} else if (k == "<A-`>") {
+		_switch_case(2);
+	} else if (k == ">") {
+		_indent(n);
+	} else if (k == "<") {
+		_unindent(n);
+	} else if (k == "u" || k == "<A-u>") {
+		_undo(n);
+	} else if (k == "U" || k == "<A-U>") {
+		_redo(n);
+	} else if (k == "<C-a>") {
+		_increment(n);
+	} else if (k == "<C-x>") {
+		_increment(-n);
+	} else if (k == "<C-c>") {
+		_toggle_comments();
+	} else if (k == "=") {
+		_host(HOST_FORMAT);
+	}
+	// Search.
+	else if (k == "/") {
+		_open_prompt(PROMPT_SEARCH_FORWARD);
+	} else if (k == "?") {
+		_open_prompt(PROMPT_SEARCH_BACKWARD);
+	} else if (k == "n") {
+		_search_next(true, ext);
+	} else if (k == "N") {
+		_search_next(false, ext);
+	} else if (k == "*") {
+		_search_selection(true);
+	} else if (k == "<A-*>") {
+		_search_selection(false);
+	} else if (k == ":") {
+		_open_prompt(PROMPT_COMMAND);
+	}
+	// Everything else (macros, shell pipes, jumplist, tree-sitter motions, unbound
+	// printable keys) is swallowed.
+}
