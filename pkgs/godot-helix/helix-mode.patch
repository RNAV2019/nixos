+bool ShaderEditorPlugin::_helix_host_command(int p_command, const Dictionary &p_args) {
+	const int current = shader_tabs->get_current_tab();
+	const int count = shader_tabs->get_tab_count();
+	if (current < 0) {
+		return false;
+	}
+
+	int switch_to = -1;
+	switch (p_command) {
+		case HelixMode::HOST_NEXT_TAB: {
+			switch_to = count > 1 ? (current + 1) % count : -1;
+		} break;
+		case HelixMode::HOST_PREV_TAB: {
+			switch_to = count > 1 ? (current + count - 1) % count : -1;
+		} break;
+		case HelixMode::HOST_LAST_TAB: {
+			switch_to = shader_tabs->get_previous_tab();
+		} break;
+		case HelixMode::HOST_SAVE: {
+			_save_shader(current);
+		} break;
+		case HelixMode::HOST_SAVE_ALL: {
+			for (int i = 0; i < count; i++) {
+				_save_shader(i);
+			}
+		} break;
+		case HelixMode::HOST_CLOSE: {
+			// Edits live in the shader resource, closing never loses them (same as the menu).
+			if (p_args.get("save_first", false)) {
+				_save_shader(current);
+			}
+			_close_shader(current);
+		} break;
+		default: {
+			return false;
+		}
+	}
+
+	if (switch_to >= 0 && switch_to < count && switch_to != current) {
+		_shader_selected(switch_to);
+		TextShaderEditor *editor = Object::cast_to<TextShaderEditor>(edited_shaders[switch_to].shader_editor);
+		if (editor && editor->get_code_editor()) {
+			editor->get_code_editor()->get_text_editor()->grab_focus();
+		}
+	}
+	return true;
+}
